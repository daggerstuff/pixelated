#!/usr/bin/env bash
set -euo pipefail

# Ensure the correct Node version from nvm is available in the hook environment
if [ -z "${NVM_DIR:-}" ]; then
  if [ -s "$HOME/.nvm/nvm.sh" ]; then
    export NVM_DIR="$HOME/.nvm"
  elif [ -s "$HOME/.config/nvm/nvm.sh" ]; then
    export NVM_DIR="$HOME/.config/nvm"
  fi
fi

if [ -n "${NVM_DIR:-}" ] && [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  if [ -f .nvmrc ]; then
    nvm use --silent >/dev/null 2>&1 || nvm use || true
  fi
fi

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Auto-sync lockfiles on checkout/merge
PREV_REF=""
if git rev-parse --verify HEAD@{1} >/dev/null 2>&1; then
  PREV_REF="HEAD@{1}"
elif git rev-parse --verify ORIG_HEAD >/dev/null 2>&1; then
  PREV_REF="ORIG_HEAD"
fi

if [ -n "$PREV_REF" ]; then
  # check for lockfile changes
  if git diff-tree -r --name-only "$PREV_REF" HEAD | grep -q 'pnpm-lock.yaml'; then
    if command -v pnpm >/dev/null 2>&1; then
      echo -e "${BLUE}📦 [Hook] pnpm-lock.yaml changed. Running pnpm install...${NC}"
      pnpm install
    else
      echo -e "${YELLOW}⚠️ [Hook] pnpm-lock.yaml changed but pnpm is not installed. Skipping install.${NC}"
    fi
  fi
  # check for python lockfile changes
  if git diff-tree -r --name-only "$PREV_REF" HEAD | grep -q 'uv.lock'; then
    if command -v uv >/dev/null 2>&1; then
      echo -e "${BLUE}📦 [Hook] uv.lock changed. Running uv sync --frozen...${NC}"
      uv sync --frozen
    else
      echo -e "${YELLOW}⚠️ [Hook] uv.lock changed but uv is not installed. Skipping sync.${NC}"
    fi
  fi
fi

# --- BEGIN BEADS INTEGRATION v1.0.4 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run post-checkout "$@"
    _bd_exit=$?
    if [ $_bd_exit -eq 124 ]; then
      echo >&2 "beads: hook 'post-checkout' timed out after ${_bd_timeout}s — continuing without beads"
      _bd_exit=0
    fi
  else
    bd hooks run post-checkout "$@"
    _bd_exit=$?
  fi
  if [ $_bd_exit -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'post-checkout'"
    _bd_exit=0
  fi
  if [ $_bd_exit -ne 0 ]; then exit $_bd_exit; fi
fi
# --- END BEADS INTEGRATION v1.0.4 ---
