{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReleaseReadiness",
  "type": "object",
  "properties": {
    "releaseId": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "overallStatus": {
      "type": "string",
      "enum": ["ready", "warning", "not-ready"]
    },
    "overallScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "providers": {
      "type": "object",
      "properties": {
        "github": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["pass", "fail", "warning", "skipped"]
            },
            "pipelineUrl": { "type": "string" },
            "checks": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "enum": ["pass", "fail", "warning", "skipped"]
              }
            }
          },
          "required": ["status"]
        },
        "gitlab": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["pass", "fail", "warning", "skipped"]
            },
            "pipelineUrl": { "type": "string" },
            "checks": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "enum": ["pass", "fail", "warning", "skipped"]
              }
            }
          },
          "required": ["status"]
        },
        "bitbucket": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["pass", "fail", "warning", "skipped"]
            },
            "pipelineUrl": { "type": "string" },
            "checks": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "enum": ["pass", "fail", "warning", "skipped"]
              }
            }
          },
          "required": ["status"]
        }
      }
    },
    "qualityGates": {
      "type": "object",
      "properties": {
        "testCoverage": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["pass", "fail", "warning"] },
            "value": { "type": "number" },
            "target": { "type": "number" }
          },
          "required": ["status", "value", "target"]
        },
        "securityVulnerabilities": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["pass", "fail", "warning"] },
            "value": { "type": "number" },
            "target": { "type": "number" }
          },
          "required": ["status", "value", "target"]
        }
      }
    }
  },
  "required": [
    "releaseId",
    "commit",
    "timestamp",
    "overallStatus",
    "overallScore",
    "providers",
    "qualityGates"
  ]
}
