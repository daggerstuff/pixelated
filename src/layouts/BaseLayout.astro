---
// Type system: JetBrains Mono for structure; a system grotesque for reading
// prose (no webfont). The former SaaS faces (Fraunces serif, Public Sans)
// are purged per DESIGN.md — "The Quiet Instrument".
import '@fontsource-variable/jetbrains-mono/wght.css'
import '@/styles/np-tokens.css'
import '@/styles/marketing.css'
import '@/styles/fm-fusion.css'
import { withBasePath } from '@/utils/path'
import { SITE } from '@/config'

interface Props {
  title?: string
  description?: string
  keywords?: string
  themeMode?: 'light' | 'dark' | 'system'
  ogType?: 'website' | 'article'
  image?: string
  bgType?: string | boolean
  pubDate?: string
  lastModDate?: string
  pathname?: string
  showNavBar?: boolean
  showFooter?: boolean
  showBackLink?: boolean
  fullWidthMain?: boolean
  centered?: boolean
  contentClass?: string
  transitionMode?: string
  isLoginPage?: boolean
  showSettingsPanel?: boolean
  showAnalysisPanel?: boolean
  initialTab?: string
  [key: string]: any
}

const siteName = SITE.title || 'Pixelated Empathy'
const defaultDescription =
  SITE.description ||
  'Clinical simulation for therapist training and supervision'

const {
  title = siteName,
  description = defaultDescription,
  ogType = 'website',
  image,
} = Astro.props

const siteBase = Astro.site ?? new URL(Astro.url.origin)
const canonicalURL = new URL(Astro.url.pathname, siteBase)
const imageURL = image
  ? new URL(image, siteBase)
  : new URL(withBasePath('/og.jpg'), siteBase)
const fullTitle = title === siteName ? title : `${title} — ${siteName}`

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/features', label: 'Features' },
  { href: '/trust', label: 'Trust' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
]

const currentPath = Astro.url.pathname
const isActive = (href: string) => {
  const full = withBasePath(href)
  return href === '/'
    ? currentPath === full
    : currentPath === full || currentPath.startsWith(`${full}/`)
}

const cspNonce = Astro.locals.cspNonce ?? ''

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'Pixelated Empathy',
  'url': 'https://pixelatedempathy.com',
  'logo': 'https://pixelatedempathy.com/favicon.svg',
  'description':
    'Clinical simulation and transcript-based review for therapist training and supervision teams.',
  'foundingDate': '2025',
  'address': { '@type': 'PostalAddress', 'addressCountry': 'US' },
  'contactPoint': {
    '@type': 'ContactPoint',
    'email': 'info@pixelatedempathy.com',
    'contactType': 'Customer Service',
  },
  'sameAs': [
    'https://x.com/juggledaggers',
    'https://github.com/daggerstuff/pixelated',
  ],
}

const mixpanelToken = import.meta.env['PUBLIC_MIXPANEL_TOKEN']

// Analytics never loads on privacy-sensitive surfaces (auth, chat, therapy,
// dashboards) — typed content there can contain PHI.
const analyticsExcludedPrefixes = [
  '/login',
  '/register',
  '/signin',
  '/signup',
  '/reset-password',
  '/auth',
  '/chat',
  '/therapy',
  '/mental-health',
  '/dashboard',
  '/admin',
  '/simulator',
]
const isAnalyticsAllowedRoute = !analyticsExcludedPrefixes.some((prefix) =>
  currentPath.startsWith(withBasePath(prefix)),
)

// Opt-in only: Mixpanel initializes solely after explicit consent
// (localStorage 'px-analytics-consent' === 'granted'). Session recording is
// disabled entirely for this mental-health product.
const mixpanelScript = mixpanelToken
  ? `
if (localStorage.getItem('px-analytics-consent') === 'granted') {
(function(e,c){if(!c.__SV){var l,h;window.mixpanel=c;c._i=[];c.init=function(q,r,f){function t(d,a){var g=a.split(".");2==g.length&&(d=d[g[0]],a=g[1]);d[a]=function(){d.push([a].concat(Array.prototype.slice.call(arguments,0)))}}var b=c;"undefined"!==typeof f?b=c[f]=[]:f="mixpanel";b.people=b.people||[];b.toString=function(d){var a="mixpanel";"mixpanel"!==f&&(a+="."+f);d||(a+=" (stub)");return a};b.people.toString=function(){return b.toString(1)+".people (stub)"};l="disable time_event track track_pageview track_links track_forms track_with_groups add_group set_group remove_group register register_once alias unregister identify name_tag set_config reset opt_in_tracking opt_out_tracking has_opted_in_tracking has_opted_out_tracking clear_opt_in_out_tracking start_batch_senders start_session_recording stop_session_recording people.set people.set_once people.unset people.increment people.append people.union people.track_charge people.clear_charges people.delete_user people.remove".split(" ");for(h=0;h<l.length;h++)t(b,l[h]);var n="set set_once union unset remove delete".split(" ");b.get_group=function(){function d(p){a[p]=function(){b.push([g,[p].concat(Array.prototype.slice.call(arguments,0)))}}for(var a={},g=["get_group"].concat(Array.prototype.slice.call(arguments,0)),m=0;m<n.length;m++)d(n[m]);return a};c._i.push([q,r,f])};c.__SV=1.2;var k=e.createElement("script");k.type="text/javascript";k.async=!0;k.src="undefined"!==typeof MIXPANEL_CUSTOM_LIB_URL?MIXPANEL_CUSTOM_LIB_URL:"file:"===e.location.protocol&&"//cdn.mxpnl.com/libs/mixpanel-2-latest.min.js".match(/^\\//)?"https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js":"//cdn.mxpnl.com/libs/mixpanel-2-latest.min.js";e=e.getElementsByTagName("script")[0];e.parentNode.insertBefore(k,e)}})(document,window.mixpanel||[]);
mixpanel.init('${mixpanelToken}', { autocapture: true });
}
`
  : ''
---

<!doctype html>
<html lang={SITE.lang || 'en'} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBasePath('/favicon.svg')} />
    <link rel="icon" href={withBasePath('/favicon.ico')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={withBasePath('/sitemap-index.xml')} />
    <title>{fullTitle}</title>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {imageURL && <meta property="og:image" content={imageURL} />}

    <meta
      name="twitter:card"
      content={imageURL ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}

    <script is:inline nonce={cspNonce}>
      const storedTheme = localStorage.getItem('theme')
      document.documentElement.dataset['theme'] = storedTheme || 'dark'
    </script>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)
        .replaceAll(String.fromCharCode(60), '\\u003c')
        .replaceAll(String.fromCharCode(62), '\\u003e')}
    />
    {
      mixpanelToken && isAnalyticsAllowedRoute && (
        <script type="text/javascript" set:html={mixpanelScript} />
      )
    }
  </head>
  <body>
    <a class="np-skip-link" href="#main-content">Skip to main content</a>
    <!-- NP Shared Header — The Quiet Instrument -->
    <header class="np-shared-header">
      <div class="np-shared-header-inner">
        <a class="np-shared-brand" href={withBasePath('/')}>
          <div class="np-shared-brand-icon">
            <img src="/apple-touch-icon.png" alt="" width="28" height="28" />
          </div>
          <div class="np-shared-brand-text">
            <span class="np-shared-brand-name">Pixelated</span>
            <span class="np-shared-brand-sub">Empathy</span>
          </div>
        </a>
        <nav class="np-shared-nav" aria-label="Main navigation">
          {
            navItems.map((item) => (
              <a
                class={isActive(item.href) ? 'np-shared-active' : ''}
                href={withBasePath(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <button
          class="np-shared-toggle"
          type="button"
          aria-label="Toggle color theme"
          data-theme-toggle
        >
          <svg
            class="np-shared-toggle-sun"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            aria-hidden="true"
          >
            <circle cx="8" cy="8" r="3.25"></circle>
            <path
              d="M8 0.75v2M8 13.25v2M15.25 8h-2M2.75 8h-2M13.13 2.87l-1.42 1.42M4.29 11.71l-1.42 1.42M13.13 13.13l-1.42-1.42M4.29 4.29L2.87 2.87"
            ></path>
          </svg>
          <svg
            class="np-shared-toggle-moon"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            aria-hidden="true"
          >
            <path d="M13.25 9.6A5.75 5.75 0 0 1 6.4 2.75a5.75 5.75 0 1 0 6.85 6.85Z"
            ></path>
          </svg>
        </button>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <!-- NP Shared Footer -->
    <footer class="np-shared-footer">
      <div class="np-shared-footer-inner">
        <div>
          <span class="np-shared-footer-brand">{siteName}</span>
          <p class="np-shared-footer-copy">
            &copy; {new Date().getFullYear()}{' '}{siteName}. All rights
            reserved.
          </p>
        </div>
        <div class="np-shared-footer-links">
          <a class="np-shared-footer-link" href={withBasePath('/about')}
            >About</a
          >
          <a class="np-shared-footer-link" href={withBasePath('/trust')}
            >Trust &amp; Security</a
          >
          <a class="np-shared-footer-link" href={withBasePath('/privacy')}
            >Privacy</a
          >
          <a class="np-shared-footer-link" href={withBasePath('/terms')}
            >Terms</a
          >
          <a class="np-shared-footer-link" href={withBasePath('/contact')}
            >Contact</a
          >
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('[data-theme-toggle]')
      toggle?.addEventListener('click', () => {
        const current = document.documentElement.dataset['theme']
        const next = current === 'dark' ? 'light' : 'dark'
        document.documentElement.dataset['theme'] = next
        localStorage.setItem('theme', next)
        window.dispatchEvent(
          new CustomEvent('theme-changed', { detail: { theme: next } }),
        )
      })
    </script>
  </body>
</html>

<style is:global>
  /* NP Shared Header — The Quiet Instrument, public pages variant */

  .np-shared-header {
    position: sticky;
    top: 0;
    z-index: var(--np-z-sticky, 50);
    background: var(--np-bg);
    border-bottom: 1px solid var(--np-line);
  }

  .np-shared-header-inner {
    max-width: var(--np-content, 76rem);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--np-pad, clamp(1rem, 3vw, 2rem));
    height: 56px;
  }

  .np-shared-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .np-shared-brand-icon {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--np-elevated);
  }

  .np-shared-brand-icon img {
    display: block;
  }

  .np-shared-brand-text {
    display: flex;
    flex-direction: column;
  }

  .np-shared-brand-name {
    font-family: var(--np-font-display);
    font-size: 1rem;
    font-weight: 350;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--np-text);
  }

  .np-shared-brand-sub {
    font-family: var(--np-font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--np-muted);
    line-height: 1.2;
  }

  .np-shared-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .np-shared-nav a {
    padding: 6px 12px;
    font-family: var(--np-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--np-muted);
    text-decoration: none;
    transition:
      color 0.15s var(--np-ease),
      background 0.15s var(--np-ease),
      transform 0.15s var(--np-ease);
  }

  .np-shared-nav a:hover {
    color: var(--np-text);
    background: var(--np-surface);
  }

  .np-shared-nav a:active {
    background: var(--np-active);
    transform: scale(0.97);
  }

  .np-shared-nav a.np-shared-active {
    color: var(--np-text);
  }

  .np-shared-nav a:focus-visible {
    outline: 2px solid var(--np-mid);
    outline-offset: 3px;
  }

  .np-shared-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--np-line);
    cursor: pointer;
    padding: 0;
    color: var(--np-muted);
    transition:
      color 0.15s var(--np-ease),
      border-color 0.15s var(--np-ease),
      transform 0.15s var(--np-ease);
  }

  .np-shared-toggle:hover {
    color: var(--np-text);
    border-color: var(--np-mid);
  }

  .np-shared-toggle:active {
    transform: scale(0.97);
  }

  .np-shared-toggle:focus-visible {
    outline: 2px solid var(--np-mid);
    outline-offset: 3px;
  }

  .np-shared-toggle-sun,
  .np-shared-toggle-moon {
    display: block;
  }

  /* Dark shows the sun (switch to light); light shows the moon. */
  html[data-theme='light'] .np-shared-toggle-sun {
    display: none;
  }
  html:not([data-theme='light']) .np-shared-toggle-moon {
    display: none;
  }

  /* NP Shared Footer */
  .np-shared-footer {
    border-top: 1px solid var(--np-line);
    background: var(--np-bg);
  }

  .np-shared-footer-inner {
    max-width: var(--np-content, 76rem);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 3rem var(--np-pad, clamp(1rem, 3vw, 2rem));
  }

  .np-shared-footer-brand {
    font-family: var(--np-font-display);
    font-size: 0.875rem;
    font-weight: 350;
    color: var(--np-text);
  }

  .np-shared-footer-copy {
    margin: 0.5rem 0 0;
    font-family: var(--np-font-body);
    font-size: 0.8125rem;
    color: var(--np-muted);
  }

  .np-shared-footer-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .np-shared-footer-link {
    font-family: var(--np-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--np-muted);
    text-decoration: none;
    transition: color 0.15s var(--np-ease);
  }

  .np-shared-footer-link:hover {
    color: var(--np-text);
  }

  @media (max-width: 640px) {
    .np-shared-footer-inner {
      flex-direction: column;
      text-align: center;
    }
    .np-shared-header-inner {
      height: auto;
      flex-wrap: wrap;
      padding: 8px var(--np-pad);
      gap: 4px;
    }
    .np-shared-nav {
      order: 3;
      width: 100%;
      flex-wrap: wrap;
      gap: 0;
    }
    .np-shared-nav a {
      white-space: nowrap;
      padding: 8px 10px;
      font-size: 0.75rem;
    }
    .np-shared-nav a:first-child {
      padding-left: 0;
    }
    .np-shared-brand {
      flex-shrink: 0;
    }
  }

  /* === SKIP LINK === */
  .np-skip-link {
    position: absolute;
    top: -100%;
    left: 16px;
    z-index: 100;
    padding: 8px 16px;
    background: var(--np-elevated);
    color: var(--np-text);
    border: 1px solid var(--np-line-strong);
    font-family: var(--np-font-mono);
    font-size: 0.75rem;
    text-decoration: none;
  }
  .np-skip-link:focus-visible {
    top: 8px;
    outline: 1px solid var(--np-mid);
    outline-offset: 2px;
  }

  /* === REDUCED MOTION === */
  @media (prefers-reduced-motion: reduce) {
    .np-shared-nav a {
      transition-duration: 0.01ms;
    }
    .np-shared-toggle {
      transition-duration: 0.01ms;
    }
    .np-shared-footer-link {
      transition-duration: 0.01ms;
    }
  }
</style>
