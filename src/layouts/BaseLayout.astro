---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@/styles/tokens.css';
import '@/styles/variables.css';
import '@/styles/fonts.css';
import '@/styles/keel-theme.css';
import '@/styles/motion.css';
import '@/styles/responsive.css';
import '@/styles/fm-fusion.css'; // design fusion layer (fm-solo-starter × Dark Metal)
import { withBasePath } from '@/utils/path';
import { SITE } from '@/config';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  themeMode?: 'light' | 'dark' | 'system';
  ogType?: 'website' | 'article';
  image?: string;
  bgType?: string | boolean;
  pubDate?: string;
  lastModDate?: string;
  pathname?: string;
  showNavBar?: boolean;
  showFooter?: boolean;
  showBackLink?: boolean;
  fullWidthMain?: boolean;
  centered?: boolean;
  contentClass?: string;
  transitionMode?: string;
  isLoginPage?: boolean;
  showSettingsPanel?: boolean;
  showAnalysisPanel?: boolean;
  initialTab?: string;
  [key: string]: any;
}

const siteName = SITE.title || 'Pixelated Empathy';
const defaultDescription = SITE.description || 'Clinical simulation for therapist training and supervision';

const {
  title = siteName,
  description = defaultDescription,
  ogType = 'website',
  image,
} = Astro.props;

const siteBase = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const imageURL = image ? new URL(image, siteBase) : new URL(withBasePath('/og.jpg'), siteBase);
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/features', label: 'Features' },
  { href: '/trust', label: 'Trust' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const full = withBasePath(href);
  return href === '/' ? currentPath === full : (currentPath === full || currentPath.startsWith(`${full}/`));
};

const cspNonce = Astro.locals.cspNonce ?? '';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'Pixelated Empathy',
  'url': 'https://pixelatedempathy.com',
  'logo': 'https://pixelatedempathy.com/favicon.svg',
  'description': 'Clinical simulation and transcript-based review for therapist training and supervision teams.',
  'foundingDate': '2025',
  'address': {
    '@type': 'PostalAddress',
    'addressCountry': 'US',
  },
  'contactPoint': {
    '@type': 'ContactPoint',
    'email': 'info@pixelatedempathy.com',
    'contactType': 'Customer Service',
  },
  'sameAs': [
    'https://x.com/juggledaggers',
    'https://github.com/daggerstuff/pixelated',
  ],
};
---

<!doctype html>
<html lang={SITE.lang || 'en'} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBasePath('/favicon.svg')} />
    <link rel="icon" href={withBasePath('/favicon.ico')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={withBasePath('/sitemap-index.xml')} />
    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {imageURL && <meta property="og:image" content={imageURL} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    <script is:inline nonce={cspNonce}>
      const storedTheme = localStorage.getItem('theme');
      document.documentElement.dataset['theme'] = storedTheme || 'dark';
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema).replaceAll(String.fromCharCode(60), '\\u003c').replaceAll(String.fromCharCode(62), '\\u003e')}></script>
    <style>
      .fm-nav-active {
        position: relative;
        padding-left: 0.5rem;
      }
      .fm-nav-active::before {
        content: "";
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 2px;
        height: 16px;
        background: var(--fm-accent);
      }
      .fm-footer-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        padding: 3rem 0;
        border-top: 1px solid var(--fm-border);
      }
      .fm-footer-copy {
        margin: 0.6rem 0 0;
        color: var(--fm-muted);
        font-family: var(--fm-sans);
        font-size: 0.85rem;
        line-height: 1.5;
      }
      .fm-footer-links {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
      }
      .fm-footer-links .fm-chip {
        color: var(--fm-muted);
        text-decoration: none;
        transition: color 0.15s ease-out, border-color 0.15s ease-out;
      }
      .fm-footer-links .fm-chip:hover {
        color: var(--fm-accent-2);
        border-color: var(--fm-accent-2);
      }
    </style>
  </head>
  <body>
<header class="site-header">
  <div class="fm-container">
    <a class="brand" href={withBasePath('/')} aria-label={`${siteName} home`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span>{siteName}</span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      {
        navItems.map((item) => (
          <a 
            class={isActive(item.href) ? 'fm-nav-active' : undefined} 
            href={withBasePath(item.href)} 
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <button class="theme-toggle" type="button" aria-label="Toggle color theme" data-theme-toggle>
      <span aria-hidden="true"></span>
    </button>
  </div>
</header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="fm-container">
        <div class="fm-footer-inner">
          <div>
            <span class="fm-section-label">{siteName} — Clinical AI Platform</span>
            <p class="fm-footer-copy">&copy; {new Date().getFullYear()} {siteName}. All rights reserved.</p>
          </div>
          <div class="fm-footer-links">
            <a class="fm-chip" href={withBasePath('/about')}>About</a>
            <a class="fm-chip" href={withBasePath('/privacy')}>Privacy</a>
            <a class="fm-chip" href={withBasePath('/contact')}>Contact</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('[data-theme-toggle]');
      toggle?.addEventListener('click', () => {
        const current = document.documentElement.dataset['theme'];
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset['theme'] = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
