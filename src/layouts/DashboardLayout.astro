---
// Style imports
import '@unocss/reset/tailwind.css'
import '@/lib/fonts'
import '@/styles/np-tokens.css'

// Astro components
import Head from '@/components/base/Head.astro'
import ErrorBoundary from '@/components/base/ErrorBoundary.astro'
import SpeedInsights from '@vercel/speed-insights/astro'
import Analytics from '@vercel/analytics/astro'

// Layout components
import Header from '@/components/layout/Header.astro'
import Footer from '@/components/mizu/Footer.astro'
import Sidebar from '@/components/layout/Sidebar.astro'
import { FEATURES } from '@/config'

interface Props {
  title?: string
  description?: string
  metaImage?: string
  showHeader?: boolean
  showFooter?: boolean
  showSidebar?: boolean
  showThemeToggle?: boolean
  showUserMenu?: boolean
  showSocialLinks?: boolean
  contentClassName?: string
}

const {
  title = 'Pixelated Empathy Therapy | Dashboard',
  description = 'Advanced therapeutic tools for mental health professionals',
  metaImage = '/og-image.png',
  showHeader = true,
  showFooter = true,
  showSidebar = true,
  showThemeToggle = true,
  showUserMenu = true,
  showSocialLinks = true,
  contentClassName = '',
} = Astro.props

const { cspNonce } = Astro.locals
const { nprogress, mediumZoom } = FEATURES
const shouldRenderAnalytics = process.env['NODE_ENV'] !== 'test'
---

<!doctype html>
<html lang="en" data-theme="dark" class="scroll-smooth">
  <Head {title} {description} ogImage={metaImage} {cspNonce} />
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#1a1a1a" />

  <script src="/js/polyfill-detector.js" is:inline></script>
  <script src="/js/module-loader.js" defer is:inline></script>
  {
    (nprogress || mediumZoom) && (
      <script src="/js/nprogress-and-zoom.js" type="module" />
    )
  }
  <body
    style="background: var(--np-bg); color: var(--np-text);"
    class="font-sans min-h-screen flex flex-col overflow-x-hidden"
  >
    <!-- Skip to content link for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2"
      style="background:var(--np-elevated);color:var(--np-text);"
    >
      Skip to content
    </a>

    <ErrorBoundary>
      {
        showHeader && (
          <Header
            showThemeToggle={showThemeToggle}
            showUserMenu={showUserMenu}
            position="sticky"
          />
        )
      }

      <div class="flex flex-grow flex-col lg:flex-row">
        {
          showSidebar && (
            <aside
              class="sidebar fixed inset-y-0 z-20 flex-shrink-0 w-64 pt-16
            transform transition-transform duration-300 lg:translate-x-0 lg:static lg:h-auto"
              id="sidebar"
              style="background: var(--np-bg); border-right: 1px solid var(--np-line);"
            >
              <Sidebar />
            </aside>
          )
        }

        <main
          class:list={[
            'relative flex-grow pt-16 transition-all duration-300 ease-in-out',
            showSidebar ? 'lg:ml-64' : 'w-full',
            contentClassName,
          ]}
          id="main-content"
        >
          <div
            class="max-w-[var(--np-content)] mx-auto px-4 py-6 min-h-[calc(100vh-4rem)] flex flex-col"
          >
            <slot />
          </div>

          {showFooter && <Footer showSocialLinks={showSocialLinks} />}
        </main>
      </div>
    </ErrorBoundary>

    <!-- Theme handling script — uses NP tokens via data-theme on html -->
    <script is:inline nonce={cspNonce}>
      const getTheme = () => {
        const savedTheme = localStorage?.getItem('theme')
        if (savedTheme && ['light', 'dark', 'system'].includes(savedTheme)) {
          return savedTheme
        }
        return 'system'
      }

      const applyTheme = (theme) => {
        const isDark =
          theme === 'dark' ||
          (theme === 'system' &&
            window.matchMedia('(prefers-color-scheme: dark)').matches)

        document.documentElement.setAttribute(
          'data-theme',
          isDark ? 'dark' : 'light',
        )
      }

      applyTheme(getTheme())

      window
        .matchMedia('(prefers-color-scheme: dark)')
        .addEventListener('change', () => {
          const theme = getTheme()
          if (theme === 'system') applyTheme('system')
        })
    </script>

    {
      shouldRenderAnalytics && (
        <>
          <SpeedInsights />
          <Analytics />
        </>
      )
    }
  </body>
</html>

<style>
  /* === SCROLLBAR === */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: var(--np-muted);
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--np-mid);
  }

  ::selection {
    background: var(--np-selection);
    color: var(--np-selection-text);
  }

  /* === SIDEBAR RESPONSIVE === */
  @media (max-width: 1024px) {
    #sidebar {
      transform: translateX(-100%);
      transition: transform 0.3s var(--np-ease);
      visibility: hidden;
    }
    #sidebar.active {
      transform: translateX(0);
      visibility: visible;
    }
  }

  @media (max-width: 640px) {
    .sidebar {
      width: 100% !important;
      max-width: 280px;
    }
  }

  /* === MAIN CONTENT FADE-IN === */
  main {
    opacity: 0;
    animation: np-fade-in 0.4s var(--np-ease-enter) forwards;
  }
  @keyframes np-fade-in {
    to {
      opacity: 1;
    }
  }

  /* === SIDEBAR SECTION EXPAND/COLLAPSE === */
  .sidebar ul {
    overflow: hidden;
  }

  .sidebar ul[style*='margin-top'] {
    animation: np-slide-down 0.2s var(--np-ease) both;
  }

  @keyframes np-slide-down {
    from {
      opacity: 0;
      max-height: 0;
    }
    to {
      opacity: 1;
      max-height: 2000px;
    }
  }

  /* === GLOBAL FOCUS BASELINE (dashboard) === */
  a:focus-visible,
  button:focus-visible,
  [tabindex]:focus-visible {
    outline: 1px solid var(--np-mid);
    outline-offset: 2px;
  }

  .sidebar a:focus-visible,
  .sidebar button:focus-visible,
  .sidebar [tabindex]:focus-visible {
    outline: 1px solid var(--np-mid) !important;
    outline-offset: 2px !important;
  }

  /* === SIDEBAR HOVER FALLBACKS (CSS layer — works even if JS fails) === */
  .sidebar a:hover,
  .sidebar button:hover {
    background: var(--np-hover) !important;
    color: var(--np-text) !important;
  }

  .sidebar [style*='background: var(--np-elevated)']:hover {
    background: var(--np-hover) !important;
  }

  /* === SIDEBAR ACTIVE/PRESSED — tactile scale === */
  .sidebar a:active,
  .sidebar button:active {
    background: var(--np-active) !important;
    color: var(--np-text) !important;
    transform: scale(0.98) !important;
  }

  /* === ACCESSIBILITY: reduce-motion removes main content animation === */
  @media (prefers-reduced-motion: reduce) {
    main {
      animation: none;
      opacity: 1;
    }
  }
</style>
