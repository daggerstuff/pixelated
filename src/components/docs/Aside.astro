---
interface Props {
  type?: 'note' | 'tip' | 'warning' | 'danger' | 'info'
  title?: string
  className?: string
}

const { type = 'note', title, className } = Astro.props
---

<aside class={`aside aside-${type} ${className || ''}`} role="complementary">
  {title && <div class="aside-title">{title}</div>}
  <div class="aside-content">
    <slot />
  </div>
</aside>

<style>
  .aside {
    margin: 1.5rem 0;
    padding: 1rem;
    border-radius: 6px;
    border-left: 4px solid;
    position: relative;
  }

  .aside-title {
    font-weight: 600;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .aside-content {
    line-height: 1.6;
  }

  .aside-note {
    background-color: var(--np-surface);
    border-left-color: var(--np-mid);
    color: var(--np-text);
  }

  .aside-info {
    background-color: #f0f0f0;
    border-left-color: #808080;
    color: #262626;
  }

  .aside-tip {
    background-color: #e8e8e8;
    border-left-color: #666666;
    color: #1a1a1a;
  }

  .aside-warning {
    background-color: #e0e0e0;
    border-left-color: #525252;
    color: #171717;
  }

  .aside-danger {
    background-color: #d4d4d4;
    border-left-color: #404040;
    color: #0a0a0a;
  }

  /* Dark mode support */
  :global(.dark) .aside-note {
    background-color: #262626;
    color: #d4d4d4;
  }

  :global(.dark) .aside-info {
    background-color: #333333;
    color: #c0c0c0;
  }

  :global(.dark) .aside-tip {
    background-color: #404040;
    color: #a3a3a3;
  }

  :global(.dark) .aside-warning {
    background-color: #525252;
    color: #a3a3a3;
  }

  :global(.dark) .aside-danger {
    background-color: #666666;
    color: #d4d4d4;
  }
</style>
