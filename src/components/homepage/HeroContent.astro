---
export interface Props {
  kicker?: string
  title?: string
  subtitle?: string
  helperText?: string
  proofPoints?: readonly { label: string; text: string }[]
  primaryCTA?: { text: string; href: string }
  secondaryCTA?: { text: string; href: string }
}

const {
  kicker,
  title,
  subtitle,
  helperText,
  proofPoints = [],
  primaryCTA,
  secondaryCTA,
} = Astro.props
---

<div class="hero-copy-wrap">
  <div class="hero-copy">
    {
      kicker && (
        <div class="hero-prelude">
          <div class="hero-kicker-pill">
            <span class="hero-kicker-dot" />
            <span class="hero-kicker">{kicker}</span>
          </div>
        </div>
      )
    }

    <div class="hero-copy__header">
      <h1 class="hero-title">{title}</h1>
      <p class="hero-subtitle">{subtitle}</p>
    </div>

    <div class="hero-actions">
      <div class="hero-actions__buttons">
        {
          primaryCTA && (
            <a href={primaryCTA.href} class="btn-premium" role="button">
              {primaryCTA.text}
            </a>
          )
        }

        {
          secondaryCTA && (
            <a href={secondaryCTA.href} class="hero-secondary-link">
              <span>{secondaryCTA.text}</span>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                class="hero-secondary-link__icon"
                aria-hidden="true"
              >
                <path
                  d="M5 12H19M19 12L13 6M19 12L13 18"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="square"
                />
              </svg>
            </a>
          )
        }
      </div>

      {
        (helperText || true) && (
          <p class="hero-actions__context">
            {helperText ||
              'Bring a real case only if the review gets more specific.'}
          </p>
        )
      }
    </div>

    {
      proofPoints.length > 0 && (
        <div class="hero-proof-grid" aria-label="Why the workflow lands">
          {proofPoints.map((point) => (
            <article class="hero-proof-card">
              <span class="hero-proof-card__label">{point.label}</span>
              <p>{point.text}</p>
            </article>
          ))}
        </div>
      )
    }
  </div>
</div>

<style>
  .hero-copy-wrap {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hero-copy {
    width: min(100%, 39rem);
    display: grid;
    gap: 1.4rem;
    align-content: start;
  }

  .hero-prelude {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
  }

  .hero-kicker-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid rgba(var(--accent-primary-rgb), 0.25);
    border-radius: 999px;
    background: rgba(var(--accent-primary-rgb), 0.06);
  }

  .hero-kicker-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--accent-primary);
  }

  .hero-kicker {
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .hero-copy__header {
    display: grid;
    gap: 1rem;
  }

  .hero-title {
    margin: 0;
    max-width: 13ch;
    margin: 0 auto;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    text-wrap: balance;
  }

  .hero-subtitle {
    margin: 0;
    max-width: 100%;
    margin: 0 auto;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(247, 243, 235, 0.75);
    text-wrap: pretty;
  }

  .hero-actions {
    display: grid;
    gap: 0.75rem;
  }

  .hero-actions__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: center;
  }

  .hero-actions__context {
    margin: 0;
    max-width: 100%;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.6;
    color: rgba(253, 252, 252, 0.55);
    letter-spacing: 0.01em;
  }

  .btn-premium,
  .hero-secondary-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.85rem;
    padding: 0.65rem 1.35rem;
    border-radius: var(--radius-button);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
    cursor: pointer;
  }

  .btn-premium {
    background: var(--accent-primary);
    color: var(--bg-primary);
    border: 1px solid rgba(var(--accent-primary-rgb), 0.4);
  }

  .hero-secondary-link {
    gap: 0.6rem;
    border: 1px solid rgba(253, 252, 252, 0.12);
    background: rgba(253, 252, 252, 0.02);
    color: rgba(253, 252, 252, 0.8);
  }

  .btn-premium:hover {
    background: var(--color-primary-500);
    border-color: rgba(var(--accent-primary-rgb), 0.6);
  }

  .hero-secondary-link:hover {
    color: var(--text-primary);
    border-color: rgba(253, 252, 252, 0.2);
    background: rgba(253, 252, 252, 0.05);
  }

  .btn-premium:focus-visible,
  .hero-secondary-link:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .hero-proof-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin-top: 0.2rem;
  }

  .hero-proof-card {
    display: grid;
    gap: 0.65rem;
    min-width: 0;
    padding: 0.9rem;
    border: 1px solid rgba(var(--accent-primary-rgb), 0.15);
    border-radius: var(--radius-card);
    background: rgba(var(--accent-primary-rgb), 0.03);
  }

  .hero-proof-card__label {
    font-family: var(--font-label);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }

  .hero-proof-card p {
    margin: 0;
    max-width: 28ch;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    line-height: 1.6;
    color: rgba(253, 252, 252, 0.75);
  }

  @media (max-width: 920px) {
    .hero-copy {
      width: 100%;
    }

    .hero-title {
      max-width: 10ch;
      font-size: clamp(1.8rem, 8vw, 2.6rem);
    }
  }

  @media (min-width: 921px) {
    .hero-copy-wrap {
      justify-content: flex-start;
    }

    .hero-copy {
      width: 100%;
      max-width: 39rem;
      gap: 1.3rem;
      text-align: left;
      justify-items: start;
    }

    .hero-prelude,
    .hero-actions__buttons {
      justify-content: flex-start;
    }

    .hero-title {
      max-width: 12ch;
      margin: 0;
      font-size: clamp(2.6rem, 4.5vw, 4rem);
      line-height: 1.05;
      letter-spacing: -0.04em;
    }

    .hero-subtitle,
    .hero-actions__context {
      margin: 0;
      max-width: 36rem;
      text-align: left;
    }

    .hero-subtitle {
      font-size: clamp(1rem, 1.2vw, 1.1rem);
      line-height: 1.6;
    }

    .hero-proof-grid {
      width: 100%;
      gap: 0.9rem;
    }

    .hero-proof-card {
      text-align: left;
      justify-items: start;
    }
  }

  @media (max-width: 720px) {
    .hero-copy-wrap {
      justify-content: center;
    }

    .hero-copy {
      gap: 1rem;
      text-align: center;
      justify-items: center;
    }

    .hero-prelude,
    .hero-actions__buttons {
      justify-content: center;
    }

    .hero-title {
      font-size: clamp(1.6rem, 10vw, 2.5rem);
      line-height: 1.05;
    }

    .hero-subtitle {
      font-size: 0.9rem;
      line-height: 1.55;
    }

    .hero-actions__buttons {
      width: 100%;
      display: grid;
      gap: 0.75rem;
    }

    .btn-premium,
    .hero-secondary-link {
      width: 100%;
    }

    .hero-proof-grid {
      grid-template-columns: 1fr;
      width: 100%;
    }
  }
</style>
