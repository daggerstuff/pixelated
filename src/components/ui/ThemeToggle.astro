---
// NP Theme Toggle — The Quiet Instrument
// Flat, zero-chroma, Fraunces/Public Sans/JetBrains Mono, no glass/gradients
---

<button
  id="np-theme-toggle"
  class="np-theme-toggle"
  aria-label="Toggle color theme"
>
  <span class="np-toggle-icon" id="np-icon-dark">
    <svg
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
    >
      <path d="M13.5 9.5A6 6 0 0 1 6.5 2.5 6 6 0 1 0 13.5 9.5Z"></path>
    </svg>
  </span>
  <span
    class="np-toggle-icon"
    id="np-icon-light"
    style="opacity:0;transform:scale(0.85)"
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
    >
      <circle cx="8" cy="8" r="3"></circle>
      <path
        d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.41 1.41M11.54 11.54l1.41 1.41M3.05 12.95l1.41-1.41M11.54 4.46l1.41-1.41"
      ></path>
    </svg>
  </span>
  <span
    class="np-toggle-icon"
    id="np-icon-system"
    style="opacity:0;transform:scale(0.85)"
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
    >
      <rect x="2" y="3" width="12" height="8" rx="1"></rect>
      <path d="M6 14h4M8 11v3"></path>
    </svg>
  </span>
</button>

<style is:global>
  .np-theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--np-line);
    cursor: pointer;
    transition: border-color 0.15s var(--np-ease);
    padding: 0;
  }

  .np-theme-toggle:hover {
    border-color: var(--np-mid);
  }

  .np-theme-toggle:focus-visible {
    outline: 1px solid var(--np-mid);
    outline-offset: 2px;
  }

  .np-toggle-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    color: var(--np-muted);
    transition: color 0.15s var(--np-ease);
  }

  .np-toggle-icon svg {
    display: block;
  }

  .np-theme-toggle:hover .np-toggle-icon {
    color: var(--np-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .np-theme-toggle {
      transition-duration: 0.01ms;
    }
  }

  .np-toggle-icon {
    transition:
      opacity 0.15s var(--np-ease),
      transform 0.15s var(--np-ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .np-theme-toggle {
      transition-duration: 0.01ms;
    }
    .np-toggle-icon {
      transition-duration: 0.01ms;
    }
  }
</style>

<script is:inline>
  ;(function () {
    var btn = document.getElementById('np-theme-toggle')
    var darkIcon = document.getElementById('np-icon-dark')
    var lightIcon = document.getElementById('np-icon-light')
    var systemIcon = document.getElementById('np-icon-system')
    var themes = ['dark', 'light', 'system']
    var idx = 0

    function getTheme() {
      var stored = localStorage.getItem('theme')
      return themes.indexOf(stored) >= 0 ? stored : 'system'
    }

    function setDataTheme(t) {
      document.documentElement.setAttribute('data-theme', t)
    }

    function showIcon(idx) {
      var icons = [darkIcon, lightIcon, systemIcon]
      for (var i = 0; i < icons.length; i++) {
        icons[i].style.opacity = i === idx ? '1' : '0'
        icons[i].style.transform = i === idx ? 'scale(1)' : 'scale(0.85)'
      }
    }

    function applyTheme(t) {
      var i = themes.indexOf(t)
      if (i < 0) i = 2
      idx = i
      var isDark =
        t === 'dark' ||
        (t === 'system' &&
          window.matchMedia('(prefers-color-scheme: dark)').matches)
      setDataTheme(isDark ? 'dark' : 'light')
      showIcon(idx)

      var label =
        t === 'dark'
          ? 'Dark mode'
          : t === 'light'
            ? 'Light mode'
            : 'System theme'
      btn.setAttribute('aria-label', 'Toggle theme (' + label + ')')
    }

    applyTheme(getTheme())

    if (btn) {
      btn.addEventListener('click', function () {
        idx = (idx + 1) % themes.length
        var t = themes[idx]
        localStorage.setItem('theme', t)
        applyTheme(t)
        window.dispatchEvent(
          new CustomEvent('theme-changed', { detail: { theme: t } }),
        )
      })
    }

    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', function () {
        if (getTheme() === 'system') applyTheme('system')
      })
  })()
</script>
