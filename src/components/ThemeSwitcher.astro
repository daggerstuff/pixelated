---
/* ThemeSwitcher — astro-palette theme overlay + hint
   Renders the theme hint label, the palette overlay modal, and all
   switching logic. Works with the [data-palette] attribute system
   defined in public/css/style.css and src/styles/np-tokens.css. */

interface Props {
  showHint?: boolean
}

const { showHint = true } = Astro.props

const palettes = [
  'herdr',
  'catppuccin',
  'terminal',
  'tokyo-night',
  'dracula',
  'nord',
  'gruvbox',
  'one-dark',
  'solarized',
  'kanagawa',
  'rose-pine',
  'vesper',
]
const lightPalettes = [
  'catppuccin-latte',
  'tokyo-night-day',
  'gruvbox-light',
  'one-light',
  'solarized-light',
  'kanagawa-lotus',
  'rose-pine-dawn',
]
---

{showHint && (
  <div class="theme-hint" id="theme-hint" aria-label="Click to switch theme">
    <span class="theme-hint-label" id="theme-hint-label">Light</span>
  </div>
)}

<div class="theme-overlay" id="theme-overlay" hidden>
  <div class="theme-overlay-panel" role="dialog" aria-label="Theme switcher" aria-modal="true">
    <div class="theme-overlay-list" id="theme-overlay-list" role="listbox" aria-label="Themes">
      <div class="theme-sep"><span>Dark</span></div>
      {palettes.map((p) => (
        <button type="button" role="option" data-value={p}>{p.replace(/-/g, ' ')}</button>
      ))}
      <div class="theme-sep"><span>Light</span></div>
      {lightPalettes.map((p) => (
        <button type="button" role="option" data-value={p}>{p.replace(/-/g, ' ')}</button>
      ))}
    </div>
    <div class="theme-overlay-footer">
      <span class="theme-overlay-actions">
        <button class="theme-close-btn" type="button" id="theme-close-btn">esc</button>
      </span>
    </div>
  </div>
</div>

<script>
  // astro-palette theme switching logic
  // (extracted from astro-palette Layout.astro — unchanged behavior)
  let controller: AbortController | undefined

  function initThemeSwitcher() {
    controller?.abort()
    controller = new AbortController()
    const { signal } = controller

    const overlay = document.getElementById('theme-overlay')
    const list = document.getElementById('theme-overlay-list')
    const hintLabel = document.getElementById('theme-hint-label')
    const themeHint = document.getElementById('theme-hint')
    const closeBtn = document.getElementById('theme-close-btn')
    if (!overlay || !list || !closeBtn) return

    const options = Array.from(
      list.querySelectorAll("[role='option']"),
    ) as HTMLButtonElement[]
    const media = window.matchMedia('(prefers-color-scheme: dark)')
    const saved = localStorage.getItem('site-palette') || ''
    let committed = saved || defaultPalette()

    function defaultPalette() {
      return media.matches ? 'vesper' : 'rose-pine-dawn'
    }

    function setPalette(value: string) {
      document.documentElement.setAttribute(
        'data-palette',
        value || defaultPalette(),
      )
    }

    function updateUI(value: string) {
      const activeValue = value || defaultPalette()
      for (const opt of options) {
        opt.setAttribute('aria-selected', String(opt.dataset.value === activeValue))
      }
      const active = options.find((opt) => opt.dataset.value === activeValue)
      if (hintLabel && active) {
        hintLabel.textContent = active.textContent?.trim() ?? ''
      }
    }

    function openOverlay() {
      if (!overlay) return
      overlay.hidden = false
      document.body.style.overflow = 'hidden'
      committed = localStorage.getItem('site-palette') || defaultPalette()
      updateUI(committed)
      const active =
        list?.querySelector<HTMLElement>("[aria-selected='true']") ?? options[0]
      active?.focus()
    }

    function closeOverlay() {
      if (!overlay) return
      overlay.hidden = true
      document.body.style.overflow = ''
    }

    function toggleOverlay() {
      if (overlay?.hidden) openOverlay()
      else closeOverlay()
    }

    function preview(index: number) {
      const opt = options[index]
      if (!opt) return
      setPalette(opt.dataset.value ?? '')
      updateUI(opt.dataset.value ?? '')
      opt.focus()
    }

    function commit(value: string) {
      setPalette(value)
      localStorage.setItem('site-palette', value)
      updateUI(value)
      closeOverlay()
    }

    function revert() {
      setPalette(committed)
      updateUI(committed)
      closeOverlay()
    }

    media.addEventListener(
      'change',
      () => {
        if (!localStorage.getItem('site-palette')) {
          setPalette('')
          updateUI('')
        }
      },
      { signal },
    )

    options.forEach((opt, idx) => {
      opt.addEventListener(
        'click',
        () => commit(opt.dataset.value ?? ''),
        { signal },
      )
      opt.addEventListener('mouseenter', () => preview(idx), { signal })
    })

    document.addEventListener(
      'keydown',
      (e) => {
        if (overlay.hidden) return
        const idx = options.indexOf(
          document.activeElement as HTMLButtonElement,
        )
        if (e.key === 'ArrowDown') {
          e.preventDefault()
          preview(idx >= 0 ? Math.min(options.length - 1, idx + 1) : 0)
        } else if (e.key === 'ArrowUp') {
          e.preventDefault()
          preview(
            idx >= 0 ? Math.max(0, idx - 1) : options.length - 1,
          )
        } else if (e.key === 'Enter' && idx >= 0) {
          e.preventDefault()
          commit(options[idx]?.dataset.value ?? '')
        } else if (e.key === 'Escape') {
          e.preventDefault()
          revert()
        } else if (e.key === 'Tab') {
          const focusables = [...options, closeBtn].filter(
            (el): el is HTMLElement | HTMLButtonElement => el !== null,
          )
          const first = focusables[0]
          const last = focusables[focusables.length - 1]
          if (!first || !last) return
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault()
            ;(last as HTMLElement).focus()
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault()
            ;(first as HTMLElement).focus()
          }
        }
      },
      { signal },
    )

    if (localStorage.getItem('site-palette-hint-seen') === '1' && themeHint) {
      themeHint.classList.add('is-seen')
    }
    themeHint?.addEventListener(
      'mouseenter',
      () => {
        localStorage.setItem('site-palette-hint-seen', '1')
        themeHint?.classList.add('is-seen')
      },
      { once: true, signal },
    )
    themeHint?.addEventListener('click', toggleOverlay, { signal })
    closeBtn.addEventListener('click', revert, { signal })
    setPalette(saved)
    updateUI(saved)
  }

  // <html> survives view transitions, so listeners follow palette switches
  // for the life of the session. Re-init on every page load.
  document.addEventListener('astro:page-load', initThemeSwitcher)
</script>
