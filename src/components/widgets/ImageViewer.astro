---
import Viewer from 'viewerjs'

interface Props {
  selector: string
  options?: Viewer.Options
  asyncInsert?: boolean
  tabFocus?: boolean
}

const {
  selector,
  options,
  asyncInsert = false,
  tabFocus = false,
} = Astro.props as Props
---

<image-viewer
  data-selector={selector}
  data-options={JSON.stringify(options)}
  data-async-insert={asyncInsert ? '' : undefined}
  data-tab-focus={tabFocus ? '' : undefined}
>
</image-viewer>

<script is:inline>
  import { initImageViewer } from './ImageViewer'

  // Initialize viewer for this element
  void initImageViewer(this)
</script>

<style>
  image-viewer {
    display: contents;
  }
</style>
