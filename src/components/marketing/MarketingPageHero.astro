---
export interface Props {
  eyebrow: string
  title: string
  lede: string
  note?: string
  trustLine?: readonly string[]
  /** Optional proof object — kept narrow, single artifact, drives composition */
  proof?: {
    /** Mono small-cap title above the artifact */
    label: string
    /** The artifact itself — supply as raw HTML/JSX (caller owns content) */
    body: string
    /** One-line caption below the artifact */
    caption?: string
  }
  primaryCTA?: { text: string; href: string }
  secondaryCTA?: { text: string; href: string }
}

const {
  eyebrow,
  title,
  lede,
  note = '',
  trustLine = [],
  proof,
  primaryCTA,
  secondaryCTA,
} = Astro.props
---

<section class="marketing-hero marketing-section--tight">
  <div class="marketing-shell">
    <div class="marketing-hero__panel">
      <div class="marketing-hero__content">
        <span class="marketing-eyebrow">{eyebrow}</span>
        <h1 class="marketing-title">{title}</h1>
        <p class="marketing-lede">{lede}</p>

        {
          (primaryCTA || secondaryCTA) && (
            <div class="marketing-actions">
              {primaryCTA && (
                <a
                  class="marketing-button marketing-button--primary"
                  href={primaryCTA.href}
                >
                  {primaryCTA.text}
                </a>
              )}
              {secondaryCTA && (
                <a
                  class="marketing-button marketing-button--secondary"
                  href={secondaryCTA.href}
                >
                  {secondaryCTA.text}
                </a>
              )}
            </div>
          )
        }

        {note && <p class="marketing-note">{note}</p>}

        {
          trustLine.length > 0 && (
            <div class="marketing-hero__trustline">
              {trustLine.map((item) => (
                <span>{item}</span>
              ))}
            </div>
          )
        }
      </div>

      {
        proof && (
          <aside class="marketing-hero__proof" aria-label={proof.label}>
            <header class="marketing-hero__proof-head">
              <span class="marketing-list-label">{proof.label}</span>
            </header>
            <div class="marketing-hero__proof-body" set:html={proof.body} />
            {proof.caption && (
              <footer class="marketing-hero__proof-foot">
                <span>{proof.caption}</span>
              </footer>
            )}
          </aside>
        )
      }
    </div>
  </div>
</section>
