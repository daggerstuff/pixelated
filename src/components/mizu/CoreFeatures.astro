---
import SectionAtmosphere from '@/components/homepage/SectionAtmosphere.astro'

export interface Props {
  label?: string
  title?: string
  copy?: string
  proofLabel?: string
  proofItems?: readonly string[]
  cards?: readonly {
    title: string
    description: string
    icon: string
    image?: string
  }[]
}

const {
  label,
  title,
  copy,
  proofLabel,
  proofItems = [],
  cards = [],
} = Astro.props
---

<section class="pe-home-section core-features-section">
  <SectionAtmosphere variant="section-soft" />
  <div class="pe-home-shell">
    <div class="core-features-intro">
      <span class="pe-meta-label">{label}</span>
      <h2 class="pe-heading-l">{title}</h2>
      <p class="pe-home-copy">{copy}</p>
    </div>

    <div class="core-feature-layout">
      <div class="core-feature-proof">
        <span class="pe-page-panel-label">{proofLabel}</span>
        <ul class="core-feature-proof__list">
          {proofItems.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="core-feature-grid">
        {
          cards.map((feature, index) => (
            <article
              class:list={[
                'core-feature-card',
                index === 0 && 'core-feature-card--lead',
              ]}
            >
              <span class="core-feature-card__caption">
                Capability {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="pe-heading-s">{feature.title}</h3>
              <p>{feature.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .core-features-section {
    background: rgba(253, 252, 252, 0.02);
    color: var(--text-primary);
  }

  .core-features-intro {
    display: grid;
    gap: 0.85rem;
    max-width: 46rem;
    margin: 0 auto;
    margin-bottom: 2rem;
    text-align: center;
    justify-items: center;
  }

  .core-feature-layout {
    display: grid;
    gap: 1.25rem;
  }

  .core-feature-proof {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    text-align: center;
  }

  .core-feature-proof__list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .core-feature-proof__list li {
    position: relative;
    padding-left: 0;
    text-align: center;
  }

  .core-feature-proof__list li::before {
    content: '';
    position: static;
    display: block;
    width: 0.35rem;
    height: 0.35rem;
    margin: 0 0 0.5rem;
    border-radius: 999px;
    background: var(--accent-primary);
    opacity: 0.8;
  }

  .core-feature-proof__list li,
  .core-feature-card p {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    line-height: 1.65;
    color: rgba(253, 252, 252, 0.75);
  }

  .core-feature-proof__list li {
    padding: 0.75rem 0 0;
  }

  .core-feature-grid {
    display: grid;
    gap: 0.85rem;
  }

  .core-feature-card {
    display: grid;
    gap: 0.75rem;
    padding: 0.9rem;
    border: 1px solid rgba(253, 252, 252, 0.08);
    border-radius: var(--radius-card);
    background: rgba(253, 252, 252, 0.02);
    justify-items: center;
    text-align: center;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .core-feature-card:hover {
    border-color: rgba(253, 252, 252, 0.15);
  }

  .core-feature-card__caption {
    font-family: var(--font-label);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }

  .core-feature-card--lead {
    background: rgba(var(--accent-primary-rgb), 0.04);
    border-color: rgba(var(--accent-primary-rgb), 0.12);
  }

  @media (min-width: 980px) {
    .core-features-intro {
      max-width: 46rem;
      margin: 0 auto 2.4rem;
    }

    .core-features-intro .pe-meta-label {
      grid-column: auto;
    }

    .core-feature-layout {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.15rem;
      justify-items: stretch;
    }

    .core-feature-proof {
      grid-template-columns: minmax(14rem, 0.35fr) minmax(0, 0.65fr);
      gap: 1.15rem;
      align-items: start;
      padding: 1rem;
      border: 1px solid rgba(253, 252, 252, 0.08);
      border-radius: var(--radius-card);
      background: rgba(253, 252, 252, 0.02);
    }

    .core-feature-proof__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem 1.15rem;
    }

    .core-feature-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
      gap: 0.85rem;
    }

    .core-feature-card p {
      max-width: 20rem;
      margin-inline: auto;
    }
  }

  @media (max-width: 720px) {
    .core-features-intro,
    .core-feature-layout,
    .core-feature-proof,
    .core-feature-card {
      text-align: center;
      justify-items: center;
    }

    .core-feature-proof__list {
      justify-items: center;
      text-align: center;
    }
  }
</style>
