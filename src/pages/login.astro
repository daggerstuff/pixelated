---
import BaseLayout from '../layouts/BaseLayout.astro'
import { LoginForm } from '../components/auth/LoginForm.tsx'
import { ClientRouter } from 'astro:transitions'

// Get the redirect URL from the query parameters
const redirectUrl = Astro.url.searchParams.get('redirect') || '/dashboard'

// Check if the redirection is coming from the dashboard
const isFromDashboard = redirectUrl.includes('/dashboard')

// Set to server-rendered mode since we need access to request data
export const prerender = false
---

<BaseLayout
  title="Log In | Pixelated Empathy"
  description="Log in to your Pixelated Empathy account to access mental health resources and personal therapy chat."
>
  <ClientRouter />
  <div class="auth-card">
    <header class="auth-card__head">
      <span class="auth-card__label">Account</span>
      <h1 class="auth-card__title">Welcome back</h1>
      <p class="auth-card__subtitle">
        Log in to continue to your therapy space.
      </p>
    </header>

    {
      isFromDashboard && (
        <p class="auth-card__notice" role="status">
          You need to be logged in to access the dashboard.
        </p>
      )
    }

    <LoginForm client:load redirectTo={redirectUrl} showSignup={false} />

    <p class="auth-card__alt">
      No account yet?
      <a href="/register">Create one</a>
    </p>
  </div>
</BaseLayout>

<style>
  /* NP auth card — flat surface, 1px line, zero radius */
  .auth-card {
    width: 100%;
    max-width: 28rem;
    margin: 48px auto;
    padding: 32px 24px;
    background: var(--np-surface);
    border: 1px solid var(--np-line);
  }

  .auth-card__head {
    margin-bottom: 24px;
  }

  .auth-card__label {
    display: block;
    font-family: var(--np-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--np-muted);
    margin-bottom: 8px;
  }

  .auth-card__title {
    font-family: var(--np-font-display);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--np-text);
    margin: 0;
  }

  .auth-card__subtitle {
    margin: 8px 0 0;
    font-size: 0.875rem;
    color: var(--np-muted);
  }

  .auth-card__notice {
    margin: 0 0 16px;
    padding: 12px;
    border: 1px solid var(--np-line-strong);
    background: var(--np-elevated);
    color: var(--np-mid);
    font-size: 0.875rem;
  }

  .auth-card__alt {
    margin: 24px 0 0;
    font-size: 0.875rem;
    color: var(--np-muted);
  }

  .auth-card__alt a {
    color: var(--np-text);
    text-underline-offset: 2px;
  }

  .auth-card__alt a:focus-visible {
    outline: 1px solid var(--np-mid);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .auth-card {
      margin: 24px 16px;
      padding: 24px 16px;
    }
  }
</style>
