---
// Demo Hub - Showcase Platform Capabilities
import BaseLayout from '@/layouts/BaseLayout.astro'
import BrutalistChatDemo from '@/components/chat/BrutalistChatDemo'

const demos = [
  {
    title: 'Enterprise Components Hub',
    description:
      'A guided tour of the main product surfaces and supporting UI used across the platform.',
    status: 'NEW',
    difficulty: 'LOW',
    href: '/components',
    icon: '🏗️',
    stats: { components: '8', status: 'integrated' },
  },
  {
    title: 'Analytics Dashboard',
    description:
      'Advanced charting and data visualization tools with Chart.js integration.',
    status: 'NEW',
    difficulty: 'MEDIUM',
    href: '/components/analytics-dashboard',
    icon: 'chart',
    stats: { charts: '4+', responsive: 'yes' },
  },
  {
    title: '3D Emotion Visualization',
    description:
      'Immersive 3D emotion mapping using Valence-Arousal-Dominance model with Three.js.',
    status: 'NEW',
    difficulty: 'HIGH',
    href: '/components/emotion-visualization',
    icon: '🎭',
    stats: { dimensions: '3D', interactive: 'yes' },
  },
  {
    title: 'Treatment Plan Manager',
    description:
      'Clinical workflow management with goal tracking, milestones, and review-oriented planning screens.',
    status: 'NEW',
    difficulty: 'MEDIUM',
    href: '/components/treatment-plans',
    icon: 'target',
    stats: { goals: 'tracked', categories: '5' },
  },
  {
    title: 'FHE Privacy Demo',
    description:
      'A technical demo focused on privacy-preserving analysis patterns for sensitive training data.',
    status: 'NEW',
    difficulty: 'HIGH',
    href: '/components/security-demo',
    icon: '🔒',
    stats: { privacy: 'privacy-first', compliant: 'review required' },
  },
  {
    title: 'UI Component Showcase',
    description:
      'Modern carousel and interface elements with multiple effects and accessibility features.',
    status: 'NEW',
    difficulty: 'LOW',
    href: '/components/ui-showcase',
    icon: '🎨',
    stats: { effects: '5+', mobile: 'optimized' },
  },
  {
    title: 'Enhanced Bias Detection',
    description:
      'Modernized UI/UX with real-time analysis, counterfactuals, and historical trends.',
    status: 'NEW',
    difficulty: 'MEDIUM',
    href: '/demo/enhanced-bias-detection',
    icon: 'sparkle',
    stats: { realtime: 'yes', scenarios: '8+', trends: 'on' },
  },
  {
    title: 'Bias Detection Engine',
    description:
      'Interactive, client-side demo showcasing multi-layer cultural bias analysis.',
    status: 'ACTIVE',
    difficulty: 'MEDIUM',
    href: '/demo/bias-detection',
    icon: '⚡',
    stats: { layers: '4', patterns: '200+' },
  },
  {
    title: 'Psychology Pipeline',
    description:
      'End-to-end pipeline overview with knowledge parsing and scenario generation demos.',
    status: 'ACTIVE',
    difficulty: 'HIGH',
    href: '/demo/psychology-pipeline',
    icon: '🧠',
    stats: { modules: '3', latency: '<500ms' },
  },
  {
    title: 'Mental Health Chat',
    description:
      'Production-grade chat with MentalLLaMA analysis (falls back to demo mode locally).',
    status: 'ACTIVE',
    difficulty: 'MEDIUM',
    href: '/mental-health-demo',
    icon: '💬',
    stats: { analysis: 'real-time', crisis: 'on' },
  },
]

const liveDemo = {
  title: 'Live Chat Simulation',
  description:
    'Experience our AI training system with a real-time therapy session simulation.',
  status: 'LIVE',
}
---

<BaseLayout
  title="Demo Hub - Experience AI Therapy Training"
  description="Try our AI-powered therapy training simulations. Practice crisis interventions, bias detection, and complex client scenarios safely."
>
  <!-- Hero Section -->
  <section
    class="relative overflow-hidden min-h-screen flex items-center py-24 px-4"
  >
    <div class="max-w-5xl mx-auto relative z-10 w-full text-center">
      <!-- Status Bar -->
      <div
        class="mb-8 inline-flex items-center gap-3 px-6 py-3 np-elevated"
        style="border: 1px solid var(--np-line);"
      >
        <span
          class="inline-block w-2 h-2 np-mid"
          style="background: var(--np-mid);"
          aria-hidden="true"></span>
        <span class="font-bold np-text tracking-wide">DEMO LIBRARY AVAILABLE</span>
      </div>

      <!-- Headline -->
      <h1 class="text-5xl md:text-7xl font-bold mb-6 leading-tight np-text">
        EXPLORE THE<br />PRODUCT SURFACES
      </h1>

      <!-- Description -->
      <p class="text-xl md:text-2xl max-w-3xl mx-auto leading-relaxed np-muted mb-12">
        Explore the product through focused demos covering simulation,
        analytics, privacy, and supporting workflow components. This page is
        meant to show what exists, not make inflated claims about what does
        not.
      </p>

      <!-- CTA -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16">
        <button
          id="live-demo-btn"
          class="px-8 py-4 font-bold np-cta np-ring"
          style="background: var(--np-elevated);"
        >
          LIVE DEMONSTRATION
        </button>
        <button
          id="modules-btn"
          class="px-8 py-4 font-bold np-ring"
          style="background: var(--np-bg); color: var(--np-text); border: 1px solid var(--np-line);"
        >
          VIEW MODULES
        </button>
      </div>

      <!-- Scroll Hint -->
      <p class="text-sm np-muted">Scroll to explore</p>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      const liveDemoBtn = document.getElementById('live-demo-btn')
      if (liveDemoBtn) {
        liveDemoBtn.addEventListener('click', function () {
          const liveDemoSection = document.querySelector('section:nth-of-type(2)')
          if (liveDemoSection) {
            liveDemoSection.scrollIntoView({ behavior: 'smooth' })
          }
        })
      }
      const modulesBtn = document.getElementById('modules-btn')
      if (modulesBtn) {
        modulesBtn.addEventListener('click', function () {
          const modulesSection = document.querySelector('section:nth-of-type(3)')
          if (modulesSection) {
            modulesSection.scrollIntoView({ behavior: 'smooth' })
          }
        })
      }
    })
  </script>

  <!-- Live Demo Section -->
  <section class="py-24 px-4" style="background: var(--np-surface);">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <p class="font-bold np-mid mb-4 tracking-wide uppercase text-sm">
          {liveDemo.status} Demonstration
        </p>
        <h2 class="text-3xl md:text-5xl font-bold mb-4 np-text">
          {liveDemo.title}
        </h2>
        <p class="text-lg max-w-3xl mx-auto mb-8 np-muted">
          {liveDemo.description}
        </p>
      </div>
      <div>
        <BrutalistChatDemo client:load />
      </div>
    </div>
  </section>

  <!-- Demo Grid Section -->
  <section class="py-24 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-5xl font-bold mb-6 np-text">
          SPECIALIZED TRAINING MODULES
        </h2>
        <p class="text-lg max-w-3xl mx-auto np-muted">
          Each module targets specific therapeutic competencies with measurable
          outcomes.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          demos.map((demo) => (
            <div
              class="p-6 flex flex-col"
              style="background: var(--np-surface); border: 1px solid var(--np-line);"
            >
              <div class="flex items-center justify-between mb-4">
                <div class="text-3xl">{demo.icon}</div>
                <div class="flex gap-2">
                  <div
                    class="text-xs px-2 py-1 font-bold uppercase tracking-wide"
                    style="background: var(--np-elevated); color: var(--np-text); border: 1px solid var(--np-line);"
                  >
                    {demo.status}
                  </div>
                  <div
                    class="text-xs px-2 py-1 font-bold uppercase tracking-wide np-muted"
                    style="border: 1px solid var(--np-line);"
                  >
                    {demo.difficulty}
                  </div>
                </div>
              </div>

              <h3 class="text-lg font-semibold mb-3 np-text">{demo.title}</h3>
              <p class="np-muted text-sm mb-6 leading-relaxed flex-1">
                {demo.description}
              </p>

              <div class="grid grid-cols-2 gap-4 mb-6">
                {Object.entries(demo.stats).map(([key, value]) => (
                  <div class="text-center">
                    <div class="text-lg font-bold np-text">{value}</div>
                    <div class="text-xs uppercase tracking-wide np-muted">{key}</div>
                  </div>
                ))}
              </div>

              <a
                href={demo.href}
                class="block w-full text-center py-3 font-bold np-cta"
              >
                LAUNCH DEMO →
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Metrics Section -->
  <section class="py-24 px-4" style="background: var(--np-surface);">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-5xl font-bold mb-6 np-text">
          MEASURABLE OUTCOMES
        </h2>
        <p class="text-lg max-w-3xl mx-auto np-muted">
          Every training session generates actionable data to track your
          progress.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 text-center" style="background: var(--np-elevated);">
          <div class="text-4xl font-bold np-text">85%</div>
          <div class="mt-2 np-mid uppercase tracking-wide text-sm">Diagnostic Accuracy</div>
          <div class="text-xs np-muted mt-2">Average improvement</div>
        </div>
        <div class="p-6 text-center" style="background: var(--np-elevated);">
          <div class="text-4xl font-bold np-text">300%</div>
          <div class="mt-2 np-mid uppercase tracking-wide text-sm">Skill Acquisition</div>
          <div class="text-xs np-muted mt-2">Faster than traditional</div>
        </div>
        <div class="p-6 text-center" style="background: var(--np-elevated);">
          <div class="text-4xl font-bold np-text">78%</div>
          <div class="mt-2 np-mid uppercase tracking-wide text-sm">Bias Reduction</div>
          <div class="text-xs np-muted mt-2">Cultural competency</div>
        </div>
        <div class="p-6 text-center" style="background: var(--np-elevated);">
          <div class="text-4xl font-bold np-text">0</div>
          <div class="mt-2 np-mid uppercase tracking-wide text-sm">Patient Harm</div>
          <div class="text-xs np-muted mt-2">Perfect safety record</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl md:text-5xl font-bold mb-6 np-text">
        READY TO REVIEW THE WORKFLOW?
      </h2>
      <p class="text-xl np-muted mb-8">
        Use the demos to see how the platform handles simulation, feedback,
        and supporting product surfaces before you talk to us.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
        <a
          href="/contact"
          class="px-8 py-4 text-lg font-bold np-cta"
          style="background: var(--np-elevated);"
        >
          TALK TO THE TEAM →
        </a>
        <a
          href="/features"
          class="px-8 py-4 text-lg font-bold"
          style="background: var(--np-bg); color: var(--np-text); border: 1px solid var(--np-line);"
        >
          REVIEW FEATURES
        </a>
      </div>
      <div class="flex flex-wrap justify-center gap-4 text-sm">
        <span
          class="px-3 py-1 font-semibold"
          style="background: var(--np-elevated); border: 1px solid var(--np-line);"
          >✓ Product walkthroughs available</span
        >
        <span
          class="px-3 py-1 font-semibold np-muted"
          style="border: 1px solid var(--np-line);"
          >✓ Full support</span
        >
        <span
          class="px-3 py-1 font-semibold np-muted"
          style="border: 1px solid var(--np-line);"
          >✓ Custom integration</span
        >
      </div>
    </div>
  </section>
</BaseLayout>
