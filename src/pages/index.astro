---
import BaseLayout from '@/layouts/BaseLayout.astro'
import '@/styles/np-landing.css'
import { withBasePath } from '@/utils/path'
import { SITE } from '@/config'
import {
  heroContent,
  introContent,
  workflowContent,
  scenariosContent,
  featuresContent,
  ctaContent,
} from '@/lib/content'

const { hero, intro, workflow, scenarios, features, cta } = {
  hero: heroContent,
  intro: introContent,
  workflow: workflowContent,
  scenarios: scenariosContent,
  features: featuresContent,
  cta: ctaContent,
}
---

<BaseLayout title={hero.title} description={hero.subtitle}>
  <div class="np-page">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        'name': SITE.name,
        'url': SITE.website,
        'description': SITE.description,
        'foundingDate': '2024',
        'sameAs': [
          'https://github.com/nochadisfaction',
          'https://twitter.com/empathypixel',
        ],
      })
        .replace(/</g, '\\u003c')
        .replace(/>/g, '\\u003e')}
    />

    <!-- Hero -->
    <section class="np-hero">
      <div class="np-container np-hero__inner">
        <span class="np-label np-hero__kicker">{hero.kicker}</span>
        <h1 class="np-display np-hero__display">{hero.title}</h1>
        <p class="np-body np-hero__subtitle">{hero.subtitle}</p>
        <div class="np-hero__actions">
          <a
            class="np-btn np-btn-primary"
            href={withBasePath(hero.primaryCTA.href)}
          >
            {hero.primaryCTA.text}
          </a>
          <a
            class="np-btn np-btn-ghost"
            href={withBasePath(hero.secondaryCTA.href)}
          >
            {hero.secondaryCTA.text}
          </a>
        </div>
      </div>

      <div class="np-container np-hero__artifact">
        <figure class="np-hero__art">
          <img
            src={withBasePath(hero.artifact.image)}
            alt={hero.artifact.imageAlt}
            loading="eager"
            width="960"
            height="540"
          />
          <figcaption class="np-hero__art-cap">
            <span class="np-data">{hero.artifact.chip}</span>
            <span class="np-mono">{hero.artifact.status}</span>
          </figcaption>
        </figure>
      </div>

      <div class="np-container">
        <div class="np-hero__proof">
          {
            hero.proofPoints.map((point) => (
              <div class="np-hero__proof-item">
                <span class="np-data">{point.label}</span>
                <p class="np-mono">{point.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Why it matters -->
    <section class="np-section">
      <div class="np-container-narrow">
        <div class="np-section-header">
          <span class="np-label">{intro.label}</span>
          <h2 class="np-headline">{intro.title}</h2>
          {
            intro.paragraphs.map((p) => (
              <p class="np-body" style="margin-top:12px;">
                {p}
              </p>
            ))
          }
        </div>
      </div>

      <div class="np-container">
        <span class="np-label" style="margin:0 0 12px var(--np-pad);"
          >{intro.panelLabel}</span
        >
        <div class="np-card-grid">
          {
            intro.panelItems.map((item) => (
              <div class="np-card">
                <span class="np-data">{item.label}</span>
                <p class="np-body" style="font-size:0.9375rem;">
                  {item.body}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Before / After -->
    <section class="np-section" style="padding-top:0;">
      <div class="np-container">
        <div class="np-compare">
          {
            intro.evidenceCards.map((card) => (
              <div class="np-compare__col">
                <span class="np-compare__tag">{card.title}</span>
                <ul class="np-compare__list">
                  {card.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="np-section">
      <div class="np-container">
        <div class="np-section-header">
          <span class="np-label">{workflow.label}</span>
          <h2 class="np-headline">{workflow.title}</h2>
        </div>

        <div class="np-steps">
          {
            workflow.steps.map((step) => (
              <div class="np-step">
                <span class="np-step__number">{step.number}</span>
                <div class="np-step__body">
                  <h3 class="np-title">{step.title}</h3>
                  <p class="np-body">{step.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Workflow outputs band -->
    <section class="np-band">
      <div class="np-container-narrow">
        <span class="np-label">{workflow.bandLabel}</span>
        <h2 class="np-headline">{workflow.bandTitle}</h2>
        <p class="np-body">{workflow.bandBody}</p>
      </div>
      <div class="np-container">
        <div class="np-outputs">
          {
            workflow.outputs.map((output) => (
              <div class="np-output">
                <span class="np-data">{output.label}</span>
                <p
                  class="np-mono"
                  style="font-size:0.8125rem;line-height:1.6;color:var(--np-muted);"
                >
                  {output.value}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Scenarios -->
    <section class="np-section">
      <div class="np-container">
        <div class="np-section-header">
          <span class="np-label">{scenarios.label}</span>
          <h2 class="np-headline">{scenarios.title}</h2>
        </div>

        <div class="np-scenario-grid">
          {
            scenarios.cards.map((card) => (
              <div class="np-scenario-card">
                <span class="np-card__kicker">{card.kicker}</span>
                <h3 class="np-title">{card.title}</h3>
                <p class="np-body" style="font-size:0.9375rem;">
                  {card.body}
                </p>
              </div>
            ))
          }
        </div>

        <!-- Strip: who it's for -->
        <div class="np-strip">
          <div class="np-strip__prose">
            <span class="np-data">{scenarios.strip.label}</span>
            <h3 class="np-title">{scenarios.strip.title}</h3>
            <p class="np-body">{scenarios.strip.body}</p>
          </div>
          <div class="np-strip__items">
            {
              scenarios.strip.items.map((item) => (
                <div class="np-strip__item">
                  <span class="np-data">{item.label}</span>
                  <p
                    class="np-mono"
                    style="font-size:0.8125rem;color:var(--np-text);"
                  >
                    {item.value}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="np-section">
      <div class="np-container">
        <div class="np-section-header">
          <span class="np-label">{features.label}</span>
          <h2 class="np-headline">{features.title}</h2>
          <p class="np-body">{features.copy}</p>
        </div>

        <div class="np-features-grid">
          {
            features.cards.map((card) => (
              <div class="np-feature-card">
                <span class="np-data">{card.title}</span>
                <p class="np-body" style="font-size:0.9375rem;">
                  {card.description}
                </p>
              </div>
            ))
          }
        </div>

        <div class="np-hero__proof" style="margin-top:32px;">
          {
            features.proofItems.map((item) => (
              <div class="np-hero__proof-item">
                <p
                  class="np-mono"
                  style="font-size:0.8125rem;line-height:1.6;color:var(--np-muted);"
                >
                  {item}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="np-cta">
      <div class="np-container-narrow">
        <div class="np-cta-inner">
          <span class="np-label">{cta.label}</span>
          <h2 class="np-headline">{cta.title}</h2>
          <p class="np-body">{cta.intro}</p>
          <div class="np-hero__actions">
            <a
              class="np-btn np-btn-primary"
              href={withBasePath(cta.primaryCTA.href)}
            >
              {cta.primaryCTA.text}
            </a>
            <a
              class="np-btn np-btn-ghost"
              href={withBasePath(cta.secondaryCTA.href)}
            >
              {cta.secondaryCTA.text}
            </a>
          </div>
          <p class="np-cta__meta">{cta.meta}</p>
        </div>
      </div>
    </section>

    <!-- Resources — inline guidance for first-timers -->
    <section class="np-section" style="padding-top:0;">
      <div class="np-container">
        <div class="np-help">
          <span class="np-label">Explore</span>
          <div class="np-help__links">
            <a class="np-help__link" href={withBasePath('/features')}>
              <span class="np-data">Features</span>
              <span class="np-help__desc">How the platform works</span>
            </a>
            <a class="np-help__link" href={withBasePath('/trust')}>
              <span class="np-data">Trust</span>
              <span class="np-help__desc">Security and compliance</span>
            </a>
            <a class="np-help__link" href={withBasePath('/demo-hub')}>
              <span class="np-data">Case Studies</span>
              <span class="np-help__desc">Real training deployments</span>
            </a>
            <a class="np-help__link" href={withBasePath('/contact')}>
              <span class="np-data">Contact</span>
              <span class="np-help__desc">Talk to the team</span>
            </a>
          </div>
          <p
            class="np-mono"
            style="font-size:0.6875rem;color:var(--np-muted);margin-top:12px;"
          >
            Book a pilot and try it with one cohort, one supervisor, and two
            scenarios.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
