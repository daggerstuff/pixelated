---
import BaseLayout from '@/layouts/BaseLayout.astro'
import '@/styles/np-landing.css'
import { withBasePath } from '@/utils/path'
import {
  heroContent,
  workflowContent,
  ctaContent,
} from '@/lib/content'

const { hero, workflow, cta } = {
  hero: heroContent,
  workflow: workflowContent,
  cta: ctaContent,
}

const sessionWalkthrough = [
  {
    label: 'Scenario',
    value:
      'A client in week three of therapy says she is not sure this is the right place and considers stopping.',
  },
  {
    label: 'Practice room',
    value:
      'Trainee enters the conversation with an AI client that adapts to hesitation, disclosure timing, and the moment the room changes.',
  },
  {
    label: 'Review desk',
    value:
      'Supervisor opens the transcript, marks the response that needed to slow down, and assigns the same scenario again as a retry.',
  },
  {
    label: 'Training record',
    value:
      'The case, transcript, and supervisor note stay attached to the same run, so the next supervision meeting starts at the right moment.',
  },
]

const buildableScenarios = [
  {
    kicker: 'Escalation',
    body: 'Suicidality screening, de-escalation, safety planning, and what to say when the room changes faster than expected.',
  },
  {
    kicker: 'Rupture',
    body: 'Avoidance, dysregulation, emotional withdrawal, and the repairs that decide whether a client stays in the conversation.',
  },
  {
    kicker: 'Disclosure',
    body: 'The turn where a client shares something high-stakes and the therapist has to decide what to do next without flattening the room.',
  },
]
---

<BaseLayout title={hero.title} description={hero.metaDescription}>
  <div class="np-page">
    <!-- Hero: the one decision a visitor came here to make. -->
    <section class="np-hero">
      <div class="np-container">
        <div class="np-hero__grid">
          <div class="np-hero__primary">
            <span class="np-label">Enterprise Clinical Training Platform</span>
            <h1 class="np-display np-hero__display">{hero.title}</h1>
            <p class="np-body np-hero__subtitle">{hero.subtitle}</p>
            <div class="np-hero__actions">
              <a
                class="np-btn np-btn-primary"
                href={withBasePath(hero.primaryCTA.href)}
              >
                {hero.primaryCTA.text}
              </a>
              <a
                class="np-btn np-btn-ghost"
                href={withBasePath(hero.secondaryCTA.href)}
              >
                {hero.secondaryCTA.text}
              </a>
            </div>
            <p class="np-hero__helper">{hero.helperText}</p>
          </div>

          <!-- TASTES §6 transcript proof object — Session 04 · Rupture repair. -->
          <aside class="np-record" aria-label="Session 04 transcript proof object">
            <header class="np-record__head">
              <span class="np-record__case">Session 04 · Rupture repair</span>
              <span class="np-record__topic">Disclosure, then naming the loss</span>
            </header>

            <div class="np-record__body">
              <ol class="np-record__transcript">
                <li class="np-record__turn">
                  <span class="np-record__speaker">Counselor · 00:18</span>
                  <p class="np-record__line">
                    What brought you back this week?
                  </p>
                </li>
                <li class="np-record__turn">
                  <span class="np-record__speaker">Client · 00:42</span>
                  <p class="np-record__line">
                    Something happened. I don't really know how to say it. I
                    haven't told anyone, including [partner].
                  </p>
                </li>
                <li class="np-record__turn">
                  <span class="np-record__speaker">Counselor · 01:04</span>
                  <p class="np-record__line">
                    Stay with me as long as you need. I won't rush this.
                  </p>
                </li>
                <li class="np-record__turn">
                  <span class="np-record__speaker">Client · 02:31</span>
                  <p class="np-record__line">
                    Three years ago. I had a stillbirth. Nobody knows except
                    [partner], and we haven't said it out loud in two years.
                  </p>
                </li>
                <li class="np-record__turn">
                  <span class="np-record__speaker">Counselor · 03:12</span>
                  <p class="np-record__line">
                    You said it out loud just now. I'm here. We don't have to do
                    anything else with it yet.
                  </p>
                </li>
                <li class="np-record__turn">
                  <span class="np-record__speaker">Client · 03:48</span>
                  <p class="np-record__line">
                    I didn't think I could. I still can't really. But you didn't
                    make me fix it.
                  </p>
</li>
              </ol>
            </div>

            <footer class="np-record__foot">
              <span class="np-record__lane">Turn 4 · Rupture named</span>
              <span class="np-record__mark">Repair attempted · retry by W5</span>
            </footer>
          </aside>
        </div>
      </div>
    </section>

    <!-- How the training loop works: the one path the product asks you to follow. -->
    <section class="np-section">
      <div class="np-container">
        <div class="np-section-header">
          <span class="np-label">{workflow.label}</span>
          <h2 class="np-headline">{workflow.title}</h2>
        </div>

        <div class="np-steps">
          {
            workflow.steps.map((step) => (
              <div class="np-step">
                <span class="np-step__number">{step.number}</span>
                <div class="np-step__body">
                  <h3 class="np-title">{step.title}</h3>
                  <p class="np-body">{step.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- One session, end to end: the actual product shape, walked as an artifact. -->
    <section class="np-section np-section--artifact">
      <div class="np-container">
        <div class="np-section-header">
          <span class="np-label">A session, end to end</span>
          <h2 class="np-headline">
            What your team gets when the practice is logged.
          </h2>
          <p class="np-body">
            Four things arrive together from one trainee attempt: a scenario,
            a transcript, a supervisor note, and a record your next meeting can
            reopen without guesswork.
          </p>
        </div>

        <ol class="np-artifact">
          {
            sessionWalkthrough.map((step) => (
              <li class="np-artifact__row">
                <span class="np-data np-artifact__label">{step.label}</span>
                <p class="np-body np-artifact__body">{step.value}</p>
              </li>
            ))
          }
        </ol>

        <div class="np-section-header np-section-header--spaced">
          <span class="np-label">Scenarios your team can run today</span>
          <h2 class="np-headline">
            Three places teams start when training feels too improvised.
          </h2>
        </div>

        <ul class="np-scenarios">
          {
            buildableScenarios.map((scenario) => (
              <li class="np-scenario">
                <span class="np-data np-scenario__kicker">{scenario.kicker}</span>
                <p class="np-body np-scenario__body">{scenario.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- CTA: the one ask. -->
    <section class="np-cta">
      <div class="np-container-narrow">
        <div class="np-cta-inner">
          <span class="np-label">{cta.label}</span>
          <h2 class="np-headline">{cta.title}</h2>
          <p class="np-body">{cta.intro}</p>
          <div class="np-hero__actions">
            <a
              class="np-btn np-btn-primary"
              href={withBasePath(cta.primaryCTA.href)}
            >
              {cta.primaryCTA.text}
            </a>
            <a
              class="np-btn np-btn-ghost"
              href={withBasePath(cta.secondaryCTA.href)}
            >
              {cta.secondaryCTA.text}
            </a>
          </div>
          <p class="np-cta__trust">
            HIPAA-ready ·
            <a href={withBasePath('/trust')}>Security &amp; data handling</a> ·
            <a href={withBasePath('/terms')}>Terms</a>
          </p>
          <p class="np-cta__meta">{cta.meta}</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
