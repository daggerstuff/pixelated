---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { homepageContent } from '@/lib/content'
import { withBasePath } from '@/utils/path'

const { hero, intro } = homepageContent
---

<BaseLayout
  title="Pixelated Empathy | Clinical simulation for therapist training and supervision"
  description="Turn difficult therapy sessions into sharper supervision with review-ready transcripts, clearer coaching moments, and one realistic case your team can learn from together."
>
  <section class="hero section">
    <p class="eyebrow">{hero.kicker}</p>
    <h1>{hero.title}</h1>
    <p class="lead">
      {hero.subtitle}
    </p>
    <div class="action-row" aria-label="Primary links">
      <a class="button" href={withBasePath(hero.primaryCTA.href)}>{hero.primaryCTA.text}</a>
      <a class="text-link" href={withBasePath(hero.secondaryCTA.href)}>{hero.secondaryCTA.text}</a>
    </div>
  </section>

  <section class="section split-overview" aria-label="Theme overview">
    <div>
      <p class="eyebrow">{intro.label}</p>
      <h2>{intro.title}</h2>
    </div>
    <div class="feature-list">
      {intro.panelItems.map((item) => (
        <article>
          <h3>{item.label}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="latest-works">
    <div class="section-heading">
      <p class="eyebrow">The Problem vs The Solution</p>
      <h2 id="latest-works">Before & After.</h2>
      <a class="text-link" href={withBasePath('/features')}>All features</a>
    </div>

    <div class="note-list">
      {intro.evidenceCards.map((card) => (
        <article class="note-row" style="padding-bottom: 2rem;">
          <div>
            <h3>{card.title}</h3>
            <ul style="margin-top: 1rem; padding-left: 1rem;">
              {card.items.map(item => (
                <li style="margin-bottom: 0.5rem; color: var(--color-muted);">{item}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
