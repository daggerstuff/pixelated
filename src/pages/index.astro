---
import BaseLayout from '@/layouts/BaseLayout.astro'
import '@/styles/np-landing.css'
import { withBasePath } from '@/utils/path'
import { heroContent, workflowContent, ctaContent } from '@/lib/content'

const { hero, workflow, cta } = {
  hero: heroContent,
  workflow: workflowContent,
  cta: ctaContent,
}

const sessionWalkthrough = [
  {
    label: 'Scenario',
    value:
      'A client in week three of therapy says she is not sure this is the right place and considers stopping.',
  },
  {
    label: 'Practice room',
    value:
      'Trainee enters the conversation with an AI client that adapts to hesitation, disclosure timing, and the moment the room changes.',
  },
  {
    label: 'Review desk',
    value:
      'Supervisor opens the transcript, marks the response that needed to slow down, and assigns the same scenario again as a retry.',
  },
  {
    label: 'Training record',
    value:
      'The case, transcript, and supervisor note stay attached to the same run, so the next supervision meeting starts at the right moment.',
  },
]

const buildableScenarios = [
  {
    kicker: 'Escalation',
    body: 'Suicidality screening, de-escalation, safety planning, and what to say when the room changes faster than expected.',
  },
  {
    kicker: 'Rupture',
    body: 'Avoidance, dysregulation, emotional withdrawal, and the repairs that decide whether a client stays in the conversation.',
  },
  {
    kicker: 'Disclosure',
    body: 'The turn where a client shares something high-stakes and the therapist has to decide what to do next without flattening the room.',
  },
]
---

<BaseLayout title={hero.title} description={hero.metaDescription}>
  <div class="np-page">
    <!-- Hero: content left, conversation demo right -->
    <section class="np-hero" aria-label="Platform overview">
      <div class="np-container np-hero__grid">
        <div class="np-hero__content">
          <span class="np-hero__kicker np-data">{hero.kicker}</span>
          <h1 class="np-display np-hero__display">
            Rehearse <span class="np-mono-word">hard conversations</span> before
            real clients.
          </h1>
          <p class="np-body-strong np-hero__subtitle">{hero.subtitle}</p>
          <div class="np-hero__actions">
            <a
              class="np-btn np-btn-primary"
              href={withBasePath(hero.primaryCTA.href)}
            >
              {hero.primaryCTA.text}
            </a>
            <a
              class="np-btn np-btn-ghost"
              href={withBasePath(hero.secondaryCTA.href)}
            >
              {hero.secondaryCTA.text}
            </a>
          </div>
        </div>

        <!-- Practice room — transcript as clinical artifact -->
        <aside
          class="np-chat-demo"
          aria-label="Example therapy conversation on the platform"
          role="region"
        >
          <div class="np-chat-demo__file-header">
            <span class="np-chat-demo__file-label">transcript.run</span>
            <span class="np-chat-demo__file-id">S-03 // rupture-repair</span>
          </div>

          <div class="np-chat-demo__messages">
            <div class="np-chat-demo__entry">
              <span class="np-chat-demo__speaker">S.</span>
              <p class="np-chat-demo__line">
                I&#39;ve been thinking about whether this is really working for
                me.
              </p>
            </div>

            <div class="np-chat-demo__entry np-chat-demo__entry--therapist">
              <span class="np-chat-demo__speaker">T.</span>
              <p class="np-chat-demo__line">
                It sounds like you&#39;re not sure this is the right place. What
                feels off?
              </p>
            </div>

            <div class="np-chat-demo__entry">
              <span class="np-chat-demo__speaker">S.</span>
              <p class="np-chat-demo__line">
                I don&#39;t know. I just feel like I&#39;m not getting anywhere.
              </p>
            </div>

            <div class="np-chat-demo__entry np-chat-demo__entry--therapist">
              <span class="np-chat-demo__speaker">T.</span>
              <p class="np-chat-demo__line">
                That&#39;s worth sitting with. Can you tell me what
                &ldquo;getting somewhere&rdquo; would look like?
              </p>
            </div>

            <div class="np-chat-demo__entry">
              <span class="np-chat-demo__speaker">S.</span>
              <p class="np-chat-demo__line">
                I guess&hellip; I thought I&#39;d feel different by now. Like
                something would click.
              </p>
            </div>

            <div class="np-chat-demo__entry np-chat-demo__entry--therapist">
              <span class="np-chat-demo__speaker">T.</span>
              <p class="np-chat-demo__line">
                It makes sense to expect change to feel more obvious. Let&#39;s
                look at what has shifted&mdash;even the small things.
              </p>
            </div>
          </div>

          <div class="np-chat-demo__live" aria-hidden="true">
            <span class="np-chat-demo__cursor">|</span>
            <span class="np-chat-demo__live-text">live · s. composing</span>
          </div>

          <p class="np-chat-demo__note">
            simulated&ensp;&middot;&ensp;trainee responds to an ai client
          </p>
        </aside>
      </div>

      <div class="np-container">
        <div class="np-hero__proof">
          {
            hero.proofPoints.map((point) => (
              <div class="np-hero__proof-item">
                <span class="np-data">{point.label}</span>
                <p class="np-mono">{point.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Trust strip: credentials and institutional signals -->
    <section class="np-trust" aria-label="Credentials and standards">
      <div class="np-container">
        <p class="np-trust__label">Built for clinical training programs</p>
        <div class="np-trust__row">
          <span class="np-trust__badge">HIPAA-ready</span>
          <span class="np-trust__badge">FERPA-aligned</span>
          <span class="np-trust__badge">Evidence-based scenarios</span>
          <span class="np-trust__badge">Accreditation-ready records</span>
        </div>
        <div class="np-trust__logos">
          <img
            src={withBasePath('/images/client-logo-1.svg')}
            alt=""
            aria-hidden="true"
            class="np-trust__logo"
          />
          <img
            src={withBasePath('/images/client-logo-2.svg')}
            alt=""
            aria-hidden="true"
            class="np-trust__logo"
          />
          <img
            src={withBasePath('/images/client-logo-3.svg')}
            alt=""
            aria-hidden="true"
            class="np-trust__logo"
          />
          <img
            src={withBasePath('/images/client-logo-4.svg')}
            alt=""
            aria-hidden="true"
            class="np-trust__logo"
          />
          <img
            src={withBasePath('/images/client-logo-5.svg')}
            alt=""
            aria-hidden="true"
            class="np-trust__logo"
          />
        </div>
      </div>
    </section>

    <!-- How the training loop works: the one path the product asks you to follow. -->
    <section class="np-section np-section--track np-reveal">
      <div class="np-container">
        <div class="np-section-header np-section-header--track">
          <span class="np-label">{workflow.label}</span>
          <h2 class="np-headline">{workflow.title}</h2>
        </div>

        <ol class="np-track" aria-label="Training loop steps">
          {
            workflow.steps.map((step) => (
              <li class="np-track__step">
                <span class="np-track__number" aria-hidden="true">
                  {step.number}
                </span>
                <h3 class="np-title np-track__title">{step.title}</h3>
                <p class="np-body np-track__body">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- One session, end to end: the actual product shape, walked as an artifact. -->
    <section class="np-section np-section--artifact np-reveal">
      <div class="np-container">
        <div class="np-section-header">
          <span class="np-label">A session, end to end</span>
          <h2 class="np-headline">
            One attempt. Four things your next meeting can teach from.
          </h2>
          <p class="np-body">
            A single trainee attempt leaves behind a scenario, a full
            transcript, a supervisor note, and a training record — all tied to
            the same run. Nobody reconstructs the session from memory, and the
            next supervision meeting opens exactly where it should.
          </p>
        </div>

        <figure class="np-screenshot">
          <img
            src={withBasePath('/images/homepage/training-session-proof.png')}
            alt="Pixelated Empathy training session interface: practice room, review notes, and session record"
            loading="lazy"
            width="960"
            height="540"
          />
          <figcaption class="np-screenshot__caption">
            <span class="np-data">Practice room</span>
            <span class="np-mono"
              >Trainee conversation on the left · Supervisor review on the right</span
            >
          </figcaption>
        </figure>

        <ol class="np-artifact">
          {
            sessionWalkthrough.map((step) => (
              <li class="np-artifact__row">
                <span class="np-data np-artifact__label">{step.label}</span>
                <p class="np-body np-artifact__body">{step.value}</p>
              </li>
            ))
          }
        </ol>

        <div class="np-section-header np-section-header--spaced">
          <span class="np-label">Scenarios your team can run today</span>
          <h2 class="np-headline">
            Start where the room gets hardest to hold.
          </h2>
        </div>

        <div class="np-scenarios-grid">
          <article class="np-scenario-feature">
            <span class="np-data np-scenario__kicker">Escalation</span>
            <p class="np-body np-scenario__body">
              Suicidality screening, de-escalation, safety planning, and what to
              say when the room changes faster than expected.
            </p>
            <span class="np-scenario__pin" aria-hidden="true">
              Highest-stakes · start here
            </span>
          </article>

          <article class="np-scenario-side np-scenario-side--rupture">
            <span class="np-data np-scenario__kicker">Rupture</span>
            <p class="np-body np-scenario__body">
              Avoidance, dysregulation, emotional withdrawal, and the repairs
              that decide whether a client stays in the conversation.
            </p>
          </article>

          <article class="np-scenario-side np-scenario-side--disclosure">
            <span class="np-data np-scenario__kicker">Disclosure</span>
            <p class="np-body np-scenario__body">
              The turn where a client shares something high-stakes and the
              therapist has to decide what to do next without flattening the
              room.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Mid-page CTA: the third placement of the primary action, after the
         strongest proof (the session walkthrough + scenarios). -->
    <section class="np-cta-band np-reveal" aria-label="Request a demo">
      <div class="np-container">
        <a
          class="np-btn np-btn-primary np-cta-band__btn"
          href={withBasePath(hero.primaryCTA.href)}
        >
          {hero.primaryCTA.text}
        </a>
      </div>
    </section>

    <!-- CTA: the one ask. -->
    <section class="np-cta np-reveal">
      <div class="np-container">
        <div class="np-cta-grid">
          <div class="np-cta-pitch">
            <span class="np-label">{cta.label}</span>
            <h2 class="np-headline np-cta-pitch__title">{cta.title}</h2>
            <p class="np-body np-cta-pitch__body">{cta.intro}</p>
            <p class="np-cta__meta">{cta.meta}</p>
          </div>

          <div class="np-cta-commit">
            <span class="np-data np-cta-commit__kicker">
              Pilot · cohort of 4 clinicians
            </span>
            <p class="np-cta-commit__line">
              Two intakes per clinician, supervised review at week three, full
              transcript access for your training lead.
            </p>
            <div class="np-cta-commit__actions">
              <a
                class="np-btn np-btn-primary np-cta-commit__primary"
                href={withBasePath(cta.primaryCTA.href)}
              >
                {cta.primaryCTA.text}
              </a>
              <a
                class="np-btn np-btn-ghost np-cta-commit__secondary"
                href={withBasePath(cta.secondaryCTA.href)}
              >
                {cta.secondaryCTA.text}
              </a>
            </div>
            <p class="np-cta__trust">
              HIPAA-ready ·
              <a href={withBasePath('/trust')}>Security &amp; data handling</a> ·
              <a href={withBasePath('/terms')}>Terms</a>
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    // Scroll-triggered fade-up reveals via IntersectionObserver.
    // Respects prefers-reduced-motion: CSS handles the override so JS
    // just needs to add the class — no motion if user opted out.
    const revealEls = document.querySelectorAll('.np-reveal')
    if ('IntersectionObserver' in window && revealEls.length > 0) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('np-reveal--in')
              io.unobserve(entry.target)
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
      )
      revealEls.forEach((el) => io.observe(el))
    } else {
      // Fallback: show everything immediately.
      revealEls.forEach((el) => el.classList.add('np-reveal--in'))
    }
  </script>
</BaseLayout>
