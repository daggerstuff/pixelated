---
import BaseLayout from '@/layouts/BaseLayout.astro'
import MarketingPageHero from '@/components/marketing/MarketingPageHero.astro'

// Ensure a real 404 status even when this page is reached via a rewrite
// (e.g. the production gate for internal-only routes in middleware.ts).
Astro.response.status = 404

const title = 'Page not found'
const description =
  'The page you tried to reach is not here. Use the routes below to get back to a live surface.'
---

<BaseLayout {title} {description}>
  <MarketingPageHero
    eyebrow="Status · 404"
    title="This page is not here."
    lede="The URL is correct, but the route does not exist on this site. Pick a live surface instead."
    primaryCTA={{ text: 'Go home', href: '/' }}
    secondaryCTA={{ text: 'See the product demo', href: '/#demo' }}
    note="Live destinations are listed below."
    proof={{
      label: 'Live routes',
      body: `<ul class="marketing-list"><li><a href="/features"><strong>Features</strong> · what the platform does</a></li><li><a href="/trust"><strong>Trust</strong> · privacy, security, controls</a></li><li><a href="/about"><strong>About</strong> · who builds it and why</a></li><li><a href="/contact"><strong>Contact</strong> · evaluate, pilot, or ask</a></li></ul>`,
      caption: 'Or email info@pixelatedempathy.com if a route is missing on purpose.',
    }}
  />
</BaseLayout>
