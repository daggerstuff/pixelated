---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
---

<DashboardLayout title="Rate Limits & Quota Management">
  <section class="admin-section">
    <h2>Rate Limits & Quota Management</h2>
    <p>
      Per-key rate limiting with configurable tiers, daily/monthly quota
      tracking, and alert management.
    </p>
  </section>

  <section class="admin-section">
    <h3>Tier Configuration</h3>
    <table class="tier-table">
      <thead>
        <tr>
          <th>Tier</th>
          <th>Requests/Min</th>
          <th>Daily Quota</th>
          <th>Monthly Quota</th>
          <th>Burst</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <tr class="tier-free">
          <td>Free</td><td>60</td><td>1,000</td><td>10,000</td><td>10</td>
          <td>Basic access for evaluation and testing</td>
        </tr>
        <tr class="tier-developer">
          <td>Developer</td><td>200</td><td>5,000</td><td>50,000</td><td>25</td>
          <td>Standard developer access</td>
        </tr>
        <tr class="tier-professional">
          <td>Professional</td><td>1,000</td><td>25,000</td><td>250,000</td><td
            >50</td
          >
          <td>Production workloads</td>
        </tr>
        <tr class="tier-enterprise">
          <td>Enterprise</td><td>5,000</td><td>100,000</td><td>1,000,000</td><td
            >100</td
          >
          <td>High-volume enterprise access</td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="admin-section">
    <h3>Overview Stats</h3>
    <div class="stats-grid" id="stats-grid">
      <div class="stat-card">
        <span class="stat-label">Total Active Keys</span><span
          class="stat-value"
          id="stat-total">—</span>
      </div>
      <div class="stat-card alert">
        <span class="stat-label">Near Rate Limit</span><span
          class="stat-value"
          id="stat-rate">—</span>
      </div>
      <div class="stat-card alert">
        <span class="stat-label">Near Daily Quota</span><span
          class="stat-value"
          id="stat-daily">—</span>
      </div>
      <div class="stat-card alert">
        <span class="stat-label">Near Monthly Quota</span><span
          class="stat-value"
          id="stat-monthly">—</span>
      </div>
    </div>
  </section>

  <section class="admin-section">
    <h3>Tier Distribution</h3>
    <div id="tier-distribution" class="tier-distribution"></div>
  </section>

  <section class="admin-section">
    <h3>Active Alerts</h3>
    <div id="alerts-container">
      <p class="muted">Loading alerts…</p>
    </div>
  </section>

  <section class="admin-section">
    <h3>Key Usage Overview</h3>
    <table class="usage-table">
      <thead>
        <tr>
          <th>Key ID</th>
          <th>Name</th>
          <th>Tier</th>
          <th>Rate Limit (current/limit)</th>
          <th>Daily Quota (remaining/limit)</th>
          <th>Monthly Quota (remaining/limit)</th>
          <th>Alert</th>
        </tr>
      </thead>
      <tbody id="usage-tbody">
        <tr><td colspan="7" class="muted">Loading…</td></tr>
      </tbody>
    </table>
  </section>

  <section class="admin-section">
    <h3>API Endpoints</h3>
    <table class="endpoint-table">
      <thead>
        <tr><th>Method</th><th>Endpoint</th><th>Description</th></tr>
      </thead>
      <tbody>
        <tr
          ><td>GET</td><td><code>/api/v1/admin/rate-limits</code></td><td
            >List usage for all active keys</td
          ></tr
        >
        <tr
          ><td>GET</td><td><code>/api/v1/admin/rate-limits?stats=true</code></td
          ><td>Aggregate stats (near-limit counts, tier distribution)</td></tr
        >
        <tr
          ><td>GET</td><td><code>/api/v1/admin/rate-limits/alerts</code></td><td
            >Active quota alerts</td
          ></tr
        >
        <tr
          ><td>GET</td><td><code>/api/developer/rate-limits/usage</code></td><td
            >Usage for current user's keys</td
          ></tr
        >
        <tr
          ><td>GET</td><td
            ><code>/api/developer/rate-limits/usage?keyId=X</code></td
          ><td>Usage for specific key</td></tr
        >
      </tbody>
    </table>
  </section>
</DashboardLayout>

<style>
  .admin-section {
    margin-bottom: 2rem;
  }
  .admin-section h2 {
    margin-bottom: 0.5rem;
  }
  .admin-section h3 {
    margin-bottom: 0.75rem;
    border-bottom: 1px solid #333;
    padding-bottom: 0.25rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  th,
  td {
    padding: 0.5rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid #444;
  }
  th {
    font-weight: 600;
    background: #1a1a2e;
  }

  .tier-free td:first-child {
    color: #6b7280;
  }
  .tier-developer td:first-child {
    color: #3b82f6;
  }
  .tier-professional td:first-child {
    color: #8b5cf6;
  }
  .tier-enterprise td:first-child {
    color: #f59e0b;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .stat-card {
    padding: 1rem;
    border-radius: 0.5rem;
    background: #1a1a2e;
    text-align: center;
  }
  .stat-card.alert {
    background: #2a1515;
  }
  .stat-label {
    display: block;
    font-size: 0.75rem;
    color: #9ca3af;
    margin-bottom: 0.25rem;
  }
  .stat-value {
    display: block;
    font-size: 1.75rem;
    font-weight: 700;
  }

  .tier-distribution {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .tier-badge {
    padding: 0.5rem 1rem;
    border-radius: 0.25rem;
    font-weight: 600;
  }

  .usage-bar {
    display: inline-block;
    width: 120px;
    height: 8px;
    background: #333;
    border-radius: 4px;
    overflow: hidden;
    vertical-align: middle;
  }
  .usage-bar-fill {
    height: 100%;
    border-radius: 4px;
  }
  .usage-bar-fill.green {
    background: #22c55e;
  }
  .usage-bar-fill.yellow {
    background: #eab308;
  }
  .usage-bar-fill.red {
    background: #ef4444;
  }

  .alert-badge {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .alert-badge.none {
    background: #1a3a1a;
    color: #4ade80;
  }
  .alert-badge.warning {
    background: #3a3a1a;
    color: #facc15;
  }
  .alert-badge.critical {
    background: #3a1a1a;
    color: #f87171;
  }

  .muted {
    color: #6b7280;
  }

  code {
    background: #1a1a2e;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.8rem;
  }

  .alert-item {
    padding: 0.75rem;
    border-radius: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .alert-item.rate_limit {
    background: #2a1a1a;
    border-left: 3px solid #ef4444;
  }
  .alert-item.daily_quota {
    background: #2a2a1a;
    border-left: 3px solid #eab308;
  }
  .alert-item.monthly_quota {
    background: #2a1a2a;
    border-left: 3px solid #a855f7;
  }
</style>

<script>
  async function loadStats() {
    try {
      const res = await fetch('/api/v1/admin/rate-limits?stats=true')
      const data = await res.json()

      const statTotal = document.getElementById('stat-total')
      const statRate = document.getElementById('stat-rate')
      const statDaily = document.getElementById('stat-daily')
      const statMonthly = document.getElementById('stat-monthly')
      if (statTotal) statTotal.textContent = String(data.totalKeys ?? 0)
      if (statRate) statRate.textContent = String(data.keysNearRateLimit ?? 0)
      if (statDaily) statDaily.textContent = String(data.keysNearDailyQuota ?? 0)
      if (statMonthly) statMonthly.textContent = String(data.keysNearMonthlyQuota ?? 0)

      const dist = document.getElementById('tier-distribution')
      const colors: Record<string, string> = {
        free: '#6b7280',
        developer: '#3b82f6',
        professional: '#8b5cf6',
        enterprise: '#f59e0b',
      }
      if (dist) {
        dist.innerHTML = Object.entries(data.tierDistribution || {})
          .map(([tier, count]: [string, unknown]) => {
            const c = (colors as Record<string, string>)[tier] || '#666'
            return `<span class="tier-badge" style="background:${c}22;color:${c}">${tier}: ${count}</span>`
          })
          .join('')
      }

      const tbody = document.getElementById('usage-tbody')
      if (tbody) tbody.innerHTML =
        (data.usages || [])
          .map((u) => {
            const ratePct =
              u.rateLimit.limit > 0
                ? u.rateLimit.remaining / u.rateLimit.limit
                : 1
            const dailyPct =
              u.dailyQuota.limit > 0
                ? u.dailyQuota.remaining / u.dailyQuota.limit
                : 1
            const monthlyPct =
              u.monthlyQuota.limit > 0
                ? u.monthlyQuota.remaining / u.monthlyQuota.limit
                : 1
            const rateClass =
              ratePct > 0.5 ? 'green' : ratePct > 0.1 ? 'yellow' : 'red'
            const dailyClass =
              dailyPct > 0.5 ? 'green' : dailyPct > 0.2 ? 'yellow' : 'red'
            const monthlyClass =
              monthlyPct > 0.5 ? 'green' : monthlyPct > 0.2 ? 'yellow' : 'red'
            const alertClass = u.alertThresholdExceeded ? 'warning' : 'none'
            const alertText = u.alertThresholdExceeded ? '⚠' : 'OK'
            return `<tr>
          <td><code>${u.apiKeyId.substring(0, 12)}…</code></td>
          <td>—</td>
          <td>${u.tier.name}</td>
          <td>${u.rateLimit.currentWindowCount}/${u.rateLimit.limit} <span class="usage-bar"><span class="usage-bar-fill ${rateClass}" style="width:${ratePct * 100}%"></span></span></td>
          <td>${u.dailyQuota.remaining}/${u.dailyQuota.limit} <span class="usage-bar"><span class="usage-bar-fill ${dailyClass}" style="width:${dailyPct * 100}%"></span></span></td>
          <td>${u.monthlyQuota.remaining}/${u.monthlyQuota.limit} <span class="usage-bar"><span class="usage-bar-fill ${monthlyClass}" style="width:${monthlyPct * 100}%"></span></span></td>
          <td><span class="alert-badge ${alertClass}">${alertText}</span></td>
        </tr>`
          })
          .join('') ||
        '<tr><td colspan="7" class="muted">No active keys</td></tr>'
    } catch {
      const errTbody = document.getElementById('usage-tbody')
      if (errTbody) errTbody.innerHTML =
        '<tr><td colspan="7" class="muted">Failed to load</td></tr>'
    }
  }

  async function loadAlerts() {
    try {
      const res = await fetch('/api/v1/admin/rate-limits/alerts')
      const data = await res.json()
      const container = document.getElementById('alerts-container')
      if (!container) return

      if (!data.alerts || data.alerts.length === 0) {
        container.innerHTML = '<p class="muted">No active alerts</p>'
        return
      }

      container.innerHTML = `
        <p><strong>${data.totalAlerts}</strong> alerts across <strong>${data.keysWithAlerts}</strong> keys</p>
        ${data.alerts
          .map(
            (a) => `<div class="alert-item ${a.type}">
          <strong>${a.type.replace('_', ' ').toUpperCase()}</strong> — Key <code>${a.apiKeyId.substring(0, 12)}…</code><br>
          ${a.message} (tier: ${a.tier})
        </div>`,
          )
          .join('')}
      `
    } catch {
      const errContainer = document.getElementById('alerts-container')
      if (errContainer) errContainer.innerHTML =
        '<p class="muted">Failed to load alerts</p>'
    }
  }

  loadStats()
  loadAlerts()
</script>
