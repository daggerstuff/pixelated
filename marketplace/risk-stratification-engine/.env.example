# Risk Stratification Engine — Environment Configuration
#
# Copy this file to `.env` and fill in the values for your deployment.
# All settings use the RISK_STRAT_ prefix.

# BAA (Business Associate Agreement) gate.
# Set to "true" ONLY when a signed BAA is in place.
# When false, the /stratify endpoint returns 403 and refuses to process PHI.
RISK_STRAT_BAA_CONFIRMED=false

# NIM (NVIDIA Inference Microservice) endpoint configuration.
# Leave NIM_URL and NIM_API_KEY empty to run in deterministic/mock mode.
RISK_STRAT_NIM_URL=
RISK_STRAT_NIM_API_KEY=
RISK_STRAT_NIM_MODEL=

# NIM request behavior
RISK_STRAT_NIM_TIMEOUT_SECONDS=30
RISK_STRAT_NIM_MAX_RETRIES=3
RISK_STRAT_NIM_RETRY_BASE_DELAY=1.0
