# HIPAA Compliance Validator configuration
# Copy this file to `.env` and fill in real values before running.
#
# IMPORTANT: HIPAA_ENCRYPTION_PASSWORD and HIPAA_ENCRYPTION_SALT are REQUIRED.
# There are no hardcoded defaults. The service will refuse to start without them.
# Once set, the same password and salt must be reused to decrypt existing data.
# Rotating either value requires re-encrypting previously encrypted PHI.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HIPAA_ENCRYPTION_PASSWORD=<required, generate with: python -c "import secrets; print(secrets.token_urlsafe(32))">

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(16))"
HIPAA_ENCRYPTION_SALT=<required, generate with: python -c "import secrets; print(secrets.token_urlsafe(16))">

# SQLite database path for audit logs, violations, and assessments.
HIPAA_DB_PATH=./data/hipaa_compliance.db
