# Deslop SaaS environment configuration
# Copy to .env and edit as needed.

# LLM endpoint for the /regen endpoint (Ollama or OpenAI-compatible chat completions URL).
DESLOP_LLM_ENDPOINT=http://localhost:11434

# LLM model name to use for regeneration.
DESLOP_LLM_MODEL=llama3

# Optional: API keys for authenticated LLM providers.
# OPENAI_API_KEY=
# OLLAMA_API_KEY=
