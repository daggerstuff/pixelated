{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "astro": true,
  "entry": [
    "astro.config.mjs",
    "src/content.config.ts",
    "src/middleware.ts",
    "src/server.ts",
    "src/server.prod.ts",
    "src/config/instrument.mjs",
    "config/instrument.mjs",
    "src/pages/**/*.astro",
    "src/pages/**/*.ts",
    "src/main.js",
    "src/client-entry.js",
    "src/client-inject.js",
    "src/client-polyfills.js",
    "src/toolbar-init.ts",
    "src/consts.ts",
    "src/types.ts",
    "src/config.ts",
    "src/hello.js",
    "src/sentry.client.config.ts",
    "src/sentry.server.config.ts",
    "src/lib/governance/policy-engine.ts",
    "src/lib/middleware/csrf.ts",
    "src/lib/research/services/*.ts",
    "src/lib/fhe/exports.ts",
    "src/lib/fhe/operations.ts",
    "src/utils/offline/offlineManager.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,js,jsx,astro}",
    "config/**/*.{ts,js,mjs}",
    "frontend/src/**/*.{ts,tsx,js,jsx}",
    "business-strategy-cms/src/**/*.{ts,tsx,js,jsx}"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.astro/**",
    "**/*.d.ts",
    "**/__tests__/**",
    "**/*.test.{ts,tsx,js,jsx}",
    "**/*.spec.{ts,tsx,js,jsx}",
    "**/*.generated.*",
    "src/scripts/**",
    "scripts/**",
    "docker/**",
    "k8s/**",
    "src/lib/governance/policy-engine.ts",
    "src/lib/middleware/csrf.ts",
    "src/lib/research/services/*.ts",
    "src/lib/auth/index.ts",
    "src/lib/ehr-native/types/*.ts",
    "src/lib/ehr-native/types/**/*.ts"
  ]
}