{
  "name": "@pixelated-empathy/auto-sdk",
  "version": "1.0.0",
  "description": "Auto-generated TypeScript SDK for the Pixelated Empathy API (generated from OpenAPI spec)",
  "keywords": [
    "api",
    "auto-generated",
    "empathy",
    "openapi",
    "pixelated",
    "sdk"
  ],
  "license": "MIT",
  "author": "Pixelated Empathy",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist generated",
    "generate": "../../scripts/ci/generate-sdks.sh"
  },
  "devDependencies": {
    "typescript": "~5.7.3"
  }
}
