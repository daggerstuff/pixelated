{
  "hooks": {
    "toolUseHook": {
      "event": "toolUse",
      "matcher": { "tool": "bash" },
      "timeoutSec": 30,
      "permissionDecision": "allow",
      "command": {
        "bash": "echo 'shell command allowed'"
      }
    },
    "postWriteHook": {
      "event": "postToolUse",
      "matcher": { "tool": "write" },
      "timeoutSec": 60,
      "command": {
        "bash": "echo 'post-write hook triggered'"
      }
    }
  }
}
