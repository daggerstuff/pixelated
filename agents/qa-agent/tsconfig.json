{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/lib/*": ["../../src/lib/*"],
      "eve": ["../../.eve/types/eve-modules.d.ts"],
      "eve/*": ["../../.eve/types/eve-modules.d.ts"]
    }
  },
  "include": ["agent/**/*.ts", "evals/**/*.ts", ".eve/**/*.d.ts"]
}
