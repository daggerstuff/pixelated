# intake-agent runtime env template — Cloudflare Workers AI path.
# Copy to `.env` (gitignored, mode 600) and fill in real values.
#
# Backend secrets (WANDB_API_KEY, R2_*, OVHAI_* tokens, HF_TOKEN) MUST NOT
# appear here or in ANY agent env: they live only in the training-infra MCP's
# own `ai/training/mcp/.env` and are injected server-side at job launch. This
# agent does not call the MCP.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_KEY=
EVE_AUTH_USERNAME=admin
EVE_AUTH_PASSWORD=
FORESIGHT_URL=http://127.0.0.1:8764/mcp
WORKERS_AI_AGENT_MODEL=@cf/zai-org/glm-5.2
NODE_ENV=production
