# Pixelated Empathy Agent Fleet — environment for agents/deploy/docker-compose.yaml
#
# Copy to .env.agents in this directory, fill in the real values, and never
# commit it (.env* is gitignored). `docker compose up` reads this file for
# every agent service.

# --- Inbound + outbound auth (eve HTTP Basic) -------------------------------
# Authenticates inbound sessions to each agent, and the supervisor's dispatch
# to its remote subagents. Leave blank for local work: unset means inbound
# answers 401 and outbound sends no Authorization header. There is no built-in
# default credential to fall back on.
EVE_AUTH_USERNAME=
EVE_AUTH_PASSWORD=

# --- Model access (Cloudflare Workers AI) ----------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_KEY=
# WORKERS_AI_AGENT_MODEL=
# WORKERS_AI_EVAL_MODEL=

# --- Foresight memory MCP (streamable HTTP) --------------------------------
# Agents reach Foresight over the Compose network by service name.
FORESIGHT_URL=http://foresight:8764/mcp

# --- session-agent persistence ---------------------------------------------
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=pixelated_empathy

# --- supervisor subagent endpoints -----------------------------------------
# Inside the Compose network each agent answers on its container port 2000;
# the host port map (2005, 2010, ...) only matters for callers outside it.
ADVISOR_AGENT_URL=http://advisor-agent:2000
CONTENT_AGENT_URL=http://content-agent:2000
EVE_AGENT_URL=http://eve-agent:2000
INTAKE_AGENT_URL=http://intake-agent:2000
PIPELINE_AGENT_URL=http://pipeline-agent:2000
QA_AGENT_URL=http://qa-agent:2000
SESSION_AGENT_URL=http://session-agent:2000

# --- Optional integrations -------------------------------------------------
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# LINEAR_AGENT_ACCESS_TOKEN=
# AI_GATEWAY_API_KEY=
