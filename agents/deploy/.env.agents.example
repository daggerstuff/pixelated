# Pixelated Empathy Agent Fleet — environment for agents/deploy/docker-compose.yaml
#
# Copy to .env.agents in this directory, fill in the real values, and never
# commit it (.env* is gitignored). `docker compose up` reads this file for
# every agent service.

# --- Inbound + outbound auth (eve HTTP Basic) -------------------------------
# Authenticates inbound sessions to each agent, and the supervisor's dispatch
# to its remote subagents. Leave blank for local work: unset means inbound
# answers 401 and outbound sends no Authorization header. There is no built-in
# default credential to fall back on.
EVE_AUTH_USERNAME=
EVE_AUTH_PASSWORD=

# --- Model access (Cloudflare Workers AI) ----------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_KEY=
# WORKERS_AI_AGENT_MODEL=
# WORKERS_AI_EVAL_MODEL=

# --- Foresight memory MCP (streamable HTTP) --------------------------------
# Foresight is NOT a service in this compose file. It runs on the host (like
# the training-infra MCP), so containers must reach it through the gateway:
#   FORESIGHT_URL=http://host.docker.internal:8764/mcp
# and every agent that uses it needs
#   extra_hosts: ["host.docker.internal:host-gateway"]
# Pointing this at a Compose service name (for example http://foresight:8764/mcp)
# fails DNS resolution because no such service is defined here.
#
# If you would rather run Foresight inside this Compose project, add a
# `foresight:` service to docker-compose.yaml first, then use its service name.
FORESIGHT_URL=http://host.docker.internal:8764/mcp

# --- training-infra MCP (control plane) ------------------------------------
# The MCP holds the backend secrets (W&B, R2, OVH) and injects them into jobs
# server-side; agents only need the URL and the shared bearer token. Set the
# token to the same value as TRAINING_INFRA_MCP_TOKEN in ai/training/mcp/.env.
#
# The MCP is a host systemd user unit (training-infra-mcp.service), not a
# Compose service. From a container reach it through the host gateway — add
# `extra_hosts: ["host.docker.internal:host-gateway"]` to the agents that use
# it, or point this at the host's LAN address if the unit is remote.
TRAINING_INFRA_MCP_URL=http://host.docker.internal:8766/mcp
TRAINING_INFRA_MCP_TOKEN=

# --- session-agent persistence ---------------------------------------------
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=pixelated_empathy

# --- supervisor subagent endpoints -----------------------------------------
# Inside the Compose network each agent answers on its container port 2000;
# the host port map (2005, 2010, ...) only matters for callers outside it.
ADVISOR_AGENT_URL=http://advisor-agent:2000
CONTENT_AGENT_URL=http://content-agent:2000
EVE_AGENT_URL=http://eve-agent:2000
INTAKE_AGENT_URL=http://intake-agent:2000
PIPELINE_AGENT_URL=http://pipeline-agent:2000
QA_AGENT_URL=http://qa-agent:2000
SESSION_AGENT_URL=http://session-agent:2000

# --- Optional integrations -------------------------------------------------
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# LINEAR_AGENT_ACCESS_TOKEN=
# AI_GATEWAY_API_KEY=
