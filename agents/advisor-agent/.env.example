# advisor-agent runtime env template — Cloudflare Workers AI path.
# Copy to `.env` (gitignored) and fill in real values.
# Backend secrets (OVHAI_TOKEN, WANDB_API_KEY, R2_*, HF_TOKEN) MUST NOT appear
# here or in any agent env: they live only in the training-infra MCP's own
# `.env` and are injected server-side at job launch.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_KEY=
EVE_AUTH_USERNAME=admin
EVE_AUTH_PASSWORD=
FORESIGHT_URL=http://127.0.0.1:8764/mcp
WORKERS_AI_AGENT_MODEL=@cf/zai-org/glm-5.2
NODE_ENV=production

# Training-infra MCP (host systemd unit). The advisor uses it read-only: it may
# validate/propose recipes and read eval gates, never submit jobs. Generate the
# token once and share it with `ai/training/mcp/.env` (see RUNBOOK.md).
TRAINING_INFRA_MCP_URL=http://127.0.0.1:8766/mcp
TRAINING_INFRA_MCP_TOKEN=

# Slack (recipe proposals and review reports)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Channel for training/recipe review output
SLACK_TRAINING_CHANNEL_ID=training-pipeline
