# pipeline-agent environment (copy to .env, mode 600; never commit .env).
#
# The training-infra MCP holds the real fleet secrets (W&B, R2, OVH) and
# injects them server-side into each launched job. This agent only needs the
# MCP URL plus the shared bearer token — never the backend API keys.

# --- training-infra MCP (control plane) ------------------------------------
# Defaults to http://127.0.0.1:8766/mcp when unset.
TRAINING_INFRA_MCP_URL=http://127.0.0.1:8766/mcp
# Must equal TRAINING_INFRA_MCP_TOKEN in ai/training/mcp/.env. Leave blank in
# local development if the MCP runs without auth; set it in any shared env.
TRAINING_INFRA_MCP_TOKEN=

# --- Foresight memory MCP (streamable HTTP) --------------------------------
FORESIGHT_URL=http://127.0.0.1:8764/mcp

# --- Optional integrations (presence-checked by check_pipeline_health) -----
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# LINEAR_AGENT_ACCESS_TOKEN=
