# supervisor-agent runtime env template — Cloudflare Workers AI path.
# Copy to `.env` (gitignored, mode 600) and fill in real values.
#
# Backend secrets (WANDB_API_KEY, R2_*, OVHAI_* tokens, HF_TOKEN) MUST NOT
# appear here or in ANY agent env: they live only in the training-infra MCP's
# own `ai/training/mcp/.env` and are injected server-side at job launch. This
# agent does not call the MCP.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_KEY=
EVE_AUTH_USERNAME=admin
EVE_AUTH_PASSWORD=
FORESIGHT_URL=http://127.0.0.1:8764/mcp
WORKERS_AI_AGENT_MODEL=@cf/zai-org/glm-5.2
NODE_ENV=production

# Slack (fleet status + escalation)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Subagent endpoints. Inside agents/deploy/docker-compose.yaml each agent
# answers on its container port 2000; for host-run agents use 127.0.0.1:<host
# port> instead (advisor 2005, content 2010, ...).
ADVISOR_AGENT_URL=http://127.0.0.1:2005
CONTENT_AGENT_URL=http://127.0.0.1:2010
EVE_AGENT_URL=http://127.0.0.1:2015
INTAKE_AGENT_URL=http://127.0.0.1:2020
PIPELINE_AGENT_URL=http://127.0.0.1:2025
QA_AGENT_URL=http://127.0.0.1:2030
SESSION_AGENT_URL=http://127.0.0.1:2035
