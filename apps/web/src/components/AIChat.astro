---
import AIChatReact from './AIChatReact'

export interface Props {
  availableModels?: import('../lib/ai/models/ai-types').AIModel[]
  showModelSelector?: boolean
  title?: string
  description?: string
}

const {
  availableModels = [
    {
      id: 'meta-llama/llama-3.3-8b-instruct',
      name: 'Llama 2 70B Chat',
    },
  ],
  showModelSelector = true,
  title = 'AI Chat',
  description = 'Interact with our AI assistant powered by the LLM API.',
} = Astro.props
---

<section
  class="w-full max-w-2xl mx-auto transition-colors duration-300"
  aria-label={title || 'AI Chat interface'}
>
  {
    title && (
      <h2 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">
        {title}
      </h2>
    )
  }
  {
    description && (
      <p class="mb-6 text-gray-600 dark:text-gray-400">{description}</p>
    )
  }

  {
    /* ⚡ Bolt: Changed client:load to client:visible to defer hydration until the component enters the viewport, improving initial page load performance. */
  }
  <AIChatReact
    client:visible
    availableModels={availableModels as import('../lib/ai/models/ai-types').AIModel[]}
    {showModelSelector}
  >
    <div
      slot="fallback"
      class="border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 flex h-[500px] items-center justify-center rounded-lg border shadow-lg"
      role="status"
      aria-busy="true"
    >
      <div class="flex flex-col items-center gap-3">
        <div
          class="border-blue-500 h-8 w-8 animate-spin rounded-full border-4 border-t-transparent"
          aria-hidden="true"
        >
        </div>
        <p class="text-gray-500 dark:text-gray-400 font-medium">
          Loading chat interface...
        </p>
      </div>
    </div>
  </AIChatReact>
</section>

<style>
  /* Ensure smooth dark mode transitions */
  :root {
    --transition-duration: 300ms;
  }

  .transition-colors {
    transition:
      background-color var(--transition-duration) ease-in-out,
      color var(--transition-duration) ease-in-out,
      border-color var(--transition-duration) ease-in-out;
  }
</style>
