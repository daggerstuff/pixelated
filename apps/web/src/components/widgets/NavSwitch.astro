---
---

<button
  id="nav-open-button"
  class="op-60 hover:op-100 op-transition inline-flex items-center justify-center md:hidden"
  title="Navigation"
  aria-label="Navigation"
  aria-expanded="false"
  aria-controls="nav-panel"
  type="button"
>
  <div u-i-ri-menu-line></div>
</button>

<div
  id="nav-panel"
  class="z-200 left-5% right-5% w-90% max-h-82vh fixed top-20 flex flex-col gap-5 rounded-lg bg-[var(--c-bg)] px-8 py-6"
>
  <ul>
    <slot name="text" />
  </ul>
  <div class="flex items-center justify-center gap-4">
    <slot name="icon" />
  </div>
</div>

<script>
  import { toggleFadeEffect } from '@/utils/animation'

  document.addEventListener('astro:page-load', (_event: Event) => {
    /* Open nav panel when user click on button */
    const handleBtnClickToOpen = () => {
      toggleFadeEffect('backdrop', true, 'hidden')
      toggleFadeEffect('nav-panel', true, 'hidden')
    }

    const navOpenButton = document.getElementById('nav-open-button')
    navOpenButton?.addEventListener('click', handleBtnClickToOpen)
  })
</script>
