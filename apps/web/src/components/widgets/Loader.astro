---
interface Props {
  style?: string
  class?: string
}

const { style, class: className } = Astro.props

/**
 * Text configuration for Loader.
 * Centralizes strings for easier future i18n implementation.
 */
const TEXT = {
  loading: 'Loading...',
}
---

<div
  {style}
  class={`flex h-full w-full items-center justify-center gap-3 ${className}`}
  role="status"
>
  <span class="sr-only">{TEXT.loading}</span>
  <div
    aria-hidden="true"
    class="h-4 w-4 animate-[dot-pulse_1.5s_ease-in-out_both_infinite] rounded-full bg-[#88888850]"
  ></div>
  <div
    aria-hidden="true"
    class="h-4 w-4 animate-[dot-pulse_1.5s_ease-in-out_both_infinite_0.16s] rounded-full bg-[#88888850]"
  ></div>
  <div
    aria-hidden="true"
    class="h-4 w-4 animate-[dot-pulse_1.5s_ease-in-out_both_infinite_0.32s] rounded-full bg-[#88888850]"
  ></div>
</div>

<style>
  @keyframes dot-pulse {
    0%,
    80%,
    100% {
      transform: scale(0);
    }
    40% {
      transform: scale(1);
    }
  }
</style>
