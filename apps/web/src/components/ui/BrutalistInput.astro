---
/**
 * Brutalist Form Components
 * Minimal, accessible, brutalist styling
 */

export interface InputProps {
  type?: 'text' | 'email' | 'password' | 'number' | 'tel' | 'url'
  name: string
  label: string
  placeholder?: string
  required?: boolean
  disabled?: boolean
  error?: string
  id?: string
}

export interface TextareaProps {
  name: string
  label: string
  placeholder?: string
  required?: boolean
  disabled?: boolean
  error?: string
  rows?: number
  id?: string
}

export interface SelectProps {
  name: string
  label: string
  options: Array<{ value: string; label: string }>
  required?: boolean
  disabled?: boolean
  error?: string
  id?: string
}
---

<!-- Input Component -->
<fragment>
  <div class="form-group">
    <label
      class="label"
      for={(Astro.props as any).id || (Astro.props as any).name}
    >
      {(Astro.props as any).label}
      {(Astro.props as any).required && <span class="text-accent ml-1">*</span>}
    </label>
    <input
      type={(Astro.props as any).type || 'text'}
      name={(Astro.props as any).name}
      id={(Astro.props as any).id || (Astro.props as any).name}
      placeholder={(Astro.props as any).placeholder}
      required={(Astro.props as any).required}
      disabled={(Astro.props as any).disabled}
      class:list={['input', (Astro.props as any).error && 'input-error']}
    />
    {
      (Astro.props as any).error && (
        <span class="form-error">{(Astro.props as any).error}</span>
      )
    }
  </div>
</fragment>

<style>
  .form-group {
    margin-bottom: var(--spacing-5);
  }

  .input-error {
    border-color: var(--color-danger);
  }

  .input-error:focus {
    border-color: var(--color-danger);
    box-shadow: 0 0 0 2px rgba(255, 68, 68, 0.1);
  }

  .form-error {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-danger);
    margin-top: var(--spacing-2);
  }
</style>
