---
// TransferAuditLog.astro
// Component for tracking and displaying data transfer audit logs
import SafeIcon from '../ui/SafeIcon.astro'
function formatDate(dateInput: any, options: any = {}) {
  if (!dateInput) return '-'
  const date = new Date(dateInput)
  const defaultOptions = {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  } as any
  return date.toLocaleDateString('en-US', { ...defaultOptions, ...options })
}

interface Props {
  title?: string
}

const { title = 'Data Transfer Audit Log' } = Astro.props

// Sample audit log entries for demonstration
const auditLogEntries = [
  {
    id: 'log-001',
    timestamp: '2025-07-15T14:32:45Z',
    patientId: process.env['PATIENT_ID'] || 'example-patient-id',
    initiatedBy: 'Dr. Sarah Johnson',
    recipientType: 'Healthcare Provider',
    recipientDetails: 'Northwest Medical Center',
    dataFormat: 'FHIR',
    sections: ['Patient Profile', 'Mental Health Data'],
    status: 'completed',
    encryptionVerified: true,
  },
  {
    id: 'log-002',
    timestamp: '2025-07-14T09:15:21Z',
    patientId: process.env['PATIENT_ID'] || 'example-patient-id',
    initiatedBy: 'Dr. James Wilson',
    recipientType: 'Patient Direct Access',
    recipientDetails: 'Patient Email',
    dataFormat: 'JSON',
    sections: ['Patient Profile', 'Chat History', 'Consent Records'],
    status: 'completed',
    encryptionVerified: true,
  },
  {
    id: 'log-003',
    timestamp: '2025-07-13T16:45:09Z',
    patientId: process.env['PATIENT_ID'] || 'example-patient-id',
    initiatedBy: 'Dr. Lisa Chen',
    recipientType: 'Research Institution',
    recipientDetails: 'University Medical Research',
    dataFormat: 'CSV',
    sections: ['Mental Health Data'],
    status: 'completed',
    encryptionVerified: true,
  },
  {
    id: 'log-004',
    timestamp: '2025-07-12T11:23:54Z',
    patientId: process.env['PATIENT_ID'] || 'example-patient-id',
    initiatedBy: 'Dr. Sarah Johnson',
    recipientType: 'Healthcare Provider',
    recipientDetails: 'Eastside Clinic',
    dataFormat: 'CCD',
    sections: ['Patient Profile', 'Mental Health Data', 'Chat History'],
    status: 'failed',
    encryptionVerified: false,
    failureReason: 'Encryption verification failed',
  },
  {
    id: 'log-005',
    timestamp: '2025-07-10T08:12:37Z',
    patientId: process.env['PATIENT_ID'] || 'example-patient-id',
    initiatedBy: 'System Administrator',
    recipientType: 'Patient Direct Access',
    recipientDetails: 'Patient Portal',
    dataFormat: 'JSON',
    sections: ['Patient Profile', 'Consent Records'],
    status: 'completed',
    encryptionVerified: true,
  },
]

// Get status class for color coding
const getStatusClass = (status: string) => {
  switch (status) {
    case 'completed':
      return 'bg-secondary border border-input text-foreground'
    case 'failed':
      return 'text-foreground font-semibold bg-card border border-ring font-semibold'
    case 'in-progress':
      return 'bg-secondary border border-input text-foreground'
    default:
      return 'text-foreground bg-secondary'
  }
}

// Get encryption verification class
const getEncryptionClass = (verified: boolean) => {
  return verified
    ? 'text-foreground'
    : 'text-foreground font-semibold font-semibold'
}
---

<div class="bg-card rounded-none overflow-hidden">
  <div class="p-6">
    <h2 class="text-2xl font-bold text-foreground mb-4">
      {title}
    </h2>

    <div class="mb-8">
      <p class="text-muted-foreground mb-4">
        Complete audit trail of all data transfers, including timestamps,
        recipient information, and encryption verification. All data transfer
        activities are logged for compliance with HIPAA regulations.
      </p>

      <!-- Filter and Search Controls -->
      <div class="flex flex-col md:flex-row gap-4 mb-6">
        <div class="flex-1">
          <label for="search" class="sr-only">Search</label>
          <div class="relative">
            <div
              class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none"
            >
              <SafeIcon name="search" class="w-5 h-5 text-muted-foreground" />
            </div>
            <input
              type="search"
              id="search"
              class="block w-full p-2 pl-10 text-sm text-foreground border border-input rounded-none bg-secondary focus:ring-ring focus:border-ring bg-popover"
              placeholder="Search by patient ID, provider..."
            />
          </div>
        </div>

        <div class="w-full md:w-auto flex flex-col md:flex-row gap-2">
          <select
            id="status-filter"
            class="bg-secondary border border-input text-foreground text-sm rounded-none focus:ring-ring focus:border-ring block p-2 border border-input"
          >
            <option value="">All Statuses</option>
            <option value="completed">Completed</option>
            <option value="failed">Failed</option>
            <option value="in-progress">In Progress</option>
          </select>

          <select
            id="date-filter"
            class="bg-secondary border border-input text-foreground text-sm rounded-none focus:ring-ring focus:border-ring block p-2 border border-input"
          >
            <option value="7">Last 7 Days</option>
            <option value="30">Last 30 Days</option>
            <option value="90">Last 90 Days</option>
            <option value="all">All Time</option>
          </select>

          <button
            type="button"
            class="text-primary-foreground bg-primary hover:bg-accent focus:ring-4 focus:ring-ring font-medium rounded-none text-sm px-5 py-2 focus:outline-none"
          >
            Apply Filters
          </button>
        </div>
      </div>
    </div>

    <!-- Audit Log Table -->
    <div class="overflow-x-auto relative sm:rounded-none">
      <table class="w-full text-sm text-left text-muted-foreground">
        <thead class="text-xs text-foreground uppercase bg-secondary">
          <tr>
            <th scope="col" class="py-3 px-4">Timestamp</th>
            <th scope="col" class="py-3 px-4">Patient ID</th>
            <th scope="col" class="py-3 px-4">Initiated By</th>
            <th scope="col" class="py-3 px-4">Recipient</th>
            <th scope="col" class="py-3 px-4">Format</th>
            <th scope="col" class="py-3 px-4">Status</th>
            <th scope="col" class="py-3 px-4">Encryption</th>
            <th scope="col" class="py-3 px-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          {
            auditLogEntries.map((entry) => (
              <tr class="bg-card border-b hover:bg-secondary">
                <td class="py-3 px-4 font-medium text-foreground whitespace-nowrap">
                  {formatDate(entry.timestamp, {
                    month: 'short',
                    hour: '2-digit',
                    minute: '2-digit',
                  })}
                </td>
                <td class="py-3 px-4">{entry.patientId}</td>
                <td class="py-3 px-4">{entry.initiatedBy}</td>
                <td class="py-3 px-4">
                  <div>
                    <div class="font-medium">{entry.recipientType}</div>
                    <div class="text-xs text-muted-foreground">
                      {entry.recipientDetails}
                    </div>
                  </div>
                </td>
                <td class="py-3 px-4">{entry.dataFormat}</td>
                <td class="py-3 px-4">
                  <span
                    class={`px-2 py-1 rounded-none text-xs font-medium ${getStatusClass(entry.status)}`}
                  >
                    {entry.status.charAt(0).toUpperCase() +
                      entry.status.slice(1)}
                  </span>
                </td>
                <td class="py-3 px-4">
                  <div
                    class={`flex items-center ${getEncryptionClass(entry.encryptionVerified)}`}
                  >
                    {entry.encryptionVerified ? (
                      <span class="flex items-center">
                        <SafeIcon name="check-circle" class="w-4 h-4 mr-1" />
                        Verified
                      </span>
                    ) : (
                      <span class="flex items-center">
                        <SafeIcon name="x-circle" class="w-4 h-4 mr-1" />
                        Failed
                      </span>
                    )}
                  </div>
                </td>
                <td class="py-3 px-4">
                  <div class="flex space-x-2">
                    <button
                      type="button"
                      class="font-medium text-foreground hover:underline"
                      aria-label="View details"
                    >
                      <SafeIcon name="eye" class="w-5 h-5" />
                    </button>
                    <button
                      type="button"
                      class="font-medium text-muted-foreground hover:underline"
                      aria-label="Download report"
                    >
                      <SafeIcon name="download" class="w-5 h-5" />
                    </button>
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <!-- Pagination -->
      <div class="flex justify-between items-center pt-4 px-2">
        <div class="text-sm text-foreground">
          Showing <span class="font-medium">1</span> to <span
            class="font-medium">5</span
          > of <span class="font-medium">25</span> entries
        </div>
        <div class="flex space-x-1">
          <button
            type="button"
            class="px-3 py-1 border border-input rounded-none text-sm font-medium text-foreground hover:bg-secondary border border-input hover:bg-accent"
          >
            Previous
          </button>
          <button
            type="button"
            class="px-3 py-1 border border-input rounded-none text-sm font-medium text-foreground bg-secondary"
          >
            1
          </button>
          <button
            type="button"
            class="px-3 py-1 border border-input rounded-none text-sm font-medium text-foreground hover:bg-secondary border border-input hover:bg-accent"
          >
            2
          </button>
          <button
            type="button"
            class="px-3 py-1 border border-input rounded-none text-sm font-medium text-foreground hover:bg-secondary border border-input hover:bg-accent"
          >
            Next
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Initialize filters and search functionality
  document.addEventListener('DOMContentLoaded', (_event: Event) => {
    const searchInput = document.getElementById('search')
    const statusFilter = document.getElementById('status-filter')
    const dateFilter = document.getElementById('date-filter')

    // In a real implementation, these would filter the table data
    // For demonstration purposes, we'll just log the filter changes

    if (searchInput) {
      searchInput.addEventListener('input', (e: Event) => {
        const searchTerm = (e.target as HTMLInputElement).value
      })
    }

    if (statusFilter) {
      statusFilter.addEventListener('change', (e: Event) => {
        const status = (e.target as HTMLSelectElement).value
      })
    }

    if (dateFilter) {
      dateFilter.addEventListener('change', (e: Event) => {
        const days = (e.target as HTMLSelectElement).value
      })
    }
  })
</script>
