---
/**
 * AI Performance Dashboard — admin island wrapper.
 * Renders the real React dashboard that fetches live metrics from
 * /api/ai/performance-metrics (replaces the previous static placeholder).
 */
import PerformanceDashboard from './PerformanceDashboard'

export interface Props {
  initialTimeRange?: '1h' | '24h' | '7d' | '30d'
  refreshIntervalMs?: number
}

const { initialTimeRange = '24h', refreshIntervalMs } = Astro.props
---

<PerformanceDashboard
  client:load
  initialTimeRange={initialTimeRange}
  refreshIntervalMs={refreshIntervalMs}
/>
