---
/**
 * AI Performance Dashboard
 *
 * Displays AI model performance metrics with time range and model filters,
 * metric cards, an SVG performance-over-time chart, and a model comparison table.
 * Data is fetched from /api/admin/ai-performance and auto-refreshes every 30s.
 *
 * @see /api/admin/ai-performance.ts
 */

// Set cache headers to improve client caching
export const cacheControl = {
  maxAge: 60, // Cache for 1 minute on client
  staleWhileRevalidate: 600, // Allow stale content while revalidating for 10 minutes
}
---

<div
  class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 performance-dashboard"
  data-performance-dashboard
>
  <!-- Screen reader announcement region -->
  <div class="sr-only" data-aria-status role="status" aria-live="polite"></div>

  <!-- Header + Filters -->
  <div
    class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-center sm:justify-between"
  >
    <h2 class="text-2xl font-bold text-gray-800 dark:text-white">
      AI Performance Dashboard
    </h2>
    <div class="flex flex-wrap gap-3">
      <!-- Time Range Selector -->
      <div class="flex flex-col gap-1">
        <label
          for="perf-time-range"
          class="text-sm font-medium text-gray-600 dark:text-gray-400"
          >Time Range</label
        >
        <select
          id="perf-time-range"
          class="rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 px-3 py-2 text-sm text-gray-800 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none"
          aria-label="Select time range for metrics"
        >
          <option value="24h">Last 24 hours</option>
          <option value="7d" selected>Last 7 days</option>
          <option value="30d">Last 30 days</option>
          <option value="90d">Last 90 days</option>
        </select>
      </div>

      <!-- Model Filter -->
      <div class="flex flex-col gap-1">
        <label
          for="perf-model-filter"
          class="text-sm font-medium text-gray-600 dark:text-gray-400"
          >Model</label
        >
        <select
          id="perf-model-filter"
          class="rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 px-3 py-2 text-sm text-gray-800 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none"
          aria-label="Filter metrics by AI model"
        >
          <option value="">All Models</option>
          <option value="Mixtral-8x7B">Mixtral-8x7B</option>
          <option value="Llama-3-70B">Llama-3-70B</option>
          <option value="Qwen-1.5-72B">Qwen-1.5-72B</option>
        </select>
      </div>

      <!-- Refresh indicator -->
      <div class="flex flex-col gap-1">
        <span class="text-sm font-medium text-gray-600 dark:text-gray-400"
          >Auto-refresh</span
        >
        <div class="flex items-center gap-2 h-[38px]">
          <span
            class="inline-block w-2 h-2 rounded-full bg-green-500 dark:bg-green-400 refresh-indicator"
            aria-hidden="true"></span>
          <span class="text-sm text-gray-500 dark:text-gray-400 refresh-timer"
            >30s</span
          >
        </div>
      </div>
    </div>
  </div>

  <!-- Error Banner (hidden by default) -->
  <div
    class="hidden mb-4 p-4 rounded-lg bg-red-50 dark:bg-red-900 border border-red-200 dark:border-red-700 error-banner"
    role="alert"
    aria-live="assertive"
  >
    <div class="flex items-start gap-3">
      <svg
        class="w-5 h-5 text-red-500 dark:text-red-400 flex-shrink-0 mt-0.5"
        fill="currentColor"
        viewBox="0 0 20 20"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
          clip-rule="evenodd"></path>
      </svg>
      <div>
        <p class="font-medium text-red-800 dark:text-red-200">
          Failed to load performance data
        </p>
        <p class="text-sm text-red-600 dark:text-red-300 error-message"></p>
      </div>
    </div>
  </div>

  <!-- Metric Cards -->
  <div
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8 metric-cards"
  >
    <!-- Requests -->
    <div
      class="bg-blue-50 dark:bg-blue-900/30 p-4 rounded-lg transition-all metric-card"
      data-metric="requests"
    >
      <h3 class="text-lg font-medium mb-2 text-blue-700 dark:text-blue-300">
        Requests
      </h3>
      <p
        class="text-3xl font-bold text-blue-800 dark:text-blue-200 metric-value"
      >
        <span class="skeleton-text">—</span>
      </p>
      <p class="text-sm text-gray-500 dark:text-gray-400 metric-period">—</p>
      <div
        class="mt-2 h-1 w-full bg-blue-100 dark:bg-blue-800/50 rounded-full overflow-hidden"
      >
        <div
          class="h-1 bg-blue-500 dark:bg-blue-400 rounded-full transition-all duration-500 metric-bar"
          style="width: 0%;"
        >
        </div>
      </div>
    </div>

    <!-- Avg Response Time -->
    <div
      class="bg-green-50 dark:bg-green-900/30 p-4 rounded-lg transition-all metric-card"
      data-metric="responseTime"
    >
      <h3 class="text-lg font-medium mb-2 text-green-700 dark:text-green-300">
        Avg Response Time
      </h3>
      <p
        class="text-3xl font-bold text-green-800 dark:text-green-200 metric-value"
      >
        <span class="skeleton-text">—</span>
      </p>
      <p class="text-sm text-gray-500 dark:text-gray-400 metric-period">—</p>
      <div
        class="mt-2 h-1 w-full bg-green-100 dark:bg-green-800/50 rounded-full overflow-hidden"
      >
        <div
          class="h-1 bg-green-500 dark:bg-green-400 rounded-full transition-all duration-500 metric-bar"
          style="width: 0%;"
        >
        </div>
      </div>
    </div>

    <!-- Token Usage -->
    <div
      class="bg-purple-50 dark:bg-purple-900/30 p-4 rounded-lg transition-all metric-card"
      data-metric="tokens"
    >
      <h3 class="text-lg font-medium mb-2 text-purple-700 dark:text-purple-300">
        Token Usage
      </h3>
      <p
        class="text-3xl font-bold text-purple-800 dark:text-purple-200 metric-value"
      >
        <span class="skeleton-text">—</span>
      </p>
      <p class="text-sm text-gray-500 dark:text-gray-400 metric-period">—</p>
      <div
        class="mt-2 h-1 w-full bg-purple-100 dark:bg-purple-800/50 rounded-full overflow-hidden"
      >
        <div
          class="h-1 bg-purple-500 dark:bg-purple-400 rounded-full transition-all duration-500 metric-bar"
          style="width: 0%;"
        >
        </div>
      </div>
    </div>

    <!-- Success Rate -->
    <div
      class="bg-amber-50 dark:bg-amber-900/30 p-4 rounded-lg transition-all metric-card"
      data-metric="successRate"
    >
      <h3 class="text-lg font-medium mb-2 text-amber-700 dark:text-amber-300">
        Success Rate
      </h3>
      <p
        class="text-3xl font-bold text-amber-800 dark:text-amber-200 metric-value"
      >
        <span class="skeleton-text">—</span>
      </p>
      <p class="text-sm text-gray-500 dark:text-gray-400 metric-period">—</p>
      <div
        class="mt-2 h-1 w-full bg-amber-100 dark:bg-amber-800/50 rounded-full overflow-hidden"
      >
        <div
          class="h-1 bg-amber-500 dark:bg-amber-400 rounded-full transition-all duration-500 metric-bar"
          style="width: 0%;"
        >
        </div>
      </div>
    </div>
  </div>

  <!-- Performance Over Time Chart -->
  <div class="mb-8">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-xl font-bold text-gray-800 dark:text-white">
        Performance Over Time
      </h3>
      <!-- Chart legend -->
      <div class="flex flex-wrap gap-4 text-sm" id="chart-legend">
        <span class="flex items-center gap-2 text-gray-600 dark:text-gray-400">
          <span
            class="inline-block w-3 h-3 rounded-full bg-blue-500 dark:bg-blue-400"
          ></span>
          Requests
        </span>
        <span class="flex items-center gap-2 text-gray-600 dark:text-gray-400">
          <span
            class="inline-block w-3 h-3 rounded-full bg-green-500 dark:bg-green-400"
          ></span>
          Response Time (ms)
        </span>
        <span class="flex items-center gap-2 text-gray-600 dark:text-gray-400">
          <span
            class="inline-block w-3 h-3 rounded-full bg-purple-500 dark:bg-purple-400"
          ></span>
          Tokens
        </span>
      </div>
    </div>
    <div
      class="h-64 bg-gray-50 dark:bg-gray-700/30 rounded-lg relative overflow-hidden chart-container"
    >
      <!-- Skeleton (shown on load) -->
      <div
        class="skeleton-chart absolute inset-0 flex items-center justify-center"
        data-skeleton
      >
        <div class="w-full px-4 flex flex-col gap-3">
          <div class="skeleton-line"></div>
          <div class="skeleton-line"></div>
          <div class="skeleton-line"></div>
          <div class="skeleton-line"></div>
        </div>
      </div>
      <!-- SVG chart (rendered by JS) -->
      <svg
        class="w-full h-full absolute inset-0 hidden perf-chart-svg"
        data-perf-chart
        preserveAspectRatio="none"
        role="img"
        aria-label="Performance metrics over time chart"
      >
      </svg>
      <p class="text-gray-500 dark:text-gray-400 sr-only" data-chart-sr>
        Loading chart data...
      </p>
    </div>
  </div>

  <!-- Model Comparison Table -->
  <div>
    <h3 class="text-xl font-bold mb-4 text-gray-800 dark:text-white">
      Model Comparison
    </h3>
    <div class="overflow-x-auto">
      <table
        class="min-w-full bg-white dark:bg-gray-800 border-collapse model-comparison-table"
      >
        <thead>
          <tr class="bg-gray-100 dark:bg-gray-700">
            <th
              scope="col"
              class="py-3 px-4 text-left text-gray-700 dark:text-gray-300"
              >Model</th
            >
            <th
              scope="col"
              class="py-3 px-4 text-left text-gray-700 dark:text-gray-300"
              >Avg Response Time</th
            >
            <th
              scope="col"
              class="py-3 px-4 text-left text-gray-700 dark:text-gray-300"
              >Tokens/Request</th
            >
            <th
              scope="col"
              class="py-3 px-4 text-left text-gray-700 dark:text-gray-300"
              >Success Rate</th
            >
            <th
              scope="col"
              class="py-3 px-4 text-left text-gray-700 dark:text-gray-300"
              >Total Requests</th
            >
          </tr>
        </thead>
        <tbody data-model-table-body>
          <!-- Skeleton rows -->
          <tr
            class="border-b border-gray-200 dark:border-gray-700 skeleton-row"
          >
            <td class="py-3 px-4 text-gray-800 dark:text-gray-300">
              <span class="skeleton-text">Loading…</span>
            </td>
            <td class="py-3 px-4 text-gray-800 dark:text-gray-300">
              <span class="skeleton-text">—</span>
            </td>
            <td class="py-3 px-4 text-gray-800 dark:text-gray-300">
              <span class="skeleton-text">—</span>
            </td>
            <td class="py-3 px-4 text-gray-800 dark:text-gray-300">
              <span class="skeleton-text">—</span>
            </td>
            <td class="py-3 px-4 text-gray-800 dark:text-gray-300">
              <span class="skeleton-text">—</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  .performance-dashboard {
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .skeleton-text {
    display: inline-block;
    min-width: 2rem;
    color: transparent;
    background: linear-gradient(90deg, #e0e0e0 25%, #d0d0d0 50%, #e0e0e0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    border-radius: 4px;
    padding: 0 4px;
  }

  .skeleton-row .skeleton-text {
    min-width: 4rem;
  }

  :global(.dark) .skeleton-text {
    background: linear-gradient(90deg, #303030 25%, #404040 50%, #303030 75%);
    background-size: 200% 100%;
  }

  .skeleton-chart .skeleton-line {
    height: 12px;
    border-radius: 6px;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }

  .skeleton-chart .skeleton-line:nth-child(1) {
    width: 85%;
  }
  .skeleton-chart .skeleton-line:nth-child(2) {
    width: 70%;
  }
  .skeleton-chart .skeleton-line:nth-child(3) {
    width: 90%;
  }
  .skeleton-chart .skeleton-line:nth-child(4) {
    width: 60%;
  }

  :global(.dark) .skeleton-chart .skeleton-line {
    background: linear-gradient(90deg, #303030 25%, #404040 50%, #303030 75%);
    background-size: 200% 100%;
  }

  @keyframes shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  @media (prefers-reduced-motion) {
    .skeleton-text,
    .skeleton-chart .skeleton-line {
      animation: none;
      background: #e0e0e0;
    }

    :global(.dark) .skeleton-text,
    :global(.dark) .skeleton-chart .skeleton-line {
      background: #303030;
    }

    .metric-bar {
      transition: none !important;
    }

    .refresh-indicator {
      animation: none !important;
    }
  }
</style>

<script>
  // ---------------------------------------------------------------------------
  // Types (mirror the API endpoint's response shape)
  // ---------------------------------------------------------------------------
  interface TimeSeriesPoint {
    timestamp: string
    requests: number
    responseTime: number
    tokens: number
    successRate: number
  }

  interface PerformanceSummary {
    totalRequests: number
    averageResponseTime: number
    totalTokens: number
    successRate: number
    period: string
  }

  interface ModelComparison {
    model: string
    avgResponseTime: number
    tokensPerRequest: number
    successRate: number
    totalRequests: number
  }

  interface PerformanceMetricsResponse {
    timestamp: number
    timeRange: string
    model: string | null
    summary: PerformanceSummary
    timeSeries: TimeSeriesPoint[]
    modelComparison: ModelComparison[]
    meta: { requestDuration: number }
  }

  // ---------------------------------------------------------------------------
  // Dashboard state
  // ---------------------------------------------------------------------------
  const REFRESH_INTERVAL_MS = 30_000
  const API_PATH = '/api/admin/ai-performance'

  let refreshTimer: ReturnType<typeof setInterval> | null = null
  let refreshCountdown = REFRESH_INTERVAL_MS / 1000

  // ---------------------------------------------------------------------------
  // DOM helpers
  // ---------------------------------------------------------------------------
  function $<T extends HTMLElement = HTMLElement>(selector: string): T | null {
    return document.querySelector<T>(selector)
  }

  function formatNumber(n: number): string {
    if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M`
    if (n >= 1_000) return `${(n / 1_000).toFixed(1)}K`
    return n.toLocaleString('en-US')
  }

  function formatMs(n: number): string {
    return `${n}ms`
  }

  function formatPercent(n: number): string {
    return `${n.toFixed(1)}%`
  }

  function periodLabel(range: string): string {
    const labels: Record<string, string> = {
      '24h': 'Last 24 hours',
      '7d': 'Last 7 days',
      '30d': 'Last 30 days',
      '90d': 'Last 90 days',
    }
    return labels[range] ?? range
  }

  // ---------------------------------------------------------------------------
  // Error handling
  // ---------------------------------------------------------------------------
  function showError(message: string): void {
    const banner = $('.error-banner')
    const messageEl = $('.error-message')
    if (banner) banner.classList.remove('hidden')
    if (messageEl) messageEl.textContent = message
    announce('Error loading performance data')
  }

  function hideError(): void {
    const banner = $('.error-banner')
    if (banner) banner.classList.add('hidden')
  }

  function announce(text: string): void {
    const el = $('[data-aria-status]')
    if (el) el.textContent = text
  }

  // ---------------------------------------------------------------------------
  // Metric cards
  // ---------------------------------------------------------------------------
  function updateMetricCards(data: PerformanceMetricsResponse): void {
    const s = data.summary

    const cards: Array<{
      selector: string
      value: string
      barWidth: number
    }> = [
      {
        selector: '[data-metric="requests"]',
        value: formatNumber(s.totalRequests),
        barWidth: Math.min(100, (s.totalRequests / 5000) * 100),
      },
      {
        selector: '[data-metric="responseTime"]',
        value: formatMs(s.averageResponseTime),
        barWidth: Math.min(100, (s.averageResponseTime / 500) * 100),
      },
      {
        selector: '[data-metric="tokens"]',
        value: formatNumber(s.totalTokens),
        barWidth: Math.min(100, (s.totalTokens / 5_000_000) * 100),
      },
      {
        selector: '[data-metric="successRate"]',
        value: formatPercent(s.successRate),
        barWidth: s.successRate,
      },
    ]

    for (const card of cards) {
      const el = document.querySelector<HTMLElement>(card.selector)
      if (!el) continue

      const valueEl = el.querySelector('.metric-value')
      if (valueEl) valueEl.textContent = card.value

      const periodEl = el.querySelector('.metric-period')
      if (periodEl) periodEl.textContent = periodLabel(data.timeRange)

      const barEl = el.querySelector<HTMLElement>('.metric-bar')
      if (barEl) barEl.style.width = `${card.barWidth}%`
    }
  }

  // ---------------------------------------------------------------------------
  // Model comparison table
  // ---------------------------------------------------------------------------
  function updateModelTable(models: ModelComparison[]): void {
    const tbody = $('[data-model-table-body]')
    if (!tbody) return

    if (models.length === 0) {
      tbody.innerHTML = `<tr><td colspan="5" class="py-4 px-4 text-center text-gray-500 dark:text-gray-400">No model data available for this filter.</td></tr>`
      return
    }

    tbody.innerHTML = models
      .map(
        (m) => `
      <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-900 transition-colors">
        <td class="py-3 px-4 text-gray-800 dark:text-gray-300">${m.model}</td>
        <td class="py-3 px-4 text-gray-800 dark:text-gray-300">${formatMs(m.avgResponseTime)}</td>
        <td class="py-3 px-4 text-gray-800 dark:text-gray-300">${m.tokensPerRequest.toLocaleString('en-US')}</td>
        <td class="py-3 px-4 text-gray-800 dark:text-gray-300">${formatPercent(m.successRate)}</td>
        <td class="py-3 px-4 text-gray-800 dark:text-gray-300">${m.totalRequests.toLocaleString('en-US')}</td>
      </tr>`,
      )
      .join('')
  }

  // ---------------------------------------------------------------------------
  // SVG Chart rendering
  // ---------------------------------------------------------------------------
  function renderChart(timeSeries: TimeSeriesPoint[]): void {
    const svg = document.querySelector<SVGSVGElement>('[data-perf-chart]')
    const skeleton = document.querySelector<HTMLElement>('[data-skeleton]')
    const srText = $('[data-chart-sr]')

    if (!svg || timeSeries.length === 0) return

    // Hide skeleton, show chart
    if (skeleton) skeleton.style.display = 'none'
    svg.classList.remove('hidden')

    // Get container dimensions
    const container = svg.parentElement
    if (!container) return
    const width = container.clientWidth || 600
    const height = container.clientHeight || 256
    const padding = { top: 20, right: 20, bottom: 30, left: 50 }
    const chartW = width - padding.left - padding.right
    const chartH = height - padding.top - padding.bottom

    svg.setAttribute('viewBox', `0 0 ${width} ${height}`)
    svg.setAttribute('preserveAspectRatio', 'none')

    // Data scales
    const requestsData = timeSeries.map((p) => p.requests)
    const responseData = timeSeries.map((p) => p.responseTime)
    const tokensData = timeSeries.map((p) => p.tokens)

    const maxRequests = Math.max(...requestsData, 1)
    const maxResponse = Math.max(...responseData, 1)
    const maxTokens = Math.max(...tokensData, 1)
    const minRequests = Math.min(...requestsData, 0)
    const minResponse = Math.min(...responseData, 0)
    const minTokens = Math.min(...tokensData, 0)

    const xStep = chartW / Math.max(timeSeries.length - 1, 1)

    // Scale helper: maps value to Y coordinate for a given series range
    function scaleY(value: number, min: number, max: number): number {
      const range = max - min || 1
      return padding.top + chartH - ((value - min) / range) * chartH
    }

    function buildPolyline(data: number[], min: number, max: number): string {
      return data
        .map((value, i) => {
          const x = padding.left + i * xStep
          const y = scaleY(value, min, max)
          return `${x.toFixed(1)},${y.toFixed(1)}`
        })
        .join(' ')
    }

    // Build grid lines (horizontal)
    const gridLines: string[] = []
    for (let i = 0; i <= 4; i++) {
      const y = padding.top + (chartH / 4) * i
      gridLines.push(
        `<line x1="${padding.left}" y1="${y}" x2="${padding.left + chartW}" y2="${y}" stroke="currentColor" stroke-width="0.5" opacity="0.15" />`,
      )
    }

    // Build X-axis labels (first, middle, last timestamps)
    const labelIndices = [
      0,
      Math.floor(timeSeries.length / 2),
      timeSeries.length - 1,
    ]
    const uniqueIndices = [...new Set(labelIndices)]
    const xLabels = uniqueIndices.map((idx) => {
      const point = timeSeries[idx]
      if (!point) return ''
      const x = padding.left + idx * xStep
      const date = new Date(point.timestamp)
      const label = date.toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
      })
      return `<text x="${x}" y="${height - 8}" text-anchor="middle" font-size="10" fill="currentColor" opacity="0.5" class="chart-x-label">${label}</text>`
    })

    // Y-axis labels for requests (left side)
    const yLabels: string[] = []
    for (let i = 0; i <= 4; i++) {
      const value = minRequests + ((maxRequests - minRequests) / 4) * (4 - i)
      const y = padding.top + (chartH / 4) * i
      yLabels.push(
        `<text x="${padding.left - 8}" y="${y + 4}" text-anchor="end" font-size="10" fill="currentColor" opacity="0.5" class="chart-y-label">${formatNumber(Math.round(value))}</text>`,
      )
    }

    // Build SVG content
    const polylineRequests = buildPolyline(
      requestsData,
      minRequests,
      maxRequests,
    )
    const polylineResponse = buildPolyline(
      responseData,
      minResponse,
      maxResponse,
    )
    const polylineTokens = buildPolyline(tokensData, minTokens, maxTokens)

    svg.innerHTML = `
      <g class="chart-grid">
        ${gridLines.join('')}
      </g>
      <g class="chart-axis-labels">
        ${yLabels.join('')}
        ${xLabels.join('')}
      </g>
      <polyline
        points="${polylineRequests}"
        fill="none"
        stroke="#3b82f6"
        stroke-width="2"
        stroke-linejoin="round"
        stroke-linecap="round"
        class="chart-line-requests"
      />
      <polyline
        points="${polylineResponse}"
        fill="none"
        stroke="#22c55e"
        stroke-width="2"
        stroke-linejoin="round"
        stroke-linecap="round"
        class="chart-line-response"
      />
      <polyline
        points="${polylineTokens}"
        fill="none"
        stroke="#a855f7"
        stroke-width="2"
        stroke-linejoin="round"
        stroke-linecap="round"
        class="chart-line-tokens"
      />
    `

    // Dark mode styling
    const isDark = document.documentElement.classList.contains('dark')
    svg.style.color = isDark ? '#d1d5db' : '#374151'

    // Update SR text
    if (srText) {
      const totalReq = timeSeries.reduce((s, p) => s + p.requests, 0)
      const avgResp = Math.round(
        timeSeries.reduce((s, p) => s + p.responseTime, 0) / timeSeries.length,
      )
      srText.textContent = `Chart showing ${timeSeries.length} data points. Total requests: ${totalReq}. Average response time: ${avgResp}ms.`
    }
  }

  // ---------------------------------------------------------------------------
  // Data fetching
  // ---------------------------------------------------------------------------
  async function fetchMetrics(
    timeRange: string,
    model: string,
  ): Promise<PerformanceMetricsResponse> {
    const params = new URLSearchParams({ timeRange })
    if (model) params.set('model', model)

    const response = await fetch(`${API_PATH}?${params.toString()}`)

    if (!response.ok) {
      const body: { error?: string } = await response.json().catch(() => ({}))
      const message =
        body.error ?? `Request failed with status ${response.status}`
      throw new Error(message)
    }

    return (await response.json()) as PerformanceMetricsResponse
  }

  // ---------------------------------------------------------------------------
  // Loading states
  // ---------------------------------------------------------------------------
  function setLoading(isLoading: boolean): void {
    if (!isLoading) return

    // Show skeleton text on metric values
    document.querySelectorAll<HTMLElement>('.metric-value').forEach((el) => {
      el.innerHTML = '<span class="skeleton-text">—</span>'
    })

    // Reset bars
    document.querySelectorAll<HTMLElement>('.metric-bar').forEach((el) => {
      el.style.width = '0%'
    })
  }

  // ---------------------------------------------------------------------------
  // Refresh cycle
  // ---------------------------------------------------------------------------
  function updateRefreshIndicator(): void {
    const timerEl = $('.refresh-timer')
    if (timerEl) timerEl.textContent = `${refreshCountdown}s`
  }

  function startRefreshCountdown(): void {
    refreshCountdown = REFRESH_INTERVAL_MS / 1000
    updateRefreshIndicator()

    if (refreshTimer) clearInterval(refreshTimer)
    refreshTimer = setInterval(() => {
      refreshCountdown--
      if (refreshCountdown <= 0) {
        refreshCountdown = REFRESH_INTERVAL_MS / 1000
        void loadDashboard()
      }
      updateRefreshIndicator()
    }, 1000)
  }

  // ---------------------------------------------------------------------------
  // Main load function
  // ---------------------------------------------------------------------------
  async function loadDashboard(): Promise<void> {
    const timeRangeEl =
      document.querySelector<HTMLSelectElement>('#perf-time-range')
    const modelEl =
      document.querySelector<HTMLSelectElement>('#perf-model-filter')

    const timeRange = timeRangeEl?.value ?? '7d'
    const model = modelEl?.value ?? ''

    setLoading(true)

    try {
      const data = await fetchMetrics(timeRange, model)
      hideError()
      updateMetricCards(data)
      updateModelTable(data.modelComparison)
      renderChart(data.timeSeries)
      announce(`Performance data loaded for ${periodLabel(data.timeRange)}`)
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : 'Unknown error'
      showError(message)
      // Keep skeleton visible on chart on error
    }
  }

  // ---------------------------------------------------------------------------
  // Initialization
  // ---------------------------------------------------------------------------
  function initDashboard(): void {
    const timeRangeEl = $('#perf-time-range')
    const modelEl = $('#perf-model-filter')

    if (timeRangeEl) {
      timeRangeEl.addEventListener('change', () => {
        void loadDashboard()
        startRefreshCountdown()
      })
    }

    if (modelEl) {
      modelEl.addEventListener('change', () => {
        void loadDashboard()
        startRefreshCountdown()
      })
    }

    // Initial load
    void loadDashboard()
    startRefreshCountdown()

    // Refresh on window focus (after being hidden for a while)
    let wasHidden = false
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        wasHidden = true
        if (refreshTimer) {
          clearInterval(refreshTimer)
          refreshTimer = null
        }
      } else if (wasHidden) {
        wasHidden = false
        void loadDashboard()
        startRefreshCountdown()
      }
    })
  }

  // Initialize when DOM is ready (module scripts are deferred, but guard anyway)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDashboard)
  } else {
    initDashboard()
  }
</script>
