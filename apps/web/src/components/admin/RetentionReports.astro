---
// RetentionReports.astro
// Component for generating and exporting data retention compliance reports
import { Icon } from 'astro-icon/components'

interface Props {
  title?: string
}

const { title = 'Data Retention Compliance Reports' } = Astro.props

// Sample report types
const reportTypes = [
  {
    id: 'compliance-summary',
    name: 'Compliance Summary',
    description:
      'Overview of data retention compliance across all data categories',
    format: ['PDF', 'CSV', 'JSON'],
    frequency: 'Monthly',
    lastGenerated: '2025-07-01',
  },
  {
    id: 'retention-details',
    name: 'Retention Policy Details',
    description:
      'Detailed breakdown of all data retention policies and their compliance status',
    format: ['PDF', 'CSV', 'XLSX'],
    frequency: 'Quarterly',
    lastGenerated: '2025-06-15',
  },
  {
    id: 'archiving-report',
    name: 'Archiving Activity',
    description:
      'Report on all archiving operations performed within a specified time period',
    format: ['PDF', 'CSV'],
    frequency: 'Monthly',
    lastGenerated: '2025-07-01',
  },
  {
    id: 'destruction-audit',
    name: 'Data Destruction Audit',
    description:
      'Comprehensive audit of all data destruction activities with compliance verification',
    format: ['PDF', 'CSV', 'XLSX'],
    frequency: 'Quarterly',
    lastGenerated: '2025-06-15',
  },
  {
    id: 'hipaa-compliance',
    name: 'HIPAA Compliance',
    description:
      'Specialized report focusing on HIPAA compliance aspects of data retention',
    format: ['PDF'],
    frequency: 'Annually',
    lastGenerated: '2025-01-15',
  },
]

// Sample schedule data
const schedules = [
  {
    id: 'schedule-001',
    name: 'Monthly Compliance Summary',
    reportType: 'compliance-summary',
    format: 'PDF',
    frequency: 'Monthly',
    day: '1st',
    recipients: ['admin@example.com', 'compliance@example.com'],
    status: 'active',
  },
  {
    id: 'schedule-002',
    name: 'Quarterly Retention Audit',
    reportType: 'retention-details',
    format: 'XLSX',
    frequency: 'Quarterly',
    day: '15th',
    recipients: [
      'admin@example.com',
      'compliance@example.com',
      'ceo@example.com',
    ],
    status: 'active',
  },
]

// Format badge styling
const getFormatBadge = (format: string) => {
  switch (format.toLowerCase()) {
    case 'pdf':
      return 'bg-card border border-ring text-foreground font-medium'
    case 'csv':
      return 'bg-secondary border border-input text-foreground font-medium'
    case 'xlsx':
      return 'bg-secondary border border-input text-foreground font-medium'
    case 'json':
      return 'bg-secondary border border-input text-foreground font-medium'
    default:
      return 'bg-secondary border border-input text-foreground font-medium'
  }
}

// Get status badge styling
const getStatusBadge = (status: string) => {
  switch (status) {
    case 'active':
      return 'bg-secondary border border-input text-foreground font-medium'
    case 'inactive':
      return 'bg-card border border-ring text-foreground font-medium'
    default:
      return 'bg-secondary border border-input text-foreground font-medium'
  }
}
---

<div class="-md overflow-hidden rounded-none bg-card">
  <div class="p-6">
    <h2 class="mb-4 text-2xl font-bold text-foreground">{title}</h2>

    <div class="mb-8">
      <p class="mb-4 text-muted-foreground">
        Generate comprehensive reports for data retention compliance auditing
        and regulatory purposes. Schedule automated report generation and
        distribution to key stakeholders.
      </p>

      <div class="mb-6 flex flex-wrap gap-4">
        <div class="flex items-center rounded-none border border-input bg-secondary p-3">
          <Icon name="file-text" class="mr-2 h-5 w-5 text-foreground" />
          <span class="text-sm font-medium text-foreground">
            Customizable reports
          </span>
        </div>

        <div class="flex items-center rounded-none border border-input bg-secondary p-3">
          <Icon name="calendar" class="mr-2 h-5 w-5 text-foreground" />
          <span class="text-sm font-medium text-foreground">
            Automated scheduling
          </span>
        </div>

        <div class="flex items-center rounded-none border border-input bg-secondary p-3">
          <Icon name="mail" class="mr-2 h-5 w-5 text-foreground" />
          <span class="text-sm text-foreground">Email distribution</span>
        </div>
      </div>
    </div>

    <!-- Report Generation Section -->
    <div class="mb-8">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-lg font-medium text-foreground">Available Reports</h3>
        <button
          type="button"
          class="text-white flex items-center rounded-none bg-primary px-3 py-1.5 text-sm hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
        >
          <Icon name="plus" class="mr-1 h-4 w-4" />
          Create Custom Report
        </button>
      </div>

      <div class="mb-6 grid grid-cols-1 gap-4">
        {reportTypes.map((report) => (
          <div class="rounded-none border border-border bg-card p-4">
            <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
              <div class="flex-1">
                <h4 class="text-base font-medium text-foreground">
                  {report.name}
                </h4>
                <p class="text-sm text-muted-foreground">
                  {report.description}
                </p>
                <div class="mt-2 flex flex-wrap gap-1">
                  {report.format.map((format) => (
                    <span
                      class={`rounded-none px-2 py-0.5 text-xs font-medium ${getFormatBadge(format)}`}
                    >
                      {format}
                    </span>
                  ))}
                </div>
              </div>

              <div class="flex flex-col">
                <div class="mb-2 text-sm text-muted-foreground">
                  <div class="flex items-center gap-1">
                    <Icon name="calendar" class="h-4 w-4" />
                    <span>
                      {report.frequency} | Last: {report.lastGenerated}
                    </span>
                  </div>
                </div>

                <div class="flex gap-2">
                  <button
                    type="button"
                    class="text-white rounded-none bg-primary px-3 py-1 text-xs font-medium hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring"
                  >
                    Generate Now
                  </button>
                  <button
                    type="button"
                    class="rounded-none bg-secondary px-3 py-1 text-xs font-medium text-foreground hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring"
                  >
                    Schedule
                  </button>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Scheduled Reports Section -->
    <div class="mb-8">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-lg font-medium text-foreground">Scheduled Reports</h3>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-muted-foreground">
          <thead class="bg-secondary text-xs uppercase text-foreground">
            <tr>
              <th scope="col" class="px-4 py-3">
                Report Name
              </th>
              <th scope="col" class="px-4 py-3">
                Type
              </th>
              <th scope="col" class="px-4 py-3">
                Format
              </th>
              <th scope="col" class="px-4 py-3">
                Frequency
              </th>
              <th scope="col" class="px-4 py-3">
                Recipients
              </th>
              <th scope="col" class="px-4 py-3">
                Status
              </th>
              <th scope="col" class="px-4 py-3">
                Actions
              </th>
            </tr>
          </thead>
          <tbody>
            {schedules.map((schedule) => (
              <tr class="border-b bg-card hover:bg-secondary">
                <td class="px-4 py-3 font-medium text-foreground">
                  {schedule.name}
                </td>
                <td class="px-4 py-3">
                  {schedule.reportType
                    .replace(/-/g, ' ')
                    .replace(/\b\w/g, (l) => l.toUpperCase())}
                </td>
                <td class="px-4 py-3">
                  <span
                    class={`rounded-none px-2 py-0.5 text-xs font-medium ${getFormatBadge(schedule.format)}`}
                  >
                    {schedule.format}
                  </span>
                </td>
                <td class="px-4 py-3">
                  {schedule.frequency} ({schedule.day})
                </td>
                <td class="px-4 py-3">
                  <div class="flex flex-wrap gap-1">
                    {schedule.recipients.map((recipient, index) =>
                      index < 2 ? (
                        <span class="rounded-none bg-secondary px-2 py-0.5 text-xs font-medium text-foreground">
                          {recipient}
                        </span>
                      ) : index === 2 ? (
                        <span class="rounded-none bg-secondary px-2 py-0.5 text-xs font-medium text-muted-foreground">
                          +{schedule.recipients.length - 2} more
                        </span>
                      ) : null,
                    )}
                  </div>
                </td>
                <td class="px-4 py-3">
                  <span
                    class={`rounded-none px-2 py-0.5 text-xs font-medium ${getStatusBadge(schedule.status)}`}
                  >
                    {schedule.status.charAt(0).toUpperCase() +
                      schedule.status.slice(1)}
                  </span>
                </td>
                <td class="px-4 py-3">
                  <div class="flex space-x-2">
                    <button
                      type="button"
                      class="text-foreground hover:underline"
                      aria-label="Edit schedule"
                    >
                      <Icon name="pencil" class="h-5 w-5" />
                    </button>
                    <button
                      type="button"
                      class="font-medium text-foreground hover:underline"
                      aria-label="Delete schedule"
                    >
                      <Icon name="trash" class="h-5 w-5" />
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Custom Report Generator -->
    <div>
      <h3 class="mb-4 text-lg font-medium text-foreground">
        Custom Report Generator
      </h3>

      <div class="rounded-none border border-border bg-secondary p-5">
        <div class="mb-4 grid grid-cols-1 gap-4 md:grid-cols-2">
          <div class="mb-4">
            <label class="mb-2 block text-sm font-medium text-foreground">
              Report Title
            </label>
            <input
              type="text"
              id="report-title"
              placeholder="Enter report title"
              class="w-full rounded-none border border-input p-2 focus:border-ring focus:ring-2 focus:ring-ring"
            />
          </div>

          <div class="mb-4">
            <label class="mb-2 block text-sm font-medium text-foreground">
              Report Type
            </label>
            <select
              id="report-type"
              class="w-full rounded-none border border-input p-2 focus:border-ring focus:ring-2 focus:ring-ring"
            >
              <option value="">Select a report type</option>
              <option value="compliance-summary">Compliance Summary</option>
              <option value="retention-details">
                Retention Policy Details
              </option>
              <option value="archiving-report">Archiving Activity</option>
              <option value="destruction-audit">Data Destruction Audit</option>
              <option value="hipaa-compliance">HIPAA Compliance</option>
              <option value="custom">Custom Report</option>
            </select>
          </div>

          <div class="mb-4">
            <label class="mb-2 block text-sm font-medium text-foreground">
              Date Range
            </label>
            <div class="flex space-x-2">
              <input
                type="date"
                id="date-from"
                class="w-full rounded-none border border-input p-2 focus:border-ring focus:ring-2 focus:ring-ring"
              />
              <input
                type="date"
                id="date-to"
                class="w-full rounded-none border border-input p-2 focus:border-ring focus:ring-2 focus:ring-ring"
              />
            </div>
          </div>

          <div class="mb-4">
            <label class="mb-2 block text-sm font-medium text-foreground">
              Format
            </label>
            <select
              id="report-format"
              class="w-full rounded-none border border-input p-2 focus:border-ring focus:ring-2 focus:ring-ring"
            >
              <option value="pdf">PDF</option>
              <option value="csv">CSV</option>
              <option value="xlsx">Excel (XLSX)</option>
              <option value="json">JSON</option>
            </select>
          </div>

          <div class="mb-4 md:col-span-2">
            <label class="mb-2 block text-sm font-medium text-foreground">
              Data Categories to Include
            </label>
            <div class="flex flex-wrap gap-3">
              <div class="flex items-center">
                <input
                  type="checkbox"
                  id="include-patient-records"
                  checked
                  class="h-4 w-4 rounded-none border border-input text-foreground focus:ring-ring"
                />
                <label
                  for="include-patient-records"
                  class="ml-2 text-sm text-foreground"
                >
                  Patient Records
                </label>
              </div>

              <div class="flex items-center">
                <input
                  type="checkbox"
                  id="include-mental-health"
                  checked
                  class="h-4 w-4 rounded-none border border-input text-foreground focus:ring-ring"
                />
                <label
                  for="include-mental-health"
                  class="ml-2 text-sm text-foreground"
                >
                  Mental Health Data
                </label>
              </div>

              <div class="flex items-center">
                <input
                  type="checkbox"
                  id="include-chat-logs"
                  checked
                  class="h-4 w-4 rounded-none border border-input text-foreground focus:ring-ring"
                />
                <label
                  for="include-chat-logs"
                  class="ml-2 text-sm text-foreground"
                >
                  Chat Logs
                </label>
              </div>

              <div class="flex items-center">
                <input
                  type="checkbox"
                  id="include-emotion-analysis"
                  checked
                  class="h-4 w-4 rounded-none border border-input text-foreground focus:ring-ring"
                />
                <label
                  for="include-emotion-analysis"
                  class="ml-2 text-sm text-foreground"
                >
                  Emotion Analysis
                </label>
              </div>

              <div class="flex items-center">
                <input
                  type="checkbox"
                  id="include-consent-records"
                  checked
                  class="h-4 w-4 rounded-none border border-input text-foreground focus:ring-ring"
                />
                <label
                  for="include-consent-records"
                  class="ml-2 text-sm text-foreground"
                >
                  Consent Records
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="mt-6 flex gap-3">
          <button
            id="generate-report-btn"
            type="button"
            class="text-white rounded-none bg-primary px-4 py-2 hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
          >
            Generate Report
          </button>
          <button
            type="button"
            class="rounded-none border border-input px-4 py-2 text-foreground hover:bg-secondary focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
          >
            Reset
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', (_event: Event) => {
    // Generate report button handler
    const generateReportBtn = document.getElementById('generate-report-btn')
    if (generateReportBtn) {
      generateReportBtn.addEventListener('click', (_event: Event) => {
        const title =
          (document.getElementById('report-title') as HTMLInputElement)
            ?.value || 'Untitled Report'
        const format = (
          document.getElementById('report-format') as HTMLSelectElement
        )?.value

        // For demonstration, just show an alert
        alert(
          `Generating "${title}" report in ${format.toUpperCase()} format. In a production environment, this would create and download the report.`,
        )
      })
    }

    // Predefined report generation buttons
    const generateNowButtons = document.querySelectorAll(
      'button:not(#generate-report-btn)',
    )
    generateNowButtons.forEach((button) => {
      if (button.textContent?.trim() === 'Generate Now') {
        button.addEventListener('click', (e: Event) => {
          const reportElement = (e.currentTarget as HTMLElement).closest(
            'div[class*="border"]',
          )
          const reportTitle = reportElement?.querySelector('h4')?.textContent

          // For demonstration, just show an alert
          alert(
            `Generating "${reportTitle}" report. In a production environment, this would create and download the report.`,
          )
        })
      }
    })
  })
</script>
