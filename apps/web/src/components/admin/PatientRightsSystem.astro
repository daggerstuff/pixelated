                    <span
                      class={`inline-flex rounded-none px-2 py-1 text-xs font-medium ${getPriorityBadgeClass(request.priority)}`}
                    >
                      {request.priority.toUpperCase()}
                    </span>
                    <div class="text-xs">
                      <span
                        class={
                          slaInfo.status === 'overdue'
                            ? 'font-medium font-semibold text-foreground'
                            : slaInfo.status === 'urgent'
                              ? 'font-medium text-foreground'
                              : 'text-muted-foreground'
                        }
                      >
