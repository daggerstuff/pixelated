                      <Icon name="eye" class="h-4 w-4" />
                    </button>

                    {(request.status === 'pending' ||
                      request.status === 'escalated') && (
                      <button
                        type="button"
                        class="rounded-none p-1 text-muted-foreground hover:bg-secondary hover:text-foreground"
