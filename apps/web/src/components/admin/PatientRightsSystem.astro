                      >
                        <Icon name="check-circle" class="h-4 w-4" />
                      </button>
                    )}

                    {request.status === 'overdue' && (
                      <button
                        type="button"
                        class="rounded-none p-1 font-semibold text-foreground hover:bg-secondary"
                        title="Escalate to Legal"
                      >
                        <Icon name="alert-triangle" class="h-4 w-4" />
                      </button>
                    )}

                    <button
                      type="button"
                      class="rounded-none p-1 text-muted-foreground hover:bg-secondary hover:text-foreground"
                      title="Download Audit Report"
                    >
                      <Icon name="download" class="h-4 w-4" />
                    </button>

                    <button
                      type="button"
                      class="rounded-none p-1 text-muted-foreground hover:bg-secondary hover:text-foreground"
                      title="More Actions"
