// Enhanced status management with SLA tracking
const getStatusBadgeClass = (status: string): string => {
  switch (status) {
    case 'fulfilled':
      return 'bg-secondary border border-input text-muted-foreground'
    case 'pending':
      return 'bg-secondary border border-ring text-foreground font-medium'
    case 'overdue':
      return 'bg-primary text-primary-foreground font-semibold animate-pulse'
    case 'rejected':
      return 'bg-primary text-primary-foreground font-semibold'
    case 'escalated':
      return 'bg-secondary border border-ring text-foreground font-medium'
    default:
      return 'bg-secondary border border-input text-muted-foreground'
  }
}

const getPriorityBadgeClass = (priority: string): string => {
  switch (priority) {
    case 'critical':
      return 'bg-primary text-primary-foreground font-semibold ring-2 ring-ring animate-pulse'
    case 'high':
      return 'bg-primary text-primary-foreground font-semibold'
    case 'medium':
      return 'bg-secondary border border-ring text-foreground font-medium'
    case 'low':
      return 'bg-secondary border border-input text-foreground'
    default:
      return 'bg-secondary border border-input text-muted-foreground'
  }
}

const getRequestTypeInfo = (
  type: string,
): { class: string; label: string; icon: string } => {
  switch (type) {
    case 'data-access':
      return {
        class: 'bg-secondary border border-input text-foreground',
        label: 'Data Access',
        icon: 'eye',
      }
    case 'data-export':
      return {
        class: 'bg-secondary border border-input text-foreground',
        label: 'Data Export',
        icon: 'download',
      }
    case 'correction':
      return {
        class: 'bg-secondary border border-input text-muted-foreground',
        label: 'Correction',
        icon: 'edit',
      }
    case 'deletion':
      return {
        class: 'bg-primary text-primary-foreground font-semibold',
        label: 'Deletion',
        icon: 'trash',
      }
    case 'portability':
      return {
        class: 'bg-secondary border border-input text-foreground',
        label: 'Portability',
        icon: 'share',
      }
    default:
      return {
        class: 'bg-secondary border border-input text-muted-foreground',
        label: 'Other',
        icon: 'file',
      }
  }
}

const getEncryptionBadge = (
  level: string,
): { class: string; label: string } => {
  switch (level) {
    case 'FHE':
      return {
        class: 'bg-secondary border border-input text-muted-foreground',
        label: 'FHE',
      }
    case 'ZKP':
      return {
        class: 'bg-secondary border border-input text-foreground',
        label: 'ZKP',
      }
    case 'AES-256':
      return {
        class: 'bg-secondary border border-input text-foreground',
        label: 'AES-256',
      }
    default:
      return {
        class: 'bg-secondary border border-input text-muted-foreground',
        label: 'Standard',
      }
  }
}

// Calculate compliance metrics
const complianceMetrics = {
  totalRequests: accessRequests.length,
  pendingRequests: accessRequests.filter((r) => r.status === 'pending').length,
  overdueRequests: accessRequests.filter((r) => r.status === 'overdue').length,
  criticalRequests: accessRequests.filter((r) => r.priority === 'critical')
    .length,
  avgProcessingTime: '12.5 days',
  complianceRate: '94.2%',
}
---

<div class="space-y-6">
