                        class="h-3 w-3 text-muted-foreground"
                      />
                      <span
                        class={`inline-flex rounded-none px-2 py-1 text-xs font-medium ${typeInfo.class}`}
                      >
                        {typeInfo.label}
                      </span>
                    </div>
                    <span
                      class={`inline-flex rounded-none px-2 py-1 text-xs font-medium ${encryptionInfo.class}`}
                    >
                      {encryptionInfo.label}
                    </span>
                  </div>
                </td>

                <td class="whitespace-nowrap px-6 py-4">
