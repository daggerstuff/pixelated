                          ? `${slaInfo.daysRemaining}d left`
                          : `${Math.abs(slaInfo.daysRemaining)}d overdue`}
                      </span>
                    </div>
                  </div>
                </td>

                <td class="whitespace-nowrap px-6 py-4">
                  <div class="flex flex-col space-y-1">
                    <span
                      class={`inline-flex rounded-none px-2 py-1 text-xs font-medium ${getStatusBadgeClass(request.status)}`}
