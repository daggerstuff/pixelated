---
// DataRetentionSystem.astro
// Component for managing data retention policies under HIPAA compliance
import {
  Trash as IconTrash,
  Plus as IconPlus,
  Pencil as IconPencil,
  Archive as IconArchive,
  Calendar as IconCalendar,
} from 'lucide-react'

interface Props {
  title?: string
}

const { title = 'Data Retention Policy Management' } = Astro.props

// Sample data categories for retention policies
const dataCategories = [
  {
    id: 'patient-records',
    name: 'Patient Records',
    description: 'Basic patient demographic and account information',
    currentPolicy: '7 years after last visit',
    legalMinimum: '6 years (HIPAA)',
    recommendedPolicy: '7 years after last visit',
    status: 'compliant',
  },
  {
    id: 'mental-health-data',
    name: 'Mental Health Data',
    description: 'Therapy notes, assessments, and treatment plans',
    currentPolicy: 'Indefinite',
    legalMinimum: 'Varies by state (5-10 years)',
    recommendedPolicy: '10 years after last visit',
    status: 'review',
  },
  {
    id: 'chat-logs',
    name: 'Chat Logs',
    description: 'Patient-provider and AI assistant conversations',
    currentPolicy: '3 years after creation',
    legalMinimum: '6 years (HIPAA)',
    recommendedPolicy: '6 years after creation',
    status: 'non-compliant',
  },
  {
    id: 'emotion-analysis',
    name: 'Emotion Analysis Data',
    description: 'Emotional state assessments and patterns',
    currentPolicy: '2 years after creation',
    legalMinimum: 'Not explicitly defined',
    recommendedPolicy: '2 years after creation or anonymization',
    status: 'compliant',
  },
  {
    id: 'consent-records',
    name: 'Consent Records',
    description: 'Patient consent for treatment and data usage',
    currentPolicy: 'Indefinite',
    legalMinimum: '6 years after expiration (HIPAA)',
    recommendedPolicy: 'Indefinite',
    status: 'compliant',
  },
]

// Get status badge styling
const getStatusBadge = (status: string): string => {
  switch (status) {
    case 'compliant':
      return 'bg-secondary border border-input text-foreground font-medium'
    case 'non-compliant':
      return 'bg-card border border-ring text-foreground font-medium'
    case 'review':
      return 'bg-secondary border border-ring text-foreground font-medium'
    default:
      return 'bg-secondary border border-input text-foreground font-medium'
  }
}

// Sample archiving actions
const archivingActions = [
  {
    name: 'Automated Monthly Archive',
    status: 'active',
    lastRun: '2025-07-01',
    nextRun: '2025-08-01',
  },
  {
    name: 'Quarterly Data Review',
    status: 'pending',
    lastRun: '2025-04-15',
    nextRun: '2025-07-15',
  },
  {
    name: 'Annual Secure Destruction',
    status: 'active',
    lastRun: '2025-01-10',
    nextRun: '2026-01-10',
  },
]
---

<div class="-md overflow-hidden rounded-none bg-card">
  <div class="p-6">
    <h2 class="mb-4 text-2xl font-bold text-foreground">{title}</h2>

    <div class="mb-8">
      <p class="mb-4 text-muted-foreground">
        Manage data retention policies in compliance with HIPAA regulations and
        state laws. Configure when data should be archived and when it should be
        securely destroyed.
      </p>

      <div class="mb-6 flex flex-wrap gap-4">
        <div class="flex items-center rounded-none border border-input bg-secondary p-3">
          <IconCalendar className="mr-2 h-5 w-5 text-foreground" />
          <span class="text-sm font-medium text-foreground">
            Configurable retention periods
          </span>
        </div>

        <div class="flex items-center rounded-none border border-input bg-secondary p-3">
          <IconArchive className="mr-2 h-5 w-5 text-foreground" />
          <span class="text-sm font-medium text-foreground">
            Automated archiving
          </span>
        </div>

        <div class="flex items-center rounded-none border border-input bg-secondary p-3">
          <IconTrash className="mr-2 h-5 w-5 text-foreground" />
          <span class="text-sm text-foreground">Secure destruction</span>
        </div>
      </div>
    </div>

    <!-- Data Retention Policies -->
    <div class="mb-8">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-lg font-medium text-foreground">
          Data Category Retention Policies
        </h3>
        <button
          type="button"
          class="text-white flex items-center rounded-none bg-primary px-3 py-1.5 text-sm hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
        >
          <IconPlus className="mr-1 h-4 w-4" />
          Add Policy
        </button>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-muted-foreground">
          <thead class="bg-secondary text-xs uppercase text-foreground">
            <tr>
              <th scope="col" class="px-4 py-3">
                Data Category
              </th>
              <th scope="col" class="px-4 py-3">
                Current Policy
              </th>
              <th scope="col" class="px-4 py-3">
                Legal Minimum
              </th>
              <th scope="col" class="px-4 py-3">
                Recommended
              </th>
              <th scope="col" class="px-4 py-3">
                Status
              </th>
              <th scope="col" class="px-4 py-3">
                Actions
              </th>
            </tr>
          </thead>
          <tbody>
            {dataCategories.map((category) => (
              <tr class="border-b bg-card hover:bg-secondary">
                <td class="px-4 py-3 font-medium text-foreground">
                  <div>
                    <div>{category.name}</div>
                    <div class="text-xs text-muted-foreground">
                      {category.description}
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3">{category.currentPolicy}</td>
                <td class="px-4 py-3">{category.legalMinimum}</td>
                <td class="px-4 py-3">{category.recommendedPolicy}</td>
                <td class="px-4 py-3">
                  <span
                    class={`rounded-none px-2 py-1 text-xs font-medium ${getStatusBadge(category.status)}`}
                  >
                    {category.status.charAt(0).toUpperCase() +
                      category.status.slice(1)}
                  </span>
                </td>
                <td class="px-4 py-3">
                  <div class="flex space-x-2">
                    <button
                      type="button"
                      class="font-medium text-foreground hover:underline"
                      aria-label={`Edit ${category.name} policy`}
                    >
                      <IconPencil className="h-5 w-5" />
                    </button>
                    <button
                      type="button"
                      class="font-medium text-muted-foreground hover:underline"
                      aria-label={`Archive ${category.name} now`}
                    >
                      <IconArchive className="h-5 w-5" />
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Archiving and Destruction Actions -->
    <div class="mb-8">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-lg font-medium text-foreground">
          Automated Retention Actions
        </h3>
        <button
          type="button"
          class="text-white flex items-center rounded-none bg-primary px-3 py-1.5 text-sm hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
        >
          <IconPlus className="mr-1 h-4 w-4" />
          Schedule Action
        </button>
      </div>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        {archivingActions.map((action) => (
          <div class="rounded-none border border-border bg-card p-4">
            <div class="mb-3 flex items-start justify-between">
              <h4 class="font-medium text-foreground">{action.name}</h4>
              <span
                class={`rounded-none px-2 py-1 text-xs font-medium ${
                  action.status === 'active'
                    ? 'border border-input bg-secondary font-medium text-foreground'
                    : 'border border-ring bg-secondary font-medium text-foreground'
                }`}
              >
                {action.status.charAt(0).toUpperCase() + action.status.slice(1)}
              </span>
            </div>
            <div class="mb-3 text-sm text-muted-foreground">
              <div class="flex items-center">
                <span class="w-28">Last run:</span>
                <span class="text-foreground">{action.lastRun}</span>
              </div>
              <div class="flex items-center">
                <span class="w-28">Next scheduled:</span>
                <span class="text-foreground">{action.nextRun}</span>
              </div>
            </div>
            <div class="mt-2 flex space-x-2">
              <button
                type="button"
                class="text-white rounded-none bg-primary px-3 py-1 text-xs font-medium hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring"
                aria-label={`Run ${action.name} now`}
              >
                Run Now
              </button>
              <button
                type="button"
                class="rounded-none bg-secondary px-3 py-1 text-xs font-medium text-foreground hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring"
                aria-label={`Configure ${action.name}`}
              >
                Configure
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Data Destruction Configuration -->
    <div>
      <h3 class="mb-4 text-lg font-medium text-foreground">
        Secure Data Destruction Configuration
      </h3>

      <div class="rounded-none border border-border bg-secondary p-5">
        <div class="mb-4">
          <label
            for="destruction-method"
            class="mb-2 block text-sm font-medium text-foreground"
          >
            Destruction Method
          </label>
          <select
            id="destruction-method"
            class="w-full rounded-none border border-input p-2 focus:border-ring focus:ring-2 focus:ring-ring"
          >
            <option value="crypto-erase">
              Cryptographic Erasure (Default)
            </option>
            <option value="data-overwrite">
              Data Overwriting (DoD 5220.22-M)
            </option>
            <option value="physical">Physical Media Destruction</option>
            <option value="combined">Combined Approach</option>
          </select>
          <p class="mt-1 text-sm text-muted-foreground">
            Cryptographic Erasure securely destroys encryption keys, making the
            encrypted data unrecoverable.
          </p>
        </div>

        <div class="mb-4">
          <label class="mb-2 block text-sm font-medium text-foreground">
            Destruction Verification
          </label>
          <div class="flex items-center">
            <input
              id="verification-checkbox"
              type="checkbox"
              checked
              class="focus:ring-3 h-4 w-4 rounded-none border border-input bg-secondary focus:ring-ring"
            />
            <label
              for="verification-checkbox"
              class="ml-2 text-sm text-foreground"
            >
              Require administrative approval and verification for all data
              destruction operations
            </label>
          </div>
        </div>

        <div class="mb-4">
          <label
            for="documentation-retention"
            class="mb-2 block text-sm font-medium text-foreground"
          >
            Documentation Retention
          </label>
          <select
            id="documentation-retention"
            class="w-full rounded-none border border-input p-2 focus:border-ring focus:ring-2 focus:ring-ring"
          >
            <option value="3-years">3 Years</option>
            <option value="5-years">5 Years</option>
            <option value="7-years" selected>
              7 Years
            </option>
            <option value="10-years">10 Years</option>
            <option value="indefinite">Indefinite</option>
          </select>
          <p class="mt-1 text-sm text-muted-foreground">
            How long to keep records of data destruction operations for
            compliance and audit purposes.
          </p>
        </div>

        <!-- Action Buttons -->
        <div class="mt-6 flex gap-3">
          <button
            type="button"
            class="text-white rounded-none bg-primary px-4 py-2 hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
          >
            Save Configuration
          </button>
          <button
            type="button"
            class="rounded-none border border-input px-4 py-2 text-foreground hover:bg-secondary focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
          >
            Cancel
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Initialize the data retention form
  document.addEventListener('DOMContentLoaded', (_event: Event) => {
    // Destruction method change handler
    const destructionMethodSelect =
      document.getElementById('destruction-method')

    if (destructionMethodSelect) {
      destructionMethodSelect.addEventListener('change', (e: Event) => {
        const method = (e.target as HTMLSelectElement)
          .value as keyof typeof descriptions

        // In a real implementation, we would update the description based on the selected method
        const descriptions = {
          'crypto-erase':
            'Cryptographic Erasure securely destroys encryption keys, making the encrypted data unrecoverable.',
          'data-overwrite':
            'Data Overwriting replaces data with random patterns multiple times according to DoD standards.',
          'physical':
            'Physical destruction ensures storage media is physically destroyed and unable to be read.',
          'combined':
            'Combined approach uses multiple methods to ensure data is completely unrecoverable.',
        }

        const descriptionElement = destructionMethodSelect.nextElementSibling
        if (descriptionElement && descriptions[method]) {
          descriptionElement.textContent = descriptions[method]
        }
      })
    }

    // Add form submission handler
    const saveButton = document.querySelector(
      'button[type="button"]:first-of-type',
    )
    if (saveButton) {
      saveButton.addEventListener('click', (_event: Event) => {
        // For demonstration purposes, just show an alert
        alert(
          'Settings saved. In a production environment, this would update your data retention configuration.',
        )
      })
    }
  })
</script>
