---
import Link from '@/components/base/Link.astro'
import { SITE } from '@/config'

const currentYear = new Date().getFullYear()
const copyrightText = `© ${currentYear} ${SITE.author}`
---

<footer class="slide-enter animate-delay-1600! mb-8 mt-auto px-7">
  <div class="prose op-50 mx-auto">
    <div class="lt-sm:flex-col flex items-center whitespace-nowrap text-sm">
      <span>{copyrightText}</span>
      <span class="lt-sm:hidden">&nbsp;|&nbsp;</span>
      <span>
        Powered by
        <Link
          class="op-100! color-[--fg]!"
          href="https://github.com/lin-stephanie/astro-antfustyle-theme"
          external={true}
        >
          Astro AntfuStyle Theme
        </Link>
      </span>
    </div>
  </div>
</footer>
