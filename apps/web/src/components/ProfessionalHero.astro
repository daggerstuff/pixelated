---
/**
 * Professional Hero Component
 * Dark-first enterprise clinical training platform
 */

export interface Props {
  kicker?: string
  title?: string
  subtitle?: string
  helperText?: string
  proofPoints?: readonly { label: string; text: string }[]
  primaryCTA?: { text: string; href: string }
  secondaryCTA?: { text: string; href: string }
}

const {
  kicker,
  title,
  subtitle,
  helperText,
  proofPoints = [],
  primaryCTA,
  secondaryCTA,
} = Astro.props
---

<section class="hero" data-component="professional-hero">
  <div class="hero-background">
    <div class="hero-gradient"></div>
    <div class="hero-grid-overlay"></div>
  </div>

  <div class="container hero-shell">
    <div class="hero-content-wrapper">
      {
        kicker && (
          <div class="hero-kicker-wrapper">
            <div class="hero-kicker-pill">
              <span class="hero-kicker-dot" />
              <span class="hero-kicker">{kicker}</span>
            </div>
          </div>
        )
      }

      <div class="hero-text-content">
        <h1 class="hero-title">{title}</h1>
        <p class="hero-subtitle">{subtitle}</p>
        {helperText && <p class="hero-helper">{helperText}</p>}
      </div>

      <div class="hero-actions">
        <div class="hero-action-buttons">
          {
            primaryCTA && (
              <a href={primaryCTA.href} class="btn-primary" role="button">
                {primaryCTA.text}
              </a>
            )
          }
          {
            secondaryCTA && (
              <a href={secondaryCTA.href} class="btn-secondary" role="button">
                {secondaryCTA.text}
              </a>
            )
          }
        </div>
      </div>

      {
        proofPoints.length > 0 && (
          <div
            class="hero-proof-grid"
            aria-label="Why choose Pixelated Empathy"
          >
            {proofPoints.map((point) => (
              <div class="hero-proof-card">
                <div class="hero-proof-icon">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                  </svg>
                </div>
                <div class="hero-proof-content">
                  <span class="hero-proof-label">{point.label}</span>
                  <p>{point.text}</p>
                </div>
              </div>
            ))}
          </div>
        )
      }

      <div class="hero-trust-indicators">
        <div class="trust-badge">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>HIPAA-ready</span>
        </div>
        <div class="trust-badge">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>Enterprise security</span>
        </div>
        <div class="trust-badge">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 6v6l4 2"></path>
          </svg>
          <span>Live support</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100dvh, 56rem);
    padding: clamp(5rem, 10vh, 7rem) 0 clamp(4rem, 6vh, 5rem);
    background: var(--bg-primary);
    overflow: hidden;
    --hero-accent: #f59e0b;
    --hero-accent-strong: #d97706;
    --hero-accent-soft: rgba(245, 158, 11, 0.18);
    --hero-accent-soft-faint: rgba(245, 158, 11, 0.08);
    --hero-accent-soft-border: rgba(245, 158, 11, 0.22);
    --hero-accent-soft-glow: rgba(245, 158, 11, 0.18);
    --hero-accent-soft-hover: rgba(245, 158, 11, 0.22);
    --hero-accent-soft-outline: rgba(217, 119, 6, 0.25);
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Sunset orange gradient overlay */
  .hero-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 0%,
      var(--hero-accent-soft-faint) 0%,
      transparent 50%
    );
  }

  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.5;
  }

  .hero-shell {
    position: relative;
    z-index: 1;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 3vw, 2rem);
  }

  .hero-content-wrapper {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 2.5vw, 2rem);
    align-items: center;
    text-align: center;
  }

  /* Kicker Pill - sunset orange accent */
  .hero-kicker-wrapper {
    display: flex;
    justify-content: center;
  }

  .hero-kicker-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: var(--hero-accent-soft);
    border: 1px solid var(--hero-accent);
  }

  .hero-kicker-dot {
    display: inline-block;
    flex-shrink: 0;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--hero-accent);
    box-shadow: inset 0 0 0 1px var(--hero-accent-soft-outline);
  }

  .hero-kicker {
    font-family: 'Plus Jakarta Sans', var(--font-sans);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hero-accent);
  }

  /* Text Content */
  .hero-text-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 42rem;
  }

  .hero-title {
    margin: 0;
    font-family: 'Plus Jakarta Sans', var(--font-sans);
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    text-wrap: balance;
  }

  .hero-subtitle {
    margin: 0;
    font-family: 'Plus Jakarta Sans', var(--font-sans);
    font-size: clamp(1rem, 1.2vw, 1.12rem);
    line-height: 1.68;
    max-width: 40rem;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .hero-helper {
    margin: 0;
    font-family: 'Plus Jakarta Sans', var(--font-sans);
    font-size: 0.88rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.72);
  }

  /* Action Buttons */
  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .hero-action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    align-items: center;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.85rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-button, 0.5rem);
    font-family: 'Plus Jakarta Sans', var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease;
    cursor: pointer;
    white-space: nowrap;
  }

  /* Sunset orange primary button */
  .btn-primary {
    background: var(--hero-accent);
    color: white;
    border: 1px solid var(--hero-accent-strong);
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.12),
      0 1px 6px var(--hero-accent-soft-glow);
  }

  .btn-primary:hover {
    background: var(--hero-accent-strong);
    border-color: var(--hero-accent-strong);
    box-shadow: 0 2px 10px var(--hero-accent-soft-hover);
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-primary);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.08);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    transform: translateY(-1px);
  }

  .btn-primary:focus-visible,
  .btn-secondary:focus-visible {
    outline: 2px solid var(--hero-accent);
    outline-offset: 2px;
  }

  /* Proof Grid - dark surface cards */
  .hero-proof-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
    max-width: 42rem;
    margin: 0;
  }

  .hero-proof-card {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem;
    border-radius: var(--radius-card, 0.75rem);
    background: color-mix(in oklab, var(--bg-secondary) 92%, transparent);
    border: 1px solid var(--border-primary);
  }

  .hero-proof-icon {
    flex-shrink: 0;
    color: var(--hero-accent);
    background: var(--hero-accent-soft);
    border: 1px solid var(--hero-accent-soft-border);
    border-radius: 999px;
    padding: 0.4rem;
  }

  .hero-proof-content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .hero-proof-label {
    font-family: 'Plus Jakarta Sans', var(--font-sans);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hero-accent);
  }

  .hero-proof-content p {
    margin: 0;
    font-family: 'Plus Jakarta Sans', var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* Trust Indicators - subtle dark styling */
  .hero-trust-indicators {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    padding-top: 0.5rem;
  }

  .trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.1);
    border: 1px solid rgba(148, 163, 184, 0.3);
    font-family: 'Plus Jakarta Sans', var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    color: #94a3b8;
  }

  .trust-badge svg {
    color: #94a3b8;
  }

  /* Desktop */
  @media (min-width: 1040px) {
    .hero {
      align-items: center;
      min-height: min(88dvh, 52rem);
      padding-top: clamp(4rem, 7vh, 6rem);
      padding-bottom: clamp(3.5rem, 6vh, 5rem);
    }

    .hero-content-wrapper {
      gap: 1.75rem;
    }

    .hero-proof-grid {
      gap: 1.15rem;
    }

    .hero-proof-card {
      padding: 1.15rem;
    }
  }

  /* Tablet */
  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding-top: 4.5rem;
      padding-bottom: 3.5rem;
    }

    .hero-proof-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Mobile */
  @media (max-width: 480px) {
    .hero-action-buttons {
      flex-direction: column;
      width: 100%;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
    }

    .hero-trust-indicators {
      justify-content: center;
    }
  }
</style>
