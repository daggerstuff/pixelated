---
// Enterprise Hero Component - Astro + UnoCSS
// Incorporates premium theme patterns from Mizu, Antfu, Lexington, and Astro Max
---

<div class="enterprise-hero min-h-screen flex flex-col justify-center items-center text-center relative overflow-hidden bg-background">
  <!-- Main Content -->
  <div class="relative z-10 max-w-6xl mx-auto px-6 lg:px-8">
    <!-- Pre-title -->
    <div class="mb-8 animate-fade-in-up">
      <span class="inline-flex items-center rounded-none border border-border bg-secondary px-4 py-2 text-sm font-medium text-foreground">
        <span class="mr-2 h-2 w-2 rounded-none animate-pulse bg-primary"></span>
        Next-Generation AI Training Platform
      </span>
    </div>

    <!-- Main Title -->
    <h1 class="text-7xl lg:text-8xl font-bold text-balance mb-6 animate-fade-in-up [animation-delay:200ms]">
      <span class="text-foreground"> Pixelated Empathy </span>
    </h1>

    <!-- Subtitle -->
    <p class="text-2xl lg:text-3xl leading-relaxed text-foreground text-balance mb-12 max-w-4xl mx-auto animate-fade-in-up [animation-delay:400ms]">
      Master mental health training with AI-powered simulations that deliver
      <span class="font-semibold text-foreground">95% accuracy</span> through
      <span class="font-semibold text-foreground">10,000+ sessions</span>
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16 animate-fade-in-up [animation-delay:600ms]">
      <button class="group relative px-8 py-4 rounded-none bg-primary px-8 py-4 font-semibold text-primary-foreground transition-colors duration-300">
        <span class="relative z-10">Start Training Now</span>
        <div class="absolute inset-0 bg-gradient-to-r from-primary-600 to-secondary-600 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </button>

      <button class="group px-8 py-4 rounded-none border border-border bg-secondary px-8 py-4 font-semibold text-foreground transition-colors duration-300 hover:bg-accent">
        <span>Watch Demo</span>
        <span class="ml-2 opacity-0 group-hover:opacity-100 transition-opacity">
          →
        </span>
      </button>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-3xl mx-auto animate-fade-in-up [animation-delay:800ms]">
      <div class="text-center group">
        <div class="text-4xl font-bold text-foreground mb-2 transition-colors">
          10K+
        </div>
        <div class="text-sm text-muted-foreground">Training Sessions</div>
      </div>
      <div class="text-center group">
        <div class="text-4xl font-bold text-foreground mb-2 transition-colors">
          95%
        </div>
        <div class="text-sm text-muted-foreground">Accuracy Rate</div>
      </div>
      <div class="text-center group">
        <div class="text-4xl font-bold text-foreground mb-2 transition-colors">
          24/7
        </div>
        <div class="text-sm text-muted-foreground">AI Support</div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-gentle-float">
    <div class="flex h-10 w-6 justify-center rounded-none border-2 border-border">
      <div class="mt-2 h-3 w-1 animate-pulse rounded-none bg-muted-foreground"></div>
    </div>
  </div>
</div>

<style>
  /* Animations */
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  @keyframes float-delayed {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-30px);
    }
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-float-delayed {
    animation: float-delayed 8s ease-in-out infinite;
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
    opacity: 0;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .enterprise-hero {
      padding: 8rem 1rem;
    }

    .enterprise-hero h1 {
      font-size: 3rem;
    }

    .enterprise-hero p {
      font-size: 1.125rem;
    }
  }
</style>
