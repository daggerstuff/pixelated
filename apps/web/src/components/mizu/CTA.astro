---
export interface Props {
  label?: string
  title?: string
  intro?: string
  verdictCopy?: string
  proofItems?: readonly { label: string; value: string }[]
  decisionTitle?: string
  rubric?: readonly string[]
  primaryCTA?: { text: string; href: string }
  secondaryCTA?: { text: string; href: string }
  meta?: string
}

const {
  label,
  title,
  intro,
  verdictCopy,
  proofItems = [],
  decisionTitle,
  rubric = [],
  primaryCTA = { text: 'Book a pilot review', href: '/contact' },
  secondaryCTA = { text: 'See the product demo', href: '/demo-hub' },
  meta,
} = Astro.props
---

<section class="pe-home-section cta-section">
  <div class="pe-home-shell">
    <div class="cta-shell">
      <div class="cta-copy">
        <span class="pe-meta-label">{label}</span>
        <h2 class="pe-heading-l">{title}</h2>
        <p class="pe-home-copy">{intro}</p>
        <p class="cta-verdict-copy">{verdictCopy}</p>

        <div class="cta-proof-list">
          {proofItems.map((item) => (
            <div class="cta-proof-item">
              <span class="cta-proof-item__label">{item.label}</span>
              <p>{item.value}</p>
            </div>
          ))}
        </div>
      </div>

      <aside class="cta-decision">
        <span class="cta-decision__label">Decision rubric</span>
        <h3 class="pe-heading-s">{decisionTitle}</h3>
        <p class="cta-decision__context">
          Keep the product only if it makes practice easier to assign, review,
          and repeat inside your existing supervision workflow.
        </p>

        <ul class="cta-rubric">
          {rubric.map((item) => (
            <li>{item}</li>
          ))}
        </ul>

        <div class="cta-action-cluster">
          <a
            href={primaryCTA.href}
            class="cta-button cta-button--primary"
            role="button"
          >
            {primaryCTA.text}
          </a>
          <a
            href={secondaryCTA.href}
            class="cta-button cta-button--secondary"
            role="button"
          >
            {secondaryCTA.text}
          </a>
        </div>

        <p class="cta-meta">{meta}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background: var(--np-surface);
    color: var(--np-text);
    border-top: 1px solid var(--np-line-strong);
  }

  .cta-shell {
    display: grid;
    gap: clamp(1.8rem, 4vw, 3.4rem);
  }

  .cta-copy,
  .cta-decision {
    display: grid;
    gap: 1rem;
  }

  .cta-copy {
    max-width: 46rem;
    margin: 0 auto;
    text-align: center;
    justify-items: center;
  }

  .cta-verdict-copy {
    margin: 0;
    max-width: 34rem;
    font-family: var(--font-sans);
    font-size: 0.98rem;
    line-height: 1.76;
    color: var(--np-text);
  }

  .cta-proof-list {
    display: grid;
    gap: 0.9rem;
    margin-top: 0.3rem;
  }

  .cta-proof-item {
    display: grid;
    gap: 0.85rem;
    padding: 1rem;
    border: 1px solid var(--np-line);
    border-radius: var(--radius-card);
    background: var(--np-bg);
    justify-items: center;
    text-align: center;
  }

  .cta-proof-item p,
  .cta-rubric li,
  .cta-meta {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    line-height: 1.74;
    color: var(--np-mid);
  }

  .cta-proof-item__label,
  .cta-decision__label {
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--np-text);
  }

  .cta-decision {
    padding: clamp(1.25rem, 2vw, 1.5rem);
    border: 1px solid var(--np-line);
    border-radius: var(--radius-card);
    background: var(--np-surface);
  }

  .cta-decision__context {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.74;
    color: var(--np-mid);
  }

  .cta-rubric {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cta-rubric li {
    position: relative;
    padding: 0.9rem 0 0;
    text-align: center;
  }

  .cta-rubric li::before {
    content: '';
    position: static;
    display: block;
    width: 0.38rem;
    height: 0.38rem;
    margin: 0 auto 0.65rem;
    border-radius: 999px;
    background: var(--np-text);
    opacity: 0.9;
  }

  .cta-action-cluster {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.5rem;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.85rem;
    padding: 0.65rem 1.35rem;
    border-radius: var(--radius-button);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
    cursor: pointer;
  }

  .cta-button--primary {
    background: var(--np-text);
    color: var(--np-bg);
    border: 1px solid var(--np-text);
  }

  .cta-button--secondary {
    background: transparent;
    color: var(--np-mid);
    border: 1px solid var(--np-line-strong);
  }

  .cta-button--primary:hover {
    background: color-mix(in srgb, var(--np-text) 90%, var(--np-bg));
    border-color: var(--np-mid);
  }

  .cta-button--secondary:hover {
    color: var(--np-text);
    border-color: var(--np-mid);
    background: var(--np-surface);
  }

  .cta-button:focus-visible {
    outline: 2px solid var(--np-mid);
    outline-offset: 2px;
  }

  .cta-meta {
    color: var(--np-muted);
  }

  @media (min-width: 980px) {
    .cta-shell {
      grid-template-columns: minmax(0, 0.95fr) minmax(24rem, 0.72fr);
      align-items: start;
      gap: clamp(3rem, 5vw, 5rem);
      text-align: center;
      justify-items: center;
    }

    .cta-copy {
      max-width: 46rem;
      margin: 0;
      text-align: center;
      justify-items: center;
    }

    .cta-copy .pe-heading-l {
      max-width: 13ch;
      margin-inline: auto;
    }

    .cta-copy .pe-home-copy {
      max-width: 34rem;
      margin: 0 auto;
      text-align: center;
    }

    .cta-proof-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      max-width: 100%;
    }

    .cta-proof-item,
    .cta-decision {
      text-align: center;
      justify-items: center;
    }

    .cta-proof-item p {
      max-width: 24rem;
      margin-inline: auto;
    }

    .cta-rubric {
      justify-items: center;
      text-align: center;
    }

    .cta-action-cluster {
      width: 100%;
    }
  }

  @media (max-width: 720px) {
    .cta-shell,
    .cta-copy,
    .cta-proof-item,
    .cta-decision,
    .cta-rubric {
      text-align: center;
      justify-items: center;
    }

    .cta-rubric {
      justify-items: center;
      text-align: center;
    }

    .cta-rubric li {
      max-width: 28rem;
      margin-inline: auto;
    }

    .cta-proof-item {
      padding: 1rem;
    }

    .cta-action-cluster {
      grid-template-columns: 1fr;
    }

    .cta-button {
      width: 100%;
    }
  }
</style>
