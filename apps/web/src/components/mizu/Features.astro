---
const features = [
  {
    title: 'AI-Powered Scenarios',
    description:
      'Experience realistic patient interactions through advanced AI simulation that adapts to your responses in real-time.',
    image: '/images/features/mental-health-therapy.jpg',
    bullets: ['Adaptive AI responses', 'Real-time interaction'],
    href: '/features#ai-scenarios',
  },
  {
    title: 'Real-Time Analytics',
    description:
      'Track your progress with detailed analytics on empathy scores, response quality, and therapeutic effectiveness.',
    image: '/images/features/competency.jpg',
    bullets: ['Empathy scoring', 'Performance tracking'],
    href: '/features#analytics',
  },
  {
    title: 'Bias Detection',
    description:
      'Built-in bias detection helps identify and correct potential blind spots in your therapeutic approach.',
    image: '/images/features/bias-spike.jpg',
    bullets: ['Real-time detection', 'Actionable insights'],
    href: '/features#bias-detection',
  },
  {
    title: 'Edge Case Training',
    description:
      'Prepare for challenging scenarios with specialized edge case training that builds resilience and adaptability.',
    image: '/images/features/edge-case.jpg',
    bullets: ['Complex scenarios', 'Crisis preparation'],
    href: '/features#edge-cases',
  },
]
---

<section id="features" class="py-24 bg-background relative overflow-hidden">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-4 text-foreground">
        Platform Features
      </h2>
      <p class="text-muted-foreground max-w-2xl mx-auto text-base">
        Everything you need to master your therapeutic skills.
      </p>
    </div>

    <div class="space-y-20 md:space-y-24">
      {features.map((feature, index) => (
        <div
          class={`flex flex-col md:flex-row items-center gap-10 md:gap-16 ${index % 2 === 1 ? 'md:flex-row-reverse' : ''}`}
        >
          <div class="flex-1">
            <div class="inline-block px-3 py-1 rounded-none bg-secondary border border-border text-foreground text-xs font-semibold uppercase tracking-wider mb-4">
              Feature {index + 1}
            </div>
            <h3 class="text-xl md:text-2xl font-bold mb-3 text-foreground">
              {feature.title}
            </h3>
            <p class="text-base text-muted-foreground leading-relaxed mb-5">
              {feature.description}
            </p>
            <ul class="space-y-3 mb-6">
              {feature.bullets.map((bullet) => (
                <li class="flex items-center gap-3 text-foreground text-sm">
                  <svg
                    class="w-4 h-4 text-foreground shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
            <a
              href={feature.href}
              class="text-foreground font-semibold hover:underline inline-flex items-center gap-2 group transition-colors text-sm"
            >
              Learn more
              <svg
                class="w-4 h-4 transform group-hover:translate-x-1 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"
                />
              </svg>
            </a>
          </div>
          <div class="flex-1 w-full">
            <div class="aspect-[4/3] rounded-none border border-border overflow-hidden relative group">
              <img
                src={feature.image}
                alt={feature.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
