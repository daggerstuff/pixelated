---
// Simple enterprise logo wall with accessible placeholders
export interface Props {
  title?: string
  subtitle?: string
}
const {
  title = 'Trusted by forward‑thinking institutions',
  subtitle = 'Select partners and collaborators',
} = Astro.props
---

<section aria-label="Trusted institutions" class="logo-wall-section">
  <div class="brutalist-container logo-wall-container">
    <div class="text-center mb-8">
      <p class="brutalist-caption">{subtitle}</p>
      <h3 class="brutalist-subheading text-xl md:text-2xl">{title}</h3>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6 items-center justify-items-center">
      <div
        class="group logo-item h-12 w-20 rounded-none border border-border bg-card transition-colors duration-300 hover:border-ring md:h-16 md:w-24"
        aria-label="Harvard University"
      >
        <img
          src="/images/logos/harvard-university.png"
          alt="Harvard University"
          class="max-w-full max-h-full object-contain opacity-70 group-hover:opacity-100 transition-opacity"
          onerror="this.style.display='none'; this.parentElement.innerHTML='<span class=\'text-xs text-muted-foreground\'>Harvard</span>';"
        />
      </div>
      <div
        class="group logo-item h-12 w-20 rounded-none border border-border bg-card transition-colors duration-300 hover:border-ring md:h-16 md:w-24"
        aria-label="Johns Hopkins"
      >
        <img
          src="/images/logos/johns-hopkins.png"
          alt="Johns Hopkins"
          class="max-w-full max-h-full object-contain opacity-70 group-hover:opacity-100 transition-opacity"
          onerror="this.style.display='none'; this.parentElement.innerHTML='<span class=\'text-xs text-muted-foreground\'>Johns Hopkins</span>';"
        />
      </div>
      <div
        class="group logo-item h-12 w-20 rounded-none border border-border bg-card transition-colors duration-300 hover:border-ring md:h-16 md:w-24"
        aria-label="Mayo Clinic"
      >
        <img
          src="/images/logos/mayo-clinic.png"
          alt="Mayo Clinic"
          class="max-w-full max-h-full object-contain opacity-70 group-hover:opacity-100 transition-opacity"
          onerror="this.style.display='none'; this.parentElement.innerHTML='<span class=\'text-xs text-muted-foreground\'>Mayo Clinic</span>';"
        />
      </div>
      <div
        class="group logo-item h-12 w-20 rounded-none border border-border bg-card transition-colors duration-300 hover:border-ring md:h-16 md:w-24"
        aria-label="VA Health"
      >
        <img
          src="/images/logos/va-health.png"
          alt="VA Health"
          class="max-w-full max-h-full object-contain opacity-70 group-hover:opacity-100 transition-opacity"
          onerror="this.style.display='none'; this.parentElement.innerHTML='<span class=\'text-xs text-muted-foreground\'>VA Health</span>';"
        />
      </div>
      <div
        class="group logo-item h-12 w-20 rounded-none border border-border bg-card transition-colors duration-300 hover:border-ring md:h-16 md:w-24"
        aria-label="Kaiser Permanente"
      >
        <img
          src="/images/logos/kaiser-permanente.png"
          alt="Kaiser Permanente"
          class="max-w-full max-h-full object-contain opacity-70 group-hover:opacity-100 transition-opacity"
          onerror="this.style.display='none'; this.parentElement.innerHTML='<span class=\'text-xs text-muted-foreground\'>Kaiser</span>';"
        />
      </div>
      <div
        class="group logo-item h-12 w-20 rounded-none border border-border bg-card transition-colors duration-300 hover:border-ring md:h-16 md:w-24"
        aria-label="NIMH"
      >
        <img
          src="/images/logos/nih.png"
          alt="NIMH"
          class="max-w-full max-h-full object-contain opacity-70 group-hover:opacity-100 transition-opacity"
          onerror="this.style.display='none'; this.parentElement.innerHTML='<span class=\'text-xs text-muted-foreground\'>NIMH</span>';"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .logo-wall-section {
    padding-top: var(--spacing-12);
    padding-bottom: var(--spacing-12);
  }

  /* Ensure proper spacing and alignment for mobile */
  .logo-wall-container {
    max-width: 100%;
    margin: 0 auto;
  }

  /* Ensure logos are properly contained and responsive */
  .logo-item {
    width: 100%;
    min-height: 48px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-2);
  }

  .logo-item img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    width: auto;
    height: auto;
  }

  /* Fallback text styling when image fails */
  .logo-item span {
    font-size: 0.625rem;
    color: var(--np-muted, #8c8c8c);
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  /* Improve mobile spacing */
  @media (max-width: 768px) {
    .logo-wall-section {
      padding-top: var(--spacing-8);
      padding-bottom: var(--spacing-8);
    }
  }
</style>
