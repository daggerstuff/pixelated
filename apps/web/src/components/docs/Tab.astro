---
interface Props {
  title: string
  active?: boolean
  className?: string
}

const { title, active = false, className } = Astro.props
---

<button
  class={`tab ${active ? 'tab-active' : ''} ${className || ''}`}
  role="tab"
  aria-selected={active}
>
  {title}
</button>

<style>
  .tab {
    background: none;
    border: none;
    padding: 0.75rem 1rem;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    border-bottom: 2px solid transparent;
    color: var(--np-muted);
    transition: all 0.2s ease;
  }

  .tab:hover {
    color: var(--np-text);
    background-color: var(--np-surface);
  }

  .tab-active {
    color: var(--np-text);
    border-bottom-color: var(--np-text);
  }

  .tab:focus {
    outline: none;
    box-shadow: 0 0 0 2px var(--np-mid);
  }
</style>
