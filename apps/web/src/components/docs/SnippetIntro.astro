---
// SnippetIntro component for introducing reusable snippets
export interface Props {
  class?: string
}

import { Target } from 'lucide-react'

const { class: className } = Astro.props
---

<div class={`snippet-intro ${className || ''}`}>
  <div class="intro-content">
    <h2>Reusable Snippets</h2>
    <p>
      Snippets are reusable pieces of content that can be included in multiple
      documentation pages. They help maintain consistency and reduce duplication
      across your documentation.
    </p>
    <div class="features-grid">
      <div class="feature">
        <h3>🔄 Reusable</h3>
        <p>
          Write once, use everywhere. Update in one place to reflect changes
          across all pages.
        </p>
      </div>
      <div class="feature">
        <h3>📝 Markdown Support</h3>
        <p>
          Full Markdown and MDX support with all the components you're used to.
        </p>
      </div>
      <div class="feature">
        <h3 class="flex items-center gap-2">
          <Target className="w-5 h-5" /> Targeted
        </h3>
        <p>
          Include specific snippets where needed without cluttering your main
          content.
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  .snippet-intro {
    @apply mb-8 p-6 bg-secondary border border-border rounded-none;
  }

  .intro-content h2 {
    @apply text-2xl font-bold text-foreground mb-4;
  }

  .intro-content > p {
    @apply text-muted-foreground mb-6 text-lg;
  }

  .features-grid {
    @apply grid grid-cols-1 md:grid-cols-3 gap-4;
  }

  .feature {
    @apply bg-card p-4 rounded-none border border-border;
  }

  .feature h3 {
    @apply text-lg font-semibold text-foreground mb-2;
  }

  .feature p {
    @apply text-muted-foreground text-sm;
  }
</style>
