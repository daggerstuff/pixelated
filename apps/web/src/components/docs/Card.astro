---
// Card component
export interface Props {
  title: string
  icon?: string
  href: string
}
---

<a
  href={Astro.props.href}
  class="card block p-6 bg-card border border-border rounded-none hover:bg-secondary transition-colors"
>
  <h3 class="text-lg font-semibold text-foreground mb-2">
    {Astro.props.title}
  </h3>
  <p class="text-muted-foreground text-sm">
    <slot />
  </p>
</a>
