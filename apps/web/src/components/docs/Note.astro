---
interface Props {
  type?: 'info' | 'warning' | 'tip' | 'danger'
  title?: string
  className?: string
}

const { type = 'info', title, className } = Astro.props
---

<div class={`note note-${type} ${className || ''}`}>
  {title && <div class="note-title">{title}</div>}
  <div class="note-content">
    <slot />
  </div>
</div>

<style>
  .note {
    border-radius: 6px;
    padding: 1rem;
    margin: 1rem 0;
    border-left: 4px solid;
  }

  .note-title {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .note-content {
    line-height: 1.6;
  }

  .note-info {
    background-color: #f5f5f5;
    border-left-color: #a3a3a3;
    color: #404040;
  }

  .note-warning {
    background-color: #f0f0f0;
    border-left-color: #808080;
    color: #262626;
  }

  .note-tip {
    background-color: #e8e8e8;
    border-left-color: #666666;
    color: #1a1a1a;
  }

  .note-danger {
    background-color: #e0e0e0;
    border-left-color: #525252;
    color: #171717;
  }

  /* Dark mode support */
  :global(.dark) .note-info {
    background-color: #262626;
    color: #d4d4d4;
  }

  :global(.dark) .note-warning {
    background-color: #333333;
    color: #c0c0c0;
  }

  :global(.dark) .note-tip {
    background-color: #404040;
    color: #a3a3a3;
  }

  :global(.dark) .note-danger {
    background-color: #525252;
    color: #a3a3a3;
  }
</style>
