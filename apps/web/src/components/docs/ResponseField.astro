---
// ResponseField component for API documentation
export interface Props {
  name: string
  type?: string
  required?: boolean
  class?: string
}

const {
  name,
  type = 'string',
  required = false,
  class: className,
} = Astro.props
---

<div class={`response-field ${className || ''}`}>
  <div class="response-field-header">
    <code class="response-field-name">{name}</code>
    {type && <span class="response-field-type">{type}</span>}
    {required && <span class="response-field-required">required</span>}
  </div>
  {Astro.slots.has('default') && (
    <div class="response-field-description">
      <slot />
    </div>
  )}
</div>

<style>
  .response-field {
    @apply border border-border p-4 mb-4;
  }

  .response-field-header {
    @apply flex items-center gap-2 mb-2;
  }

  .response-field-name {
    @apply font-mono text-sm bg-secondary px-2 py-1 rounded-none;
  }

  .response-field-type {
    @apply text-xs bg-secondary text-muted-foreground px-2 py-1 rounded-none;
  }

  .response-field-required {
    @apply text-xs bg-primary text-primary-foreground px-2 py-1 rounded-none;
  }

  .response-field-description {
    @apply text-sm text-muted-foreground;
  }

  .response-field-description :global(p:first-child) {
    @apply mt-0;
  }

  .response-field-description :global(p:last-child) {
    @apply mb-0;
  }
</style>
