---
interface Session {
  id: string
  clientId: string
  therapistId: string
  startTime: string
  status: string
  title: string
}

interface Props {
  sessions: Session[]
  selectedSessionId: string
}

const { sessions, selectedSessionId } = Astro.props

// Format date for display
const formatDate = (dateString: string) => {
  const date = new Date(dateString)
  return date.toLocaleDateString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
  })
}
---

<div class="bg-card rounded-none border border-border overflow-hidden">
  <div class="p-4 border-b border-border">
    <h3 class="text-lg font-semibold">Recent Sessions</h3>
  </div>

  {sessions.length === 0 ? (
    <div class="p-6 text-center text-muted-foreground">No sessions found</div>
  ) : (
    <ul>
      {sessions.map((session) => (
        <li
          class={`border-b border-border last:border-0 ${selectedSessionId === session.id ? 'bg-secondary border-ring' : ''}`}
        >
          <a
            href={`/client/${session.clientId}/sessions/${session.id}`}
            class="block px-4 py-3 hover:bg-accent transition"
          >
            <div class="flex justify-between items-center">
              <div>
                <h4 class="font-medium text-foreground">{session.title}</h4>
                <div class="text-sm text-muted-foreground">
                  {formatDate(session.startTime)}
                </div>
              </div>
              <div>
                <span
                  class={`inline-flex items-center px-2.5 py-0.5 rounded-none text-xs font-medium
                    ${
                      session.status === 'completed'
                        ? 'bg-secondary border border-input text-foreground'
                        : session.status === 'scheduled'
                          ? 'bg-secondary border border-ring text-foreground font-medium'
                          : session.status === 'canceled'
                            ? 'bg-primary text-primary-foreground font-semibold'
                            : 'bg-secondary border border-border text-muted-foreground'
                    }`}
                >
                  {session.status}
                </span>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</div>
