---
interface Session {
  id: string
  clientId: string
  therapistId: string
  startTime: string
  status: string
  title: string
}

interface Props {
  sessions: Session[]
  selectedSessionId: string
}

const { sessions, selectedSessionId } = Astro.props

// Format date for display
const formatDate = (dateString: string) => {
  const date = new Date(dateString)
  return date.toLocaleDateString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
  })
}
---

<div class="overflow-hidden rounded-none border border-border bg-card">
  <div class="border-b border-border p-4">
    <h3 class="text-lg font-semibold">Recent Sessions</h3>
  </div>

  {sessions.length === 0 ? (
    <div class="p-6 text-center text-muted-foreground">No sessions found</div>
  ) : (
    <ul>
      {sessions.map((session) => (
        <li
          class={`border-b border-border last:border-0 ${selectedSessionId === session.id ? 'border-ring bg-secondary' : ''}`}
        >
          <a
            href={`/client/${session.clientId}/sessions/${session.id}`}
            class="block px-4 py-3 transition hover:bg-accent"
          >
            <div class="flex items-center justify-between">
              <div>
                <h4 class="font-medium text-foreground">{session.title}</h4>
                <div class="text-sm text-muted-foreground">
                  {formatDate(session.startTime)}
                </div>
              </div>
              <div>
                <span
                  class={`inline-flex items-center rounded-none px-2.5 py-0.5 text-xs font-medium ${
                    session.status === 'completed'
                      ? 'border border-input bg-secondary text-foreground'
                      : session.status === 'scheduled'
                        ? 'border border-ring bg-secondary font-medium text-foreground'
                        : session.status === 'canceled'
                          ? 'bg-primary font-semibold text-primary-foreground'
                          : 'border border-border bg-secondary text-muted-foreground'
                  }`}
                >
                  {session.status}
                </span>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</div>
