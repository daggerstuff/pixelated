---
// Simple ArticleCard component
// Used to display a card for a blog pos
export interface Props {
  title: string
  description: string
  author?: string
  date?: string
  readingTime?: string
  tags?: string | string[]
}

const {
  title,
  description,
  author,
  date,
  readingTime,
  tags: tagInput,
} = Astro.props

const tags = Array.isArray(tagInput)
  ? tagInput
  : typeof tagInput === 'string'
    ? tagInput
        .split(',')
        .map((tag) => tag.trim())
        .filter((tag) => tag.length > 0)
    : []
---

<div class="mb-5 rounded-none border border-border bg-card p-5">
  <h3 class="text-xl font-bold mb-2">{title}</h3>
  <p class="mb-3 text-muted-foreground">{description}</p>

  <div class="mb-2 flex flex-wrap items-center text-sm text-muted-foreground">
    {author && <span class="mr-3">{author}</span>}
    {date && <span class="mr-3">{date}</span>}
    {readingTime && <span>{readingTime}</span>}
  </div>

  {tags && tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map((tag: string) => (
        <span class="rounded-none border border-border bg-secondary px-2.5 py-0.5 text-xs font-medium text-foreground">
          {tag}
        </span>
      ))}
    </div>
  )}
</div>
