---
import { formatDate } from '@/utils/date'

interface Props {
  title: string
  author: string
  date: string
  readingTime?: string
  tags?: string[]
}

const { title, author, date, readingTime, tags = [] } = Astro.props
const formattedDate = formatDate(date)
---

<div class="mb-12">
  <h1 class="text-4xl font-bold mb-4">{title}</h1>

  <div class="mb-6 flex items-center text-sm text-muted-foreground">
    <span>{formattedDate}</span>
    {readingTime && (
      <span>
        <span class="mx-2">•</span>
        <span>{readingTime}</span>
      </span>
    )}
    <span class="mx-2">•</span>
    <span>{author}</span>
  </div>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map((tag: string) => (
        <a
          href={`/blog/tag/${tag}`}
          class="rounded-none border border-border bg-secondary px-3 py-1 text-sm text-foreground transition-colors hover:bg-accent"
        >
          #{tag}
        </a>
      ))}
    </div>
  )}
</div>
