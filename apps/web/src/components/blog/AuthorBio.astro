---
export interface Props {
  name: string
  image?: string
  credentials?: string
  specialties?: string[]
  bio?: string
}

const {
  name,
  image = '',
  credentials = '',
  specialties = [],
  bio = '',
} = Astro.props
---

<div class="my-6 rounded-none border border-border bg-card p-6">
  <div class="flex items-start gap-4">
    {image && (
      <img src={image} alt={name} class="w-20 h-20 rounded-full object-cover" />
    )}
    <div>
      <h3 class="text-xl font-bold">{name}</h3>
      {credentials && (
        <p class="text-sm text-muted-foreground">{credentials}</p>
      )}

      {specialties.length > 0 && (
        <div class="mt-2">
          <p class="font-medium text-sm">Specialties:</p>
          <div class="flex flex-wrap gap-2 mt-1">
            {specialties.map((specialty: string) => (
              <span class="rounded-none border border-border bg-secondary px-2.5 py-0.5 text-xs font-medium text-foreground">
                {specialty}
              </span>
            ))}
          </div>
        </div>
      )}

      {bio && <p class="mt-3 text-muted-foreground">{bio}</p>}
    </div>
  </div>
</div>
