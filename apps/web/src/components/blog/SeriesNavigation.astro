---
export interface Props {
  series: string
  current: string
  next?: {
    title: string
    url: string
  }
  previous?: {
    title: string
    url: string
  }
}

const { series, current, next, previous } = Astro.props
---

<div class="my-6 rounded-none border border-border bg-secondary p-6">
  <div class="mb-4">
    <h3 class="text-xl font-bold mb-1">{series} Series</h3>
    <p class="text-muted-foreground">Currently reading: {current}</p>
  </div>

  <div class="flex flex-col sm:flex-row gap-4">
    {previous && (
      <a
        href={previous.url}
        class="flex-1 rounded-none border border-border bg-card p-4 transition-colors hover:border-ring"
      >
        <div class="mb-1 text-sm text-muted-foreground">Previous</div>
        <div class="font-medium">{previous.title}</div>
      </a>
    )}

    {next && (
      <a
        href={next.url}
        class="flex-1 rounded-none border border-border bg-card p-4 transition-colors hover:border-ring"
      >
        <div class="mb-1 text-sm text-muted-foreground">Next</div>
        <div class="font-medium">{next.title}</div>
      </a>
    )}
  </div>
</div>
