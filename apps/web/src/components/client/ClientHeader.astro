---
interface Props {
  clientId: string
  name: string
  email: string
  avatar: string
}

const { clientId, name, email, avatar } = Astro.props
---

<div class="mb-6 flex items-center justify-between rounded-none border border-border bg-card p-6">
  <div class="flex items-center">
    <img
      src={avatar}
      alt={name}
      class="mr-4 h-16 w-16 rounded-full object-cover"
    />
    <div>
      <h1 class="text-2xl font-bold">{name}</h1>
      <p class="text-muted-foreground">{email}</p>
      <div class="mt-2 flex">
        <a
          href={`/client/${clientId}`}
          class="mr-4 text-sm text-foreground hover:underline"
        >
          Overview
        </a>
        <a
          href={`/client/${clientId}/sessions`}
          class="mr-4 text-sm text-foreground hover:underline"
        >
          Sessions
        </a>
        <a
          href={`/client/${clientId}/temporal-analysis`}
          class="mr-4 text-sm font-semibold text-foreground hover:underline"
        >
          Temporal Analysis
        </a>
        <a
          href={`/client/${clientId}/insights`}
          class="text-sm text-foreground hover:underline"
        >
          Insights
        </a>
      </div>
    </div>
  </div>
  <div>
    <a
      href={`/client/${clientId}/notes`}
      class="border-transparent hover:bg-primary/90 inline-flex items-center justify-center rounded-none border bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="mr-1 h-4 w-4"
        viewBox="0 0 20 20"
        fill="currentColor"
      >
        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"></path>
      </svg>
      Client Notes
    </a>
  </div>
</div>
