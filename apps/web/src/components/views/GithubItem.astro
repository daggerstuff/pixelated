---
import DOMPurify from 'isomorphic-dompurify'

import Link from '~/components/base/Link.astro'
import { VERSION_COLOR } from '~/utils/data'
import { formatDate } from '~/utils/datetime'

import type { ExtendedReleaseData, ExtendedPrData } from './GithubView.astro'

type Props =
  | {
      collectionType: 'releases'
      idx: number
      item: ExtendedReleaseData
      isDiffMonth: boolean
    }
  | {
      collectionType: 'prs'
      idx: number
      item: ExtendedPrData
      isDiffMonth: boolean
    }

const { collectionType, idx, item, isDiffMonth } = Astro.props

// Organization check - only available for PRs
const isOrg =
  collectionType === 'prs' ? item.repository?.isInOrganization : false

// Logo handling
const mainLogoSrc = item.mainLogo
const mainLogoAlt =
  collectionType === 'releases'
    ? item.pkgName
    : item.repository?.nameWithOwner || ''
const subLogoSrc = item.subLogo

// Link handling
const firstLinkHref = collectionType === 'releases' ? item.link : item.url
const firstLinkText = collectionType === 'releases' ? item.pkgName : item.title

const secondLinkHref =
  collectionType === 'prs' ? item.repository?.url : item.link
const secondLinkText =
  collectionType === 'prs'
    ? item.repository?.nameWithOwner
    : item.repoNameWithOwner

// Time and content handling
const time = collectionType === 'releases' ? item.publishedAt : item.createdAt
const content = collectionType === 'releases' ? item.desc : item.bodyHTML

const sanitizedContent = content
  ? DOMPurify.sanitize(content, {
      ALLOWED_TAGS: [
        'a',
        'b',
        'strong',
        'i',
        'em',
        'u',
        's',
        'code',
        'pre',
        'p',
        'br',
        'hr',
        'ul',
        'ol',
        'li',
        'blockquote',
        'h1',
        'h2',
        'h3',
        'h4',
        'h5',
        'h6',
        'img',
      ],
      ALLOWED_ATTR: ['href', 'title', 'rel', 'target', 'src', 'alt'],
    })
  : undefined
---

<details
  class={`slide-enter flex flex-col ${isDiffMonth ? 'lt-sm:mt-10 mt-12' : ''}`}
  style={{ '--enter-stage': idx }}
>
  {/* Logo */}
  <summary class="lt-sm:gap-2 flex cursor-pointer items-center gap-4">
    <div class="relative flex-none">
      <img
        class={`lt-sm:size-10 mt-0.2 size-11 border border-border ${isOrg ? 'rounded-none' : 'transform-scale-108 rounded-full'}`}
        src={mainLogoSrc}
        alt={mainLogoAlt}
      />
      {subLogoSrc && (
        <div
          class={`right--1.6 p-0.72 absolute bottom--2 flex size-6 items-center justify-center rounded-none border border-border bg-card`}
        >
          {subLogoSrc.includes('://') ? (
            <img src={subLogoSrc} alt="Sub logo" />
          ) : (
            <span class={subLogoSrc} />
          )}
        </div>
      )}
    </div>

    {/* Text */}
    <div class="flex min-w-0 flex-1 items-center justify-between gap-2">
      <div class="flex min-w-0 flex-col gap-0.5">
        <Link
          class="op-100! text-4.4 lt-sm:text-3.9 flex items-center gap-1.5 hover:underline"
          href={firstLinkHref}
          external={true}
        >
          {collectionType === 'prs' &&
            (item.state === 'MERGED' ? (
              <span
                u-i-bx-git-merge
                class="size-4.5 lt-sm:size-4 shrink-0 text-foreground"
              />
            ) : (
              <span
                u-i-bx-git-pull-request
                class="size-4.5 lt-sm:size-4 shrink-0 text-foreground"
              />
            ))}
          <span class="truncate">{firstLinkText}</span>
        </Link>
        <div class="lt-sm:text-3.2 op-transition flex items-center text-sm">
          <Link class="truncate" href={secondLinkHref} external={true}>
            {secondLinkText}
          </Link>
        </div>
      </div>
      <div class="gap-0.6 flex shrink-0 flex-col items-end">
        <Link
          class="op-100! text-4.2 lt-sm:text-3.6 font-mono hover:underline"
          href={firstLinkHref}
          external={true}
        >
          {collectionType === 'releases' && (
            <span>
              v{item.versionParts[0]}
              <span
                class={`rounded ${VERSION_COLOR[item.versionType as keyof typeof VERSION_COLOR] || ''}`}
              >
                {item.versionParts[1]}
              </span>
            </span>
          )}
          {collectionType === 'prs' && <span>#{item.number}</span>}
        </Link>
        <time class="op-60 lt-sm:text-3.2 text-sm" datetime={time} title={time}>
          {formatDate(time, false)}
        </time>
      </div>
    </div>
  </summary>
  <div class="prose github-item-prose" set:html={sanitizedContent || ''} />
</details>
