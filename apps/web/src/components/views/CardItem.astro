---
import type { HTMLAttributes } from 'astro/types'
import { Image } from 'astro:assets'
import type { LocalImageProps, RemoteImageProps } from 'astro:assets'
import DOMPurify from 'isomorphic-dompurify'

import Link from '@/components/base/Link.astro'
import ImageCarousel from '@/components/widgets/ImageCarousel.astro'
import { formatDate } from '@/utils/datetime'

interface ImageData {
  src: string
  alt: string
}

interface VideoData {
  src: string
  alt: string
  thumbnail: string
}

interface ExternalData {
  uri: string
  title: string
  description: string
  thumb: string
}

interface QuoteData {
  uri: string
  text: string
  author: {
    link: string
    avatar: string
    name: string
    handle: string
  }
}

export interface CardItemData {
  date?: Date | string
  text?: string
  html?: string
  link?: string
  images?: ImageData[]
  video?: VideoData
  external?: ExternalData
  quote?: QuoteData
  details?: string[]
}

interface Props {
  // idx?: number
  item: CardItemData
  imageProps?: LocalImageProps | RemoteImageProps
  videoProps?: HTMLAttributes<'video'>
  class?: string | undefined
  href?: string | undefined
}

const {
  // idx,
  item,
  imageProps,
  videoProps,
  class: className,
} = Astro.props

const COMPACT = false
const MAX_DETAILS = 3

const { date, text, html, link, images, video, external, quote, details } = item
const MediaContainer = link ? Link : 'div'
const Content = details ? 'collapsible-content' : 'div'

// ⚡ Bolt: Sanitize HTML in the frontmatter instead of inline to reduce SSR overhead
const sanitizedHtml = html
  ? DOMPurify.sanitize(html, { USE_PROFILES: { html: true } })
  : undefined
const sanitizedDetails = details
  ? details.map((d) => DOMPurify.sanitize(d, { USE_PROFILES: { html: true } }))
  : undefined
---

<section class={className}>
  <div class="b b-border flex flex-col overflow-hidden rounded-none bg-card">
    {((images && images.length > 0) || video) && (
      <MediaContainer
        class="b-b b-b-border op-100!"
        {...(MediaContainer === Link ? { href: link } : {})}
      >
        {images &&
          images.length > 0 &&
          (images.length > 1 ? (
            <ImageCarousel
              {images}
              imageProps={{
                width: 1200,
                height: 675,
              }}
            />
          ) : (
            <Image
              class="aspect-[16/9] object-cover"
              src={images[0]!.src}
              alt={images[0]!.alt}
              width={1200}
              height={675}
              {...imageProps}
            />
          ))}

        {video && (
          <video
            class="aspect-[16/9] w-full object-cover"
            src={video.src}
            poster={video.thumbnail}
            aria-label={video.alt}
            autoplay
            muted
            loop
            playsinline
            {...videoProps}
          />
        )}
      </MediaContainer>
    )}
    {external && (
      <Link
        class="b b-border op-100! mx-3 mt-3 flex flex-col overflow-hidden rounded-none"
        href={external.uri}
      >
        {!COMPACT && external.thumb && (
          <Image
            class="b-b b-b-border aspect-[1.91/1] object-cover"
            src={external.thumb}
            alt={external.title}
            width={1200}
            height={628}
          />
        )}
        <div class="flex flex-col px-3 pb-1 pt-2">
          <div class="b-b b-b-border flex flex-col gap-1 pb-1.5">
            <p class="font-600 text-sm">{external.title}</p>
            <p class="text-xs">{external.description}</p>
          </div>
          <div class="op-70 flex items-center gap-1 pt-1 text-[0.72rem]">
            <div u-i-lucide-globe class="size-1em" aria-hidden="true" />
            <p>{new URL(external.uri).hostname}</p>
          </div>
        </div>
      </Link>
    )}
    {quote && (
      <div class="b b-border mx-3 mt-3 flex flex-col gap-2 overflow-hidden rounded-none p-2 text-sm">
        <div class="flex items-center gap-1">
          <Image
            class="size-1em rounded-full object-cover"
            src={quote.author.avatar}
            alt={quote.author.name}
            inferSize
          />
          <p class="truncate">
            <span class="font-600">{quote.author.name}</span>
            <Link class="op-transition" href={quote.author.link}>
              {`@${quote.author.handle}`}
            </Link>
          </p>
        </div>
        <Link class="op-80!" href={quote.uri}>
          <p class="line-height-normal">{quote.text}</p>
        </Link>
      </div>
    )}
    <Content class="p-4 pb-3">
      {sanitizedHtml && (
        <div class="prose card-item-prose" set:html={sanitizedHtml} />
      )}
      {text && <p class="prose card-item-prose">{text}</p>}
      {sanitizedDetails && (
        <div class="card-item-details" style="max-height: 0; overflow-y: clip;">
          <ol class="relative border-s border-border">
            {sanitizedDetails
              .slice(0, MAX_DETAILS + 1)
              .map((detail: string, idx: number) => (
                <li class="mb-6 ms-4 last:mb-0">
                  <div class="start--1.6 absolute mt-1.5 h-3 w-3 rounded-full border border-background bg-secondary" />
                  {idx < MAX_DETAILS && (
                    <div class="prose card-item-prose" set:html={detail} />
                  )}
                  {link && idx === MAX_DETAILS && (
                    <Link class="prose card-item-prose op-100!" href={link}>
                      View more...
                    </Link>
                  )}
                </li>
              ))}
          </ol>
        </div>
      )}
      {date && (
        <div class="flex items-center justify-between pt-3 text-sm">
          {link ? (
            <Link class="op-transition flex-auto" href={link}>
              {formatDate(date, false)}
            </Link>
          ) : (
            <p class="op-60">{formatDate(date, false)}</p>
          )}
          {sanitizedDetails && (
            <button
              type="button"
              aria-expanded="false"
              aria-label="Toggle details"
              class="details-switch op-50 op-transition hover:op-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
            >
              <div u-i-lucide-chevron-down class="icon-down" />
              <div u-i-lucide-chevron-up class="icon-up hidden" />
            </button>
          )}
        </div>
      )}
    </Content>
  </div>
</section>

<script>
  class CollapsibleContent extends HTMLElement {
    #isExpanded = false
    #detailsContainer: HTMLElement | null = null
    #button: HTMLElement | null = null
    #upIcon: HTMLElement | null = null
    #downIcon: HTMLElement | null = null
    #handleClick: (() => void) | null = null

    connectedCallback() {
      this.#detailsContainer = this.querySelector('.card-item-details')
      this.#button = this.querySelector('.details-switch')
      this.#downIcon = this.querySelector('.icon-down')
      this.#upIcon = this.querySelector('.icon-up')

      this.#isExpanded = false
      this.#setupEventListeners()
    }

    disconnectedCallback() {
      this.#cleanup()
    }

    #setupEventListeners = () => {
      if (!this.#button) return

      this.#handleClick = () => {
        if (!this.#detailsContainer || !this.#upIcon || !this.#downIcon) return

        this.#isExpanded = !this.#isExpanded

        if (this.#isExpanded) {
          this.#detailsContainer.style.marginTop = '1.1rem'
          this.#detailsContainer.style.maxHeight = `${this.#detailsContainer.scrollHeight}px`
          this.#upIcon.classList.remove('hidden')
          this.#downIcon.classList.add('hidden')
          this.#button?.setAttribute('aria-expanded', 'true')
        } else {
          this.#detailsContainer.style.marginTop = '0'
          this.#detailsContainer.style.maxHeight = '0'
          this.#upIcon.classList.add('hidden')
          this.#downIcon.classList.remove('hidden')
          this.#button?.setAttribute('aria-expanded', 'false')
        }
      }

      this.#button.addEventListener('click', this.#handleClick)
    }

    #cleanup = () => {
      if (this.#button && this.#handleClick) {
        this.#button.removeEventListener('click', this.#handleClick)
        this.#handleClick = null
      }
    }
  }

  customElements.define('collapsible-content', CollapsibleContent)
</script>
