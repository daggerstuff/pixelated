---
export const prerender = false
import Link from '@/components/base/Link.astro'
import GithubView from '@/components/views/GithubView.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const frontmatter = {
  title: 'AstroEco is Releasing...',
  description:
    'Example: Displaying GitHub releases using astro-loader-github-releases',
}
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <section class="py-12">
    <div class="mx-auto max-w-6xl px-4 text-center">
      <h1 class="text-white mb-4 text-4xl font-bold">
        AstroEco is <span class="animate-pulse">Releasing...</span>
      </h1>
      <p class="mb-12 italic text-muted-foreground">
        Example: Displaying GitHub releases using{' '}
        <Link
          href="https://github.com/lin-stephanie/astro-loaders/tree/main/packages/astro-loader-github-releases"
          external={true}
        >
          astro-loader-github-releases
        </Link>
      </p>
      <GithubView collectionType="releases" />
    </div>
  </section>
</BaseLayout>
