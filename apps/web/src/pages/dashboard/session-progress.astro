---
export const prerender = false

import Card from '@/components/ui/Card.astro'
import {
  DynamicMultiSessionProgression,
  DynamicBeliefChangeTracker,
  DynamicDefenseMechanismAdaptation,
  DynamicGoalAttainmentScale,
} from '@/lib/utils/dynamic-components'

import DashboardLayout from '../../layouts/DashboardLayout.astro'

const { user } = Astro.props as { user: any }

const therapistId = Astro.url.searchParams.get('therapistId') || user?.id || ''
const sessionId = Astro.url.searchParams.get('sessionId') || ''
---

<DashboardLayout
  title="Session Progress | Pixelated Empathy Therapy"
  description="Multi-session progression tracking with belief changes, defense mechanisms, and goal attainment"
>
  <div class="container mx-auto space-y-6 py-6">
    <div class="mb-8 flex items-center justify-between">
      <div>
        <p class="mb-1 font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground">
          Longitudinal tracking
        </p>
        <h1 class="mb-2 text-4xl font-bold tracking-tight">Session Progress</h1>
        <p class="text-lg text-muted-foreground">
          Multi-session progression metrics, belief changes, and therapeutic
          outcomes
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/dashboard/enhanced?mode=analytics"
          class="hover:bg-secondary/80 rounded-none bg-secondary px-4 py-2 text-sm text-secondary-foreground transition-colors"
        >
          Back to Analytics
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
      <Card>
        <div class="p-4">
          <p class="text-sm font-medium text-muted-foreground">Sessions</p>
          <p class="text-2xl font-bold">—</p>
        </div>
      </Card>
      <Card>
        <div class="p-4">
          <p class="text-sm font-medium text-muted-foreground">Avg Alliance</p>
          <p class="text-2xl font-bold">—/10</p>
        </div>
      </Card>
      <Card>
        <div class="p-4">
          <p class="text-sm font-medium text-muted-foreground">
            Beliefs Tracked
          </p>
          <p class="text-2xl font-bold">—</p>
        </div>
      </Card>
      <Card>
        <div class="p-4">
          <p class="text-sm font-medium text-muted-foreground">
            Goals Achieved
          </p>
          <p class="text-2xl font-bold">—/—</p>
        </div>
      </Card>
    </div>

    <Card>
      <div class="p-6">
        <DynamicMultiSessionProgression client:visible sessions={[]} />
      </div>
    </Card>

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
      <Card>
        <div class="p-6">
          <DynamicBeliefChangeTracker client:visible beliefs={[]} />
        </div>
      </Card>

      <Card>
        <div class="p-6">
          <DynamicDefenseMechanismAdaptation client:visible defenses={[]} />
        </div>
      </Card>
    </div>

    <Card>
      <div class="p-6">
        <DynamicGoalAttainmentScale client:visible goals={[]} />
      </div>
    </Card>

    <div class="flex items-center justify-between border-t border-border pt-6">
      <div class="flex items-center gap-4 text-sm text-muted-foreground">
        <span>
          Therapist: <span class="font-medium">{therapistId || '—'}</span>
        </span>
        <span>•</span>
        <span>
          Session: <span class="font-medium">{sessionId || 'All'}</span>
        </span>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/dashboard/enhanced?mode=analytics"
          class="hover:bg-secondary/80 rounded-none bg-secondary px-4 py-2 text-sm text-secondary-foreground transition-colors"
        >
          Analytics Dashboard
        </a>
        <a
          href="/dashboard/enhanced"
          class="hover:bg-primary/90 rounded-lg bg-primary px-4 py-2 text-sm text-primary-foreground transition-colors"
        >
          Enhanced Dashboard
        </a>
      </div>
    </div>
  </div>
</DashboardLayout>
