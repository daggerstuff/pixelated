---
export const prerender = false

import {
  BarChart3,
  TrendingUp,
  Users,
  PieChart,
  Clock,
  Activity,
} from 'lucide-react'

import Card from '@/components/ui/Card.astro'
import DashboardLayout from '@/layouts/DashboardLayout.astro'

// Mock data - will be replaced with real API data
const mockData = {
  passRate: 0.72,
  scoreDistribution: {
    technique: 0.85,
    alliance: 0.78,
    structure: 0.82,
    cultural: 0.65,
    ebp: 0.71,
    dsm5: 0.58,
  },
  queueDepth: 14,
  weeklyTrend: [
    { date: '2026-06-13', passRate: 0.68, queueDepth: 12 },
    { date: '2026-06-14', passRate: 0.7, queueDepth: 13 },
    { date: '2026-06-15', passRate: 0.69, queueDepth: 11 },
    { date: '2026-06-16', passRate: 0.71, queueDepth: 12 },
    { date: '2026-06-17', passRate: 0.72, queueDepth: 13 },
    { date: '2026-06-18', passRate: 0.73, queueDepth: 14 },
    { date: '2026-06-19', passRate: 0.72, queueDepth: 14 },
  ],
}

// Fetch data from API
let data = mockData
let isLoading = false
let error: string | null = null

try {
  const response = await fetch('/api/dashboard/clinical-validity')
  if (response.ok) {
    data = await response.json()
  } else {
    error = `API returned ${response.status}: ${response.statusText}`
  }
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to fetch data'
  console.error('Failed to fetch clinical validity data:', err)
}

// Calculate rolling 7-day average and check for degradation
let showDegradationAlert = false
let degradationDetails = {
  currentPassRate: data.passRate,
  rollingAverage: 0,
  degradationPercentage: 0,
}

if (data.weeklyTrend && data.weeklyTrend.length > 0) {
  // Calculate rolling 7-day average from weeklyTrend
  const sum = data.weeklyTrend.reduce((total, day) => total + day.passRate, 0)
  const rollingAverage = sum / data.weeklyTrend.length

  degradationDetails.rollingAverage = rollingAverage
  degradationDetails.currentPassRate = data.passRate

  // Check if current pass rate is more than 10 percentage points below rolling average
  // currentPassRate < (rollingAverage - 0.10)
  const degradationThreshold = rollingAverage - 0.1
  showDegradationAlert = data.passRate < degradationThreshold

  // Calculate degradation in percentage points (absolute difference)
  degradationDetails.degradationPercentage =
    (rollingAverage - data.passRate) * 100
}
---

<DashboardLayout
  title="Clinical Validity Dashboard | Pixelated Empathy"
  description="Monitor clinical validity pass rates, per-dimension score distributions, annotation queue depth, and 7-day trends"
>
  <div class="container mx-auto px-4 py-6">
    {/* Header */}
    <div class="mb-8">
      <h1 class="mb-2 text-3xl font-bold tracking-tight">
        Clinical Validity Dashboard
      </h1>
      <p class="text-muted-foreground">
        Monitor scoring performance across 6 clinical dimensions and annotation
        queue status. Figures on this page are mock data for layout review, not
        measured results.
      </p>
    </div>

    {/* Degradation Alert */}
    {showDegradationAlert && (
      <div
        class="relative mb-6 rounded-none border border-ring bg-secondary p-4"
        role="alert"
        aria-labelledby="degradation-alert-title"
        aria-describedby="degradation-alert-description"
      >
        <div class="flex items-start gap-3">
          {/* Icon */}
          <div class="flex-shrink-0 rounded-none bg-secondary p-2">
            <svg
              class="h-5 w-5 text-foreground"
              fill="currentColor"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
                clip-rule="evenodd"
              />
            </svg>
          </div>

          {/* Content */}
          <div class="flex-1">
            <h3
              id="degradation-alert-title"
              class="mb-1 text-lg font-semibold text-foreground"
            >
              Performance Degradation Detected
            </h3>
            <p
              id="degradation-alert-description"
              class="mb-3 text-muted-foreground"
            >
              Clinical validity pass rate has dropped{' '}
              {degradationDetails.degradationPercentage.toFixed(1)} percentage
              points below the 7-day rolling average (more than 10% threshold).
              Current: {(degradationDetails.currentPassRate * 100).toFixed(1)}%
              vs Average: {(degradationDetails.rollingAverage * 100).toFixed(1)}
              %
            </p>
            <div class="flex flex-wrap gap-2">
              <button
                class="hover:bg-primary/90 rounded-none bg-primary px-4 py-2 font-medium text-primary-foreground transition-colors focus:outline-none focus:ring-2 focus:ring-ring"
                onclick="console.log('Investigate degradation')"
              >
                Investigate
              </button>
              <button
                class="rounded-none border border-border bg-secondary px-4 py-2 font-medium text-foreground transition-colors hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring"
                onclick="this.closest('[role=\'alert\']').style.display = 'none'"
              >
                Dismiss
              </button>
            </div>
          </div>
        </div>

        {/* Accessibility: hidden live region for screen readers */}
        <div aria-live="assertive" class="sr-only">
          Alert: Performance degradation detected. Clinical validity pass rate
          has dropped {degradationDetails.degradationPercentage.toFixed(1)}{' '}
          percentage points below the 7-day rolling average.
        </div>
      </div>
    )}

    {/* Error State */}
    {error && (
      <div class="mb-6 rounded-none border border-ring bg-secondary p-4">
        <p class="font-medium text-foreground">Unable to load dashboard data</p>
        <p class="mt-1 text-sm text-foreground">{error}</p>
        <p class="mt-2 text-sm text-muted-foreground">
          Showing mock data for demonstration. Ensure the clinical validity API
          endpoint is running.
        </p>
      </div>
    )}

    {/* Loading State */}
    {isLoading && (
      <div class="mb-6 rounded-none border border-border bg-secondary p-4">
        <p class="font-medium text-foreground">Loading dashboard data...</p>
      </div>
    )}

    {/* Key Metrics Grid */}
    <div class="mb-8 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
      {/* Current Pass Rate */}
      <Card class="p-6">
        <div class="mb-4 flex items-center gap-3">
          <div class="rounded-none bg-secondary p-2">
            <TrendingUp class="h-5 w-5 text-foreground" />
          </div>
          <h3 class="text-lg font-semibold">Current Pass Rate</h3>
        </div>
        <div class="mb-1 text-3xl font-bold">
          {(data.passRate * 100).toFixed(1)}%
        </div>
        <p class="mb-2 text-sm text-muted-foreground">Samples scoring ≥ 0.6</p>
        <div class="flex items-center gap-1 text-sm font-medium text-foreground">
          <TrendingUp class="h-4 w-4" /> +2.1%
        </div>
      </Card>

      {/* Queue Depth */}
      <Card class="p-6">
        <div class="mb-4 flex items-center gap-3">
          <div class="rounded-none bg-secondary p-2">
            <Users class="h-5 w-5 text-foreground" />
          </div>
          <h3 class="text-lg font-semibold">Queue Depth</h3>
        </div>
        <div class="mb-1 text-3xl font-bold">{data.queueDepth}</div>
        <p class="mb-2 text-sm text-muted-foreground">
          Samples awaiting review
        </p>
        <div class="flex items-center gap-1 text-sm font-medium text-foreground">
          <span>+1</span>
        </div>
      </Card>

      {/* 7-Day Avg */}
      <Card class="p-6">
        <div class="mb-4 flex items-center gap-3">
          <div class="rounded-none bg-secondary p-2">
            <Activity class="h-5 w-5 text-foreground" />
          </div>
          <h3 class="text-lg font-semibold">7-Day Avg</h3>
        </div>
        <div class="mb-1 text-3xl font-bold">
          {(
            (data.weeklyTrend.reduce((sum, day) => sum + day.passRate, 0) /
              data.weeklyTrend.length) *
            100
          ).toFixed(1)}
          %
        </div>
        <p class="mb-2 text-sm text-muted-foreground">
          Weekly average pass rate
        </p>
        <div class="flex items-center gap-1 text-sm font-medium text-foreground">
          <TrendingUp class="h-4 w-4" /> +1.5%
        </div>
      </Card>

      {/* Total Scored */}
      <Card class="p-6">
        <div class="mb-4 flex items-center gap-3">
          <div class="rounded-none bg-secondary p-2">
            <BarChart3 class="h-5 w-5 text-foreground" />
          </div>
          <h3 class="text-lg font-semibold">Total Scored</h3>
        </div>
        <div class="mb-1 text-3xl font-bold">1,247</div>
        <p class="mb-2 text-sm text-muted-foreground">Samples evaluated</p>
        <div class="flex items-center gap-1 text-sm font-medium text-foreground">
          <TrendingUp class="h-4 w-4" /> +42
        </div>
      </Card>
    </div>

    {/* Main Content Grid */}
    <div class="mb-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
      {/* Score Distribution */}
      <Card class="lg:col-span-2">
        <div class="p-6">
          <div class="mb-4 flex items-center justify-between">
            <h2 class="text-xl font-semibold">
              Per-Dimension Score Distribution
            </h2>
            <PieChart class="h-5 w-5 text-muted-foreground" />
          </div>
          <p class="mb-6 text-muted-foreground">
            Breakdown across 6 clinical validity dimensions
          </p>

          <div class="space-y-4">
            {Object.entries(data.scoreDistribution).map(
              ([dimension, score]) => {
                const width = `${score * 100}%`
                const scorePercent = (score * 100).toFixed(1)
                let colorClass = 'bg-foreground'
                if (score < 0.6) colorClass = 'bg-primary/70'
                if (score < 0.4) colorClass = 'bg-muted-foreground/50'

                return (
                  <div>
                    <div class="mb-1 flex justify-between text-sm">
                      <span class="font-medium capitalize">{dimension}</span>
                      <span class="font-mono">{scorePercent}%</span>
                    </div>
                    <div class="bg-surface h-2 overflow-hidden rounded-none">
                      <div
                        class={`h-full ${colorClass} rounded-none transition-all duration-500`}
                        style={`width: ${width}`}
                      />
                    </div>
                  </div>
                )
              },
            )}
          </div>
        </div>
      </Card>

      {/* Queue Status */}
      <Card>
        <div class="p-6">
          <div class="mb-4 flex items-center justify-between">
            <h2 class="text-xl font-semibold">Annotation Queue</h2>
            <Clock class="h-5 w-5 text-muted-foreground" />
          </div>

          <div class="mb-6 text-center">
            <div class="mb-2 text-5xl font-bold">{data.queueDepth}</div>
            <p class="text-muted-foreground">samples awaiting review</p>
          </div>

          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-sm">High priority</span>
              <span class="font-semibold">3</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm">Medium priority</span>
              <span class="font-semibold">7</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm">Low priority</span>
              <span class="font-semibold">4</span>
            </div>
          </div>

          <button class="hover:bg-accent-hover mt-6 w-full rounded-none bg-accent px-4 py-2.5 font-medium text-foreground transition-colors">
            Review Next Sample
          </button>
        </div>
      </Card>
    </div>

    {/* 7-Day Trend */}
    <Card class="mb-8">
      <div class="p-6">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-xl font-semibold">7-Day Trend</h2>
          <BarChart3 class="h-5 w-5 text-muted-foreground" />
        </div>
        <p class="mb-6 text-muted-foreground">
          Pass rate and queue depth trends over the past week
        </p>

        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-border">
                <th class="px-4 py-3 text-left font-medium">Date</th>
                <th class="px-4 py-3 text-left font-medium">Pass Rate</th>
                <th class="px-4 py-3 text-left font-medium">Queue Depth</th>
                <th class="px-4 py-3 text-left font-medium">Status</th>
              </tr>
            </thead>
            <tbody>
              {data.weeklyTrend.map((day, index) => {
                const passRatePercent = (day.passRate * 100).toFixed(1)
                let status = 'Good'
                let statusColor = 'text-muted-foreground'

                if (day.passRate < 0.65) {
                  status = 'Needs attention'
                  statusColor = 'text-foreground font-medium'
                }
                if (day.passRate < 0.55) {
                  status = 'Critical'
                  statusColor = 'text-foreground font-bold'
                }

                return (
                  <tr class="hover:bg-surface/50 border-b border-border last:border-0">
                    <td class="px-4 py-3">{day.date}</td>
                    <td class="px-4 py-3 font-mono">{passRatePercent}%</td>
                    <td class="px-4 py-3">{day.queueDepth}</td>
                    <td class={`px-4 py-3 font-medium ${statusColor}`}>
                      {status}
                    </td>
                  </tr>
                )
              })}
            </tbody>
          </table>
        </div>
      </div>
    </Card>

    {/* Info Panel */}
    <Card class="bg-surface/50">
      <div class="p-6">
        <h3 class="mb-3 text-lg font-semibold">
          About Clinical Validity Scoring
        </h3>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          <div>
            <h4 class="mb-2 font-medium">6 Dimensions</h4>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>• Technique: Therapeutic modality detection</li>
              <li>• Alliance: Collaboration & validation</li>
              <li>• Structure: Assessment & planning</li>
              <li>• Cultural: Cultural awareness</li>
              <li>• EBP: Evidence-based practice</li>
              <li>• DSM-5: Clinical diagnosis alignment</li>
            </ul>
          </div>
          <div>
            <h4 class="mb-2 font-medium">Scoring Thresholds</h4>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>• Accept: ≥ 0.6 (pass through)</li>
              <li>• Borderline: 0.4 - 0.6 (needs review)</li>
              <li>• Reject: &lt; 0.4 (filtered out)</li>
              <li>• Current target: ≥ 50% pass rate</li>
            </ul>
          </div>
          <div>
            <h4 class="mb-2 font-medium">Data Sources</h4>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>• ClinicalValidityScorer v4</li>
              <li>• 241 pre-labeled validation samples</li>
              <li>• SDG pipeline outputs</li>
              <li>• Annotation queue API</li>
            </ul>
          </div>
        </div>
      </div>
    </Card>
  </div>
</DashboardLayout>
