---
import { ChartBar, Target, TrendingUp } from 'lucide-react'

import BrutalistButton from '@/components/ui/BrutalistButton.astro'
import BrutalistCard from '@/components/ui/BrutalistCard.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
export const prerender = false
---

<BaseLayout
  title="Advanced Analytics - Bias Detection Dashboard - Pixelated"
  description="Comprehensive analytics and insights for bias detection patterns and system performance"
>
  <!-- Hero Section -->
  <section class="brutalist-section relative overflow-hidden">
    <!-- Floating Background Elements -->

    <div class="brutalist-container relative z-10">
      <div class="mb-12 text-center">
        <div class="nav-pill nav-pill--active mb-8 inline-flex items-center gap-3">
          <div class="status-dot status-dot--processing"></div>
          <span class="font-bold">ADVANCED ANALYTICS</span>
        </div>

        <h1 class="brutalist-heading mb-6 text-5xl md:text-7xl">
          <span class="gradient-text-secondary">DATA</span>
          <br />
          <span class="gradient-text-primary">INSIGHTS</span>
        </h1>

        <p class="mx-auto mb-8 max-w-4xl text-xl text-foreground">
          Deep analytical insights into bias patterns, demographic trends, and
          system performance. Enterprise-grade reporting with actionable
          intelligence.
        </p>

        <!-- Time Range Selector -->
        <div class="mb-12 flex flex-wrap justify-center gap-4">
          <button class="nav-pill time-range-btn active" data-days="7">
            Last 7 Days
          </button>
          <button class="nav-pill time-range-btn" data-days="30">
            Last 30 Days
          </button>
          <button class="nav-pill time-range-btn" data-days="90">
            Last 90 Days
          </button>
          <button class="nav-pill time-range-btn" data-days="365">
            Last Year
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Analytics Dashboard -->
  <section class="brutalist-section bg-secondary">
    <div class="brutalist-container">
      <!-- Key Insights Cards -->
      <div class="mb-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        <BrutalistCard variant="elevated" class="text-center">
          <div class="mb-3 text-3xl">
            <ChartBar className="h-8 w-8" />
          </div>
          <div class="metric-value" id="total-analyses">
            0
          </div>
          <div class="metric-label">Total Analyses</div>
          <div class="mt-2 text-sm text-foreground" id="analysis-trend">
            Loading...
          </div>
        </BrutalistCard>

        <BrutalistCard variant="elevated" class="text-center">
          <div class="mb-3 text-3xl">
            <Target className="h-8 w-8" />
          </div>
          <div class="metric-value" id="avg-bias-score">
            0%
          </div>
          <div class="metric-label">Average Bias Score</div>
          <div class="mt-2 text-sm text-foreground" id="bias-trend">
            Loading...
          </div>
        </BrutalistCard>

        <BrutalistCard variant="elevated" class="text-center">
          <div class="mb-3 text-3xl">🚨</div>
          <div class="metric-value" id="high-alerts">
            0
          </div>
          <div class="metric-label">High Alerts</div>
          <div class="mt-2 text-sm text-foreground" id="alert-trend">
            Loading...
          </div>
        </BrutalistCard>

        <BrutalistCard variant="elevated" class="text-center">
          <div class="mb-3 text-3xl">👥</div>
          <div class="metric-value" id="unique-demographics">
            0
          </div>
          <div class="metric-label">Demographic Groups</div>
          <div class="mt-2 text-sm text-foreground" id="demo-trend">
            Loading...
          </div>
        </BrutalistCard>
      </div>

      <!-- Main Chart -->
      <BrutalistCard variant="elevated" class="mb-12">
        <div class="space-y-6">
          <div class="border-b border-border pb-4">
            <h3 class="brutalist-subheading mb-2 text-xl">
              BIAS TRENDS OVER TIME
            </h3>
            <p class="text-sm text-foreground">
              Historical analysis of bias scores, session volume, and alert
              patterns
            </p>
          </div>

          <div
            id="main-chart-container"
            class="flex min-h-[400px] items-center justify-center"
          >
            <div class="text-center text-foreground">
              <div class="mb-2 text-4xl">
                <TrendingUp className="h-10 w-10" />
              </div>
              <p>Loading analytics data...</p>
            </div>
          </div>
        </div>
      </BrutalistCard>

      <!-- Detailed Analytics Grid -->
      <div class="mb-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
        <!-- Bias Distribution -->
        <BrutalistCard variant="elevated">
          <div class="space-y-6">
            <div class="border-b border-border pb-4">
              <h3 class="brutalist-subheading mb-2 text-xl">
                BIAS SCORE DISTRIBUTION
              </h3>
              <p class="text-sm text-foreground">
                Breakdown of bias scores by severity levels
              </p>
            </div>

            <div id="bias-distribution" class="space-y-4">
              <div class="py-8 text-center text-foreground">
                <div class="mb-2 text-3xl">
                  <ChartBar className="h-8 w-8" />
                </div>
                <p>Loading distribution data...</p>
              </div>
            </div>
          </div>
        </BrutalistCard>

        <!-- Demographic Analysis -->
        <BrutalistCard variant="elevated">
          <div class="space-y-6">
            <div class="border-b border-border pb-4">
              <h3 class="brutalist-subheading mb-2 text-xl">
                DEMOGRAPHIC ANALYSIS
              </h3>
              <p class="text-sm text-foreground">
                Bias patterns across different demographic groups
              </p>
            </div>

            <div id="demographic-analysis" class="space-y-4">
              <div class="py-8 text-center text-foreground">
                <div class="mb-2 text-3xl">👥</div>
                <p>Loading demographic data...</p>
              </div>
            </div>
          </div>
        </BrutalistCard>
      </div>

      <!-- Bias Patterns Analysis -->
      <BrutalistCard variant="elevated" class="mb-12">
        <div class="space-y-6">
          <div class="border-b border-border pb-4">
            <h3 class="brutalist-subheading mb-2 text-xl">TOP BIAS PATTERNS</h3>
            <p class="text-sm text-foreground">
              Most common bias patterns detected in analysis layers
            </p>
          </div>

          <div id="bias-patterns" class="space-y-4">
            <div class="py-8 text-center text-foreground">
              <div class="mb-2 text-3xl">🔍</div>
              <p>Loading pattern analysis...</p>
            </div>
          </div>
        </div>
      </BrutalistCard>
    </div>
  </section>

  <!-- Export & Actions -->
  <section class="brutalist-section">
    <div class="brutalist-container">
      <div class="mb-12 text-center">
        <h2 class="brutalist-heading mb-4 text-3xl md:text-5xl">
          EXPORT & REPORTING
        </h2>
        <p class="text-lg text-foreground">
          Generate comprehensive reports and export analytics data
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        <BrutalistCard hover={true}>
          <div class="text-center">
            <div class="mb-4 text-4xl">📄</div>
            <h3 class="brutalist-subheading mb-3 text-lg">PDF REPORT</h3>
            <p class="mb-4 text-sm text-foreground">
              Generate comprehensive PDF reports with charts, insights, and
              recommendations.
            </p>
            <BrutalistButton
              href="#"
              variant="secondary"
              size="sm"
              id="export-pdf"
            >
              GENERATE PDF →
            </BrutalistButton>
          </div>
        </BrutalistCard>

        <BrutalistCard hover={true}>
          <div class="text-center">
            <div class="mb-4 text-4xl">
              <ChartBar className="h-10 w-10" />
            </div>
            <h3 class="brutalist-subheading mb-3 text-lg">EXCEL EXPORT</h3>
            <p class="mb-4 text-sm text-foreground">
              Export raw data and analytics to Excel format for further
              analysis.
            </p>
            <BrutalistButton
              href="#"
              variant="secondary"
              size="sm"
              id="export-excel"
            >
              EXPORT EXCEL →
            </BrutalistButton>
          </div>
        </BrutalistCard>

        <BrutalistCard hover={true}>
          <div class="text-center">
            <div class="mb-4 text-4xl">📧</div>
            <h3 class="brutalist-subheading mb-3 text-lg">SCHEDULED REPORTS</h3>
            <p class="mb-4 text-sm text-foreground">
              Set up automated report generation and email delivery schedules.
            </p>
            <BrutalistButton
              href="#"
              variant="secondary"
              size="sm"
              id="schedule-reports"
            >
              SCHEDULE REPORTS →
            </BrutalistButton>
          </div>
        </BrutalistCard>
      </div>
    </div>
  </section>

  <!-- Navigation -->
  <section class="brutalist-section bg-secondary">
    <div class="brutalist-container">
      <div class="text-center">
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          <BrutalistButton
            href="/dashboard/bias-detection"
            variant="secondary"
            size="lg"
          >
            ← BACK TO DASHBOARD
          </BrutalistButton>
          <BrutalistButton
            href="/admin/bias-detection"
            variant="primary"
            size="lg"
          >
            VIEW DETAILED REPORTS →
          </BrutalistButton>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .time-range-btn {
    @apply bg-secondary transition-colors duration-200 hover:bg-accent;
  }

  .time-range-btn.active {
    @apply bg-primary text-primary-foreground;
  }

  .metric-value {
    @apply mb-1 text-3xl font-bold text-foreground;
  }

  .metric-label {
    @apply text-sm text-foreground;
  }

  /* Status dots */
  .status-dot {
    @apply h-3 w-3 rounded-full;
  }

  .status-dot--processing {
    @apply animate-pulse bg-primary;
  }

  /* Gradient text */
  .gradient-text-primary {
    @apply text-transparent bg-card bg-clip-text;
  }

  .gradient-text-secondary {
    @apply text-transparent bg-card bg-clip-text;
  }
</style>

<script>
  // Scoped §2.1 data marks: multi-series chart hues, defined once
  // (series identity across categories must read at a glance).
  const SERIES_COLORS = {
    biasLine: '#EF4444',
    sessionBars: '#3B82F6',
    alertLine: '#F59E0B',
  } as const

  // Chart chrome (gridlines) on the neutral ramp, resolved at runtime
  // so it follows the active theme token.
  const GRID_COLOR =
    getComputedStyle(document.documentElement)
      .getPropertyValue('--np-line')
      .trim() || 'rgba(255, 255, 255, 0.08)'

  // Bias-distribution severity-tier dot glyphs (§2.1 categorical marks,
  // slice-41 biasScoreTierFill precedent).
  const DISTRIBUTION_TIER_DOT: Record<string, string> = {
    'Very Low': 'bg-green-400',
    'Low': 'bg-blue-400',
    'Medium': 'bg-yellow-400',
    'High': 'bg-orange-400',
  }

  class AdvancedAnalyticsDashboard {
    private currentDays: number = 30
    private analyticsData: any = null

    constructor() {
      this.currentDays = 30
      this.analyticsData = null
      this.initializeDashboard()
      this.setupTimeRangeButtons()
    }

    async initializeDashboard() {
      await this.loadAnalyticsData()
      this.renderDashboard()
    }

    async loadAnalyticsData() {
      try {
        const response = await fetch(
          `/api/dashboard/bias-detection/analytics?days=${this.currentDays}`,
        )
        if (response.ok) {
          this.analyticsData = await response.json()
        } else {
          console.warn('Analytics data loading failed:', response.status)
        }
      } catch (error) {
        console.warn('Analytics data loading error:', error)
      }
    }

    setupTimeRangeButtons() {
      const buttons = document.querySelectorAll('.time-range-btn')
      buttons.forEach((button) => {
        button.addEventListener('click', async (e: any) => {
          const target = e.target as HTMLElement
          const days = parseInt(target.dataset['days'] || '30')

          // Update active state
          buttons.forEach((btn) => btn.classList.remove('active'))
          target.classList.add('active')

          // Load new data
          this.currentDays = days
          await this.loadAnalyticsData()
          this.renderDashboard()
        })
      })
    }

    renderDashboard() {
      if (!this.analyticsData) return

      this.renderKeyMetrics()
      this.renderMainChart()
      this.renderBiasDistribution()
      this.renderDemographicAnalysis()
      this.renderBiasPatterns()
    }

    renderKeyMetrics() {
      const { historical, demographics } = this.analyticsData

      // Calculate metrics
      const totalAnalyses = historical.reduce(
        (sum: any, day: any) => sum + day.sessionCount,
        0,
      )
      const avgBiasScore =
        historical.length > 0
          ? (
              (historical.reduce(
                (sum: any, day: any) => sum + day.biasScore,
                0,
              ) /
                historical.length) *
              100
            ).toFixed(1)
          : '0.0'
      const highAlerts = historical.reduce(
        (sum: any, day: any) => sum + day.alertCount,
        0,
      )
      const uniqueDemographics = demographics.length

      // Update DOM
      const totalAnalysesEl = document.getElementById('total-analyses')
      if (totalAnalysesEl)
        totalAnalysesEl.textContent = totalAnalyses.toString()

      const avgBiasScoreEl = document.getElementById('avg-bias-score')
      if (avgBiasScoreEl) avgBiasScoreEl.textContent = avgBiasScore + '%'

      const highAlertsEl = document.getElementById('high-alerts')
      if (highAlertsEl) highAlertsEl.textContent = highAlerts.toString()

      const uniqueDemographicsEl = document.getElementById(
        'unique-demographics',
      )
      if (uniqueDemographicsEl)
        uniqueDemographicsEl.textContent = uniqueDemographics.toString()

      // Update trends (simplified)
      const analysisTrendEl = document.getElementById('analysis-trend')
      if (analysisTrendEl) analysisTrendEl.textContent = '+12% from last period'

      const biasTrendEl = document.getElementById('bias-trend')
      if (biasTrendEl) biasTrendEl.textContent = '-5% improvement'

      const alertTrendEl = document.getElementById('alert-trend')
      if (alertTrendEl) alertTrendEl.textContent = '+8% this period'

      const demoTrendEl = document.getElementById('demo-trend')
      if (demoTrendEl) demoTrendEl.textContent = '3 new groups'
    }

    renderMainChart() {
      const container = document.getElementById('main-chart-container')
      if (!container) return

      // Create canvas for chart
      container.innerHTML =
        '<canvas id="main-analytics-chart" class="w-full" style="height: 400px;"></canvas>'

      const canvas = document.getElementById(
        'main-analytics-chart',
      ) as HTMLCanvasElement
      if (!canvas) return

      const ctx = canvas.getContext('2d')
      if (!ctx) return

      const { historical } = this.analyticsData
      if (!historical.length) return

      // Set canvas size
      const rect = canvas.getBoundingClientRect()
      canvas.width = rect.width * window.devicePixelRatio
      canvas.height = 400 * window.devicePixelRatio
      ctx.scale(window.devicePixelRatio, window.devicePixelRatio)

      // Chart dimensions
      const padding = 60
      const chartWidth = rect.width - padding * 2
      const chartHeight = 400 - padding * 2

      // Clear canvas
      ctx.clearRect(0, 0, rect.width, 400)

      // Draw grid
      ctx.strokeStyle = GRID_COLOR
      ctx.lineWidth = 1
      ctx.setLineDash([2, 2])

      for (let i = 0; i <= 5; i++) {
        const y = padding + (chartHeight * i) / 5
        ctx.beginPath()
        ctx.moveTo(padding, y)
        ctx.lineTo(rect.width - padding, y)
        ctx.stroke()
      }

      ctx.setLineDash([])

      // Draw bias score line
      ctx.strokeStyle = SERIES_COLORS.biasLine
      ctx.lineWidth = 3
      ctx.beginPath()

      historical.forEach((point: any, index: any) => {
        const x = padding + (chartWidth * index) / (historical.length - 1)
        const y = padding + chartHeight - chartHeight * point.biasScore

        if (index === 0) {
          ctx.moveTo(x, y)
        } else {
          ctx.lineTo(x, y)
        }
      })

      ctx.stroke()

      // Draw session bars
      const barWidth = (chartWidth / historical.length) * 0.3
      ctx.fillStyle = SERIES_COLORS.sessionBars

      historical.forEach((point: any, index: any) => {
        const x =
          padding +
          (chartWidth * index) / (historical.length - 1) -
          barWidth / 2
        const barHeight =
          (chartHeight * point.sessionCount) /
          Math.max(...historical.map((d: any) => d.sessionCount))
        const y = padding + chartHeight - barHeight

        ctx.fillRect(x, y, barWidth, barHeight)
      })

      // Draw alert line
      ctx.strokeStyle = SERIES_COLORS.alertLine
      ctx.lineWidth = 2
      ctx.setLineDash([5, 5])
      ctx.beginPath()

      historical.forEach((point: any, index: any) => {
        const x = padding + (chartWidth * index) / (historical.length - 1)
        const y =
          padding +
          chartHeight -
          (chartHeight * point.alertCount) /
            Math.max(...historical.map((d: any) => d.alertCount), 1)

        if (index === 0) {
          ctx.moveTo(x, y)
        } else {
          ctx.lineTo(x, y)
        }
      })

      ctx.stroke()
      ctx.setLineDash([])
    }

    renderBiasDistribution() {
      const container = document.getElementById('bias-distribution')
      if (!container || !this.analyticsData.distribution) return

      const { distribution } = this.analyticsData
      const maxCount = Math.max(...distribution.map((d: any) => d.count))

      container.innerHTML = distribution
        .map(
          (item: any) => `
        <div class="flex items-center justify-between p-3 bg-secondary rounded-none">
          <div class="flex items-center gap-3">
            <div class="w-3 h-3 rounded-full ${
              DISTRIBUTION_TIER_DOT[item.range] ?? 'bg-red-400'
            }"></div>
            <span class="text-foreground">${item.range}</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-24 bg-secondary rounded-none h-2">
              <div class="bg-primary h-2 rounded-none" style="width: ${(item.count / maxCount) * 100}%"></div>
            </div>
            <span class="text-foreground font-medium">${item.count}</span>
          </div>
        </div>
      `,
        )
        .join('')
    }

    renderDemographicAnalysis() {
      const container = document.getElementById('demographic-analysis')
      if (!container || !this.analyticsData.demographics) return

      const { demographics } = this.analyticsData

      container.innerHTML = demographics
        .slice(0, 5)
        .map(
          (item: any) => `
        <div class="flex items-center justify-between p-3 bg-secondary rounded-none">
          <div>
            <div class="text-foreground font-medium">${item.gender} • ${item.ethnicity}</div>
            <div class="text-sm text-foreground">Age: ${item.ageGroup}</div>
          </div>
          <div class="text-right">
            <div class="text-foreground font-medium">${item.count} sessions</div>
            <div class="text-sm ${item.avgBias * 100 > 50 ? 'text-foreground font-semibold' : 'text-muted-foreground'}">
              ${(item.avgBias * 100).toFixed(1)}% avg bias
            </div>
          </div>
        </div>
      `,
        )
        .join('')
    }

    renderBiasPatterns() {
      const container = document.getElementById('bias-patterns')
      if (!container || !this.analyticsData.patterns) return

      const { patterns } = this.analyticsData

      container.innerHTML = patterns
        .map(
          (pattern: any) => `
        <div class="flex items-center justify-between p-4 bg-secondary rounded-none">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 bg-secondary rounded-none flex items-center justify-center">
              <span class="text-foreground text-sm">⚠️</span>
            </div>
            <div>
              <div class="text-foreground font-medium">${pattern.layer}</div>
              <div class="text-sm text-foreground">${pattern.occurrences} occurrences</div>
            </div>
          </div>
          <div class="text-right">
            <div class="text-lg font-bold text-foreground">
              ${(pattern.avgScore * 100).toFixed(1)}%
            </div>
            <div class="text-sm text-foreground">avg bias score</div>
          </div>
        </div>
      `,
        )
        .join('')
    }
  }

  // Initialize dashboard when page loads
  document.addEventListener('DOMContentLoaded', () => {
    new AdvancedAnalyticsDashboard()
  })
</script>
