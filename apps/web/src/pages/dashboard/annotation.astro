---
export const prerender = false

import { ClipboardList, XCircle, TrendingUp } from 'lucide-react'

import Card from '@/components/ui/Card.astro'
import DashboardLayout from '@/layouts/DashboardLayout.astro'

// Types for queue items
interface QueueItem {
  id: number
  sample_text: string
  original_score: number
  per_dimension_scores: Record<string, number>
  routing_reason?: string
  status: string
  created_at: string
}

// Fetch pending items from annotation API
let pendingItems: QueueItem[] = []
let reviewedItems: QueueItem[] = []
let error: string | null = null

try {
  const response = await fetch('http://localhost:3102/queue/pending', {
    headers: { Accept: 'application/json' },
  })

  if (response.ok) {
    const items: QueueItem[] = await response.json()
    pendingItems = items.filter(
      (item) => item.status === 'pending' || item.status === 'pending_review',
    )
    reviewedItems = items.filter((item) => item.status === 'reviewed')
  } else {
    error = `Failed to fetch queue: ${response.status} ${response.statusText}`
  }
} catch (err) {
  error = `Error connecting to annotation API: ${err instanceof Error ? err.message : String(err)}`
}

// Client-side promote handler
const handlePromote = `
  async function handlePromote(itemId, targetStage) {
    const btn = event.target.closest('[data-promote-btn]');
    const originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Promoting...';
    
    try {
      const response = await fetch('/api/clinical-validity/annotations/' + itemId + '/promote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          promoter_id: 'dashboard-user',
          target_stage: targetStage || null
        })
      });
      
      if (response.ok) {
        const card = btn.closest('[data-queue-card]');
        if (card) {
          card.style.opacity = '0.5';
          card.style.transform = 'scale(0.98)';
          setTimeout(() => {
            card.remove();
            // Check if lists are empty
            const pendingContainer = document.querySelector('[data-pending-list]');
            const reviewedContainer = document.querySelector('[data-reviewed-list]');
            if (pendingContainer && pendingContainer.children.length === 0) {
              const emptyPending = document.querySelector('[data-empty-pending]');
              if (emptyPending) emptyPending.style.display = 'block';
            }
            if (reviewedContainer && reviewedContainer.children.length === 0) {
              const emptyReviewed = document.querySelector('[data-empty-reviewed]');
              if (emptyReviewed) emptyReviewed.style.display = 'block';
            }
          }, 300);
        }
        alert('Item promoted successfully!');
      } else {
        const data = await response.json();
        alert('Promotion failed: ' + (data.detail || response.statusText));
        btn.disabled = false;
        btn.textContent = originalText;
      }
    } catch (err) {
      alert('Error: ' + err.message);
      btn.disabled = false;
      btn.textContent = originalText;
    }
  }
`
---

<DashboardLayout
  title="Annotation Queue | Pixelated Empathy Dashboard"
  description="Expert review interface for clinical validity annotation queue"
  showSidebar={true}
>
  <div class="container mx-auto px-4 py-6">
    <!-- Header -->
    <div class="mb-8">
      <div class="mb-2 flex items-center gap-3">
        <ClipboardList class="h-8 w-8 text-accent" />
        <h1 class="text-3xl font-bold tracking-tight">Annotation Queue</h1>
      </div>
      <p class="text-muted-foreground">
        Review borderline clinical validity samples and submit expert scores
      </p>
    </div>

    {error ? (
      <div class="mb-6 rounded-none border border-ring bg-secondary px-4 py-3 text-foreground">
        <p class="font-medium">Error</p>
        <p class="text-sm">{error}</p>
      </div>
    ) : null}

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <!-- Left column: Pending items list -->
      <div class="space-y-6 lg:col-span-2">
        <!-- Pending Items -->
        <Card class="p-6">
          <div class="mb-6 flex items-center justify-between">
            <h2 class="text-xl font-semibold">Pending Items</h2>
            <span class="bg-accent/10 rounded-full px-3 py-1 text-xs font-medium text-accent">
              {pendingItems.length} item{pendingItems.length !== 1 ? 's' : ''}
            </span>
          </div>

          {pendingItems.length > 0 ? (
            <div class="space-y-4" data-pending-list>
              {pendingItems.map((item) => (
                <div
                  class="rounded-none border border-border p-4"
                  data-queue-card
                >
                  <div class="mb-3 flex items-start justify-between">
                    <div>
                      <h3 class="font-medium">Sample #{item.id}</h3>
                      <p class="mt-1 text-xs text-muted-foreground">
                        Added {new Date(item.created_at).toLocaleDateString()}
                      </p>
                    </div>
                    <div class="text-right">
                      <div class="text-lg font-semibold">
                        {(item.original_score * 100).toFixed(1)}%
                      </div>
                      <div class="text-xs text-muted-foreground">
                        Original Score
                      </div>
                    </div>
                  </div>

                  <div class="mb-3">
                    <p class="line-clamp-3 text-sm">{item.sample_text}</p>
                  </div>

                  {item.routing_reason && (
                    <div class="mb-3">
                      <span class="rounded-none border border-border bg-secondary px-2 py-1 text-xs font-medium text-foreground">
                        {item.routing_reason}
                      </span>
                    </div>
                  )}

                  <div class="grid grid-cols-2 gap-2 text-xs sm:grid-cols-3">
                    {Object.entries(item.per_dimension_scores).map(
                      ([dimension, score]) => (
                        <div class="flex items-center justify-between">
                          <span class="capitalize text-muted-foreground">
                            {dimension}:
                          </span>
                          <span class="font-medium">
                            {(score * 100).toFixed(0)}%
                          </span>
                        </div>
                      ),
                    )}
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="py-12 text-center" data-empty-pending>
              <XCircle class="mx-auto mb-4 h-12 w-12 text-muted-foreground" />
              <h3 class="mb-2 text-lg font-medium">No pending items</h3>
              <p class="text-muted-foreground">
                All annotation queue items have been reviewed.
              </p>
            </div>
          )}
        </Card>

        <!-- Reviewed Items (eligible for promotion) -->
        <Card class="border-accent/30 p-6">
          <div class="mb-6 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <TrendingUp class="h-5 w-5 text-accent" />
              <h2 class="text-xl font-semibold">Reviewed Items</h2>
            </div>
            <span class="rounded-none border border-border bg-secondary px-3 py-1 text-xs font-medium text-foreground">
              {reviewedItems.length} ready for promotion
            </span>
          </div>

          {reviewedItems.length > 0 ? (
            <div class="space-y-4" data-reviewed-list>
              {reviewedItems.map((item) => (
                <div
                  class="rounded-none border border-border bg-secondary p-4"
                  data-queue-card
                >
                  <div class="mb-3 flex items-start justify-between">
                    <div>
                      <h3 class="font-medium">Sample #{item.id}</h3>
                      <p class="mt-1 text-xs text-muted-foreground">
                        Added {new Date(item.created_at).toLocaleDateString()}
                      </p>
                      <span class="mt-1 inline-block rounded-none border border-border bg-secondary px-2 py-0.5 text-xs font-medium text-foreground">
                        Reviewed
                      </span>
                    </div>
                    <div class="text-right">
                      <div class="text-lg font-semibold">
                        {(item.original_score * 100).toFixed(1)}%
                      </div>
                      <div class="text-xs text-muted-foreground">
                        Original Score
                      </div>
                    </div>
                  </div>

                  <div class="mb-3">
                    <p class="line-clamp-3 text-sm">{item.sample_text}</p>
                  </div>

                  {item.routing_reason && (
                    <div class="mb-3">
                      <span class="rounded-none border border-border bg-secondary px-2 py-1 text-xs font-medium text-foreground">
                        {item.routing_reason}
                      </span>
                    </div>
                  )}

                  <div class="mb-4 grid grid-cols-2 gap-2 text-xs sm:grid-cols-3">
                    {Object.entries(item.per_dimension_scores).map(
                      ([dimension, score]) => (
                        <div class="flex items-center justify-between">
                          <span class="capitalize text-muted-foreground">
                            {dimension}:
                          </span>
                          <span class="font-medium">
                            {(score * 100).toFixed(0)}%
                          </span>
                        </div>
                      ),
                    )}
                  </div>

                  <button
                    type="button"
                    data-promote-btn
                    onclick={`handlePromote(${item.id}, 'validated')`}
                    class="hover:bg-accentHover w-full rounded-md bg-accent px-4 py-2 text-sm font-medium text-foreground transition-colors focus:outline-none focus:ring-2 focus:ring-accent disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto"
                  >
                    Promote to Validated
                  </button>
                </div>
              ))}
            </div>
          ) : (
            <div class="py-12 text-center" data-empty-reviewed>
              <TrendingUp class="mx-auto mb-4 h-12 w-12 text-muted-foreground" />
              <h3 class="mb-2 text-lg font-medium">
                No items ready for promotion
              </h3>
              <p class="text-muted-foreground">
                Reviewed items will appear here for promotion.
              </p>
            </div>
          )}
        </Card>
      </div>

      <!-- Right column: Stats and instructions -->
      <div>
        <Card class="p-6">
          <h2 class="mb-6 text-xl font-semibold">Queue Statistics</h2>

          <div class="mb-6 grid grid-cols-2 gap-4">
            <div class="bg-surface/50 rounded-none p-3 text-center">
              <div class="text-2xl font-bold">{pendingItems.length}</div>
              <div class="text-xs text-muted-foreground">Pending</div>
            </div>
            <div class="bg-surface/50 rounded-none p-3 text-center">
              <div class="text-2xl font-bold">{reviewedItems.length}</div>
              <div class="text-xs text-muted-foreground">Reviewed</div>
            </div>
          </div>

          <div class="text-sm text-muted-foreground">
            <p>
              Annotation API:{' '}
              <span class="font-medium text-accent">Running on port 3102</span>
            </p>
            <p class="mt-2">Use POST /queue/submit to submit reviews</p>
          </div>
        </Card>

        {/* Instructions */}
        <Card class="mt-6 p-6">
          <h3 class="mb-4 text-lg font-semibold">Review Guidelines</h3>
          <ul class="space-y-3 text-sm">
            <li class="flex items-start gap-2">
              <span class="font-medium text-accent">•</span>
              <span>
                Borderline samples (0.4-0.6 score) require expert review
              </span>
            </li>
            <li class="flex items-start gap-2">
              <span class="font-medium text-accent">•</span>
              <span>Assess clinical validity across all dimensions</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="font-medium text-accent">•</span>
              <span>Submit scores via the annotation API</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="font-medium text-accent">•</span>
              <span>Use your assigned reviewer ID</span>
            </li>
          </ul>
        </Card>

        {/* Promotion Workflow Info */}
        <Card class="mt-6 border-border p-6">
          <h3 class="mb-4 text-lg font-semibold text-foreground">
            Promotion Workflow
          </h3>
          <div class="space-y-2 text-sm">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full border-2 border-muted-foreground"></span>
              <span class="text-muted-foreground">Pending</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-muted-foreground"></span>
              <span class="text-muted-foreground">Reviewed</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-primary"></span>
              <span class="text-muted-foreground">Validated</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-foreground"></span>
              <span class="text-muted-foreground">Merged</span>
            </div>
          </div>
          <p class="mt-4 text-xs text-muted-foreground">
            Items must be reviewed before they can be promoted through the
            workflow stages.
          </p>
        </Card>
      </div>
    </div>
  </div>
</DashboardLayout>

<script is:inline set:html={handlePromote}></script>
