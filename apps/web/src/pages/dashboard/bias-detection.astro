---
import { ChartBar, _Rocket, _Search, Target, TrendingUp } from 'lucide-react'

import BrutalistButton from '@/components/ui/BrutalistButton.astro'
import BrutalistCard from '@/components/ui/BrutalistCard.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
export const prerender = false
---

<BaseLayout
  title="Bias Detection Dashboard - Pixelated"
  description="Comprehensive bias detection management and analytics dashboard"
>
  <!-- Hero Section -->
  <section class="brutalist-section relative overflow-hidden">
    <!-- Floating Background Elements -->

    <div class="brutalist-container relative z-10">
      <div class="mb-12 text-center">
        <div class="nav-pill nav-pill--active mb-8 inline-flex items-center gap-3">
          <div class="status-dot status-dot--processing"></div>
          <span class="font-bold">BIAS DETECTION DASHBOARD</span>
        </div>

        <h1 class="brutalist-heading mb-6 text-5xl md:text-7xl">
          <span class="gradient-text-secondary">ANALYTICS</span>
          <br />
          <span class="gradient-text-primary">COMMAND CENTER</span>
        </h1>

        <p class="mx-auto mb-8 max-w-4xl text-xl text-muted-foreground">
          A demonstration dashboard for bias-detection review across therapeutic
          interactions. The figures below are sample values, not live telemetry.
        </p>

        <!-- Status Badges -->
        <div class="mb-12 flex flex-wrap justify-center gap-4">
          <div class="nav-pill bg-primary text-primary-foreground">
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
            SYSTEM HEALTHY
          </div>
          <div class="nav-pill bg-primary text-primary-foreground">
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"
              ></path>
            </svg>
            SAMPLE DATA
          </div>
          <div class="nav-pill bg-primary text-primary-foreground">
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
              ></path>
            </svg>
            DEMO ONLY
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Dashboard Grid -->
  <section class="brutalist-section bg-background">
    <div class="brutalist-container">
      <div class="mb-12 grid grid-cols-1 gap-8 lg:grid-cols-3">
        <!-- System Overview -->
        <BrutalistCard variant="elevated" class="lg:col-span-2">
          <div class="space-y-6">
            <div class="border-b border-border pb-4">
              <h3 class="brutalist-subheading mb-2 text-xl">SYSTEM OVERVIEW</h3>
              <p class="text-sm text-muted-foreground">
                Sample values from an illustrative run. Not live telemetry.
              </p>
            </div>

            <!-- Key Metrics -->
            <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
              <div class="metric-card">
                <div class="metric-value" id="total-sessions">
                  1,247
                </div>
                <div class="metric-label">Total Sessions</div>
                <div class="metric-trend trend-up">+12%</div>
              </div>
              <div class="metric-card">
                <div class="metric-value" id="avg-bias-score">
                  23.4%
                </div>
                <div class="metric-label">Avg Bias Score</div>
                <div class="metric-trend trend-down">-5%</div>
              </div>
              <div class="metric-card">
                <div class="metric-value" id="active-alerts">
                  3
                </div>
                <div class="metric-label">Active Alerts</div>
                <div class="metric-trend trend-neutral">0%</div>
              </div>
              <div class="metric-card">
                <div class="metric-value" id="system-uptime">
                  99.7%
                </div>
                <div class="metric-label">System Uptime</div>
                <div class="metric-trend trend-up">+0.2%</div>
              </div>
            </div>

            <!-- Performance Chart Placeholder -->
            <div class="rounded-none border border-border bg-card p-6">
              <h4 class="mb-4 text-lg font-semibold text-muted-foreground">
                Performance Trends
              </h4>
              <div class="flex h-48 items-center justify-center rounded-none bg-secondary">
                <div class="text-center text-muted-foreground">
                  <div class="mb-2 text-4xl">
                    <ChartBar className="h-10 w-10" />
                  </div>
                  <p>Interactive performance charts loading...</p>
                </div>
              </div>
            </div>
          </div>
        </BrutalistCard>

        <!-- Quick Actions -->
        <BrutalistCard variant="elevated">
          <div class="space-y-6">
            <div class="border-b border-border pb-4">
              <h3 class="brutalist-subheading mb-2 text-xl">QUICK ACTIONS</h3>
              <p class="text-sm text-muted-foreground">
                Common management tasks
              </p>
            </div>

            <div class="space-y-3">
              <BrutalistButton
                href="/demo-hub"
                variant="primary"
                class="w-full"
              >
                🧪 RUN ANALYSIS TEST
              </BrutalistButton>
              <BrutalistButton
                href="/admin/bias-detection"
                variant="secondary"
                class="w-full"
              >
                📊 VIEW REPORTS
              </BrutalistButton>
              <BrutalistButton
                href="#active-alerts"
                variant="secondary"
                class="w-full"
              >
                🚨 MANAGE ALERTS
              </BrutalistButton>
              <BrutalistButton
                href="/admin/security-settings"
                variant="outline"
                class="w-full"
              >
                ⚙️ SYSTEM SETTINGS
              </BrutalistButton>
            </div>

            <!-- System Status -->
            <div class="rounded-none border border-border bg-card p-4">
              <h4 class="mb-3 text-sm font-semibold text-muted-foreground">
                SYSTEM STATUS
              </h4>
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-sm text-muted-foreground">ML Models</span>
                  <span class="text-sm font-medium text-foreground">
                    ✓ Active
                  </span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-sm text-muted-foreground">
                    API Services
                  </span>
                  <span class="text-sm font-medium text-foreground">
                    ✓ Online
                  </span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-sm text-muted-foreground">Database</span>
                  <span class="text-sm font-medium text-foreground">
                    ✓ Connected
                  </span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-sm text-muted-foreground">Data</span>
                  <span class="text-sm font-medium text-foreground">
                    ✓ Sample
                  </span>
                </div>
              </div>
            </div>
          </div>
        </BrutalistCard>
      </div>

      <!-- Recent Activity & Alerts -->
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        <!-- Recent Analyses -->
        <BrutalistCard variant="elevated">
          <div class="space-y-6">
            <div class="border-b border-border pb-4">
              <h3 class="brutalist-subheading mb-2 text-xl">RECENT ANALYSES</h3>
              <p class="text-sm text-muted-foreground">
                Latest bias detection sessions
              </p>
            </div>

            <div class="space-y-4" id="recent-analyses">
              <!-- Dynamic content will be loaded here -->
              <div class="py-8 text-center text-muted-foreground">
                <div class="mb-2 text-3xl">🔄</div>
                <p>Loading recent analyses...</p>
              </div>
            </div>
          </div>
        </BrutalistCard>

        <!-- Active Alerts -->
        <BrutalistCard variant="elevated">
          <div class="space-y-6">
            <div class="border-b border-border pb-4">
              <h3 class="brutalist-subheading mb-2 text-xl">ACTIVE ALERTS</h3>
              <p class="text-sm text-muted-foreground">
                Current bias detection alerts
              </p>
            </div>

            <div class="space-y-4" id="active-alerts">
              <!-- Dynamic content will be loaded here -->
              <div class="py-8 text-center text-muted-foreground">
                <div class="mb-2 text-3xl">🔔</div>
                <p>No active alerts</p>
              </div>
            </div>
          </div>
        </BrutalistCard>
      </div>
    </div>
  </section>

  <!-- Advanced Analytics Section -->
  <section class="brutalist-section">
    <div class="brutalist-container">
      <div class="mb-12 text-center">
        <h2 class="brutalist-heading mb-4 text-3xl md:text-5xl">
          ADVANCED
          <span class="gradient-text-primary">ANALYTICS</span>
        </h2>
        <p class="text-lg text-muted-foreground">
          Deep insights into bias patterns and system performance
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        <!-- Bias Distribution -->
        <BrutalistCard hover={true}>
          <div class="text-center">
            <div class="mb-4 text-4xl">
              <TrendingUp className="h-10 w-10" />
            </div>
            <h3 class="brutalist-subheading mb-3 text-lg">BIAS DISTRIBUTION</h3>
            <p class="mb-4 text-sm text-muted-foreground">
              Statistical analysis of bias scores across different demographics
              and scenarios.
            </p>
            <BrutalistButton
              href="/components/analytics-dashboard"
              variant="secondary"
              size="sm"
            >
              VIEW ANALYSIS →
            </BrutalistButton>
          </div>
        </BrutalistCard>

        <!-- Performance Metrics -->
        <BrutalistCard hover={true}>
          <div class="text-center">
            <div class="mb-4 text-4xl">⚡</div>
            <h3 class="brutalist-subheading mb-3 text-lg">
              PERFORMANCE METRICS
            </h3>
            <p class="mb-4 text-sm text-muted-foreground">
              Real-time monitoring of system performance, response times, and
              accuracy metrics.
            </p>
            <BrutalistButton
              href="/admin/ai-performance"
              variant="secondary"
              size="sm"
            >
              VIEW METRICS →
            </BrutalistButton>
          </div>
        </BrutalistCard>

        <!-- Compliance Reports -->
        <BrutalistCard hover={true}>
          <div class="text-center">
            <div class="mb-4 text-4xl">📋</div>
            <h3 class="brutalist-subheading mb-3 text-lg">
              COMPLIANCE REPORTS
            </h3>
            <p class="mb-4 text-sm text-muted-foreground">
              Review views for bias findings, audit trails, and reporting. No
              compliance determination is claimed.
            </p>
            <BrutalistButton
              href="/admin/security-dashboard"
              variant="secondary"
              size="sm"
            >
              VIEW REPORTS →
            </BrutalistButton>
          </div>
        </BrutalistCard>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="brutalist-section bg-background">
    <div class="brutalist-container">
      <div class="mental-health-safe mx-auto max-w-4xl text-center">
        <div class="mb-6 text-5xl">
          <Target className="h-16 w-16" />
        </div>

        <h2 class="brutalist-heading mb-6 text-3xl md:text-5xl">
          TAKE CONTROL OF
          <br />
          <span class="gradient-text-primary">BIAS DETECTION</span>
        </h2>

        <p class="mb-8 text-xl text-muted-foreground">
          Advanced analytics and real-time monitoring for comprehensive bias
          management. Enterprise-grade insights with actionable recommendations.
        </p>

        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          <BrutalistButton href="/demo-hub" variant="primary" size="lg">
            🚀 Start Analysis
          </BrutalistButton>
          <BrutalistButton href="/docs" variant="secondary" size="lg">
            📖 VIEW DOCUMENTATION
          </BrutalistButton>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .metric-card {
    @apply rounded-none border border-border bg-card p-4 text-center;
  }

  .metric-value {
    @apply mb-1 text-2xl font-bold text-foreground;
  }

  .metric-label {
    @apply text-sm text-muted-foreground;
  }

  .metric-trend {
    @apply mt-1 text-xs font-medium;
  }

  .trend-up {
    @apply font-medium text-foreground;
  }

  .trend-down {
    @apply font-semibold text-foreground;
  }

  .trend-neutral {
    @apply text-muted-foreground;
  }

  /* Status dots */
  .status-dot {
    @apply h-3 w-3 rounded-full;
  }

  .status-dot--processing {
    @apply animate-pulse bg-primary;
  }

  /* Gradient text */
  .gradient-text-primary {
    @apply text-foreground;
  }

  .gradient-text-secondary {
    @apply text-foreground;
  }
</style>

<script>
  class BiasDetectionDashboard {
    constructor() {
      this.initializeDashboard()
      this.startRealTimeUpdates()
    }

    async initializeDashboard() {
      try {
        // Load dashboard data
        const response = await fetch('/api/dashboard/bias-detection/summary')
        if (response.ok) {
          const data = await response.json()
          this.updateDashboard(data)
        }
      } catch (error) {
        console.warn('Dashboard data loading failed:', error)
        // Continue with default values
      }
    }

    updateDashboard(data: any) {
      // Update metrics
      if (data.metrics) {
        Object.entries(data.metrics).forEach(([key, value]: [string, any]) => {
          const element = document.getElementById(key)
          if (element) {
            element.textContent = value
          }
        })
      }

      // Update recent analyses
      if (data.recentAnalyses) {
        this.renderRecentAnalyses(data.recentAnalyses)
      }

      // Update alerts
      if (data.activeAlerts) {
        this.renderActiveAlerts(data.activeAlerts)
      }
    }

    renderRecentAnalyses(analyses: any[]) {
      const container = document.getElementById('recent-analyses')
      if (!container || !analyses.length) return

      container.innerHTML = analyses
        .map(
          (analysis) => `
        <div class="bg-secondary rounded-none p-4 border border-border">
          <div class="flex items-center justify-between mb-2">
            <span class="font-medium text-foreground">${analysis.sessionType}</span>
            <span class="text-sm px-2 py-1 rounded-none ${
              analysis.biasScore > 0.6
                ? 'bg-foreground text-background font-medium'
                : analysis.biasScore > 0.3
                  ? 'bg-secondary border border-ring text-foreground font-medium'
                  : 'bg-secondary border border-border text-muted-foreground'
            }">
              ${(analysis.biasScore * 100).toFixed(1)}%
            </span>
          </div>
          <div class="text-sm text-muted-foreground">
            ${new Date(analysis.timestamp).toLocaleString()}
          </div>
        </div>
      `,
        )
        .join('')
    }

    renderActiveAlerts(alerts: any[]) {
      const container = document.getElementById('active-alerts')
      if (!container) return

      if (!alerts.length) {
        container.innerHTML = `
          <div class="text-center py-8 text-muted-foreground">
            <div class="text-3xl mb-2">✅</div>
            <p>No active alerts</p>
          </div>
        `
        return
      }

      container.innerHTML = alerts
        .map(
          (alert) => `
        <div class="bg-secondary border border-ring rounded-none p-4">
          <div class="flex items-start gap-3">
            <div class="w-2 h-2 rounded-full bg-foreground mt-2 flex-shrink-0"></div>
            <div>
              <div class="font-medium text-foreground">${alert.title}</div>
              <div class="text-sm text-muted-foreground mt-1">${alert.description}</div>
              <div class="text-xs text-muted-foreground mt-2">
                ${new Date(alert.timestamp).toLocaleString()}
              </div>
            </div>
          </div>
        </div>
      `,
        )
        .join('')
    }

    startRealTimeUpdates() {
      // Update uptime counter
      setInterval(() => {
        const uptimeEl = document.getElementById('system-uptime')
        if (uptimeEl) {
          const current = parseFloat(uptimeEl.textContent || '99.7')
          const newValue = Math.max(
            99.0,
            Math.min(100.0, current + (Math.random() - 0.5) * 0.1),
          )
          uptimeEl.textContent = newValue.toFixed(1) + '%'
        }
      }, 30000) // Update every 30 seconds
    }
  }

  // Initialize dashboard when page loads
  document.addEventListener('DOMContentLoaded', () => {
    new BiasDetectionDashboard()
  })
</script>
