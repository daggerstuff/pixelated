---
import BrutalistChatDemo from '@/components/chat/BrutalistChatDemo'
// Demo Hub - Showcase Platform Capabilities
import BaseLayout from '@/layouts/BaseLayout.astro'

const demos = [
  {
    title: 'Enterprise Components Hub',
    description:
      'A guided tour of the main product surfaces and supporting UI used across the platform.',
    status: 'NEW',
    difficulty: 'LOW',
    href: '/components',
    icon: '🏗️',
    stats: { components: '8', status: 'integrated' },
  },
  {
    title: 'Analytics Dashboard',
    description:
      'Advanced charting and data visualization tools with Chart.js integration.',
    status: 'NEW',
    difficulty: 'MEDIUM',
    href: '/components/analytics-dashboard',
    icon: 'chart',
    stats: { charts: '4+', responsive: 'yes' },
  },
  {
    title: '3D Emotion Visualization',
    description:
      'Immersive 3D emotion mapping using Valence-Arousal-Dominance model with Three.js.',
    status: 'NEW',
    difficulty: 'HIGH',
    href: '/components/emotion-visualization',
    icon: '🎭',
    stats: { dimensions: '3D', interactive: 'yes' },
  },
  {
    title: 'Treatment Plan Manager',
    description:
      'Clinical workflow management with goal tracking, milestones, and review-oriented planning screens.',
    status: 'NEW',
    difficulty: 'MEDIUM',
    href: '/components/treatment-plans',
    icon: 'target',
    stats: { goals: 'tracked', categories: '5' },
  },
  {
    title: 'FHE Privacy Demo',
    description:
      'A technical demo focused on privacy-preserving analysis patterns for sensitive training data.',
    status: 'NEW',
    difficulty: 'HIGH',
    href: '/components/security-demo',
    icon: '🔒',
    stats: { privacy: 'privacy-first', compliant: 'review required' },
  },
  {
    title: 'UI Component Showcase',
    description:
      'Modern carousel and interface elements with multiple effects and accessibility features.',
    status: 'NEW',
    difficulty: 'LOW',
    href: '/components/ui-showcase',
    icon: '🎨',
    stats: { effects: '5+', mobile: 'optimized' },
  },
  {
    title: 'Enhanced Bias Detection',
    description:
      'Modernized UI/UX with real-time analysis, counterfactuals, and historical trends.',
    status: 'NEW',
    difficulty: 'MEDIUM',
    href: '/demo/enhanced-bias-detection',
    icon: 'sparkle',
    stats: { realtime: 'yes', scenarios: '8+', trends: 'on' },
  },
  {
    title: 'Bias Detection Engine',
    description:
      'Interactive, client-side demo showcasing multi-layer cultural bias analysis.',
    status: 'ACTIVE',
    difficulty: 'MEDIUM',
    href: '/demo/bias-detection',
    icon: '⚡',
    stats: { layers: '4', patterns: '200+' },
  },
  {
    title: 'Psychology Pipeline',
    description:
      'End-to-end pipeline overview with knowledge parsing and scenario generation demos.',
    status: 'ACTIVE',
    difficulty: 'HIGH',
    href: '/demo/psychology-pipeline',
    icon: '🧠',
    stats: { modules: '3', latency: '<500ms' },
  },
  {
    title: 'Mental Health Chat',
    description:
      'Production-grade chat with MentalLLaMA analysis (falls back to demo mode locally).',
    status: 'ACTIVE',
    difficulty: 'MEDIUM',
    href: '/mental-health-demo',
    icon: '💬',
    stats: { analysis: 'real-time', crisis: 'on' },
  },
]

const liveDemo = {
  title: 'Live Chat Simulation',
  description:
    'Experience our AI training system with a real-time therapy session simulation.',
  status: 'LIVE',
}
---

<BaseLayout
  title="Demo Hub - Experience AI Therapy Training"
  description="Try our AI-powered therapy training simulations. Practice crisis interventions, bias detection, and complex client scenarios safely."
>
  <!-- Hero Section -->
  <section class="relative flex min-h-screen items-center overflow-hidden px-4 py-24">
    <div class="relative z-10 mx-auto w-full max-w-5xl text-center">
      <!-- Status Bar -->
      <div
        class="np-elevated mb-8 inline-flex items-center gap-3 px-6 py-3"
        style="border: 1px solid var(--np-line);"
      >
        <span
          class="np-mid inline-block h-2 w-2"
          style="background: var(--np-mid);"
          aria-hidden="true"
        ></span>
        <span class="np-text font-bold tracking-wide">
          DEMO LIBRARY AVAILABLE
        </span>
      </div>

      <!-- Headline -->
      <h1 class="np-text mb-6 text-5xl font-bold leading-tight md:text-7xl">
        EXPLORE THE
        <br />
        PRODUCT SURFACES
      </h1>

      <!-- Description -->
      <p class="np-muted mx-auto mb-12 max-w-3xl text-xl leading-relaxed md:text-2xl">
        Explore the product through focused demos covering simulation,
        analytics, privacy, and supporting workflow components. This page is
        meant to show what exists, not make inflated claims about what does not.
      </p>

      <!-- CTA -->
      <div class="mb-16 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <button
          id="live-demo-btn"
          class="np-cta np-ring px-8 py-4 font-bold"
          style="background: var(--np-elevated);"
        >
          LIVE DEMONSTRATION
        </button>
        <button
          id="modules-btn"
          class="np-ring px-8 py-4 font-bold"
          style="background: var(--np-bg); color: var(--np-text); border: 1px solid var(--np-line);"
        >
          VIEW MODULES
        </button>
      </div>

      <!-- Scroll Hint -->
      <p class="np-muted text-sm">Scroll to explore</p>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      const liveDemoBtn = document.getElementById('live-demo-btn')
      if (liveDemoBtn) {
        liveDemoBtn.addEventListener('click', function () {
          const liveDemoSection = document.querySelector(
            'section:nth-of-type(2)',
          )
          if (liveDemoSection) {
            liveDemoSection.scrollIntoView({ behavior: 'smooth' })
          }
        })
      }
      const modulesBtn = document.getElementById('modules-btn')
      if (modulesBtn) {
        modulesBtn.addEventListener('click', function () {
          const modulesSection = document.querySelector(
            'section:nth-of-type(3)',
          )
          if (modulesSection) {
            modulesSection.scrollIntoView({ behavior: 'smooth' })
          }
        })
      }
    })
  </script>
  <!-- Live Demo Section -->
  <section class="px-4 py-24" style="background: var(--np-surface);">
    <div class="mx-auto max-w-5xl">
      <div class="mb-12 text-center">
        <p class="np-mid mb-4 text-sm font-bold uppercase tracking-wide">
          {liveDemo.status} Demonstration
        </p>
        <h2 class="np-text mb-4 text-3xl font-bold md:text-5xl">
          {liveDemo.title}
        </h2>
        <p class="np-muted mx-auto mb-8 max-w-3xl text-lg">
          {liveDemo.description}
        </p>
      </div>
      <div>
        <BrutalistChatDemo client:load />
      </div>
    </div>
  </section>

  <!-- Demo Grid Section -->
  <section class="px-4 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12 text-center">
        <h2 class="np-text mb-6 text-3xl font-bold md:text-5xl">
          SPECIALIZED TRAINING MODULES
        </h2>
        <p class="np-muted mx-auto max-w-3xl text-lg">
          Each module targets specific therapeutic competencies with measurable
          outcomes.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {demos.map((demo) => (
          <div
            class="flex flex-col p-6"
            style="background: var(--np-surface); border: 1px solid var(--np-line);"
          >
            <div class="mb-4 flex items-center justify-between">
              <div class="text-3xl">{demo.icon}</div>
              <div class="flex gap-2">
                <div
                  class="px-2 py-1 text-xs font-bold uppercase tracking-wide"
                  style="background: var(--np-elevated); color: var(--np-text); border: 1px solid var(--np-line);"
                >
                  {demo.status}
                </div>
                <div
                  class="np-muted px-2 py-1 text-xs font-bold uppercase tracking-wide"
                  style="border: 1px solid var(--np-line);"
                >
                  {demo.difficulty}
                </div>
              </div>
            </div>

            <h3 class="np-text mb-3 text-lg font-semibold">{demo.title}</h3>
            <p class="np-muted mb-6 flex-1 text-sm leading-relaxed">
              {demo.description}
            </p>

            <div class="mb-6 grid grid-cols-2 gap-4">
              {Object.entries(demo.stats).map(([key, value]) => (
                <div class="text-center">
                  <div class="np-text text-lg font-bold">{value}</div>
                  <div class="np-muted text-xs uppercase tracking-wide">
                    {key}
                  </div>
                </div>
              ))}
            </div>

            <a
              href={demo.href}
              class="np-cta block w-full py-3 text-center font-bold"
            >
              LAUNCH DEMO →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Metrics Section -->
  <section class="px-4 py-24" style="background: var(--np-surface);">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12 text-center">
        <h2 class="np-text mb-6 text-3xl font-bold md:text-5xl">
          MEASURABLE OUTCOMES
        </h2>
        <p class="np-muted mx-auto max-w-3xl text-lg">
          Every training session generates actionable data to track your
          progress.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="p-6 text-center" style="background: var(--np-elevated);">
          <div class="np-text text-4xl font-bold">85%</div>
          <div class="np-mid mt-2 text-sm uppercase tracking-wide">
            Diagnostic Accuracy
          </div>
          <div class="np-muted mt-2 text-xs">Average improvement</div>
        </div>
        <div class="p-6 text-center" style="background: var(--np-elevated);">
          <div class="np-text text-4xl font-bold">300%</div>
          <div class="np-mid mt-2 text-sm uppercase tracking-wide">
            Skill Acquisition
          </div>
          <div class="np-muted mt-2 text-xs">Faster than traditional</div>
        </div>
        <div class="p-6 text-center" style="background: var(--np-elevated);">
          <div class="np-text text-4xl font-bold">78%</div>
          <div class="np-mid mt-2 text-sm uppercase tracking-wide">
            Bias Reduction
          </div>
          <div class="np-muted mt-2 text-xs">Cultural competency</div>
        </div>
        <div class="p-6 text-center" style="background: var(--np-elevated);">
          <div class="np-text text-4xl font-bold">0</div>
          <div class="np-mid mt-2 text-sm uppercase tracking-wide">
            Patient Harm
          </div>
          <div class="np-muted mt-2 text-xs">Perfect safety record</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="px-4 py-24">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="np-text mb-6 text-3xl font-bold md:text-5xl">
        READY TO REVIEW THE WORKFLOW?
      </h2>
      <p class="np-muted mb-8 text-xl">
        Use the demos to see how the platform handles simulation, feedback, and
        supporting product surfaces before you talk to us.
      </p>
      <div class="mb-8 flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="/contact"
          class="np-cta px-8 py-4 text-lg font-bold"
          style="background: var(--np-elevated);"
        >
          TALK TO THE TEAM →
        </a>
        <a
          href="/features"
          class="px-8 py-4 text-lg font-bold"
          style="background: var(--np-bg); color: var(--np-text); border: 1px solid var(--np-line);"
        >
          REVIEW FEATURES
        </a>
      </div>
      <div class="flex flex-wrap justify-center gap-4 text-sm">
        <span
          class="px-3 py-1 font-semibold"
          style="background: var(--np-elevated); border: 1px solid var(--np-line);"
        >
          ✓ Product walkthroughs available
        </span>
        <span
          class="np-muted px-3 py-1 font-semibold"
          style="border: 1px solid var(--np-line);"
        >
          ✓ Full support
        </span>
        <span
          class="np-muted px-3 py-1 font-semibold"
          style="border: 1px solid var(--np-line);"
        >
          ✓ Custom integration
        </span>
      </div>
    </div>
  </section>
</BaseLayout>
