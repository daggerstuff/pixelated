---
import MarketingPageHero from '@/components/marketing/MarketingPageHero.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = true

const title = 'Offline Mode'
const description = 'You are currently working in offline mode.'
---

<BaseLayout {title} {description}>
  <MarketingPageHero
    eyebrow="System · Offline"
    title="You are currently offline."
    lede="Cached pages may still load while you are disconnected. Reconnect to the internet to use live features and sync EHR data."
    primaryCTA={{ text: 'Return to Dashboard', href: '/dashboard' }}
    secondaryCTA={{ text: 'Practice Simulator', href: '/simulator' }}
    note="Some cached resources remain accessible while disconnected."
    proof={{
      label: 'Offline status',
      body: `<p>When your connection returns, refresh the page or return to the dashboard to continue with up-to-date data.</p>`,
      caption: 'No background request queue is active on this route.',
    }}
  />
</BaseLayout>
