---
import TreatmentPlanner from '../components/treatment/TreatmentPlanner.tsx'

// Page metadata
const title = 'Treatment Planning'
const description =
  'Personalized, evidence-based treatment recommendations for therapy planning.'
---

<main class="mx-auto max-w-4xl px-4 py-10">
  <h1 class="mb-2 text-3xl font-bold">{title}</h1>
  <p class="mb-8 text-lg text-muted-foreground">{description}</p>

  <TreatmentPlanner
    client:load
    pageTitle={title}
    pageDescription={description}
  />
</main>

<style>
  .filter-btn {
    @apply rounded-none bg-secondary px-4 py-2 font-medium text-foreground transition hover:bg-accent;
  }
  .filter-btn.active {
    @apply bg-primary text-primary-foreground;
  }
</style>
