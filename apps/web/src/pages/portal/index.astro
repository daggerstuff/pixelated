---
import {
  PortalShell,
  SchedulingWidget,
  MessagingWidget,
  HomeworkWidget,
  TelehealthWidget,
  StatementWidget,
} from '@/components/ehr/portal'
import Layout from '@/layouts/Layout.astro'

export const prerender = false
---

<Layout
  title="Client Portal — Pixelated Empathy"
  description="Patient portal dashboard"
>
  <PortalShell activeFeature="dashboard" client:load>
    <div class="space-y-6">
      <div>
        <h2 class="text-xl font-semibold" style="color: var(--np-text)">
          Welcome to Your Portal
        </h2>
        <p class="mt-1 text-sm" style="color: var(--np-muted)">
          Manage your appointments, messages, homework, and statements in one
          place.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div
          class="rounded p-4"
          style="background: var(--np-surface); border: 1px solid var(--np-line)"
        >
          <h3 class="mb-2 text-sm font-semibold" style="color: var(--np-text)">
            Upcoming Appointments
          </h3>
          <SchedulingWidget client:load />
        </div>

        <div
          class="rounded p-4"
          style="background: var(--np-surface); border: 1px solid var(--np-line)"
        >
          <h3 class="mb-2 text-sm font-semibold" style="color: var(--np-text)">
            Recent Messages
          </h3>
          <MessagingWidget client:load />
        </div>

        <div
          class="rounded p-4"
          style="background: var(--np-surface); border: 1px solid var(--np-line)"
        >
          <h3 class="mb-2 text-sm font-semibold" style="color: var(--np-text)">
            Homework
          </h3>
          <HomeworkWidget client:load />
        </div>

        <div
          class="rounded p-4"
          style="background: var(--np-surface); border: 1px solid var(--np-line)"
        >
          <h3 class="mb-2 text-sm font-semibold" style="color: var(--np-text)">
            Statements
          </h3>
          <StatementWidget client:load />
        </div>
      </div>
    </div>
  </PortalShell>
</Layout>
