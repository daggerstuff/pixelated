---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="Unauthorized - Pixelated Empathy">
  <main class="container mx-auto px-4 py-16">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="mb-4 text-4xl font-bold">Access Denied</h1>

      <div class="mb-8 rounded-none border border-ring bg-secondary p-6 text-foreground">
        <p class="mb-2 text-lg">
          You don't have permission to access this page.
        </p>
        <p>
          Please contact your administrator if you believe this is an error.
        </p>
      </div>

      <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="/"
          class="border-transparent hover:bg-primary/90 inline-flex items-center justify-center rounded-none border bg-primary px-6 py-3 text-base font-medium text-primary-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 focus:ring-offset-background"
        >
          Go to Home
        </a>

        <a
          href="/dashboard"
          class="inline-flex items-center justify-center rounded-none border border-border bg-secondary px-6 py-3 text-base font-medium text-foreground hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 focus:ring-offset-background"
        >
          Back to Dashboard
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  main {
    min-height: calc(100vh - 200px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>
