---
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = '404 - Page Not Found'
const description = 'Sorry, the page you are looking for could not be found.'
---

<BaseLayout {title} {description}>
  <div class="container mx-auto px-4 py-16 text-center">
    <h1 class="mb-4 text-4xl font-bold">404</h1>
    <p class="mb-8 text-xl">Page not found</p>
    <p>The page you're looking for doesn't exist or has been moved.</p>
    <a
      href="/"
      class="hover:bg-primary/90 mt-4 inline-block rounded-none bg-primary px-4 py-2 text-primary-foreground"
    >
      Return Home
    </a>
  </div>
</BaseLayout>
