---
// Enhanced Bias Detection Demo Page (Modernized UI/UX)
import BaseLayout from '@/layouts/BaseLayout.astro'
import EnhancedBiasDetectionInterface from '@/components/demos/bias-detection/EnhancedBiasDetectionInterface.tsx'
---

<BaseLayout
  title="Enhanced Bias Detection Demo - Pixelated Empathy"
  description="Advanced AI-powered bias detection system for therapeutic conversations with real-time analysis, counterfactual scenarios, and comprehensive reporting."
  keywords="bias detection, AI therapy, mental health, therapeutic training, bias analysis, cultural competency"
>
  <main class="min-h-screen bg-secondary">
    <!-- Hero Section -->
    <section class="bg-background text-foreground py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-bold mb-6">
            Enhanced Bias Detection Demo
          </h1>
          <p class="text-xl md:text-2xl mb-8 text-foreground">
            Advanced AI-powered analysis of bias patterns in therapeutic
            conversations with modern UI/UX
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            <span class="px-3 py-1 rounded-none bg-secondary border border-border text-sm">
              Real-time Analysis
            </span>
            <span class="px-3 py-1 rounded-none bg-secondary border border-border text-sm">
              Counterfactual Scenarios
            </span>
            <span class="px-3 py-1 rounded-none bg-secondary border border-border text-sm">
              Historical Trends
            </span>
            <span class="px-3 py-1 rounded-none bg-secondary border border-border text-sm">
              Responsive & Accessible
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Enhanced Interface -->
    <section class="py-10">
      <div class="container mx-auto px-4">
        <EnhancedBiasDetectionInterface client:load />
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center bg-card rounded-none p-8 border border-border">
          <h2 class="text-2xl font-bold mb-3">Ready to explore more?</h2>
          <p class="text-muted-foreground mb-6">
            Visit the original demo or explore platform dashboards for
            integrated analytics.
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            <a
              href="/demo/bias-detection"
              class="px-5 py-2 bg-secondary text-foreground rounded-none hover:bg-accent"
            >
              Original Demo
            </a>
            <a
              href="/dashboard/bias-detection"
              class="px-5 py-2 bg-primary text-primary-foreground rounded-none hover:bg-primary/90"
            >
              Bias Analytics Dashboard
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <style>
    .bias-detection-demo {
      min-height: 600px;
    }
    @media (max-width: 768px) {
      .bias-detection-demo {
        padding: 1rem;
      }
    }
    .demo-loading {
      animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulse {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0.5;
      }
    }
    .demo-container:focus-within {
      outline: 2px solid var(--np-mid);
      outline-offset: 2px;
    }
    @media print {
      .no-print {
        display: none !important;
      }
      .print-break {
        page-break-before: always;
      }
    }
  </style>
</BaseLayout>
