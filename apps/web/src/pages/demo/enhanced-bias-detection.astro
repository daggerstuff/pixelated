---
import EnhancedBiasDetectionInterface from '@/components/demos/bias-detection/EnhancedBiasDetectionInterface.tsx'
// Enhanced Bias Detection Demo Page (Modernized UI/UX)
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout
  title="Enhanced Bias Detection Demo - Pixelated Empathy"
  description="Advanced AI-powered bias detection system for therapeutic conversations with real-time analysis, counterfactual scenarios, and comprehensive reporting."
  keywords="bias detection, AI therapy, mental health, therapeutic training, bias analysis, cultural competency"
>
  <main class="min-h-screen bg-secondary">
    <!-- Hero Section -->
    <section class="bg-background py-16 text-foreground">
      <div class="container mx-auto px-4">
        <div class="mx-auto max-w-4xl text-center">
          <h1 class="mb-6 text-4xl font-bold md:text-5xl">
            Enhanced Bias Detection Demo
          </h1>
          <p class="mb-8 text-xl text-foreground md:text-2xl">
            Advanced AI-powered analysis of bias patterns in therapeutic
            conversations with modern UI/UX
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            <span class="rounded-none border border-border bg-secondary px-3 py-1 text-sm">
              Real-time Analysis
            </span>
            <span class="rounded-none border border-border bg-secondary px-3 py-1 text-sm">
              Counterfactual Scenarios
            </span>
            <span class="rounded-none border border-border bg-secondary px-3 py-1 text-sm">
              Historical Trends
            </span>
            <span class="rounded-none border border-border bg-secondary px-3 py-1 text-sm">
              Responsive & Accessible
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Enhanced Interface -->
    <section class="py-10">
      <div class="container mx-auto px-4">
        <EnhancedBiasDetectionInterface client:load />
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12">
      <div class="container mx-auto px-4">
        <div class="mx-auto max-w-3xl rounded-none border border-border bg-card p-8 text-center">
          <h2 class="mb-3 text-2xl font-bold">Ready to explore more?</h2>
          <p class="mb-6 text-muted-foreground">
            Visit the original demo or explore platform dashboards for
            integrated analytics.
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            <a
              href="/demo/bias-detection"
              class="rounded-none bg-secondary px-5 py-2 text-foreground hover:bg-accent"
            >
              Original Demo
            </a>
            <a
              href="/dashboard/bias-detection"
              class="hover:bg-primary/90 rounded-none bg-primary px-5 py-2 text-primary-foreground"
            >
              Bias Analytics Dashboard
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <style>
    .bias-detection-demo {
      min-height: 600px;
    }
    @media (max-width: 768px) {
      .bias-detection-demo {
        padding: 1rem;
      }
    }
    .demo-loading {
      animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulse {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0.5;
      }
    }
    .demo-container:focus-within {
      outline: 2px solid var(--np-mid);
      outline-offset: 2px;
    }
    @media print {
      .no-print {
        display: none !important;
      }
      .print-break {
        page-break-before: always;
      }
    }
  </style>
</BaseLayout>
