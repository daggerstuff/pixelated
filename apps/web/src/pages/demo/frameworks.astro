---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PsychologyFrameworksDemo from '@/components/demo/PsychologyFrameworksDemo'
---

<BaseLayout
  title="Therapeutic Frameworks Browser - Evidence-Based Practice"
  description="Interactive browser for evidence-based therapeutic frameworks and techniques. Explore CBT, DBT, ACT, and more with detailed clinical information."
>
  <main class="min-h-screen bg-background">
    <div class="container mx-auto px-4 py-12">
      <!-- Hero Section -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 bg-secondary border border-border rounded-full px-4 py-2 mb-6">
          <div class="w-2 h-2 bg-primary rounded-full animate-pulse"></div>
          <span class="text-foreground font-medium text-sm">
            THERAPEUTIC FRAMEWORKS
          </span>
        </div>

        <h1 class="text-4xl md:text-6xl font-bold text-foreground mb-6">
          Evidence-Based
          <span class="text-foreground block">Therapeutic Frameworks</span>
        </h1>

        <p class="text-xl text-foreground max-w-3xl mx-auto leading-relaxed mb-8">
          Comprehensive interactive browser for evidence-based therapeutic
          frameworks and techniques. Explore detailed clinical information,
          research evidence, and practical applications for CBT, DBT, ACT, and
          more.
        </p>

        <div class="flex flex-wrap justify-center gap-4 mb-8">
          <div class="bg-secondary border border-border rounded-none px-4 py-2 text-foreground">
            <span class="font-semibold">5+</span> Major Frameworks
          </div>
          <div class="bg-secondary border border-border rounded-none px-4 py-2 text-foreground">
            <span class="font-semibold">200+</span> Techniques
          </div>
          <div class="bg-secondary border border-border rounded-none px-4 py-2 text-foreground">
            <span class="font-semibold">Evidence</span> Levels
          </div>
          <div class="bg-secondary border border-border rounded-none px-4 py-2 text-foreground">
            <span class="font-semibold">Clinical</span> Applications
          </div>
        </div>
      </div>

      <!-- Demo Component -->
      <PsychologyFrameworksDemo client:load />

      <!-- Framework Information -->
      <div class="mt-16 max-w-6xl mx-auto">
        <div class="bg-secondary border border-border rounded-none p-8">
          <h2 class="text-2xl font-bold text-foreground mb-6 text-center">
            Included Therapeutic Frameworks
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="bg-card border border-border rounded-none p-6">
              <h3 class="text-lg font-semibold text-foreground mb-3">
                Cognitive Behavioral Therapy (CBT)
              </h3>
              <p class="text-foreground text-sm mb-4">
                Evidence-based approach focusing on identifying and changing
                dysfunctional thought patterns and behaviors.
              </p>
              <div class="text-xs text-foreground">
                <strong>Evidence Level:</strong> Strong •{' '}
                <strong>Applications:</strong> Depression, Anxiety, PTSD
              </div>
            </div>

            <div class="bg-card border border-border rounded-none p-6">
              <h3 class="text-lg font-semibold text-foreground mb-3">
                Dialectical Behavior Therapy (DBT)
              </h3>
              <p class="text-foreground text-sm mb-4">
                Comprehensive treatment incorporating mindfulness, distress
                tolerance, emotion regulation, and interpersonal skills.
              </p>
              <div class="text-xs text-foreground">
                <strong>Evidence Level:</strong> Strong •{' '}
                <strong>Applications:</strong> BPD, Self-harm, Emotional
                dysregulation
              </div>
            </div>

            <div class="bg-card border border-border rounded-none p-6">
              <h3 class="text-lg font-semibold text-foreground mb-3">
                Acceptance & Commitment Therapy (ACT)
              </h3>
              <p class="text-foreground text-sm mb-4">
                Third-wave therapy focusing on psychological flexibility,
                mindfulness, and values-based action.
              </p>
              <div class="text-xs text-foreground">
                <strong>Evidence Level:</strong> Moderate •{' '}
                <strong>Applications:</strong> Chronic pain, Anxiety, Workplace
                stress
              </div>
            </div>

            <div class="bg-card border border-border rounded-none p-6">
              <h3 class="text-lg font-semibold text-foreground mb-3">
                Psychodynamic Therapy
              </h3>
              <p class="text-foreground text-sm mb-4">
                Insight-oriented approach exploring unconscious processes and
                early life experiences.
              </p>
              <div class="text-xs text-foreground">
                <strong>Evidence Level:</strong> Moderate •{' '}
                <strong>Applications:</strong> Personality disorders, Complex
                trauma
              </div>
            </div>

            <div class="bg-card border border-border rounded-none p-6">
              <h3 class="text-lg font-semibold text-foreground mb-3">
                Humanistic Therapy
              </h3>
              <p class="text-foreground text-sm mb-4">
                Client-centered approach emphasizing personal growth,
                self-actualization, and therapeutic relationship.
              </p>
              <div class="text-xs text-foreground">
                <strong>Evidence Level:</strong> Moderate •{' '}
                <strong>Applications:</strong> Self-esteem, Personal growth
              </div>
            </div>

            <div class="bg-card border border-border rounded-none p-6">
              <h3 class="text-lg font-semibold text-foreground mb-3">
                Trauma-Informed Care
              </h3>
              <p class="text-foreground text-sm mb-4">
                Comprehensive approach recognizing and responding to the impact
                of traumatic stress.
              </p>
              <div class="text-xs text-foreground">
                <strong>Evidence Level:</strong> Strong •{' '}
                <strong>Applications:</strong> PTSD, Complex trauma, Crisis
                intervention
              </div>
            </div>
          </div>

          <div class="mt-8 p-6 bg-secondary border border-border rounded-none">
            <p class="text-muted-foreground text-center">
              <strong>Educational Resource:</strong> This framework browser
              provides evidence-based information for educational and training
              purposes. All content is derived from peer-reviewed research and
              clinical practice guidelines.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
