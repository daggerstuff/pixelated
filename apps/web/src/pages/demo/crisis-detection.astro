---
import CrisisDetectionDemo from '@/components/demo/CrisisDetectionDemo'
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout
  title="Crisis Detection System - Advanced Risk Assessment"
  description="Enterprise-grade crisis detection system with real-time suicide risk assessment, emergency protocols, and immediate intervention resources."
>
  <main class="min-h-screen bg-background">
    <div class="container mx-auto px-4 py-12">
      <!-- Hero Section -->
      <div class="mb-12 text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-secondary px-4 py-2">
          <div class="h-2 w-2 animate-pulse rounded-full bg-primary"></div>
          <span class="text-sm font-medium text-foreground">
            ENTERPRISE CRISIS SYSTEM
          </span>
        </div>

        <h1 class="mb-6 text-4xl font-bold text-foreground md:text-6xl">
          Crisis Detection
          <span class="block text-foreground">& Assessment</span>
        </h1>

        <p class="mx-auto mb-8 max-w-3xl text-xl leading-relaxed text-foreground">
          An illustrative crisis-detection demo that surfaces suicide-risk and
          self-harm signals in a synthetic transcript and prompts the trainee
          toward human support. It is not a clinical or emergency service.
        </p>

        <div class="mb-8 flex flex-wrap justify-center gap-4">
          <div class="rounded-none border border-border bg-secondary px-4 py-2 text-foreground">
            <span class="font-semibold">Synthetic</span> Transcripts Only
          </div>
          <div class="rounded-none border border-border bg-secondary px-4 py-2 text-foreground">
            <span class="font-semibold">Illustrative</span> Detection Signals
          </div>
          <div class="rounded-none border border-border bg-secondary px-4 py-2 text-foreground">
            <span class="font-semibold">No</span> Clinical Use
          </div>
          <div class="rounded-none border border-border bg-secondary px-4 py-2 text-foreground">
            <span class="font-semibold">Demo</span> Environment
          </div>
        </div>
      </div>

      <!-- Demo Component -->
      <CrisisDetectionDemo client:load />

      <!-- Technical Details -->
      <div class="mx-auto mt-16 max-w-4xl">
        <div class="rounded-none border border-border bg-secondary p-8">
          <h2 class="mb-6 text-center text-2xl font-bold text-foreground">
            Technical Specifications
          </h2>

          <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
            <div>
              <h3 class="mb-4 text-lg font-semibold text-foreground">
                Detection Capabilities
              </h3>
              <ul class="space-y-2 text-foreground">
                <li>• Suicidal ideation assessment</li>
                <li>• Self-harm risk evaluation</li>
                <li>• Hopelessness indicators</li>
                <li>• Impulsivity markers</li>
                <li>• Social isolation patterns</li>
                <li>• Substance use correlations</li>
              </ul>
            </div>

            <div>
              <h3 class="mb-4 text-lg font-semibold text-foreground">
                Clinical Features
              </h3>
              <ul class="space-y-2 text-foreground">
                <li>• Evidence-based assessment</li>
                <li>• Protective factor analysis</li>
                <li>• Risk stratification levels</li>
                <li>• Emergency resource routing</li>
                <li>• Intervention recommendations</li>
                <li>• Audit trail logging</li>
              </ul>
            </div>
          </div>

          <div class="mt-8 rounded-none border border-border bg-secondary p-6">
            <p class="text-center text-muted-foreground">
              <strong>Important:</strong> This system is designed for
              educational and training purposes. In actual crisis situations,
              immediately contact emergency services (911) or the National
              Suicide Prevention Lifeline (988).
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
