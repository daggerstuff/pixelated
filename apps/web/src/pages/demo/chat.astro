---
import { ChartBar, Rocket } from 'lucide-react'

import BrutalistButton from '@/components/ui/BrutalistButton.astro'
import BrutalistCard from '@/components/ui/BrutalistCard.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

import { ChatDemo } from '../../components/demo'
export const prerender = false
---

<BaseLayout
  title="Mental Health AI Chat - Live Demo"
  description="Experience our therapeutic AI chat system with real-time sentiment analysis and crisis detection capabilities"
>
  <!-- Enhanced Hero Section with Modern Visual Elements -->
  <section class="brutalist-section mesh-bg-1 relative overflow-hidden">
    <!-- Floating Background Elements -->

    <div class="brutalist-container relative z-10">
      <div class="mb-12 text-center">
        <!-- Enhanced Status Indicator -->
        <div class="nav-pill nav-pill--active mb-8 inline-flex items-center gap-3">
          <div class="status-dot status-dot--online"></div>
          <span class="font-bold">THERAPEUTIC AI ONLINE</span>
        </div>

        <h1 class="brutalist-heading mb-6 text-5xl md:text-7xl">
          <span>THERAPEUTIC</span>
          <br />
          <span>AI CHAT</span>
        </h1>

        <p class="mx-auto mb-8 max-w-4xl text-xl text-foreground">
          Experience advanced AI chat with{' '}
          <span class="font-bold">therapeutic response generation</span>,
          real-time sentiment analysis, and crisis detection powered by
          enterprise-grade AI.
        </p>

        <!-- Enhanced Badge System -->
        <div class="mb-12 flex flex-wrap justify-center gap-4">
          <div class="nav-pill border border-border bg-secondary text-foreground">
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
              ></path>
            </svg>
            REAL-TIME CHAT
          </div>
          <div class="nav-pill border border-border bg-secondary text-foreground">
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
              ></path>
            </svg>
            SENTIMENT ANALYSIS
          </div>
          <div class="nav-pill border border-border bg-secondary text-foreground">
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"
              ></path>
            </svg>
            CRISIS DETECTION
          </div>
          <div class="nav-pill border border-border bg-secondary text-foreground">
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.031 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
            DEMO DATA
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Enhanced Main Chat Demo -->
  <section class="brutalist-section mesh-bg-2 bg-card">
    <div class="brutalist-container">
      <div class="mx-auto max-w-6xl">
        <div class="glass-card mb-12">
          <div class="space-y-6">
            <div class="border-b border-border pb-4">
              <h3 class="brutalist-subheading mb-2 text-2xl">
                💬 LIVE CHAT INTERFACE
              </h3>
              <p class="text-foreground">
                Send a message to start a therapeutic conversation with our AI
              </p>
            </div>

            <!-- Chat Demo Container -->
            <div class="chat-container rounded-none">
              <ChatDemo client:load />
            </div>

            <!-- Quick Start Actions -->
            <div class="flex gap-3 border-t border-border pt-4">
              <BrutalistButton
                variant="primary"
                class="flex-1"
                id="sample-anxiety"
              >
                😰 Try Anxiety Sample
              </BrutalistButton>
              <BrutalistButton
                variant="secondary"
                class="flex-1"
                id="sample-depression"
              >
                😔 Try Depression Sample
              </BrutalistButton>
              <BrutalistButton
                variant="outline"
                class="flex-1"
                id="sample-crisis"
              >
                🚨 Try Crisis Sample
              </BrutalistButton>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Showcase -->
  <section class="brutalist-section">
    <div class="brutalist-container">
      <div class="mb-12 text-center">
        <h2 class="brutalist-heading mb-4 text-3xl md:text-5xl">
          ADVANCED
          <span class="confidence-boost">CAPABILITIES</span>
        </h2>
        <p class="text-lg text-foreground">
          Real-time AI analysis and therapeutic response generation
        </p>
      </div>

      <div class="brutalist-grid brutalist-grid--2 mx-auto max-w-5xl">
        <BrutalistCard hover={true}>
          <div class="text-center">
            <div class="mb-6 text-5xl">🧠</div>
            <h3 class="brutalist-subheading mb-4 text-xl">
              REAL-TIME ANALYSIS
            </h3>
            <div class="space-y-3 text-left">
              <div class="flex items-center gap-3">
                <span class="h-3 w-3 rounded-full bg-primary"></span>
                <span class="text-foreground">
                  Sentiment analysis of every message
                </span>
              </div>
              <div class="flex items-center gap-3">
                <span class="h-3 w-3 rounded-full bg-primary"></span>
                <span class="text-foreground">Emotional state tracking</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="h-3 w-3 rounded-full bg-primary"></span>
                <span class="text-foreground">Crisis detection & alerting</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="h-3 w-3 rounded-full bg-primary"></span>
                <span class="text-foreground">
                  Therapeutic response generation
                </span>
              </div>
            </div>
          </div>
        </BrutalistCard>

        <BrutalistCard hover={true}>
          <div class="text-center">
            <div class="mb-6 text-5xl">🔒</div>
            <h3 class="brutalist-subheading mb-4 text-xl">
              SECURITY & COMPLIANCE
            </h3>
            <div class="space-y-3 text-left">
              <div class="flex items-center gap-3">
                <span class="h-3 w-3 rounded-full bg-primary"></span>
                <span class="text-foreground">Synthetic-data architecture</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="h-3 w-3 rounded-full bg-primary"></span>
                <span class="text-foreground">End-to-end encryption</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="h-3 w-3 rounded-full bg-primary"></span>
                <span class="text-foreground">Comprehensive audit logging</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="h-3 w-3 rounded-full bg-primary"></span>
                <span class="text-foreground">Zero data retention in demo</span>
              </div>
            </div>
          </div>
        </BrutalistCard>
      </div>
    </div>
  </section>

  <!-- Technical Details -->
  <section class="brutalist-section bg-card">
    <div class="brutalist-container">
      <div class="mb-12 text-center">
        <h2 class="brutalist-heading mb-4 text-3xl md:text-5xl">
          HOW IT
          <span class="text-foreground">WORKS</span>
        </h2>
        <p class="text-lg text-foreground">
          Advanced AI integration with therapeutic training
        </p>
      </div>

      <div class="brutalist-grid brutalist-grid--3">
        <BrutalistCard hover={true}>
          <div class="text-center">
            <div class="mb-4 text-4xl">⚡</div>
            <h3 class="brutalist-subheading mb-3 text-lg">
              STREAMING RESPONSES
            </h3>
            <p class="mb-4 text-sm text-foreground">
              Real-time streaming responses using the LLM API for natural
              conversation flow.
            </p>
            <div class="space-y-2 text-sm">
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-primary"></span>
                <span>Sub-second response times</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-primary"></span>
                <span>Natural conversation flow</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-primary"></span>
                <span>Context-aware responses</span>
              </div>
            </div>
          </div>
        </BrutalistCard>

        <BrutalistCard hover={true}>
          <div class="text-center">
            <div class="mb-4 text-4xl">
              <ChartBar className="h-10 w-10" />
            </div>
            <h3 class="brutalist-subheading mb-3 text-lg">
              SENTIMENT ANALYSIS
            </h3>
            <p class="mb-4 text-sm text-foreground">
              Real-time emotional state analysis with configurable sensitivity
              thresholds.
            </p>
            <div class="space-y-2 text-sm">
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-primary"></span>
                <span>Emotion classification</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-primary"></span>
                <span>Intensity scoring</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-primary"></span>
                <span>Trend tracking</span>
              </div>
            </div>
          </div>
        </BrutalistCard>

        <BrutalistCard hover={true}>
          <div class="text-center">
            <div class="mb-4 text-4xl">🚨</div>
            <h3 class="brutalist-subheading mb-3 text-lg">CRISIS DETECTION</h3>
            <p class="mb-4 text-sm text-foreground">
              Advanced pattern recognition for identifying crisis situations
              with immediate alerts.
            </p>
            <div class="space-y-2 text-sm">
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-primary"></span>
                <span>Suicide risk assessment</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-primary"></span>
                <span>Self-harm detection</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-primary"></span>
                <span>Immediate escalation</span>
              </div>
            </div>
          </div>
        </BrutalistCard>
      </div>
    </div>
  </section>

  <!-- Performance Metrics -->
  <section class="brutalist-section">
    <div class="brutalist-container">
      <div class="mb-12 text-center">
        <h2 class="brutalist-heading mb-4 text-3xl md:text-5xl">
          DEMO
          <span class="confidence-boost">METRICS</span>
        </h2>
        <p class="text-lg text-foreground">
          What this demo shows. No accuracy, uptime or session figures are
          claimed.
        </p>
      </div>

      <div class="dashboard-grid">
        <div class="metric-card">
          <div class="metric-value">Streaming</div>
          <div class="metric-label">Response Mode</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">Sample</div>
          <div class="metric-label">Sentiment Analysis</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">Demo</div>
          <div class="metric-label">Environment</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">1</div>
          <div class="metric-label">Sample Session</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="brutalist-section bg-card">
    <div class="brutalist-container">
      <div class="mental-health-safe mx-auto max-w-4xl text-center">
        <div class="mb-6 text-5xl">
          <Rocket className="h-20 w-20" />
        </div>

        <h2 class="brutalist-heading mb-6 text-3xl md:text-5xl">
          READY TO INTEGRATE
          <br />
          <span class="confidence-boost">THERAPEUTIC AI?</span>
        </h2>

        <p class="mb-8 text-xl text-foreground">
          Deploy our AI chat system in your practice. Full API access, custom
          training, and enterprise support.
        </p>

        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          <BrutalistButton href="/contact" variant="primary" size="lg">
            GET API ACCESS →
          </BrutalistButton>
          <BrutalistButton href="/demo-hub" variant="secondary" size="lg">
            EXPLORE MORE DEMOS
          </BrutalistButton>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  class ChatDemoInterface {
    constructor() {
      this.initializeSampleButtons()
    }

    initializeSampleButtons() {
      const anxietyBtn = document.getElementById('sample-anxiety')
      const depressionBtn = document.getElementById('sample-depression')
      const crisisBtn = document.getElementById('sample-crisis')

      anxietyBtn?.addEventListener('click', () => {
        this.sendSampleMessage(
          "I'm feeling really anxious about my presentation tomorrow. My heart won't stop racing and I can't sleep.",
        )
      })

      depressionBtn?.addEventListener('click', () => {
        this.sendSampleMessage(
          "I've been feeling empty and hopeless lately. Nothing seems to bring me joy anymore.",
        )
      })

      crisisBtn?.addEventListener('click', () => {
        this.sendSampleMessage(
          "I don't think I can handle this anymore. Everything feels overwhelming and pointless.",
        )
      })
    }

    sendSampleMessage(message: string) {
      // This would integrate with the ChatDemo component
      // For now, we'll simulate the action
      const chatInput = document.querySelector(
        'textarea[placeholder*="message"]',
      ) as HTMLTextAreaElement
      if (chatInput) {
        chatInput.value = message
        chatInput.focus()

        // Trigger input event to notify the component
        const event = new Event('input', { bubbles: true })
        chatInput.dispatchEvent(event)
      }
    }
  }

  // Initialize demo interface
  document.addEventListener('DOMContentLoaded', () => {
    const _chatDemo = new ChatDemoInterface()
  })
</script>

<style>
  /* Enhanced chat container styling */
  .chat-container {
    min-height: 600px;
    background: var(--np-surface);
    border: 1px solid var(--np-line);
    border-radius: 0;
  }

  /* Sample button hover effects */
  #sample-anxiety:hover,
  #sample-depression:hover,
  #sample-crisis:hover {
    border-color: var(--np-mid);
  }

  /* Metric card animations */
  .metric-card {
    transition: border-color 0.15s ease;
  }

  .metric-card:hover {
    border-color: var(--np-mid);
  }

  /* Custom animations */
  @keyframes pulse-metrics {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.8;
    }
  }

  .metric-value {
    animation: pulse-metrics 3s ease-in-out infinite;
  }
</style>
