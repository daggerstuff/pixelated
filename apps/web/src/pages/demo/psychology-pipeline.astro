---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PipelineOverview from '../../components/demo/PipelineOverview.tsx'
import KnowledgeParsingDemo from '../../components/demo/KnowledgeParsingDemo.tsx'
import ScenarioGenerationDemo from '../../components/demo/ScenarioGenerationDemo.tsx'
import Card from '@/components/ui/Card.astro'
import CardContent from '@/components/ui/CardContent.astro'
import CardDescription from '@/components/ui/CardDescription.astro'
import CardHeader from '@/components/ui/CardHeader.astro'
import CardTitle from '@/components/ui/CardTitle.astro'
import { ChartBar } from 'lucide-react'
import Badge from '@/components/ui/Badge.astro'
---

<BaseLayout
  title="Psychology Pipeline Demo"
  description="Advanced AI-powered psychology pipeline demonstration featuring clinical knowledge parsing, therapeutic scenario generation, and comprehensive mental health analysis tools."
  bgType="plum"
>
  <div class="min-h-screen text-foreground py-8">
    <div class="container mx-auto px-4">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="mb-6">
          <Badge class="inline-flex items-center gap-2 px-4 py-2 text-sm bg-secondary border border-border text-muted-foreground rounded-none">
            <span class="relative flex h-3 w-3">
              <span class="animate-pulse absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-primary"></span>
            </span>
            Live Demo Active
          </Badge>
        </div>
        <h1 class="text-4xl lg:text-5xl font-bold mb-6">
          Psychology Pipeline
          <span class="text-foreground block mt-2">
            AI-Powered Clinical Analysis
          </span>
        </h1>
        <p class="text-lg text-foreground max-w-3xl mx-auto">
          Experience cutting-edge artificial intelligence in clinical psychology
          with real-time knowledge parsing, therapeutic scenario generation, and
          comprehensive mental health analysis tools.
        </p>
      </div>

      <!-- Features Overview -->
      <div class="grid md:grid-cols-3 gap-8 mb-12">
        <Card class="border border-border bg-secondary">
          <CardHeader>
            <div class="text-4xl mb-3">🧠</div>
            <CardTitle class="text-foreground">Knowledge Parsing</CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription class="text-muted-foreground">
              Advanced entity extraction and concept analysis for psychological
              and therapeutic content with real-time confidence scoring.
            </CardDescription>
            <div class="mt-4 space-y-2">
              <div class="flex items-center gap-2 text-sm">
                <span class="w-2 h-2 bg-primary rounded-full"></span>
                <span>Mental health condition detection</span>
              </div>
              <div class="flex items-center gap-2 text-sm">
                <span class="w-2 h-2 bg-primary rounded-full"></span>
                <span>Therapeutic technique identification</span>
              </div>
              <div class="flex items-center gap-2 text-sm">
                <span class="w-2 h-2 bg-primary rounded-full"></span>
                <span>Risk assessment & analysis</span>
              </div>
            </div>
          </CardContent>
        </Card>

        <Card class="border border-border bg-secondary">
          <CardHeader>
            <div class="text-4xl mb-3">📋</div>
            <CardTitle class="text-foreground">Scenario Generation</CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription class="text-muted-foreground">
              Create comprehensive therapeutic scenarios with detailed client
              profiles, clinical formulations, and treatment plans.
            </CardDescription>
            <div class="mt-4 space-y-2">
              <div class="flex items-center gap-2 text-sm">
                <span class="w-2 h-2 bg-primary rounded-full"></span>
                <span>Dynamic client profile creation</span>
              </div>
              <div class="flex items-center gap-2 text-sm">
                <span class="w-2 h-2 bg-primary rounded-full"></span>
                <span>Clinical formulation generation</span>
              </div>
              <div class="flex items-center gap-2 text-sm">
                <span class="w-2 h-2 bg-primary rounded-full"></span>
                <span>Treatment plan development</span>
              </div>
            </div>
          </CardContent>
        </Card>

        <Card class="border border-border bg-secondary">
          <CardHeader>
            <div class="text-4xl mb-3">
              <ChartBar className="w-10 h-10" />
            </div>
            <CardTitle class="text-foreground">Analytics & Insights</CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription class="text-muted-foreground">
              Comprehensive analysis with detailed metadata, confidence scoring,
              and clinical relevance metrics for informed decision-making.
            </CardDescription>
            <div class="mt-4 space-y-2">
              <div class="flex items-center gap-2 text-sm">
                <span class="w-2 h-2 bg-primary rounded-full"></span>
                <span>Real-time confidence scoring</span>
              </div>
              <div class="flex items-center gap-2 text-sm">
                <span class="w-2 h-2 bg-primary rounded-full"></span>
                <span>Performance metrics tracking</span>
              </div>
              <div class="flex items-center gap-2 text-sm">
                <span class="w-2 h-2 bg-primary rounded-full"></span>
                <span>Clinical relevance assessment</span>
              </div>
            </div>
          </CardContent>
        </Card>
      </div>

      <!-- Pipeline Overview Section -->
      <Card class="border border-border bg-secondary mb-12">
        <CardHeader>
          <CardTitle class="text-foreground text-2xl">
            Pipeline Architecture Overview
          </CardTitle>
          <CardDescription class="text-foreground">
            Understand the sophisticated workflow that powers our AI-driven
            clinical analysis system.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <PipelineOverview client:load />
        </CardContent>
      </Card>

      <!-- Knowledge Parsing Demo Section -->
      <Card class="border border-border bg-secondary mb-12">
        <CardHeader>
          <CardTitle class="text-foreground text-2xl">
            Clinical Knowledge Parsing Demo
          </CardTitle>
          <CardDescription class="text-foreground">
            Experience real-time entity extraction and concept analysis for
            psychological and therapeutic content.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <KnowledgeParsingDemo client:load />
        </CardContent>
      </Card>

      <!-- Scenario Generation Demo Section -->
      <Card class="border border-border bg-secondary mb-12">
        <CardHeader>
          <CardTitle class="text-foreground text-2xl">
            Therapeutic Scenario Generation Demo
          </CardTitle>
          <CardDescription class="text-foreground">
            Create comprehensive clinical cases with detailed formulations and
            evidence-based treatment plans.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <ScenarioGenerationDemo client:load />
        </CardContent>
      </Card>

      <!-- Technical Specifications -->
      <Card class="border border-border bg-secondary">
        <CardHeader>
          <CardTitle class="text-foreground text-xl">
            Technical Specifications
          </CardTitle>
          <CardDescription class="text-foreground">
            Performance metrics and system capabilities of the psychology
            pipeline.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="text-center p-4 bg-secondary rounded-none">
              <div class="text-2xl font-bold text-foreground">{'< 500ms'}</div>
              <div class="text-sm text-foreground">Average Response Time</div>
            </div>
            <div class="text-center p-4 bg-secondary rounded-none">
              <div class="text-2xl font-bold text-foreground">94.7%</div>
              <div class="text-sm text-foreground">
                Clinical Entity Recognition
              </div>
            </div>
            <div class="text-center p-4 bg-secondary rounded-none">
              <div class="text-2xl font-bold text-foreground">50k+</div>
              <div class="text-sm text-foreground">Training Case Studies</div>
            </div>
            <div class="text-center p-4 bg-secondary rounded-none">
              <div class="text-2xl font-bold text-foreground">HIPAA</div>
              <div class="text-sm text-foreground">Compliant Encryption</div>
            </div>
            <div class="text-center p-4 bg-secondary rounded-none">
              <div class="text-2xl font-bold text-foreground">10k+</div>
              <div class="text-sm text-foreground">Concurrent Analyses</div>
            </div>
            <div class="text-center p-4 bg-secondary rounded-none">
              <div class="text-2xl font-bold text-foreground">REST</div>
              <div class="text-sm text-foreground">API with Webhooks</div>
            </div>
          </div>
        </CardContent>
      </Card>
    </div>
  </div>
</BaseLayout>
