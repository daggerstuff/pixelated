---
import { Target as TargetIcon } from 'lucide-react'

import BrutalistButton from '@/components/ui/BrutalistButton.astro'
import BrutalistCard from '@/components/ui/BrutalistCard.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
// import BrutalistBadge from '@/components/ui/BrutalistBadge.astro'

export const prerender = false // Enable SSR for A/B testing

// A/B Testing Variants
const variants = {
  A: {
    headline: 'Rehearse the Conversations That Matter',
    subheadline:
      "Practice crisis interventions with synthetic AI clients who can't be harmed",
    cta: 'Open the Demo',
  },
  B: {
    headline: 'Train Without Fear, Heal With Confidence',
    subheadline:
      'Rehearse difficult cases through AI simulation before facing real clients',
    cta: 'Open the Demo',
  },
  C: {
    headline: 'Practice What Textbooks Cannot Teach',
    subheadline:
      "Synthetic AI clients let you rehearse what a textbook can't demonstrate",
    cta: 'Open the Demo',
  },
}

// Randomly assign variant (in production, this would be more sophisticated)
const variantKey = ['A', 'B', 'C'][Math.floor(Math.random() * 3)]
const currentVariant = (variants as any)?.[variantKey]

const technicalSpecs = [
  {
    metric: 'Crisis Response',
    value: 'Rehearsal',
    comparison: 'Practice a high-risk moment before it is real',
  },
  {
    metric: 'Multi-Session',
    value: 'Personas',
    comparison: 'Follow one synthetic client across a series',
  },
  {
    metric: 'Turn-Level',
    value: 'Feedback',
    comparison: 'Supervisor review grounded in the transcript',
  },
  {
    metric: 'Repeatable',
    value: 'Retries',
    comparison: 'Rerun any moment as often as you need',
  },
]

const impossibleScenarios = [
  {
    title: 'Persistent AI Patients Across Sessions',
    description:
      "AI patient 'Marcus' remembers being abandoned, tests boundaries consistently across sessions",
    icon: '🧠',
    accent: 'red',
  },
  {
    title: 'Crisis Training Without Consequences',
    description:
      'Students rehearse suicidal ideation scenarios repeatedly until the response is deliberate rather than panicked',
    icon: '🚨',
    accent: 'red',
  },
  {
    title: 'Personality Disorder Simulations',
    description:
      'Experience borderline splitting, narcissistic rage, antisocial manipulation safely',
    icon: '🎭',
    accent: 'red',
  },
  {
    title: 'Trauma Response Training',
    description:
      'Practice with dissociation, flashbacks, and complex PTSD presentations',
    icon: '💔',
    accent: 'red',
  },
]
---

<BaseLayout
  title="ClinicalVault Trainer - Synthetic Clinical Simulation"
  description="Rehearse crisis interventions and complex therapy scenarios with synthetic AI clients. Illustrative demo, not a clinical service."
>
  <!-- Hero Section -->
  <section class="brutalist-section">
    <div class="brutalist-container">
      <div class="mb-12 text-center">
        <div class="status-indicator status-indicator--warning mb-6 inline-flex">
          <div class="pulse-dot pulse-dot--blue"></div>
          <span class="font-bold">CRISIS TRAINING DEMO</span>
        </div>

        <h1 class="brutalist-heading mb-6 text-5xl md:text-7xl">
          {currentVariant.headline}
          <br />
          <span class="text-foreground">CLINICALVAULT</span>
        </h1>

        <p class="mx-auto mb-8 max-w-4xl text-xl text-foreground">
          {currentVariant.subheadline}
        </p>
      </div>
    </div>
  </section>

  <!-- Technical Specifications -->
  <section class="brutalist-section bg-card">
    <div class="brutalist-container">
      <div class="dashboard-grid">
        {technicalSpecs.map((spec) => (
          <div class="metric-card hover-lift">
            <div class="metric-value text-foreground">{spec.value}</div>
            <div class="metric-label">{spec.metric}</div>
            <div class="mt-2 text-xs text-foreground">{spec.comparison}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive Demo Section -->
  <section class="brutalist-section">
    <div class="brutalist-container">
      <BrutalistCard variant="elevated" class="mx-auto max-w-4xl">
        <div class="space-y-6">
          <div class="border-b border-border pb-4">
            <div class="flex items-start justify-between">
              <div>
                <h3 class="brutalist-subheading mb-2 text-2xl">
                  🚨 LIVE CRISIS INTERVENTION DEMO
                </h3>
                <p class="text-foreground">
                  Experience a real training scenario with AI patient "Sarah"
                  presenting with suicidal ideation
                </p>
              </div>
              <div class="status-indicator status-indicator--warning">
                <div class="pulse-dot pulse-dot--blue"></div>
                <span class="font-bold">LIVE DEMO</span>
              </div>
            </div>
          </div>

          <div class="chat-container">
            <div class="chat-header">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-secondary">
                  <span class="text-foreground">👤</span>
                </div>
                <div>
                  <div class="font-medium text-foreground">
                    AI Patient: Sarah
                  </div>
                  <div class="text-sm text-muted-foreground">
                    Presenting with acute suicidal ideation
                  </div>
                </div>
              </div>
            </div>

            <div class="chat-messages">
              <div class="message message--ai">
                "I don't see the point anymore. Everything I try just fails.
                Maybe everyone would be better off without me..."
              </div>
            </div>

            <div class="chat-input-area">
              <div class="flex gap-3">
                <BrutalistButton
                  variant="primary"
                  class="flex-1"
                  data-demo-action="crisis-response"
                >
                  PRACTICE CRISIS RESPONSE
                </BrutalistButton>
                <BrutalistButton
                  variant="outline"
                  data-demo-action="view-techniques"
                >
                  VIEW TECHNIQUES
                </BrutalistButton>
              </div>
            </div>
          </div>

          <div class="flex flex-wrap gap-4 text-sm text-foreground">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-primary"></span>
              <span>Adapts in real-time</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-primary"></span>
              <span>Completely private and safe</span>
            </div>
          </div>
        </div>
      </BrutalistCard>
    </div>
  </section>

  <!-- Impossible Before HIPAA Section -->
  <section class="brutalist-section bg-card">
    <div class="brutalist-container">
      <div class="mb-12 text-center">
        <h2 class="brutalist-heading mb-4 text-3xl md:text-5xl">
          TRAINING THAT WAS
          <span class="text-foreground">IMPOSSIBLE BEFORE</span>
        </h2>
        <p class="mx-auto max-w-4xl text-lg text-foreground">
          These scenarios were too dangerous, too rare, or too ethically complex
          to practice with real patients
        </p>
      </div>

      <div class="brutalist-grid brutalist-grid--2">
        {impossibleScenarios.map((scenario) => (
          <BrutalistCard hover={true}>
            <div class="space-y-4">
              <div class="text-center text-5xl">{scenario.icon}</div>
              <div class="brutalist-badge brutalist-badge--danger text-center">
                PREVIOUSLY IMPOSSIBLE TO PRACTICE SAFELY
              </div>
              <h3 class="brutalist-subheading text-lg">{scenario.title}</h3>
              <p class="leading-relaxed text-foreground">
                {scenario.description}
              </p>
            </div>
          </BrutalistCard>
        ))}
      </div>
    </div>
  </section>

  <!-- Security Guarantee -->
  <section class="brutalist-section bg-card">
    <div class="brutalist-container">
      <BrutalistCard variant="security" class="mx-auto max-w-4xl">
        <div class="space-y-6 text-center">
          <div class="text-6xl">🛡️</div>
          <h3 class="brutalist-subheading text-2xl">
            SYNTHETIC DATA BY DESIGN
          </h3>
          <p class="text-lg leading-relaxed text-foreground">
            This demo runs on synthetic personas. No client records, protected
            health information, or real patient material is processed, so there
            is nothing sensitive to expose in a rehearsal.
          </p>
          <div class="flex flex-wrap justify-center gap-6">
            <div class="flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-primary"></span>
              <span class="font-medium">Synthetic Personas</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-primary"></span>
              <span class="font-medium">No Client Records</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-primary"></span>
              <span class="font-medium">Illustrative Demo</span>
            </div>
          </div>
        </div>
      </BrutalistCard>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="brutalist-section">
    <div class="brutalist-container">
      <div class="mental-health-safe mx-auto max-w-4xl text-center">
        <div class="mb-6 text-6xl">
          <TargetIcon className="h-24 w-24" />
        </div>

        <div class="status-indicator status-indicator--warning mb-6 inline-flex">
          <div class="pulse-dot pulse-dot--blue"></div>
          <span class="font-bold">PROPOSED TRAINING CONCEPT</span>
        </div>

        <h2 class="brutalist-heading mb-8 text-3xl md:text-5xl">
          READY TO TRANSFORM YOUR
          <br />
          <span class="confidence-boost">TRAINING PROGRAM?</span>
        </h2>

        <p class="mb-8 text-xl leading-relaxed text-foreground">
          Bring synthetic clinical rehearsal to your program's next practicum
          semester.
        </p>

        <div class="mb-8 flex flex-col justify-center gap-4 sm:flex-row">
          <BrutalistButton
            href="/contact"
            variant="primary"
            size="lg"
            data-demo-cta="primary"
            data-variant={variantKey}
          >
            {currentVariant?.['cta']}
          </BrutalistButton>
          <BrutalistButton
            href="/demo-hub"
            variant="secondary"
            size="lg"
            data-demo-cta="secondary"
          >
            EXPLORE OTHER DEMOS
          </BrutalistButton>
        </div>

        <div class="flex flex-wrap justify-center gap-4">
          <div class="brutalist-badge brutalist-badge--success">
            🎓 MADE FOR UNIVERSITIES
          </div>
          <div class="brutalist-badge brutalist-badge--info">
            🔒 YOUR DATA STAYS PRIVATE
          </div>
          <div class="brutalist-badge brutalist-badge--success">
            💛 BUILT FOR TRAINING PROGRAMS
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Analytics tracking for demo interactions
  document.addEventListener('DOMContentLoaded', () => {
    // Track page view
    if (typeof window.gtag !== 'undefined') {
      window.gtag('event', 'page_view', {
        page_title: 'ClinicalVault Trainer Demo',
        page_location: window.location.href,
        ab_variant:
          (document.querySelector('[data-variant]') as HTMLElement | null)
            ?.dataset['variant'] || 'unknown',
      })
    }

    // Track demo interactions
    document.querySelectorAll('[data-demo-action]').forEach((button) => {
      button.addEventListener('click', (e: any) => {
        const target = e.target as HTMLElement | null
        if (!target) return

        const action = target.dataset['demoAction']

        if (!action) return

        if (typeof window.gtag !== 'undefined') {
          window.gtag('event', 'demo_interaction', {
            demo_type: 'clinical_vault_trainer',
            interaction_type: action,
            ab_variant:
              (document.querySelector('[data-variant]') as HTMLElement | null)
                ?.dataset['variant'] || 'unknown',
          })
        }

        // Send to our analytics API
        fetch('/api/analytics/demo-tracking', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event: 'demo_interaction',
            page: 'clinical-vault-trainer',
            action: action,
            timestamp: new Date().toISOString(),
            session_id: sessionStorage.getItem('session_id') || 'anonymous',
            ab_variant:
              (document.querySelector('[data-variant]') as HTMLElement | null)
                ?.dataset['variant'] || 'unknown',
          }),
        }).catch(console.error)
      })
    })

    // Track CTA clicks
    document.querySelectorAll('[data-demo-cta]').forEach((button) => {
      button.addEventListener('click', (e: any) => {
        const target = e.target as HTMLElement | null
        if (!target) return

        const ctaType = target.dataset?.['demoCta']
        const variant = target.dataset?.['variant']

        if (!ctaType) return

        if (typeof window.gtag !== 'undefined') {
          window.gtag('event', 'demo_cta_click', {
            demo_type: 'clinical_vault_trainer',
            cta_type: ctaType,
            ab_variant: variant || 'unknown',
          })
        }

        // Send to our analytics API
        fetch('/api/analytics/demo-tracking', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event: 'demo_cta_click',
            page: 'clinical-vault-trainer',
            cta_type: ctaType,
            timestamp: new Date().toISOString(),
            session_id: sessionStorage.getItem('session_id') || 'anonymous',
            ab_variant: variant || 'unknown',
          }),
        }).catch(console.error)
      })
    })

    // Track scroll depth
    let maxScroll = 0
    window.addEventListener('scroll', () => {
      const scrollPercent = Math.round(
        (window.scrollY / (document.body.scrollHeight - window.innerHeight)) *
          100,
      )
      if (scrollPercent > maxScroll) {
        maxScroll = scrollPercent

        if (maxScroll % 25 === 0 && typeof window.gtag !== 'undefined') {
          window.gtag('event', 'scroll_depth', {
            demo_type: 'clinical_vault_trainer',
            scroll_depth: maxScroll,
            ab_variant:
              (document.querySelector('[data-variant]') as HTMLElement | null)
                ?.dataset?.['variant'] || 'unknown',
          })
        }
      }
    })
  })
</script>
