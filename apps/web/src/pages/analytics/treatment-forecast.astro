---
import TreatmentForecastForm from '@/components/analytics/TreatmentForecastForm.tsx'
---

<html lang="en">
  <head>
    <title>Treatment Outcome Forecast</title>
    <meta
      name="description"
      content="Forecast treatment outcomes using AI-powered analytics."
    />
  </head>
  <body>
    <main class="bg-white mx-auto mt-8 max-w-2xl rounded-lg p-6 shadow-lg">
      <h1 class="mb-4 text-3xl font-bold text-primary">
        Treatment Outcome Forecast
      </h1>
      <p class="mb-6 text-muted-foreground">
        Predict the likelihood of achieving specific treatment outcomes based on
        your session and plan data. All predictions are AI-powered and for
        clinical decision support only.
      </p>
      <TreatmentForecastForm client:load />
    </main>
  </body>
</html>

<style>
  .input {
    @apply rounded border px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary;
  }
  .btn {
    @apply hover:bg-primary/90 rounded-none bg-primary px-4 py-2 font-semibold text-primary-foreground transition;
  }
  .alert-error {
    @apply rounded-none border border-ring bg-secondary px-4 py-2 text-foreground;
  }
  .checkbox {
    @apply form-checkbox h-5 w-5 text-primary;
  }
</style>
