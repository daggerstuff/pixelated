---
export const prerender = false
import type { AstroGlobal } from 'astro'

import { ConversionDashboard } from '@/components/analytics/ConversionDashboard'
import { PrivacyDashboard } from '@/components/analytics/PrivacyDashboard'
import AnalyticsDashboard from '@/components/chat/AnalyticsDashboardReact'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { requirePageAuth } from '@/lib/auth/serverAuth'
import { PolicyEngine } from '@/lib/governance/policy-engine'

// Protect this route - only authenticated users can access analytics
const authResponse = await requirePageAuth(Astro as AstroGlobal)
if (authResponse) {
  return authResponse
}

// Enforce Data Governance policies
const policyEngine = new PolicyEngine()
const evalResult = await policyEngine.evaluate({
  action: 'view_analytics',
  context: {
    userId: Astro.locals.user?.id,
    auditEnabled: true,
    consentVerified: true,
  },
})

if (!evalResult.allowed) {
  return Astro.redirect(
    `/unauthorized?reason=${encodeURIComponent(evalResult.reason)}`,
  )
}

// Default analytics configuration
const defaultConfig = {
  securityLevel: 'maximum' as const,
  encryptionEnabled: true,
  scenario: 'analytics',
}
---

<BaseLayout
  title="Analytics Dashboard"
  description="View and manage analytics data"
>
  <div class="container mx-auto px-4 py-8">
    <h1 class="mb-8 text-4xl font-bold">Analytics Dashboard</h1>

    <div class="grid gap-8 md:grid-cols-[350px,1fr]">
      {/* Privacy Controls Sidebar */}
      <div class="space-y-4">
        <PrivacyDashboard client:load />

        <div class="rounded-lg border bg-card p-4">
          <h3 class="mb-3 text-lg font-semibold">Analytics Sections</h3>
          <ul class="space-y-2">
            <li>
              <a
                href="/analytics"
                class="bg-primary/10 flex items-center rounded-md px-3 py-2 text-primary"
              >
                <span class="text-sm font-medium">Usage Analytics</span>
              </a>
            </li>
            <li>
              <a
                href="/analytics/conversions"
                class="hover:bg-primary/10 flex items-center rounded-md px-3 py-2 text-foreground transition-colors hover:text-primary"
              >
                <span class="text-sm font-medium">Conversion Tracking</span>
              </a>
            </li>
            <li>
              <a
                href="/admin/performance-dashboard"
                class="hover:bg-primary/10 flex items-center rounded-md px-3 py-2 text-foreground transition-colors hover:text-primary"
              >
                <span class="text-sm font-medium">Performance Metrics</span>
              </a>
            </li>
          </ul>
        </div>
      </div>

      {/* Main Analytics Content */}
      <div class="space-y-8">
        <div class="rounded-lg border bg-card p-6">
          <h2 class="mb-4 text-2xl font-semibold">Usage Analytics</h2>
          <AnalyticsDashboard
            client:load
            messages={[]}
            securityLevel={defaultConfig.securityLevel}
            encryptionEnabled={defaultConfig.encryptionEnabled}
            scenario={defaultConfig.scenario}
          />
        </div>

        <div class="rounded-lg border bg-card p-6">
          <h2 class="mb-4 text-2xl font-semibold">Conversion Overview</h2>
          <p class="mb-4 text-muted-foreground">
            Quick summary of recent conversion metrics. For detailed analysis,
            visit the
            <a
              href="/analytics/conversions"
              class="text-primary hover:underline"
            >
              Conversion Tracking Dashboard
            </a>
            .
          </p>
          <ConversionDashboard client:load />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
