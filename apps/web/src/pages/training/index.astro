---
// Pixelated Empathy Training Portal - Main Landing Page
// Integrates seamlessly with existing Astro architecture

import Button from '@/components/ui/Button.astro'
import Card from '@/components/ui/Card.astro'
import { readinessEnhancements } from '@/data/readiness-enhancements'
import Layout from '@/layouts/Layout.astro'
import { getCurrentUser, isAuthenticated } from '@/lib/auth'

// Check if user is authenticated using the available auth functions
const isUserAuthenticated = await isAuthenticated(Astro.request)
if (!isUserAuthenticated) {
  return Astro.redirect('/auth/login')
}

const userSession = await getCurrentUser(Astro.request)
if (!userSession) {
  return Astro.redirect('/auth/login')
}

const userRole = userSession.role // 'trainee', 'supervisor', 'admin'

// Mock data for now - in a real implementation, you'd fetch from API
const activeTrainingSessions: any[] = []
const trainingPrograms: any[] = []
---

<Layout
  title="Pixelated Empathy - Therapeutic Training Platform"
  description="Advanced AI-powered therapeutic training simulation platform"
>
  <main class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-purple-50">
    <!-- Hero Section -->
    <section class="relative px-4 py-16 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="flex items-center justify-center mb-6">
          <div class="w-16 h-16 bg-gradient-to-br from-blue-600 to-purple-600 rounded-none flex items-center justify-center mr-4">
            <span class="text-2xl">🎭</span>
          </div>
          <h1 class="text-4xl font-bold text-foreground sm:text-5xl lg:text-6xl">
            Pixelated{' '}
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-purple-600">
              Empathy
            </span>
          </h1>
        </div>

        <p class="max-w-3xl mx-auto text-xl text-muted-foreground sm:text-2xl">
          Revolutionary therapeutic training platform where AI role-plays as
          difficult clients for comprehensive therapist education and supervisor
          evaluation.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
          {userRole === 'trainee' && (
            <Button
              href="/training/session/new"
              size="lg"
              class="bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700"
            >
              🎬 Start Training Session
            </Button>
          )}
          {userRole === 'supervisor' && (
            <Button
              href="/dashboard"
              size="lg"
              class="bg-gradient-to-r from-green-600 to-blue-600 hover:from-green-700 hover:to-blue-700"
            >
              👨‍🏫 Supervisor Dashboard
            </Button>
          )}
          <Button
            href="/analytics"
            variant="outline"
            size="lg"
            class="border-2 border-primary text-primary hover:bg-primary/10"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"></svg>{' '}
            View Progress
          </Button>
        </div>
      </div>
    </section>

    <!-- Active Sessions Section -->
    {activeTrainingSessions.length > 0 && (
      <section class="px-4 py-12 mx-auto max-w-7xl sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-foreground mb-8 text-center">
          Active Training Sessions
        </h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {activeTrainingSessions.map((session: any) => (
            <Card class="p-6 border-l-4 border-l-ring">
              <div class="flex items-start justify-between mb-4">
                <div>
                  <h3 class="text-lg font-semibold text-foreground">
                    {session.clientProfile.name}
                  </h3>
                  <p class="text-sm text-muted-foreground">
                    {session.clientProfile.personalityType}
                  </p>
                </div>
                <span
                  class={`px-2 py-1 text-xs font-medium rounded-none ${
                    session.status === 'active'
                      ? 'bg-secondary text-foreground'
                      : 'bg-secondary text-foreground border border-ring'
                  }`}
                >
                  {session.status}
                </span>
              </div>

              <div class="space-y-2 mb-4">
                <div class="flex justify-between text-sm">
                  <span class="text-muted-foreground">Duration:</span>
                  <span class="font-medium">{session.duration}</span>
                </div>
                <div class="flex justify-between text-sm">
                  <span class="text-muted-foreground">Difficulty:</span>
                  <span class="font-medium">
                    Level {session.difficultyLevel}
                  </span>
                </div>
                <div class="flex justify-between text-sm">
                  <span class="text-muted-foreground">Progress:</span>
                  <span class="font-medium">
                    {session.therapeuticProgress}%
                  </span>
                </div>
              </div>

              <Button
                href={`/training/session/${session.sessionId}`}
                class="w-full"
                size="sm"
              >
                {userRole === 'supervisor'
                  ? '👀 Monitor Session'
                  : '🎭 Continue Training'}
              </Button>
            </Card>
          ))}
        </div>
      </section>
    )}

    <!-- Training Programs Section -->
    <section class="px-4 py-12 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-foreground mb-8 text-center">
        Training Programs
      </h2>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {trainingPrograms.map((program: any) => (
          <Card class="p-8 transition-all duration-300 border-2 hover:border-ring">
            <div class="text-center mb-6">
              <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-blue-500 rounded-none flex items-center justify-center mx-auto mb-4">
                <span class="text-2xl">{program.icon || '🎓'}</span>
              </div>
              <h3 class="text-xl font-bold text-foreground mb-2">
                {program.name}
              </h3>
              <p class="text-muted-foreground">{program.description}</p>
            </div>

            <div class="space-y-3 mb-6">
              <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Target Level:</span>
                <span class="font-medium capitalize">
                  {program.targetLevel}
                </span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Sessions Required:</span>
                <span class="font-medium">{program.requiredSessions}</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Completion Rate:</span>
                <span class="font-medium">{program.completionRate}%</span>
              </div>
            </div>

            <div class="mb-6">
              <h4 class="text-sm font-semibold text-foreground mb-2">
                Key Skills:
              </h4>
              <div class="flex flex-wrap gap-2">
                {program.keySkills?.slice(0, 3).map((skill: string) => (
                  <span class="px-2 py-1 text-xs bg-secondary text-foreground rounded-none">
                    {skill}
                  </span>
                ))}
              </div>
            </div>

            <Button
              href="/simulator"
              class="w-full"
              variant={program.enrolled ? 'default' : 'outline'}
            >
              {program.enrolled ? 'Continue Program' : 'Start Program'}
            </Button>
          </Card>
        ))}
      </div>
    </section>

    <!-- Readiness Enhancements Section -->
    <section class="px-4 py-12 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-foreground">
          Readiness &amp; Governance Enhancements
        </h2>
        <p class="mt-3 text-lg text-muted-foreground max-w-3xl mx-auto">
          Extend training into audit evidence, clinical safety stress testing,
          and executive-ready reporting without losing the learning loop.
        </p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {readinessEnhancements.map((enhancement) => (
          <Card class="p-6 border-l-4 border-l-neutral-500 flex flex-col">
            <div class="mb-4">
              <h3 class="text-lg font-semibold text-foreground">
                {enhancement.title}
              </h3>
              <p class="text-sm text-muted-foreground">{enhancement.summary}</p>
            </div>
            <div class="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-2">
              Primary audience
            </div>
            <div class="text-sm font-medium text-foreground mb-4">
              {enhancement.audience}
            </div>
            <ul class="space-y-2 text-sm text-muted-foreground flex-1">
              {enhancement.outcomes.map((outcome) => (
                <li class="flex items-start gap-2">
                  <span class="text-primary mt-1">•</span>
                  <span>{outcome}</span>
                </li>
              ))}
            </ul>
            <Button
              href="/contact"
              variant="outline"
              size="sm"
              class="mt-4 w-full"
            >
              Request enablement
            </Button>
          </Card>
        ))}
      </div>
    </section>

    <!-- Quick Stats Section -->
    <section class="px-4 py-12 bg-secondary mx-auto max-w-7xl sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-4">
        <div class="text-center">
          <div class="text-3xl font-bold text-primary mb-2">8,000+</div>
          <div class="text-muted-foreground">Training Conversations</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary mb-2">6</div>
          <div class="text-muted-foreground">Difficult Client Types</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-foreground mb-2">5</div>
          <div class="text-muted-foreground">Competency Levels</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-foreground mb-2">98%</div>
          <div class="text-muted-foreground">Training Effectiveness</div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Custom styles for Pixelated Empathy branding */
  .hero-gradient {
    background: linear-gradient(
      135deg,
      rgba(59, 130, 246, 0.1) 0%,
      rgba(147, 51, 234, 0.1) 100%
    );
  }

  .card-hover {
    transition: all 0.3s ease;
  }

  .card-hover:hover {
    transform: translateY(-2px);
  }
</style>
