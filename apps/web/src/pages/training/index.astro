---
// Pixelated Empathy Training Portal - Main Landing Page
// Integrates seamlessly with existing Astro architecture

import Button from '@/components/ui/Button.astro'
import Card from '@/components/ui/Card.astro'
import { readinessEnhancements } from '@/data/readiness-enhancements'
import Layout from '@/layouts/Layout.astro'
import { providerUnavailableResponse } from '@/lib/auth/provider-unavailable'
import { resolvePageSession } from '@/lib/auth/session'

// One token validation per request, across the middleware and this page.
//
// The middleware has already validated the token for this request and
// published its verdict on `Astro.locals`; `resolvePageSession` reads that
// verdict instead of validating the same token again. A cold `/training` used
// to cost middleware 1 + page 1 `/userinfo` calls, and `isAuthenticated` added
// a third (diagnosis D7). The session page resolves the same way, so both
// training pages share one path.
const { session, providerUnavailable, developer } = await resolvePageSession(
  Astro.request,
  Astro.locals,
)
// A developer key is not a token, so it arrives as a `none` verdict with a
// developer identity alongside it; the page has always served that caller.
const userRole = session
  ? (session.user.role ?? 'guest')
  : (developer?.role ?? null)
if (!userRole) {
  // The middleware already resolved this token for this request, so a failure
  // here means the provider could not verify it (a /userinfo 429, a timeout) —
  // a temporary outage, not a logout.
  if (providerUnavailable) {
    return providerUnavailableResponse(Astro.url.pathname)
  }
  return Astro.redirect('/login?redirect=/training')
}

// Faculty access uses `admin`, the role the session page also checks.
// A session role is an `AuthRole` (`admin | staff | therapist | user | guest`,
// `src/config/auth.config.ts`), so a `supervisor` gate could never match. The
// auth role mapping itself is unchanged.

// The session page redirects here only for a genuine absence (a 404, or a
// refusal such as 403). It used to redirect on any non-ok response, including
// the data load's deadline 503, which made an outage look like a missing
// session. The temporary-unavailable case is rendered by the session page
// itself, so this parameter never carries an outage.
const errorParam = Astro.url.searchParams.get('error')
const sessionNotFound = errorParam === 'session-not-found'

// Mock data for now - in a real implementation, you'd fetch from API
const activeTrainingSessions: any[] = []
const trainingPrograms: any[] = []
---

<Layout
  title="Pixelated Empathy - Therapeutic Training Platform"
  description="Advanced AI-powered therapeutic training simulation platform"
>
  <main class="from-blue-50 via-white to-purple-50 min-h-screen bg-gradient-to-br">
    <!-- Hero Section -->
    <section class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="mb-6 flex items-center justify-center">
          <div class="from-blue-600 to-purple-600 mr-4 flex h-16 w-16 items-center justify-center rounded-none bg-gradient-to-br">
            <span class="text-2xl">🎭</span>
          </div>
          <h1 class="text-4xl font-bold text-foreground sm:text-5xl lg:text-6xl">
            Pixelated{' '}
            <span class="text-transparent from-blue-600 to-purple-600 bg-gradient-to-r bg-clip-text">
              Empathy
            </span>
          </h1>
        </div>

        <p class="mx-auto max-w-3xl text-xl text-muted-foreground sm:text-2xl">
          Proposed synthetic conversation practice for education. Training
          scenarios, session creation, session coaching, automated client
          replies, and supervisor review are not yet available in this portal.
        </p>

        {sessionNotFound && (
          <p
            class="mx-auto mt-6 max-w-2xl rounded-none border border-border bg-background px-4 py-3 text-sm text-foreground"
            role="status"
          >
            That training session could not be found. It may have been removed,
            or it may belong to another account.
          </p>
        )}

        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
          {userRole === 'trainee' && (
            <p
              class="rounded-md border border-border bg-background px-4 py-3 text-sm text-muted-foreground"
              role="status"
            >
              No training sessions are available. Pilot enrollment is not open.
            </p>
          )}
          {userRole === 'admin' && (
            <Button
              href="/dashboard"
              size="lg"
              class="from-green-600 to-blue-600 hover:from-green-700 hover:to-blue-700 bg-gradient-to-r"
            >
              👨‍🏫 Supervisor Dashboard
            </Button>
          )}
          <Button
            href="/analytics"
            variant="outline"
            size="lg"
            class="hover:bg-primary/10 border-2 border-primary text-primary"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"></svg>{' '}
            View Progress
          </Button>
        </div>
      </div>
    </section>

    <!-- Training journey scaffolding (structure only) -->
    <section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
      <div class="border border-border bg-card p-6">
        <p class="text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground">
          Training journey
        </p>
        <h2 class="mt-3 text-2xl font-semibold text-foreground">
          Session creation and the scenario catalog
        </h2>
        <p
          class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-foreground"
          role="status"
        >
          Both surfaces are structure only. They are awaiting the approved
          scenario catalog, which is an owner decision held by the clinical
          content owner, so the catalog lists no scenarios and session creation
          writes nothing.
        </p>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          <li class="border border-border bg-background p-4">
            <h3 class="text-base font-semibold text-foreground">
              Scenario catalog
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              Lists and selects an approved scenario. Awaiting the approved
              scenario catalog.
            </p>
            <a
              href="/training/scenarios"
              class="mt-4 inline-flex min-h-[44px] items-center justify-center border border-border bg-secondary px-6 py-3 text-sm font-medium text-foreground transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            >
              Open the scenario catalog
            </a>
          </li>
          <li class="border border-border bg-background p-4">
            <h3 class="text-base font-semibold text-foreground">
              Create a training session
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              Creates a trainee session from an approved scenario. Blocked on
              the same approval.
            </p>
            <a
              href="/training/sessions/new"
              class="mt-4 inline-flex min-h-[44px] items-center justify-center border border-border bg-secondary px-6 py-3 text-sm font-medium text-foreground transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            >
              Open session creation
            </a>
          </li>
        </ul>
      </div>
    </section>

    <!-- Active Sessions Section -->
    {activeTrainingSessions.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <h2 class="mb-8 text-center text-3xl font-bold text-foreground">
          Active Training Sessions
        </h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {activeTrainingSessions.map((session: any) => (
            <Card class="border-l-4 border-l-ring p-6">
              <div class="mb-4 flex items-start justify-between">
                <div>
                  <h3 class="text-lg font-semibold text-foreground">
                    {session.clientProfile.name}
                  </h3>
                  <p class="text-sm text-muted-foreground">
                    {session.clientProfile.personalityType}
                  </p>
                </div>
                <span
                  class={`rounded-none px-2 py-1 text-xs font-medium ${
                    session.status === 'active'
                      ? 'bg-secondary text-foreground'
                      : 'border border-ring bg-secondary text-foreground'
                  }`}
                >
                  {session.status}
                </span>
              </div>

              <div class="mb-4 space-y-2">
                <div class="flex justify-between text-sm">
                  <span class="text-muted-foreground">Duration:</span>
                  <span class="font-medium">{session.duration}</span>
                </div>
                <div class="flex justify-between text-sm">
                  <span class="text-muted-foreground">Difficulty:</span>
                  <span class="font-medium">
                    Level {session.difficultyLevel}
                  </span>
                </div>
                <div class="flex justify-between text-sm">
                  <span class="text-muted-foreground">Progress:</span>
                  <span class="font-medium">
                    {session.therapeuticProgress}%
                  </span>
                </div>
              </div>

              <Button
                href={`/training/session/${session.sessionId}`}
                class="w-full"
                size="sm"
              >
                {userRole === 'admin'
                  ? '👀 Monitor Session'
                  : '🎭 Continue Training'}
              </Button>
            </Card>
          ))}
        </div>
      </section>
    )}

    <!-- Training Programs Section -->
    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-center text-3xl font-bold text-foreground">
        Training Programs
      </h2>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {trainingPrograms.map((program: any) => (
          <Card class="border-2 p-8 transition-all duration-300 hover:border-ring">
            <div class="mb-6 text-center">
              <div class="from-purple-500 to-blue-500 mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-none bg-gradient-to-br">
                <span class="text-2xl">{program.icon || '🎓'}</span>
              </div>
              <h3 class="mb-2 text-xl font-bold text-foreground">
                {program.name}
              </h3>
              <p class="text-muted-foreground">{program.description}</p>
            </div>

            <div class="mb-6 space-y-3">
              <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Target Level:</span>
                <span class="font-medium capitalize">
                  {program.targetLevel}
                </span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Sessions Required:</span>
                <span class="font-medium">{program.requiredSessions}</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Completion Rate:</span>
                <span class="font-medium">{program.completionRate}%</span>
              </div>
            </div>

            <div class="mb-6">
              <h4 class="mb-2 text-sm font-semibold text-foreground">
                Key Skills:
              </h4>
              <div class="flex flex-wrap gap-2">
                {program.keySkills?.slice(0, 3).map((skill: string) => (
                  <span class="rounded-none bg-secondary px-2 py-1 text-xs text-foreground">
                    {skill}
                  </span>
                ))}
              </div>
            </div>

            <Button
              href="/simulator"
              class="w-full"
              variant={program.enrolled ? 'default' : 'outline'}
            >
              {program.enrolled ? 'Continue Program' : 'Start Program'}
            </Button>
          </Card>
        ))}
      </div>
    </section>

    <!-- Journey scaffolding: client replies and session coaching (structure
         only). Kept in its own delimited block so a sibling scaffold PR can be
         merged beside it without a conflict; the release keeps every link. -->
    <section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
      <div class="border border-border bg-card p-6">
        <p class="text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground">
          Training journey
        </p>
        <h2 class="mt-3 text-2xl font-semibold text-foreground">
          Client replies and session coaching
        </h2>
        <p
          class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-foreground"
          role="status"
        >
          Structure only. A synthetic client reply cannot be told apart from a
          real one, and the coaching rubric and competency framework are owner
          decisions, so neither surface emits content. Each names the decision
          it is waiting on and the role that owns it.
        </p>
        <a
          href="/training/coaching"
          class="mt-4 inline-flex min-h-[44px] items-center justify-center border border-border bg-secondary px-6 py-3 text-sm font-medium text-foreground transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          Open session coaching
        </a>
      </div>
    </section>
    <!-- /Journey scaffolding: client replies and session coaching -->

    <!-- Readiness Enhancements Section -->
    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="mb-10 text-center">
        <h2 class="text-3xl font-bold text-foreground">
          Readiness &amp; Governance Enhancements
        </h2>
        <p class="mx-auto mt-3 max-w-3xl text-lg text-muted-foreground">
          Extend training into audit evidence, clinical safety stress testing,
          and executive-ready reporting without losing the learning loop.
        </p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {readinessEnhancements.map((enhancement) => (
          <Card class="border-l-neutral-500 flex flex-col border-l-4 p-6">
            <div class="mb-4">
              <h3 class="text-lg font-semibold text-foreground">
                {enhancement.title}
              </h3>
              <p class="text-sm text-muted-foreground">{enhancement.summary}</p>
            </div>
            <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">
              Primary audience
            </div>
            <div class="mb-4 text-sm font-medium text-foreground">
              {enhancement.audience}
            </div>
            <ul class="flex-1 space-y-2 text-sm text-muted-foreground">
              {enhancement.outcomes.map((outcome) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1 text-primary">•</span>
                  <span>{outcome}</span>
                </li>
              ))}
            </ul>
            <Button
              href="/contact"
              variant="outline"
              size="sm"
              class="mt-4 w-full"
            >
              Request enablement
            </Button>
          </Card>
        ))}
      </div>
    </section>

    <!-- Quick Stats Section -->
    <section class="mx-auto max-w-7xl bg-secondary px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-4">
        <div class="text-center">
          <div class="mb-2 text-3xl font-bold text-primary">8,000+</div>
          <div class="text-muted-foreground">Training Conversations</div>
        </div>
        <div class="text-center">
          <div class="mb-2 text-3xl font-bold text-primary">6</div>
          <div class="text-muted-foreground">Difficult Client Types</div>
        </div>
        <div class="text-center">
          <div class="mb-2 text-3xl font-bold text-foreground">5</div>
          <div class="text-muted-foreground">Competency Levels</div>
        </div>
        <div class="text-center">
          <div class="mb-2 text-3xl font-bold text-foreground">98%</div>
          <div class="text-muted-foreground">Training Effectiveness</div>
        </div>
      </div>
    </section>

    <!-- Journey scaffolding: faculty review (structure only). Kept in its own
         delimited block so a sibling scaffold PR can be merged beside it
         without a conflict; the release keeps every link. -->
    <section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
      <div class="border border-border bg-card p-6">
        <p class="text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground">
          Training journey
        </p>
        <h2 class="mt-3 text-2xl font-semibold text-foreground">
          Faculty review
        </h2>
        <p
          class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-foreground"
          role="status"
        >
          Structure only. A faculty member cannot be scoped to the sessions they
          may review, because training sessions are not linked to a workspace.
          The surface names that missing relation and the migration that would
          close it; it reviews nothing and reads no session data.
        </p>
        <a
          href="/training/faculty-review"
          class="mt-4 inline-flex min-h-[44px] items-center justify-center border border-border bg-secondary px-6 py-3 text-sm font-medium text-foreground transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          Open faculty review
        </a>
      </div>
    </section>
    <!-- /Journey scaffolding: faculty review -->
  </main>
</Layout>

<style>
  /* Custom styles for Pixelated Empathy branding */
  .hero-gradient {
    background: linear-gradient(
      135deg,
      rgba(59, 130, 246, 0.1) 0%,
      rgba(147, 51, 234, 0.1) 100%
    );
  }

  .card-hover {
    transition: all 0.3s ease;
  }

  .card-hover:hover {
    transform: translateY(-2px);
  }
</style>
