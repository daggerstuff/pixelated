---
// Create a training session (structure only).
//
// This is the surface and the code path that would create a training session
// for a trainee. It stops at the two decisions the grant leaves to the owner:
// the approved scenario catalog, and the mapping from an approved scenario onto
// the session record the read path requires. Both are rendered as named
// blockers, and no row is written while either stands.
//
// The control is disabled because there is nothing to select and the creation
// path would refuse the request. The POST branch exists anyway, so a direct
// request reaches the same code path and gets the same refusal instead of a
// 404 or a silent no-op.

import Layout from '@/layouts/Layout.astro'
import { providerUnavailableResponse } from '@/lib/auth/provider-unavailable'
import { resolvePageSession } from '@/lib/auth/session'
import { loadApprovedScenarioCatalog } from '../_scenario-catalog'
import {
  planTrainingSessionCreation,
  readSubmittedScenarioId,
} from '../_session-creation'

// One page-session read for this request, through the helper that consumes the
// middleware's verdict. A second `getSession` / `isAuthenticated` /
// `getCurrentUser` call would re-validate the same token (diagnosis D7).
const { session, providerUnavailable, developer } = await resolvePageSession(
  Astro.request,
  Astro.locals,
)

const signedIn = Boolean(session ?? developer)
if (!signedIn) {
  if (providerUnavailable) {
    return providerUnavailableResponse(Astro.url.pathname)
  }
  return Astro.redirect(
    `/login?redirect=${encodeURIComponent('/training/sessions/new')}`,
  )
}

const catalog = loadApprovedScenarioCatalog()
const attempted = Astro.request.method === 'POST'
const submittedScenarioId = attempted
  ? await readSubmittedScenarioId(Astro.request)
  : null
const plan = planTrainingSessionCreation(catalog, submittedScenarioId)
const canCreate = plan.blockers.length === 0

if (attempted) {
  // The request reached the creation path and was refused before any write.
  // 409: it cannot be satisfied in the catalog's current state, and retrying
  // changes nothing until the owner approves.
  Astro.response.status = 409
  Astro.response.headers.set('Cache-Control', 'no-store')
}
---

<Layout
  title="Create a training session | Pixelated Empathy"
  description="Session creation for trainee practice. Structure only: awaiting the approved scenario catalog."
>
  <div class="min-h-screen bg-background text-foreground">
    <div class="px-4 py-12 mx-auto max-w-3xl sm:px-6">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground">
        Training
      </p>
      <h1 class="mt-3 text-3xl font-semibold text-foreground">
        Create a training session
      </h1>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        A training session is created from an approved scenario. This surface
        and the code path behind it exist; the decisions they depend on are the
        owner's and have not been made.
      </p>

      {attempted && (
        <section
          class="p-6 mt-8 border border-border bg-card"
          aria-labelledby="creation-refusal-heading"
        >
          <h2
            id="creation-refusal-heading"
            class="text-lg font-semibold text-foreground"
          >
            No training session was created
          </h2>
          <p
            class="mt-3 text-sm leading-relaxed text-muted-foreground"
            role="status"
          >
            The request reached the session-creation path and was refused before
            any write. {plan.blockers.length} decision
            {plan.blockers.length === 1 ? '' : 's'} still block it.
          </p>
        </section>
      )}

      <section class="mt-8" aria-labelledby="creation-blockers-heading">
        <h2
          id="creation-blockers-heading"
          class="text-lg font-semibold text-foreground"
        >
          Blocking decisions
        </h2>

        <ul class="mt-4 space-y-4">
          {plan.blockers.map((blocker) => (
            <li class="p-6 border border-border bg-card">
              <p class="text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground">
                {blocker.owner}
              </p>
              <h3 class="mt-2 text-base font-semibold text-foreground">
                {blocker.headline}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                {blocker.detail}
              </p>
              <p class="mt-3 text-xs text-muted-foreground">
                Blocker <span class="font-mono">{blocker.id}</span>
              </p>
            </li>
          ))}
        </ul>
      </section>

      <form
        method="post"
        action="/training/sessions/new"
        class="p-6 mt-8 border border-border bg-card"
      >
        <label for="scenario" class="block text-sm font-medium text-foreground">
          Approved scenario
        </label>
        <select
          id="scenario"
          name="scenario"
          class="w-full px-3 py-2 mt-2 text-sm border min-h-[44px] border-input bg-background text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none disabled:opacity-[0.55]"
          disabled={!canCreate}
        >
          {catalog.scenarios.length === 0 ? (
            <option value="">No approved scenarios</option>
          ) : (
            catalog.scenarios.map((scenario) => (
              <option value={scenario.id}>{scenario.label}</option>
            ))
          )}
        </select>

        <button
          type="submit"
          class="inline-flex items-center justify-center min-h-[44px] px-6 py-3 mt-4 text-sm font-medium border border-border bg-secondary text-foreground transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none disabled:pointer-events-none disabled:opacity-[0.55]"
          disabled={!canCreate}
        >
          Create training session
        </button>

        <p class="mt-3 text-sm text-muted-foreground" role="status">
          {canCreate
            ? 'Ready to create a session from the selected scenario.'
            : 'Session creation is disabled while the blockers above stand.'}
        </p>
      </form>

      <nav class="flex flex-wrap gap-4 pt-6 mt-10 border-t border-border">
        <a
          href="/training/scenarios"
          class="inline-flex items-center justify-center min-h-[44px] px-6 py-3 text-sm font-medium border border-border bg-secondary text-foreground transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
        >
          Open the scenario catalog
        </a>
        <a
          href="/training"
          class="inline-flex items-center justify-center min-h-[44px] px-6 py-3 text-sm font-medium border border-border bg-secondary text-foreground transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
        >
          Back to training
        </a>
      </nav>
    </div>
  </div>
</Layout>
