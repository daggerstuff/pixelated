---
// Pixelated Empathy Training Session - Individual Session Page
// Integrates with existing Astro architecture for immersive training experience

import Layout from '@/layouts/Layout.astro'
import { resolvePageSession } from '@/lib/auth/session'
import { getTrainingSessionResponse } from '@/lib/services/training/session-api'
import VitalsMonitorIsland from '@/components/simulation/VitalsMonitorIsland.tsx'
import { classifyTrainingSessionLoad } from '../_session-load-state'

type TrainingSessionResponse = {
  sessionId: string
  messages: Array<{ id: string; content: string; createdAt: string }>
  clientProfile: {
    name: string
    age: number
    gender: string
    personalityType: string
    presentingProblem: string
    triggers?: string[]
    strengths?: string[]
  }
  difficultyLevel: string | number
}

const isTrainingSessionResponse = (
  value: unknown,
): value is TrainingSessionResponse => {
  if (!value || typeof value !== 'object') {
    return false
  }

  const maybeValue = value as Record<string, unknown>
  const clientProfile = maybeValue['clientProfile']

  return (
    typeof maybeValue['sessionId'] === 'string' &&
    Array.isArray(maybeValue['messages']) &&
    (typeof maybeValue['difficultyLevel'] === 'string' ||
      typeof maybeValue['difficultyLevel'] === 'number') &&
    typeof clientProfile === 'object' &&
    clientProfile !== null
  )
}

const { sessionId } = Astro.params

// Read the verdict the middleware already computed for this request. Calling
// `getSession` here re-validated the same token: on an invalid token the
// middleware resolves once and declines to redirect, then this page validated
// it a second time to reach the same conclusion — two `/userinfo` calls.
const { session, providerUnavailable: authUnavailable } =
  await resolvePageSession(Astro.request, Astro.locals)

// A provider outage is not a logout (diagnosis D1). With the middleware's
// verdict available we know directly that the token could not be verified —
// a temporary outage, not an absent session and not a sign-out.
// `training/index.astro` received the same treatment.

if (!session && !authUnavailable) {
  return Astro.redirect(
    `/login?redirect=${encodeURIComponent(`/training/session/${sessionId}`)}`,
  )
}

if (!sessionId) {
  return Astro.redirect('/training?error=session-not-found')
}

const escapeJsonForScriptTag = (value: unknown): string => {
  const serialized = JSON.stringify(value)
  if (serialized === undefined) {
    return 'null'
  }
  return serialized.replace(/</g, '\\u003c').replace(/>/g, '\\u003e')
}

// Get session data from API
//
// The underlying status decides what the trainee sees (VAL-UX-001). A 5xx is
// never an absence: the training deadline and a database-availability failure
// both answer 503, and the trainee must be told the session is temporarily
// unavailable and offered a retry — not bounced to /training as though the
// session had never existed. Only a 4xx (404, or a refusal such as 403) is a
// genuine absence and keeps the existing not-found redirect.
let sessionData: TrainingSessionResponse | undefined
let unavailable = authUnavailable
try {
  if (!authUnavailable) {
    const response = await getTrainingSessionResponse(Astro.request, sessionId)
    const rawSessionData = response.ok ? await response.json() : undefined
    const loadState = classifyTrainingSessionLoad(
      response.status,
      isTrainingSessionResponse(rawSessionData),
    )

    if (loadState === 'ready') {
      sessionData = rawSessionData
    } else if (loadState === 'unavailable') {
      unavailable = true
    }
  }
} catch {
  // A thrown load (a network failure, an unexpected rejection) is temporary.
  unavailable = true
}

if (!sessionData && !unavailable) {
  return Astro.redirect('/training?error=session-not-found')
}

if (unavailable) {
  Astro.response.status = 503
  Astro.response.headers.set('Retry-After', '1')
}

// Map MongoDB roles to training context
// In a real implementation, this would check specific training permissions
// For now: therapists are trainees by default, admins can supervise
const userRole = session?.user.role
const isTrainee = userRole === 'therapist' || userRole === 'user'
const isSupervisor = userRole === 'admin'
---

<Layout
  title={
    sessionData
      ? `Training Session - ${sessionData.clientProfile.name}`
      : 'Training session temporarily unavailable'
  }
  description={
    sessionData
      ? 'Synthetic educational conversation practice; not clinical care'
      : 'The training session could not be loaded in time. Retry shortly.'
  }
>
  {!sessionData ? (
    <main class="min-h-full bg-background px-4 py-16 text-foreground sm:px-6">
      <section class="mx-auto max-w-2xl">
        <p class="text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground">
          Training session
        </p>
        <h1 class="mt-3 text-2xl font-semibold text-foreground">
          This training session is temporarily unavailable
        </h1>
        <p
          class="mt-4 text-sm leading-relaxed text-muted-foreground"
          role="status"
        >
          The session data could not be loaded in time. This is a temporary
          problem, not a missing session: nothing has been deleted, reassigned,
          or lost. Retry loading this session.
        </p>
        <a
          href={Astro.url.pathname}
          class="mt-6 inline-flex min-h-[44px] items-center justify-center rounded-none border border-border bg-secondary px-6 py-3 text-sm font-medium text-foreground transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
        >
          Retry loading this session
        </a>
      </section>
    </main>
  ) : (
    <>
      {/* $1 */}
      <script is:inline src="/js/training-session.js" type="module"></script>
      <main class="session-shell flex flex-col bg-background">
        {/* $1 */}
        <header class="bg-card border-b border-border px-6 py-4 flex-shrink-0">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
              <button
                id="back-button"
                class="flex items-center text-muted-foreground hover:text-foreground transition-colors"
              >
                <svg
                  class="w-5 h-5 mr-2"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"
                  ></path>
                </svg>
                Back to Training
              </button>

              <div class="h-6 border-l border-input"></div>

              <div>
                <h1 class="text-xl font-semibold text-foreground">
                  Training Session: {sessionData.clientProfile.name}
                </h1>
                <p class="text-sm text-muted-foreground">
                  {sessionData.clientProfile.personalityType} • Level{' '}
                  {sessionData.difficultyLevel}
                </p>
              </div>
            </div>

            <div class="flex items-center space-x-4">
              {/* $1 */}
              <div class="flex items-center space-x-2 text-sm text-muted-foreground">
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                  ></path>
                </svg>
                <span id="session-timer">00:00</span>
              </div>

              {/* $1 */}
              <div class="flex items-center space-x-2">
                <button
                  id="end-session"
                  class="bg-secondary hover:bg-accent text-foreground px-3 py-2 rounded-none text-sm transition-colors"
                >
                  Exit Session
                </button>
              </div>
            </div>
            <p class="mt-3 text-sm text-muted-foreground" role="status">
              Messages save to this synthetic session. Automated client replies,
              coaching analysis, and supervisor alerts are not active.
            </p>
          </div>
        </header>

        {/* $1 */}
        <div class="flex-1 flex session-panes">
          {isTrainee && (
            <div class="flex-1 flex">
              {/* $1 */}
              <aside class="w-80 bg-card border-r border-border flex flex-col session-aside">
                {/* $1 */}
                <div class="p-6 border-b border-border">
                  <h2 class="text-lg font-semibold text-foreground mb-4">
                    Client Information
                  </h2>

                  <div class="space-y-4">
                    <div>
                      <label class="text-sm font-medium text-muted-foreground">
                        Demographics
                      </label>
                      <p class="text-sm text-foreground">
                        {sessionData.clientProfile.age} year old{' '}
                        {sessionData.clientProfile.gender}
                      </p>
                    </div>

                    <div>
                      <label class="text-sm font-medium text-muted-foreground">
                        Presenting Problem
                      </label>
                      <p class="text-sm text-foreground">
                        {sessionData.clientProfile.presentingProblem}
                      </p>
                    </div>

                    <div>
                      <label class="text-sm font-medium text-muted-foreground">
                        Key Triggers
                      </label>
                      <div class="flex flex-wrap gap-1 mt-1">
                        {sessionData.clientProfile.triggers?.map(
                          (trigger: string) => (
                            <span class="px-2 py-1 text-xs bg-foreground text-background rounded-none">
                              {trigger}
                            </span>
                          ),
                        )}
                      </div>
                    </div>

                    <div>
                      <label class="text-sm font-medium text-muted-foreground">
                        Strengths
                      </label>
                      <div class="flex flex-wrap gap-1 mt-1">
                        {sessionData.clientProfile.strengths?.map(
                          (strength: string) => (
                            <span class="px-2 py-1 text-xs bg-secondary text-foreground rounded-none">
                              {strength}
                            </span>
                          ),
                        )}
                      </div>
                    </div>
                  </div>
                </div>

                {/* $1 */}
                <div class="p-6 border-b border-border">
                  <h3 class="text-md font-semibold text-foreground mb-4">
                    Client State
                  </h3>

                  <div class="text-center mb-4">
                    <div
                      id="client-avatar"
                      class="w-32 h-32 bg-secondary rounded-none mx-auto mb-4 flex items-center justify-center border-4 border-border transition-all duration-1000"
                    >
                      <span class="text-4xl" id="avatar-emotion">
                        😐
                      </span>
                    </div>

                    <div
                      id="emotional-state"
                      class="text-sm font-medium text-muted-foreground mb-2"
                    >
                      Neutral
                    </div>
                  </div>

                  {/* $1 */}
                  <div class="space-y-3">
                    <div>
                      <div class="flex justify-between text-xs text-muted-foreground mb-1">
                        <span>Trust Level</span>
                        <span id="trust-percentage">0%</span>
                      </div>
                      <div class="w-full bg-secondary rounded-none h-2">
                        <div
                          id="trust-meter"
                          class="bg-primary h-2 rounded-none transition-all duration-500"
                          style="width: 0%"
                        />
                      </div>
                    </div>

                    <div>
                      <div class="flex justify-between text-xs text-muted-foreground mb-1">
                        <span>Resistance Level</span>
                        <span id="resistance-percentage">0%</span>
                      </div>
                      <div class="w-full bg-secondary rounded-none h-2">
                        <div
                          id="resistance-meter"
                          class="bg-primary h-2 rounded-none transition-all duration-500"
                          style="width: 0%"
                        />
                      </div>
                    </div>

                    <div>
                      <div class="flex justify-between text-xs text-muted-foreground mb-1">
                        <span>Crisis Risk</span>
                        <span id="crisis-percentage">0%</span>
                      </div>
                      <div class="w-full bg-secondary rounded-none h-2">
                        <div
                          id="crisis-meter"
                          class="bg-primary h-2 rounded-none transition-all duration-500"
                          style="width: 0%"
                        />
                      </div>
                    </div>
                  </div>
                </div>

                {/* $1 */}
                <div class="p-6 flex-1">
                  <h3 class="text-md font-semibold text-foreground mb-4">
                    Nonverbal Cues
                  </h3>

                  <div class="space-y-3 text-sm">
                    <div>
                      <span class="font-medium text-muted-foreground">
                        Body Language:
                      </span>
                      <span id="body-language" class="ml-2 text-foreground">
                        Neutral posture
                      </span>
                    </div>
                    <div>
                      <span class="font-medium text-muted-foreground">
                        Voice Tone:
                      </span>
                      <span id="voice-tone" class="ml-2 text-foreground">
                        Normal tone
                      </span>
                    </div>
                    <div>
                      <span class="font-medium text-muted-foreground">
                        Eye Contact:
                      </span>
                      <span id="eye-contact" class="ml-2 text-foreground">
                        Appropriate
                      </span>
                    </div>
                  </div>
                </div>

                {/* $1 */}
                <div class="p-6 border-t border-border">
                  <VitalsMonitorIsland client:load {sessionId} />
                </div>
              </aside>

              {/* $1 */}
              <div class="flex-1 flex flex-col session-column">
                {/* $1 */}
                <div class="flex-1 flex flex-col bg-card session-transcript">
                  {/* $1 */}
                  <div
                    id="messages-container"
                    class="flex-1 overflow-y-auto p-6 space-y-4 session-messages"
                  >
                    {/* $1 */}
                    <div class="text-center text-muted-foreground py-8">
                      <p>
                        Session starting... The client will begin speaking
                        shortly.
                      </p>
                    </div>
                  </div>

                  {/* $1 */}
                  <div class="border-t border-border p-4 bg-background">
                    <div class="flex flex-col space-y-3">
                      {/* $1 */}
                      <div class="flex items-center space-x-4">
                        <label class="text-sm font-medium text-foreground">
                          Response Type:
                        </label>
                        <select
                          id="intervention-type"
                          class="text-sm border border-input rounded-none px-3 py-1 focus:ring-2 focus:ring-ring focus:border-ring"
                        >
                          <option value="reflection">Reflection</option>
                          <option value="empathy">Empathy</option>
                          <option value="inquiry">Open-ended Question</option>
                          <option value="clarification">Clarification</option>
                          <option value="interpretation">Interpretation</option>
                          <option value="confrontation">
                            Therapeutic Confrontation
                          </option>
                        </select>

                        <button
                          id="suggestions-button"
                          class="text-sm bg-secondary text-foreground px-3 py-1 rounded-none hover:bg-accent transition-colors"
                        >
                          <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                          />{' '}
                          Get Suggestions
                        </button>
                      </div>

                      {/* $1 */}
                      <div class="flex space-x-3">
                        <div class="flex-1">
                          <textarea
                            id="message-input"
                            placeholder="Type your therapeutic response..."
                            class="w-full border border-input rounded-none px-4 py-3 focus:ring-2 focus:ring-ring focus:border-ring resize-none"
                            rows="3"
                          ></textarea>

                          {/* $1 */}
                          <div class="flex justify-between items-center mt-2 text-xs text-muted-foreground">
                            <span>
                              Quality:{' '}
                              <span id="response-quality" class="font-medium">
                                Good
                              </span>
                            </span>
                            <span id="character-count">0/1000</span>
                          </div>
                        </div>

                        <button
                          id="send-message"
                          class="bg-primary hover:bg-primary/90 text-primary-foreground px-6 py-3 rounded-none font-medium transition-colors flex items-center justify-center"
                          disabled
                        >
                          <svg
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"
                            />
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              {/* $1 */}
              <aside class="w-80 bg-card border-l border-border flex flex-col session-aside">
                {/* $1 */}
                <div class="p-6 border-b border-border">
                  <h2 class="text-lg font-semibold text-foreground mb-4">
                    Real-time Guidance
                  </h2>

                  {/* $1 */}
                  <div class="space-y-4">
                    <div>
                      <div class="flex justify-between text-sm text-muted-foreground mb-1">
                        <span>Rapport Building</span>
                        <span id="rapport-score">0/5</span>
                      </div>
                      <div class="w-full bg-secondary rounded-none h-2">
                        <div
                          id="rapport-progress"
                          class="bg-primary h-2 rounded-none transition-all duration-500"
                          style="width: 0%"
                        />
                      </div>
                    </div>

                    <div>
                      <div class="flex justify-between text-sm text-muted-foreground mb-1">
                        <span>Active Listening</span>
                        <span id="listening-score">0/5</span>
                      </div>
                      <div class="w-full bg-secondary rounded-none h-2">
                        <div
                          id="listening-progress"
                          class="bg-primary h-2 rounded-none transition-all duration-500"
                          style="width: 0%"
                        />
                      </div>
                    </div>

                    <div>
                      <div class="flex justify-between text-sm text-muted-foreground mb-1">
                        <span>Empathy</span>
                        <span id="empathy-score">0/5</span>
                      </div>
                      <div class="w-full bg-secondary rounded-none h-2">
                        <div
                          id="empathy-progress"
                          class="bg-primary h-2 rounded-none transition-all duration-500"
                          style="width: 0%"
                        />
                      </div>
                    </div>
                  </div>
                </div>

                {/* $1 */}
                <div class="p-6 border-b border-border">
                  <h3 class="text-md font-semibold text-foreground mb-4">
                    Live Feedback
                  </h3>
                  <div id="feedback-messages" class="space-y-2 text-sm">
                    <p class="text-muted-foreground">
                      Feedback will appear here.
                    </p>
                  </div>
                </div>

                {/* $1 */}
                <div
                  id="crisis-alerts"
                  class="hidden p-6 bg-secondary border-b border-ring"
                >
                  <h3 class="text-md font-semibold text-foreground mb-2">
                    ⚠️ Crisis Alert
                  </h3>
                  <div id="crisis-message" class="text-sm text-foreground" />
                </div>

                {/* $1 */}
                <div class="flex-1 p-6">
                  <h3 class="text-md font-semibold text-foreground mb-4">
                    Session Notes
                  </h3>
                  <textarea
                    id="session-notes"
                    placeholder="Add your reflections and observations..."
                    class="w-full h-32 border border-input rounded-none px-3 py-2 text-sm focus:ring-2 focus:ring-ring focus:border-ring resize-none"
                  ></textarea>
                </div>
              </aside>
            </div>
          )}

          {/* $1 */}
          {isSupervisor && (
            <div class="flex-1 px-4 py-12 sm:px-6">
              <section class="mx-auto max-w-2xl">
                <p class="text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground">
                  Faculty review
                </p>
                <h2 class="mt-3 text-2xl font-semibold text-foreground">
                  Faculty review is not available
                </h2>
                <p
                  class="mt-4 text-sm leading-relaxed text-muted-foreground"
                  role="status"
                >
                  Training sessions are not linked to a workspace, so a faculty
                  member cannot be scoped to the sessions they may review.
                  Faculty review stays disabled until that relation exists.
                </p>
              </section>
            </div>
          )}
        </div>
      </main>

      {/* $1 */}
      <script
        type="application/json"
        id="session-data"
        is:inline
        set:html={escapeJsonForScriptTag(sessionData)}
      ></script>
    </>
  )}
</Layout>

<style>
  /* ===== Session shell (VAL-UX-002) =====

     The send control must be the element a pointer lands on. It was not: the
     shell was `h-screen`, so it was 100vh tall inside a document that also
     carries the site header and the site footer. The composer's bottom edge
     therefore sat exactly on the footer's top edge, and because the transcript
     did not scroll (every flex column in the chain kept its automatic
     `min-height: auto`, so `#messages-container` expanded to the full
     transcript height instead of scrolling) each new message pushed the
     composer further down inside a clipping container — under the footer, out
     of the viewport, and unreachable by a pointer.

     Desktop: the shell owns the space between the header and the footer, and
     the transcript scrolls inside it. Mobile: the panes stack and the document
     scrolls, so the composer stays reachable at 320px. */
  .session-shell {
    height: auto;
  }

  .session-panes {
    overflow: hidden;
  }

  @media (min-width: 769px) {
    :global(body) {
      display: flex;
      flex-direction: column;
      height: 100dvh;
      min-height: 0;
    }

    :global(main#main-content) {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      min-height: 0;
    }

    .session-shell {
      flex: 1 1 auto;
      min-height: 0;
    }

    /* A clipping container that is not a scroll container: no programmatic
       scroll (focus, scrollIntoView) can move the composer out of place. */
    .session-panes {
      min-height: 0;
      overflow: clip;
    }

    /* Each trainee aside is its own scroll container (VAL-UX-003).
       `clip` on the row above deliberately removes the focus-scroll path that
       `overflow: hidden` would still provide, and both asides are taller than
       the row at 1440x900 — the focusable `#session-notes` textarea sits
       entirely below the clip line, so a keyboard user could tab to a field
       that is never painted. An aside is a sibling of the transcript column,
       so scrolling it cannot move the composer the way scrolling the row
       could; the row stays clipped. */
    .session-aside {
      min-height: 0;
      overflow-y: auto;
    }

    .session-column,
    .session-transcript,
    .session-messages {
      min-height: 0;
    }
  }

  @media (max-width: 768px) {
    .session-panes {
      overflow: visible;
    }
  }

  /* Custom styles for training session */
  .message-bubble {
    max-width: 80%;
    padding: 12px 16px;
    border-radius: 18px;
    margin-bottom: 8px;
  }

  .message-therapist {
    background: #3b82f6;
    color: white;
    margin-left: auto;
    border-bottom-right-radius: 4px;
  }

  .message-client {
    background: #f3f4f6;
    color: #1f2937;
    margin-right: auto;
    border-bottom-left-radius: 4px;
  }

  .typing-indicator {
    display: flex;
    align-items: center;
    padding: 16px;
    color: #6b7280;
  }

  .typing-dots {
    display: inline-flex;
    align-items: center;
  }

  .typing-dots span {
    height: 8px;
    width: 8px;
    background: #9ca3af;
    border-radius: 50%;
    display: inline-block;
    margin: 0 2px;
    animation: typing 1.4s infinite;
  }

  .typing-dots span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .typing-dots span:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes typing {
    0%,
    60%,
    100% {
      transform: translateY(0);
    }
    30% {
      transform: translateY(-10px);
    }
  }

  /* Responsive design */
  @media (max-width: 1024px) {
    aside {
      width: 20rem;
    }
  }

  @media (max-width: 768px) {
    .flex {
      flex-direction: column;
    }

    aside {
      width: 100%;
      height: auto;
      max-height: 40vh;
    }
  }
</style>
