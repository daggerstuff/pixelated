---
// Pixelated Empathy Training Session - Individual Session Page
// Integrates with existing Astro architecture for immersive training experience

import Layout from '@/layouts/Layout.astro'
import { getSession } from '@/lib/auth'

type TrainingSessionResponse = {
  clientProfile: {
    name: string
    age: number
    gender: string
    personalityType: string
    presentingProblem: string
    triggers?: string[]
    strengths?: string[]
  }
  difficultyLevel: string | number
}

const isTrainingSessionResponse = (
  value: unknown,
): value is TrainingSessionResponse => {
  if (!value || typeof value !== 'object') {
    return false
  }

  const maybeValue = value as Record<string, unknown>
  const clientProfile = maybeValue['clientProfile']

  return (
    (typeof maybeValue['difficultyLevel'] === 'string' ||
      typeof maybeValue['difficultyLevel'] === 'number') &&
    typeof clientProfile === 'object' &&
    clientProfile !== null
  )
}

const { sessionId } = Astro.params
const session = await getSession(Astro.request)

if (!session) {
  return Astro.redirect('/auth/login')
}

// Extract token for API call
const authHeader = Astro.request.headers.get('authorization')
const fetchCookieValue = (cookieName: string): string | undefined => {
  const cookieHeader = Astro.request.headers.get('cookie')
  if (!cookieHeader) {
    return undefined
  }
  const cookies = cookieHeader.split(';').map((c) => c.trim())
  for (const cookie of cookies) {
    const [name, value] = cookie.split('=')
    if (name === cookieName && value !== undefined) {
      return decodeURIComponent(value)
    }
  }
  return undefined
}
const token =
  authHeader?.replace('Bearer ', '') || fetchCookieValue('auth-token')

const escapeJsonForScriptTag = (value: unknown): string => {
  const serialized = JSON.stringify(value)
  if (serialized === undefined) {
    return 'null'
  }
  return serialized.replace(/</g, '\\u003c').replace(/>/g, '\\u003e')
}

// Get session data from API
let sessionData: TrainingSessionResponse | undefined
try {
  const response = await fetch(`/api/training/sessions/${sessionId}`, {
    headers: { Authorization: `Bearer ${token}` },
  })
  const rawSessionData = await response.json()
  if (isTrainingSessionResponse(rawSessionData)) {
    sessionData = rawSessionData
  }
} catch {
  sessionData = undefined
}

if (!sessionData) {
  return Astro.redirect('/training?error=session-not-found')
}

// Map MongoDB roles to training context
// In a real implementation, this would check specific training permissions
// For now: therapists are trainees by default, admins can supervise
const userRole = session.user.role
const isTrainee = userRole === 'therapist' || userRole === 'user'
const isSupervisor = userRole === 'admin'
---

<Layout
  title={`Training Session - ${sessionData.clientProfile.name}`}
  description="Immersive therapeutic training session with AI client simulation"
>
  {/* $1 */}
  <script is:inline src="/js/socket.io.min.js"></script>
  <script is:inline src="/js/training-session.js" type="module"></script>
  <main class="h-screen flex flex-col bg-background">
    {/* $1 */}
    <header class="bg-card border-b border-border px-6 py-4 flex-shrink-0">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <button
            id="back-button"
            class="flex items-center text-muted-foreground hover:text-foreground transition-colors"
          >
            <svg
              class="w-5 h-5 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"
              ></path>
            </svg>
            Back to Training
          </button>

          <div class="h-6 border-l border-input"></div>

          <div>
            <h1 class="text-xl font-semibold text-foreground">
              Training Session: {sessionData.clientProfile.name}
            </h1>
            <p class="text-sm text-muted-foreground">
              {sessionData.clientProfile.personalityType} • Level{' '}
              {sessionData.difficultyLevel}
            </p>
          </div>
        </div>

        <div class="flex items-center space-x-4">
          {/* $1 */}
          <div class="flex items-center space-x-2 text-sm text-muted-foreground">
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
            <span id="session-timer">00:00</span>
          </div>

          {/* $1 */}
          <button
            id="emergency-button"
            class="bg-primary hover:bg-primary/90 text-primary-foreground px-4 py-2 rounded-none text-sm font-medium transition-colors"
          >
            🚨 Emergency
          </button>

          {/* $1 */}
          <div class="flex items-center space-x-2">
            <button
              id="pause-session"
              class="bg-secondary hover:bg-accent text-foreground border border-ring px-3 py-2 rounded-none text-sm transition-colors"
            >
              ⏸️ Pause
            </button>
            <button
              id="end-session"
              class="bg-secondary hover:bg-accent text-foreground px-3 py-2 rounded-none text-sm transition-colors"
            >
              ⏹️ End
            </button>
          </div>
        </div>
      </div>
    </header>

    {/* $1 */}
    <div class="flex-1 flex overflow-hidden">
      {isTrainee && (
        <div class="flex-1 flex">
          {/* $1 */}
          <aside class="w-80 bg-card border-r border-border flex flex-col">
            {/* $1 */}
            <div class="p-6 border-b border-border">
              <h2 class="text-lg font-semibold text-foreground mb-4">
                Client Information
              </h2>

              <div class="space-y-4">
                <div>
                  <label class="text-sm font-medium text-muted-foreground">
                    Demographics
                  </label>
                  <p class="text-sm text-foreground">
                    {sessionData.clientProfile.age} year old{' '}
                    {sessionData.clientProfile.gender}
                  </p>
                </div>

                <div>
                  <label class="text-sm font-medium text-muted-foreground">
                    Presenting Problem
                  </label>
                  <p class="text-sm text-foreground">
                    {sessionData.clientProfile.presentingProblem}
                  </p>
                </div>

                <div>
                  <label class="text-sm font-medium text-muted-foreground">
                    Key Triggers
                  </label>
                  <div class="flex flex-wrap gap-1 mt-1">
                    {sessionData.clientProfile.triggers?.map(
                      (trigger: string) => (
                        <span class="px-2 py-1 text-xs bg-foreground text-background rounded-none">
                          {trigger}
                        </span>
                      ),
                    )}
                  </div>
                </div>

                <div>
                  <label class="text-sm font-medium text-muted-foreground">
                    Strengths
                  </label>
                  <div class="flex flex-wrap gap-1 mt-1">
                    {sessionData.clientProfile.strengths?.map(
                      (strength: string) => (
                        <span class="px-2 py-1 text-xs bg-secondary text-foreground rounded-none">
                          {strength}
                        </span>
                      ),
                    )}
                  </div>
                </div>
              </div>
            </div>

            {/* $1 */}
            <div class="p-6 border-b border-border">
              <h3 class="text-md font-semibold text-foreground mb-4">
                Client State
              </h3>

              <div class="text-center mb-4">
                <div
                  id="client-avatar"
                  class="w-32 h-32 bg-secondary rounded-none mx-auto mb-4 flex items-center justify-center border-4 border-border transition-all duration-1000"
                >
                  <span class="text-4xl" id="avatar-emotion">
                    😐
                  </span>
                </div>

                <div
                  id="emotional-state"
                  class="text-sm font-medium text-muted-foreground mb-2"
                >
                  Neutral
                </div>
              </div>

              {/* $1 */}
              <div class="space-y-3">
                <div>
                  <div class="flex justify-between text-xs text-muted-foreground mb-1">
                    <span>Trust Level</span>
                    <span id="trust-percentage">0%</span>
                  </div>
                  <div class="w-full bg-secondary rounded-none h-2">
                    <div
                      id="trust-meter"
                      class="bg-primary h-2 rounded-none transition-all duration-500"
                      style="width: 0%"
                    />
                  </div>
                </div>

                <div>
                  <div class="flex justify-between text-xs text-muted-foreground mb-1">
                    <span>Resistance Level</span>
                    <span id="resistance-percentage">0%</span>
                  </div>
                  <div class="w-full bg-secondary rounded-none h-2">
                    <div
                      id="resistance-meter"
                      class="bg-primary h-2 rounded-none transition-all duration-500"
                      style="width: 0%"
                    />
                  </div>
                </div>

                <div>
                  <div class="flex justify-between text-xs text-muted-foreground mb-1">
                    <span>Crisis Risk</span>
                    <span id="crisis-percentage">0%</span>
                  </div>
                  <div class="w-full bg-secondary rounded-none h-2">
                    <div
                      id="crisis-meter"
                      class="bg-primary h-2 rounded-none transition-all duration-500"
                      style="width: 0%"
                    />
                  </div>
                </div>
              </div>
            </div>

            {/* $1 */}
            <div class="p-6 flex-1">
              <h3 class="text-md font-semibold text-foreground mb-4">
                Nonverbal Cues
              </h3>

              <div class="space-y-3 text-sm">
                <div>
                  <span class="font-medium text-muted-foreground">
                    Body Language:
                  </span>
                  <span id="body-language" class="ml-2 text-foreground">
                    Neutral posture
                  </span>
                </div>
                <div>
                  <span class="font-medium text-muted-foreground">
                    Voice Tone:
                  </span>
                  <span id="voice-tone" class="ml-2 text-foreground">
                    Normal tone
                  </span>
                </div>
                <div>
                  <span class="font-medium text-muted-foreground">
                    Eye Contact:
                  </span>
                  <span id="eye-contact" class="ml-2 text-foreground">
                    Appropriate
                  </span>
                </div>
              </div>
            </div>
          </aside>

          {/* $1 */}
          <div class="flex-1 flex flex-col">
            {/* $1 */}
            <div class="flex-1 flex flex-col bg-card">
              {/* $1 */}
              <div
                id="messages-container"
                class="flex-1 overflow-y-auto p-6 space-y-4"
              >
                {/* $1 */}
                <div class="text-center text-muted-foreground py-8">
                  <p>
                    Session starting... The client will begin speaking shortly.
                  </p>
                </div>
              </div>

              {/* $1 */}
              <div class="border-t border-border p-4 bg-background">
                <div class="flex flex-col space-y-3">
                  {/* $1 */}
                  <div class="flex items-center space-x-4">
                    <label class="text-sm font-medium text-foreground">
                      Response Type:
                    </label>
                    <select
                      id="intervention-type"
                      class="text-sm border border-input rounded-none px-3 py-1 focus:ring-2 focus:ring-ring focus:border-ring"
                    >
                      <option value="reflection">Reflection</option>
                      <option value="empathy">Empathy</option>
                      <option value="inquiry">Open-ended Question</option>
                      <option value="clarification">Clarification</option>
                      <option value="interpretation">Interpretation</option>
                      <option value="confrontation">
                        Therapeutic Confrontation
                      </option>
                    </select>

                    <button
                      id="suggestions-button"
                      class="text-sm bg-secondary text-foreground px-3 py-1 rounded-none hover:bg-accent transition-colors"
                    >
                      <svg
                        class="w-5 h-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                      />{' '}
                      Get Suggestions
                    </button>
                  </div>

                  {/* $1 */}
                  <div class="flex space-x-3">
                    <div class="flex-1">
                      <textarea
                        id="message-input"
                        placeholder="Type your therapeutic response..."
                        class="w-full border border-input rounded-none px-4 py-3 focus:ring-2 focus:ring-ring focus:border-ring resize-none"
                        rows="3"
                      ></textarea>

                      {/* $1 */}
                      <div class="flex justify-between items-center mt-2 text-xs text-muted-foreground">
                        <span>
                          Quality:{' '}
                          <span id="response-quality" class="font-medium">
                            Good
                          </span>
                        </span>
                        <span id="character-count">0/1000</span>
                      </div>
                    </div>

                    <button
                      id="send-message"
                      class="bg-primary hover:bg-primary/90 text-primary-foreground px-6 py-3 rounded-none font-medium transition-colors flex items-center justify-center"
                      disabled
                    >
                      <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"
                        />
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {/* $1 */}
          <aside class="w-80 bg-card border-l border-border flex flex-col">
            {/* $1 */}
            <div class="p-6 border-b border-border">
              <h2 class="text-lg font-semibold text-foreground mb-4">
                Real-time Guidance
              </h2>

              {/* $1 */}
              <div class="space-y-4">
                <div>
                  <div class="flex justify-between text-sm text-muted-foreground mb-1">
                    <span>Rapport Building</span>
                    <span id="rapport-score">0/5</span>
                  </div>
                  <div class="w-full bg-secondary rounded-none h-2">
                    <div
                      id="rapport-progress"
                      class="bg-primary h-2 rounded-none transition-all duration-500"
                      style="width: 0%"
                    />
                  </div>
                </div>

                <div>
                  <div class="flex justify-between text-sm text-muted-foreground mb-1">
                    <span>Active Listening</span>
                    <span id="listening-score">0/5</span>
                  </div>
                  <div class="w-full bg-secondary rounded-none h-2">
                    <div
                      id="listening-progress"
                      class="bg-primary h-2 rounded-none transition-all duration-500"
                      style="width: 0%"
                    />
                  </div>
                </div>

                <div>
                  <div class="flex justify-between text-sm text-muted-foreground mb-1">
                    <span>Empathy</span>
                    <span id="empathy-score">0/5</span>
                  </div>
                  <div class="w-full bg-secondary rounded-none h-2">
                    <div
                      id="empathy-progress"
                      class="bg-primary h-2 rounded-none transition-all duration-500"
                      style="width: 0%"
                    />
                  </div>
                </div>
              </div>
            </div>

            {/* $1 */}
            <div class="p-6 border-b border-border">
              <h3 class="text-md font-semibold text-foreground mb-4">
                Live Feedback
              </h3>
              <div id="feedback-messages" class="space-y-2 text-sm">
                <p class="text-muted-foreground">Feedback will appear here.</p>
              </div>
            </div>

            {/* $1 */}
            <div
              id="crisis-alerts"
              class="hidden p-6 bg-secondary border-b border-ring"
            >
              <h3 class="text-md font-semibold text-foreground mb-2">
                ⚠️ Crisis Alert
              </h3>
              <div id="crisis-message" class="text-sm text-foreground" />
            </div>

            {/* $1 */}
            <div class="flex-1 p-6">
              <h3 class="text-md font-semibold text-foreground mb-4">
                Session Notes
              </h3>
              <textarea
                id="session-notes"
                placeholder="Add your reflections and observations..."
                class="w-full h-32 border border-input rounded-none px-3 py-2 text-sm focus:ring-2 focus:ring-ring focus:border-ring resize-none"
              ></textarea>
            </div>
          </aside>
        </div>
      )}

      {/* $1 */}
      {isSupervisor && (
        <div class="flex-1">
          {/* $1 */}
          <div id="supervisor-dashboard" />
        </div>
      )}
    </div>
  </main>

  {/* $1 */}
  <script
    type="application/json"
    id="session-data"
    is:inline
    set:html={escapeJsonForScriptTag(sessionData)}
  ></script>
  <script
    type="application/json"
    id="user-data"
    is:inline
    set:html={escapeJsonForScriptTag({ role: userRole, id: session.user.id })}
  ></script>
</Layout>

<style>
  /* Custom styles for training session */
  .message-bubble {
    max-width: 80%;
    padding: 12px 16px;
    border-radius: 18px;
    margin-bottom: 8px;
  }

  .message-therapist {
    background: #3b82f6;
    color: white;
    margin-left: auto;
    border-bottom-right-radius: 4px;
  }

  .message-client {
    background: #f3f4f6;
    color: #1f2937;
    margin-right: auto;
    border-bottom-left-radius: 4px;
  }

  .typing-indicator {
    display: flex;
    align-items: center;
    padding: 16px;
    color: #6b7280;
  }

  .typing-dots {
    display: inline-flex;
    align-items: center;
  }

  .typing-dots span {
    height: 8px;
    width: 8px;
    background: #9ca3af;
    border-radius: 50%;
    display: inline-block;
    margin: 0 2px;
    animation: typing 1.4s infinite;
  }

  .typing-dots span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .typing-dots span:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes typing {
    0%,
    60%,
    100% {
      transform: translateY(0);
    }
    30% {
      transform: translateY(-10px);
    }
  }

  /* Responsive design */
  @media (max-width: 1024px) {
    aside {
      width: 20rem;
    }
  }

  @media (max-width: 768px) {
    .flex {
      flex-direction: column;
    }

    aside {
      width: 100%;
      height: auto;
      max-height: 40vh;
    }
  }
</style>
