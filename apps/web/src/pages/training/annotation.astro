---
// Pixelated Empathy - Expert Annotation Queue
// Page for expert reviewers to review pending annotation queue items

import Button from '@/components/ui/Button.astro'
import Card from '@/components/ui/Card.astro'
import Layout from '@/layouts/Layout.astro'
import { getCurrentUser, isAuthenticated } from '@/lib/auth'

// SSR mode (prerender=false) as specified in feature description
export const prerender = false

// Check if user is authenticated using the same pattern as training/index.astro
const isUserAuthenticated = await isAuthenticated(Astro.request)
if (!isUserAuthenticated) {
  return Astro.redirect('/auth/login')
}

const userSession = await getCurrentUser(Astro.request)
if (!userSession) {
  return Astro.redirect('/auth/login')
}

const reviewerId =
  userSession.id || (userSession as { email?: string }).email || 'anonymous'

// Define the type for pending items
interface QueueItem {
  id: string | number
  sample_text: string
  original_score: number
  routing_reason?: string
  per_dimension_scores: Record<string, number>
  status: string
}

// Fetch pending items from annotation API on port 3102
let pendingItems: QueueItem[] = []
let reviewedItems: QueueItem[] = []
let error: string | null = null

try {
  // Use full URL for SSR fetch as specified in feature description
  const apiUrl = new URL('/queue/pending', Astro.url.origin)
  apiUrl.port = '3102'

  const response = await fetch(apiUrl.toString(), {
    method: 'GET',
    headers: {
      Accept: 'application/json',
    },
  })

  if (response.ok) {
    const items: QueueItem[] = await response.json()
    pendingItems = items.filter(
      (item) => item.status === 'pending' || item.status === 'pending_review',
    )
    reviewedItems = items.filter((item) => item.status === 'reviewed')
  } else {
    error = `Failed to fetch pending items: ${response.status} ${response.statusText}`
  }
} catch (err) {
  error = `Error fetching pending items: ${err instanceof Error ? err.message : String(err)}`
}

// Function to handle form submission (client-side)
const handleSubmit = `
  async function handleSubmit(event, itemId) {
    event.preventDefault()
    const form = event.target
    const submitButton = form.querySelector('button[type="submit"]')
    const successMessage = form.parentElement.querySelector('.success-message')
    const errorMessage = form.parentElement.querySelector('.error-message')
    
    // Reset messages
    if (successMessage) successMessage.style.display = 'none'
    if (errorMessage) errorMessage.style.display = 'none'
    
    // Get form data
    const reviewerScore = parseFloat(form.querySelector('[name="reviewer_score"]').value)
    const notes = form.querySelector('[name="notes"]').value
    
    // Validate score
    if (reviewerScore < 0 || reviewerScore > 1) {
      alert('Reviewer score must be between 0 and 1')
      return
    }
    
    // Get reviewer_id from data attribute
    const reviewerId = form.dataset.reviewerId
    
    // Disable submit button
    submitButton.disabled = true
    submitButton.textContent = 'Submitting...'
    
    try {
      const response = await fetch('http://localhost:3102/queue/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify({
          item_id: itemId,
          reviewer_score: reviewerScore,
          notes: notes,
          reviewer_id: reviewerId
        })
      })
      
      if (response.ok) {
        const result = await response.json()
        
        // Show success message
        if (successMessage) {
          successMessage.textContent = 'Review submitted successfully!'
          successMessage.style.display = 'block'
        }
        
        // Remove item from list after a short delay
        setTimeout(() => {
          const itemElement = document.getElementById(\`item-\${itemId}\`)
          if (itemElement) {
            itemElement.style.opacity = '0'
            itemElement.style.transform = 'translateX(-20px)'
            setTimeout(() => {
              itemElement.remove()
              
              // Show empty state if no items left
              const itemsContainer = document.querySelector('.items-container')
              const emptyState = document.querySelector('.empty-state')
              if (itemsContainer && itemsContainer.children.length === 0 && emptyState) {
                emptyState.style.display = 'block'
              }
            }, 300)
          }
        }, 1000)
        
        // Reset form
        form.reset()
      } else {
        const errorData = await response.json()
        throw new Error(errorData.message || \`Submission failed: \${response.status}\`)
      }
    } catch (err) {
      // Show error message
      if (errorMessage) {
        errorMessage.textContent = \`Error: \${err.message}\`
        errorMessage.style.display = 'block'
      }
      console.error('Submission error:', err)
    } finally {
      // Re-enable submit button
      submitButton.disabled = false
      submitButton.textContent = 'Submit Review'
    }
  }
`

// Function to handle promotion (client-side)
const handlePromote = `
  async function handlePromote(itemId, targetStage) {
    event.preventDefault()
    const btn = event.target.closest('[data-promote-btn]');
    const originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Promoting...';
    
    try {
      const response = await fetch('/api/clinical-validity/annotations/' + itemId + '/promote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          promoter_id: 'training-user',
          target_stage: targetStage || null
        })
      });
      
      if (response.ok) {
        const card = btn.closest('[data-queue-card]');
        if (card) {
          card.style.opacity = '0.5';
          card.style.transform = 'scale(0.98)';
          setTimeout(() => {
            card.remove();
            // Show empty state if no items left
            const reviewedContainer = document.querySelector('[data-reviewed-list]');
            const emptyReviewed = document.querySelector('[data-empty-reviewed]');
            if (reviewedContainer && reviewedContainer.children.length === 0 && emptyReviewed) {
              emptyReviewed.style.display = 'block';
            }
          }, 300);
        }
        alert('Item promoted successfully!');
      } else {
        const data = await response.json();
        alert('Promotion failed: ' + (data.detail || response.statusText));
        btn.disabled = false;
        btn.textContent = originalText;
      }
    } catch (err) {
      alert('Error: ' + err.message);
      btn.disabled = false;
      btn.textContent = originalText;
    }
  }
`
---

<Layout
  title="Pixelated Empathy - Expert Annotation Queue"
  description="Review pending clinical validity samples for expert annotation"
>
  <main
    class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-purple-50"
  >
    {/* Hero Section */}
    <section class="relative px-4 py-16 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="flex items-center justify-center mb-6">
          <div
            class="w-16 h-16 bg-gradient-to-br from-orange-600 to-red-600 rounded-2xl flex items-center justify-center mr-4"
          >
            <span class="text-2xl">📋</span>
          </div>
          <h1 class="text-4xl font-bold text-gray-900 sm:text-5xl lg:text-6xl">
            Expert <span
              class="text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-red-600"
              >Annotation Queue</span
            >
          </h1>
        </div>

        <p class="max-w-3xl mx-auto text-xl text-gray-600 sm:text-2xl">
          Review pending clinical validity samples that require expert
          evaluation. Provide your assessment to help improve the scoring model.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
          <Button
            href="/training"
            variant="outline"
            size="lg"
            class="border-2 border-blue-600 text-blue-600 hover:bg-blue-50"
          >
            ← Back to Training Portal
          </Button>
        </div>
      </div>
    </section>

    {/* Main Content */}
    <section class="px-4 py-8 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">
          Pending Items for Review
        </h2>

        {
          error ? (
            <div class="bg-neutral-50 border border-neutral-300 p-4 mb-6 rounded-lg">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg
                    class="h-5 w-5 text-neutral-500"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm text-neutral-700">{error}</p>
                </div>
              </div>
            </div>
          ) : null
        }
      </div>

      {/* Empty State */}
      <div
        class={`empty-state ${pendingItems.length > 0 ? 'hidden' : 'block'} mb-8 text-center py-12`}
      >
        <div
          class="mx-auto w-24 h-24 bg-neutral-200 rounded-full flex items-center justify-center mb-6"
        >
          <span class="text-3xl">📭</span>
        </div>
        <h3 class="text-2xl font-bold text-gray-700 mb-3">No pending items</h3>
        <p class="text-gray-600 max-w-md mx-auto">
          All items have been reviewed. Check back later for new samples that
          need expert annotation.
        </p>
      </div>

      {/* Items Container */}
      <div class="items-container grid gap-6">
        {
          pendingItems.map((item) => (
            <div id={`item-${item.id}`} class="transition-all duration-300">
              <Card class="p-6 border border-neutral-300">
                <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
                  {/* Sample Text */}
                  <div class="flex-1">
                    <div class="mb-4">
                      <h3 class="text-lg font-semibold text-gray-900 mb-2">
                        Sample Text
                      </h3>
                      <div class="bg-gray-50 p-4 rounded-lg border border-gray-200 max-h-48 overflow-y-auto">
                        <p class="text-gray-700 whitespace-pre-wrap">
                          {item.sample_text}
                        </p>
                      </div>
                    </div>

                    {/* Scores Summary */}
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-4">
                      <div class="bg-neutral-100 p-3 rounded-lg border border-neutral-200">
                        <div class="text-xs font-medium text-neutral-700 uppercase tracking-wide mb-1">
                          Original Score
                        </div>
                        <div class="text-xl font-bold text-neutral-900">
                          {(item.original_score * 100).toFixed(1)}%
                        </div>
                      </div>

                      {item.routing_reason ? (
                        <div class="bg-neutral-100 p-3 rounded-lg border border-neutral-200">
                          <div class="text-xs font-medium text-neutral-700 uppercase tracking-wide mb-1">
                            Routing Reason
                          </div>
                          <div class="text-sm text-neutral-800">
                            {item.routing_reason}
                          </div>
                        </div>
                      ) : null}

                      <div class="bg-purple-50 p-3 rounded-lg border border-purple-100">
                        <div class="text-xs font-medium text-purple-800 uppercase tracking-wide mb-1">
                          Dimensions
                        </div>
                        <div class="text-sm text-purple-900">
                          {Object.keys(item.per_dimension_scores || {}).length}{' '}
                          scored
                        </div>
                      </div>
                    </div>

                    {/* Per-dimension Scores */}
                    {item.per_dimension_scores &&
                    Object.keys(item.per_dimension_scores).length > 0 ? (
                      <div class="mb-4">
                        <h4 class="text-sm font-semibold text-gray-900 mb-2">
                          Per-dimension Scores
                        </h4>
                        <div class="flex flex-wrap gap-2">
                          {Object.entries(item.per_dimension_scores).map(
                            ([dimension, score]) => (
                              <div class="px-3 py-1 bg-gray-100 text-gray-700 text-sm rounded-full">
                                {dimension}: {(score * 100).toFixed(0)}%
                              </div>
                            ),
                          )}
                        </div>
                      </div>
                    ) : null}
                  </div>

                  {/* Review Form */}
                  <div class="lg:w-96">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">
                      Your Review
                    </h3>

                    <form
                      class="space-y-4"
                      data-reviewer-id={reviewerId}
                      onsubmit={`handleSubmit(event, ${item.id}); return false;`}
                    >
                      {/* Reviewer Score */}
                      <div>
                        <label
                          for={`reviewer_score_${item.id}`}
                          class="block text-sm font-medium text-gray-700 mb-1"
                        >
                          Reviewer Score (0-1)
                        </label>
                        <div class="relative">
                          <input
                            type="number"
                            id={`reviewer_score_${item.id}`}
                            name="reviewer_score"
                            min="0"
                            max="1"
                            step="0.01"
                            required
                            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-neutral-500 focus:border-neutral-500"
                            placeholder="e.g., 0.75"
                          />
                          <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                            <span class="text-gray-500">/1</span>
                          </div>
                        </div>
                        <p class="mt-1 text-xs text-gray-500">
                          Enter a score between 0 (not clinically valid) and 1
                          (highly clinically valid)
                        </p>
                      </div>

                      {/* Notes */}
                      <div>
                        <label
                          for={`notes_${item.id}`}
                          class="block text-sm font-medium text-gray-700 mb-1"
                        >
                          Notes (Optional)
                        </label>
                        <textarea
                          id={`notes_${item.id}`}
                          name="notes"
                          rows="3"
                          class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-neutral-500 focus:border-neutral-500"
                          placeholder="Add any notes about your assessment..."
                        />
                        <p class="mt-1 text-xs text-gray-500">
                          Maximum 5000 characters
                        </p>
                      </div>

                      {/* Submit Button */}
                      <button
                        type="submit"
                        class="w-full bg-neutral-800 hover:bg-neutral-900 text-white font-medium py-2.5 px-4 rounded-md transition duration-200 focus:outline-none focus:ring-2 focus:ring-neutral-500 focus:ring-offset-2"
                      >
                        Submit Review
                      </button>
                    </form>

                    {/* Success and Error Messages */}
                    <div class="mt-4 space-y-2">
                      <div class="success-message hidden bg-neutral-50 border border-neutral-300 p-4 rounded-lg">
                        <div class="flex">
                          <div class="flex-shrink-0">
                            <svg
                              class="h-5 w-5 text-neutral-500"
                              fill="currentColor"
                              viewBox="0 0 20 20"
                            >
                              <path
                                fill-rule="evenodd"
                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                clip-rule="evenodd"
                              />
                            </svg>
                          </div>
                          <div class="ml-3">
                            <p class="text-sm text-neutral-700" />
                          </div>
                        </div>
                      </div>

                      <div class="error-message hidden bg-neutral-50 border border-neutral-300 p-4 rounded-lg">
                        <div class="flex">
                          <div class="flex-shrink-0">
                            <svg
                              class="h-5 w-5 text-neutral-500"
                              fill="currentColor"
                              viewBox="0 0 20 20"
                            >
                              <path
                                fill-rule="evenodd"
                                d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                                clip-rule="evenodd"
                              />
                            </svg>
                          </div>
                          <div class="ml-3">
                            <p class="text-sm text-neutral-700" />
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </Card>
            </div>
          ))
        }
      </div>

      {/* Reviewed Items (eligible for promotion) */}
      <div class="mt-12">
        <div class="flex items-center gap-3 mb-6">
          <div
            class="w-10 h-10 bg-neutral-800 rounded-xl flex items-center justify-center"
          >
            <span class="text-xl text-white">⬆</span>
          </div>
          <h2 class="text-2xl font-bold text-gray-900">Reviewed Items</h2>
          <span
            class="px-3 py-1 text-xs font-medium rounded-full bg-neutral-100 text-neutral-700"
          >
            {reviewedItems.length} ready for promotion
          </span>
        </div>

        {
          reviewedItems.length > 0 ? (
            <div class="space-y-6" data-reviewed-list>
              {reviewedItems.map((item) => (
                <div
                  id={`reviewed-${item.id}`}
                  class="transition-all duration-300 p-6 border border-neutral-300 bg-neutral-50 rounded-lg"
                  data-queue-card
                >
                  <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
                    {/* Sample Text */}
                    <div class="flex-1">
                      <div class="mb-4">
                        <div class="flex items-center gap-2 mb-2">
                          <h3 class="text-lg font-semibold text-gray-900">
                            Sample #{item.id}
                          </h3>
                          <span class="px-2 py-0.5 text-xs font-medium rounded bg-neutral-200 text-neutral-700">
                            Reviewed
                          </span>
                        </div>
                        <div class="bg-white p-4 rounded-lg border border-gray-200 max-h-48 overflow-y-auto">
                          <p class="text-gray-700 whitespace-pre-wrap">
                            {item.sample_text}
                          </p>
                        </div>
                      </div>

                      {/* Scores Summary */}
                      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-4">
                        <div class="bg-neutral-100 p-3 rounded-lg border border-neutral-200">
                          <div class="text-xs font-medium text-neutral-700 uppercase tracking-wide mb-1">
                            Original Score
                          </div>
                          <div class="text-xl font-bold text-neutral-900">
                            {(item.original_score * 100).toFixed(1)}%
                          </div>
                        </div>

                        {item.routing_reason ? (
                          <div class="bg-neutral-100 p-3 rounded-lg border border-neutral-200">
                            <div class="text-xs font-medium text-neutral-700 uppercase tracking-wide mb-1">
                              Routing Reason
                            </div>
                            <div class="text-sm text-neutral-800">
                              {item.routing_reason}
                            </div>
                          </div>
                        ) : null}

                        <div class="bg-neutral-100 p-3 rounded-lg border border-neutral-200">
                          <div class="text-xs font-medium text-neutral-700 uppercase tracking-wide mb-1">
                            Dimensions
                          </div>
                          <div class="text-sm text-neutral-800">
                            {
                              Object.keys(item.per_dimension_scores || {})
                                .length
                            }{' '}
                            scored
                          </div>
                        </div>
                      </div>

                      {/* Per-dimension Scores */}
                      {item.per_dimension_scores &&
                      Object.keys(item.per_dimension_scores).length > 0 ? (
                        <div class="mb-4">
                          <h4 class="text-sm font-semibold text-gray-900 mb-2">
                            Per-dimension Scores
                          </h4>
                          <div class="flex flex-wrap gap-2">
                            {Object.entries(item.per_dimension_scores).map(
                              ([dimension, score]) => (
                                <div class="px-3 py-1 bg-gray-100 text-gray-700 text-sm rounded-full">
                                  {dimension}: {(score * 100).toFixed(0)}%
                                </div>
                              ),
                            )}
                          </div>
                        </div>
                      ) : null}
                    </div>

                    {/* Promote Action */}
                    <div class="lg:w-64">
                      <h3 class="text-lg font-semibold text-gray-900 mb-4">
                        Promotion
                      </h3>
                      <p class="text-sm text-gray-600 mb-4">
                        This item has been reviewed and is ready to be promoted
                        to the next stage.
                      </p>
                      <button
                        type="button"
                        data-promote-btn
                        onclick={`handlePromote(${item.id}, 'validated')`}
                        class="w-full bg-neutral-800 hover:bg-neutral-900 text-white font-medium py-2.5 px-4 rounded-md transition duration-200 focus:outline-none focus:ring-2 focus:ring-neutral-500 focus:ring-offset-2"
                      >
                        Promote to Validated
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div
              class="text-center py-12 bg-gray-100 rounded-lg"
              data-empty-reviewed
            >
              <div class="mx-auto w-24 h-24 bg-neutral-200 rounded-full flex items-center justify-center mb-6">
                <span class="text-3xl">✓</span>
              </div>
              <h3 class="text-2xl font-bold text-gray-700 mb-3">
                No items ready for promotion
              </h3>
              <p class="text-gray-600 max-w-md mx-auto">
                Reviewed items will appear here ready for promotion to the next
                workflow stage.
              </p>
            </div>
          )
        }
      </div>
    </section>

    {/* Stats Section */}
    <section class="px-4 py-12 bg-gray-50 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-bold text-gray-900">
          Annotation Queue Overview
        </h2>
        <p class="mt-3 text-gray-600 max-w-2xl mx-auto">
          You are reviewing samples that were routed for expert annotation due
          to borderline clinical validity scores.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <Card class="p-6 text-center border-t-4 border-t-neutral-500">
          <div class="text-3xl font-bold text-neutral-800 mb-2">
            {pendingItems.length}
          </div>
          <div class="text-gray-700 font-medium">Pending Items</div>
          <p class="text-sm text-gray-500 mt-2">Awaiting expert review</p>
        </Card>

        <Card class="p-6 text-center border-t-4 border-t-neutral-400">
          <div class="text-3xl font-bold text-neutral-800 mb-2">Expert</div>
          <div class="text-gray-700 font-medium">Reviewer Role</div>
          <p class="text-sm text-gray-500 mt-2">
            Your reviews help improve the model
          </p>
        </Card>

        <Card class="p-6 text-center border-t-4 border-t-neutral-500">
          <div class="text-3xl font-bold text-neutral-800 mb-2">
            Clinical Validity
          </div>
          <div class="text-gray-700 font-medium">Focus Area</div>
          <p class="text-sm text-gray-500 mt-2">
            Assessing therapeutic quality
          </p>
        </Card>
      </div>
    </section>
  </main>
</Layout>

<script is:inline set:html={handleSubmit + handlePromote} />

<style>
  /* Custom styles */
  .items-container {
    transition: all 0.3s ease;
  }

  input[type='number']::-webkit-inner-spin-button,
  input[type='number']::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  input[type='number'] {
    -moz-appearance: textfield;
  }
</style>
