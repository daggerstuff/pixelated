---
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'

import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = false

// Get all blog posts that are not drafts
const posts = await getCollection(
  'blog',
  ({ data }: { data: { draft?: boolean } }) => {
    return import.meta.env.PROD ? !data.draft : true
  },
)

// Extract all tags and count their occurrences
const tagCounts = posts.reduce(
  (acc: Record<string, number>, post: CollectionEntry<'blog'>) => {
    if (!post.data.tags) return acc

    post.data.tags.forEach((tag: string) => {
      acc[tag] = (acc[tag] || 0) + 1
    })

    return acc
  },
  {} as Record<string, number>,
)

// Convert to array, sort alphabetically
const sortedTags = Object.entries(tagCounts)
  .sort((a, b) => a[0].localeCompare(b[0]))
  .map(([tag, count]) => ({ tag, count }))

const title = 'Blog Tags'
const description = 'Browse all blog tags'
const bgType = 'rose'
---

<BaseLayout {title} {description} {bgType}>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <header class="mb-12">
      <div class="mb-4 flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/blog" class="transition-colors hover:text-foreground">
          Blog
        </a>
        <span>/</span>
        <span class="text-foreground">Topics</span>
      </div>
      <h1 class="mb-4 text-3xl font-bold">All Topics</h1>
      <p class="text-muted-foreground">
        Explore articles by topic and discover new areas of interest.
      </p>
    </header>

    <div class="mb-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {sortedTags.map(({ tag, count }) => (
        <a
          href={`/blog/tags/${tag}`}
          class="group block rounded-none border border-border bg-secondary p-6 transition-all hover:border-ring hover:bg-accent"
        >
          <div class="mb-2 flex items-center justify-between">
            <h3 class="text-lg font-bold transition-colors group-hover:text-foreground">
              #{tag}
            </h3>
            <span class="text-sm text-muted-foreground">
              {count} post{count !== 1 ? 's' : ''}
            </span>
          </div>
          <p class="text-sm text-muted-foreground">
            Explore articles about {tag}
          </p>
        </a>
      ))}
    </div>

    <div class="border-t border-border pt-8">
      <a
        href="/blog"
        class="inline-flex items-center text-muted-foreground transition-colors hover:text-foreground"
      >
        ← Back to all posts
      </a>
    </div>
  </div>
</BaseLayout>
