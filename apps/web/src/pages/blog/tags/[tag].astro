---
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

import BlogPostCard from '@/components/BlogPostCard.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { filterBlogPosts } from '@/utils/blog'

const { tag } = Astro.params

if (!tag) {
  return Astro.redirect('/blog/tags')
}

let posts: CollectionEntry<'blog'>[] = []
try {
  const allPosts = await getCollection('blog')
  const validPosts = filterBlogPosts(allPosts, { excludeDrafts: true })
  posts = filterBlogPosts(validPosts, { tag })
} catch (error) {
  console.error('Error fetching blog posts for tag:', tag, error)
}

// Handle empty posts gracefully
const hasPosts = posts && posts.length > 0
const postCount = hasPosts ? posts.length : 0
---

<BaseLayout title={`#${tag}`} description={`All blog posts tagged with ${tag}`}>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <header class="mb-12">
      <nav
        class="mb-4 flex items-center gap-2 text-sm text-muted-foreground"
        aria-label="Breadcrumb"
      >
        <a href="/blog" class="transition-colors hover:text-foreground">
          Blog
        </a>
        <span aria-hidden="true">/</span>
        <a href="/blog/tags" class="transition-colors hover:text-foreground">
          Topics
        </a>
        <span aria-hidden="true">/</span>
        <span class="text-foreground" aria-current="page">
          #{tag}
        </span>
      </nav>

      <h1 class="mb-4 text-3xl font-bold">#{tag}</h1>
      <p class="text-muted-foreground">
        {postCount} post{postCount !== 1 ? 's' : ''} about {tag}
      </p>
    </header>

    <section class="space-y-8" aria-label={`Posts tagged with ${tag}`}>
      {hasPosts ? (
        posts.map((post) => <BlogPostCard {post} currentTag={tag} />)
      ) : (
        <div class="py-12 text-center">
          <p class="mb-4 text-muted-foreground">No posts found for #{tag}</p>
          <a
            href="/blog/tags"
            class="inline-flex items-center text-foreground transition-colors hover:text-foreground"
          >
            Browse all topics
          </a>
        </div>
      )}
    </section>

    <footer class="mt-12 border-t border-border pt-8">
      <nav
        class="flex flex-col justify-between gap-4 sm:flex-row"
        aria-label="Related pages"
      >
        <a
          href="/blog/tags"
          class="inline-flex items-center text-muted-foreground transition-colors hover:text-foreground"
          aria-label="Browse all topics"
        >
          ← All topics
        </a>
        <a
          href="/blog"
          class="inline-flex items-center text-muted-foreground transition-colors hover:text-foreground"
          aria-label="View all blog posts"
        >
          All posts →
        </a>
      </nav>
    </footer>
  </div>
</BaseLayout>
