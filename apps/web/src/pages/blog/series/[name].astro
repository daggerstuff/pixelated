const { name } = Astro.params

if (!name) {
  return Astro.redirect('/404')
}

const allPosts = await getCollection('blog', ({ data }: BlogPost) =>
  import.meta.env.PROD ? !data.draft : true,
)

const postsInSeries = allPosts
  .filter((post: BlogPost) => post.data.tags && post.data.tags.includes(name))
  .sort(
    (a: BlogPost, b: BlogPost) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
  )

const title = `Series: ${name}`
const description = `All posts in the '${name}' series.`
---

<BaseLayout {title} {description}>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="mb-12 text-center">
      <h1 class="text-4xl font-bold text-foreground">Series: {name}</h1>
      <p class="mt-2 text-lg text-muted-foreground">
        {postsInSeries.length} post{postsInSeries.length !== 1 ? 's' : ''} in
        this series
      </p>
    </div>
    <ul class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {postsInSeries.map((post: BlogPost) => (
        <PostCard {post} />
      ))}
    </ul>
  </div>
</BaseLayout>
