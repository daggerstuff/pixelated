const pageParam = Astro.params['page'] || '1'
const currentPage = parseInt(pageParam, 10)
const pageSize = 20

const posts = await getCollection('blog', (entry: any) => {
  return import.meta.env.PROD ? !entry.data.draft : true
})

const sortedPosts = posts.sort((postA: any, postB: any) => {
  return postB.data.pubDate.valueOf() - postA.data.pubDate.valueOf()
})

const totalPages = Math.ceil(sortedPosts.length / pageSize)

if (currentPage < 1 || currentPage > totalPages) {
  return Astro.redirect('/404')
}

const start = (currentPage - 1) * pageSize
const end = start + pageSize
const pageData = sortedPosts.slice(start, end)

const page = {
  data: pageData,
  currentPage: currentPage,
  lastPage: totalPages,
  size: pageSize,
  total: sortedPosts.length,
  url: {
    current: `/blog/page/${currentPage}`,
    prev: currentPage > 1 ? `/blog/page/${currentPage - 1}` : undefined,
    next:
      currentPage < totalPages ? `/blog/page/${currentPage + 1}` : undefined,
  },
}

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })
}

function getReadingTime(content: string) {
  const wordsPerMinute = 200
  const words = content.split(/\s+/).length
  const minutes = Math.ceil(words / wordsPerMinute)
  return `${minutes} min read`
}

const title =
  page.currentPage === 1 ? 'All Posts' : `All Posts - Page ${page.currentPage}`
const description =
  'All articles about therapy, technology, and digital empathy'
---

<BaseLayout {title} {description}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-12">
      <div class="flex items-center gap-2 mb-4 text-sm text-muted-foreground">
        <a href="/blog" class="hover:text-foreground transition-colors">
          Blog
        </a>
        <span>/</span>
        <span class="text-foreground">All Posts</span>
      </div>
      <h1 class="text-3xl font-bold mb-4">All Posts</h1>
      <p class="text-muted-foreground">
        {page.total} articles about therapy, technology, and digital empathy
      </p>
    </header>

    <div class="space-y-8 mb-12">
      {page.data.map((post: any) => (
        <article class="group">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-shrink-0 text-sm text-muted-foreground sm:w-32">
              {formatDate(new Date(post.data.pubDate))}
              <span class="hidden sm:block mt-1">
                {getReadingTime(post.body)}
              </span>
            </div>

            <div class="flex-1">
              <h3 class="text-xl font-bold mb-2 group-hover:text-foreground transition-colors">
                <a href={`/blog/${getContentSlug(post)}`} class="block">
                  {post.data.title}
                </a>
              </h3>

              <p class="text-foreground mb-3 leading-relaxed">
                {post.data.description}
              </p>

              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-3">
                  {post.data.tags.map((tag: string) => (
                    <a
                      href={`/blog/tags/${tag}`}
                      class="text-xs text-foreground hover:text-foreground transition-colors"
                    >
                      #{tag}
                    </a>
                  ))}
                </div>
              )}

              <a
                href={`/blog/${getContentSlug(post)}`}
                class="inline-flex items-center text-sm text-muted-foreground hover:text-foreground transition-colors group-hover:text-foreground"
              >
                Read article
                <span class="ml-1 group-hover:translate-x-1 transition-transform">
                  →
                </span>
              </a>
            </div>
          </div>
        </article>
      ))}

      <!-- Pagination -->
      {(page.url.prev || page.url.next) && (
        <div class="border-t border-border pt-8">
          <div class="flex justify-between items-center">
            <div>
              {page.url.prev && (
                <a
                  href={page.url.prev}
                  class="inline-flex items-center text-muted-foreground hover:text-foreground transition-colors"
                >
                  ← Previous page
                </a>
              )}
            </div>

            <span class="text-sm text-muted-foreground">
              Page {page.currentPage} of {page.lastPage}
            </span>

            <div>
              {page.url.next && (
                <a
                  href={page.url.next}
                  class="inline-flex items-center text-muted-foreground hover:text-foreground transition-colors"
                >
                  Next page →
                </a>
              )}
            </div>
          </div>
        </div>
      )}

      <!-- Navigation -->
      <div class="border-t border-border pt-8 mt-8">
        <div class="flex flex-col sm:flex-row gap-4 justify-between">
          <div class="flex gap-4">
            <a
              href="/blog"
              class="text-muted-foreground hover:text-foreground transition-colors"
            >
              ← Blog home
            </a>
            <a
              href="/blog/tags"
              class="text-muted-foreground hover:text-foreground transition-colors"
            >
              All topics
            </a>
          </div>
          <a
            href="/rss.xml"
            class="text-muted-foreground hover:text-foreground transition-colors"
          >
            RSS feed
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
