---
export const prerender = false

import { getCollection, type CollectionEntry } from 'astro:content'

import BaseLayout from '@/layouts/BaseLayout.astro'
import { getContentSlug } from '@/utils/blog'
function formatDate(dateInput: any, options: any = {}) {
  if (!dateInput) return '-'
  const date = new Date(dateInput)
  const defaultOptions = {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  } as any
  return date.toLocaleDateString('en-US', { ...defaultOptions, ...options })
}
function getReadingTime(content: string) {
  const wordsPerMinute = 200
  const words = content.split(/\s+/).length
  const minutes = Math.ceil(words / wordsPerMinute)
  return `${minutes} min read`
}

type BlogPost = CollectionEntry<'blog'>

const allPosts = await getCollection('blog', ({ data }: BlogPost) => {
  const isProd =
    import.meta.env.PROD === true || process.env['NODE_ENV'] === 'production'
  return isProd ? !data.draft : true
})

const posts = allPosts
  .sort(
    (a: BlogPost, b: BlogPost) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
  )
  .slice(0, 6) // Show recent posts

// Get tags sorted by frequency and select the top 6
const tagFrequency = {}
allPosts.forEach((post: any) => {
  ;(post.data.tags || []).forEach((tag: any) => {
    tagFrequency[tag] = (tagFrequency[tag] || 0) + 1
  })
})
const allTags = Object.keys(tagFrequency)
const topTags = allTags
  .sort((a, b) => tagFrequency[b] - tagFrequency[a])
  .slice(0, 6)
---

<BaseLayout
  title="Blog"
  description="Writing on therapy, technology, and digital empathy."
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <!-- Hero Section -->
    <header class="mb-16">
      <h1 class="mb-4 text-4xl font-bold tracking-tight md:text-5xl">
        Writing on therapy, technology, and digital empathy.
      </h1>
      <p class="mb-6 text-lg text-muted-foreground">
        Welcome to our corner of the internet. We're sharing thoughts on
        creating meaningful therapeutic experiences through technology.
      </p>
      <a
        href="/about"
        class="font-medium text-foreground transition-colors hover:text-foreground"
      >
        More about us →
      </a>
    </header>

    <!-- Recent Posts -->
    <section class="mb-16">
      <div class="mb-8 flex items-center justify-between">
        <h2 class="text-2xl font-bold">Recent Posts</h2>
        <a
          href="/blog/page/1"
          class="font-medium text-foreground transition-colors hover:text-foreground"
        >
          View all posts →
        </a>
      </div>

      <div class="space-y-8">
        {posts.map((post: BlogPost) => (
          <article class="group">
            <div class="flex flex-col gap-4 sm:flex-row">
              <div class="flex-shrink-0 text-sm text-muted-foreground sm:w-32">
                {formatDate(new Date(post.data.pubDate))}
                <span class="mt-1 hidden sm:block">
                  {getReadingTime(post.body)}
                </span>
              </div>

              <div class="flex-1">
                <h3 class="mb-2 text-xl font-bold transition-colors group-hover:text-foreground">
                  <a href={`/blog/${getContentSlug(post)}`} class="block">
                    {post.data.title}
                  </a>
                </h3>

                <p class="mb-3 leading-relaxed text-foreground">
                  {post.data.description}
                </p>

                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {post.data.tags.map((tag: string) => (
                      <a
                        href={`/blog/tags/${tag}`}
                        class="text-xs text-foreground transition-colors hover:text-foreground"
                      >
                        #{tag}
                      </a>
                    ))}
                  </div>
                )}

                <a
                  href={`/blog/${getContentSlug(post)}`}
                  class="mt-3 inline-flex items-center text-sm text-muted-foreground transition-colors hover:text-foreground group-hover:text-foreground"
                >
                  Read article
                  <span class="ml-1 transition-transform group-hover:translate-x-1">
                    →
                  </span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Explore Topics -->
    <section>
      <div class="mb-8 flex items-center justify-between">
        <h2 class="text-2xl font-bold">Explore Topics</h2>
        <a
          href="/blog/tags"
          class="font-medium text-foreground transition-colors hover:text-foreground"
        >
          View all topics →
        </a>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {topTags.filter(Boolean).map((tag) => {
          const tagPosts = allPosts.filter((post: BlogPost) =>
            post.data.tags?.includes(tag),
          )
          return (
            <a
              href={`/blog/tags/${tag}`}
              class="group block rounded-none border border-border bg-secondary p-6 transition-all hover:border-ring hover:bg-accent"
            >
              <div class="mb-2 flex items-center justify-between">
                <h3 class="text-lg font-bold transition-colors group-hover:text-foreground">
                  #{tag}
                </h3>
                <span class="text-sm text-muted-foreground">
                  {tagPosts.length} post{tagPosts.length !== 1 ? 's' : ''}
                </span>
              </div>
              <p class="text-sm text-muted-foreground">
                Explore articles about {tag}
              </p>
            </a>
          )
        })}
      </div>
    </section>
  </div>
</BaseLayout>
