---
// MANDATE: Live Registry Stats for Task D.1
// In Astro, this server-side script runs at build/request time
import sqlite3 from 'better-sqlite3'

import Button from '../../components/ui/Button.astro'
import Card from '../../components/ui/Card.astro'
import CardContent from '../../components/ui/CardContent.astro'
import CardHeader from '../../components/ui/CardHeader.astro'
import CardTitle from '../../components/ui/CardTitle.astro'
import Layout from '../../layouts/Layout.astro'
const db = new sqlite3(
  '/home/vivi/pixelated/ai/training_corpus/assets/registry.db',
)
const stats = db
  .prepare(
    'SELECT COUNT(*) as shards, SUM(total_records) as records FROM sources',
  )
  .get()
db.close()

const totalShards = stats.shards
const totalRecords = stats.records
const sdkVersion = '0.42.0-beta'
---

<Layout title="Developer Portal | Pixelated">
  <main class="mx-auto max-w-6xl space-y-12 p-8">
    <div class="space-y-4">
      <h1 class="text-4xl font-bold tracking-tight text-primary">
        Developer Portal
      </h1>
      <p class="text-xl text-muted-foreground">
        Access the world's largest therapeutic dataset manifest.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      <Card>
        <CardHeader>
          <CardTitle>Corpus Metrics</CardTitle>
        </CardHeader>
        <CardContent>
          <div class="text-3xl font-bold">{totalRecords.toLocaleString()}</div>
          <p class="text-sm text-muted-foreground">Records Tracked</p>
          <div class="mt-4 text-2xl font-semibold">{totalShards}</div>
          <p class="text-sm text-muted-foreground">S3 Shards Linked</p>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>API Credentials</CardTitle>
        </CardHeader>
        <CardContent class="space-y-4">
          <div class="break-all rounded-md bg-muted p-4 font-mono text-xs">
            pix_live_xxxxxxxxxxxxxxxxxxxxxxxx
          </div>
          <div class="flex gap-2">
            <Button size="sm">Regenerate</Button>
          </div>
          <p class="text-[10px] text-muted-foreground">
            MANDATE: All requests must include <code>X-Pixelated-Client</code>.
          </p>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>SDK Status</CardTitle>
        </CardHeader>
        <CardContent class="space-y-4">
          <div class="flex items-center justify-between text-sm">
            <span>Version</span>
            <span class="badge rounded bg-primary px-2 py-0.5 text-[10px] text-primary-foreground">
              {sdkVersion}
            </span>
          </div>
          <div class="flex items-center justify-between text-sm">
            <span>Env</span>
            <span class="font-medium text-foreground">Production</span>
          </div>
          <Button variant="secondary" size="sm" class="w-full">
            Docs (PDF)
          </Button>
        </CardContent>
      </Card>
    </div>

    <div class="space-y-6">
      <h2 class="text-2xl font-semibold">Quick Start</h2>
      <div class="bg-zinc-950 text-zinc-50 overflow-x-auto rounded-xl p-6 font-mono text-sm shadow-2xl">
        <pre><code># Install the SDK
pnpm add @pixelated/sdk

# Initialize your client using the package export available in your app.
# Example (replace with your actual SDK binding):
const client = new PixelatedClient(&#123;
  apiKey: 'YOUR_API_KEY',
  clientId: 'your-app-id',
&#125;);

# Stream from the 133M corpus
const audit = await client.training.stream(&#123; family: 'therapeutic' &#125;);
console.log(`Tracking $&#123;audit.total_shards&#125; shards...`);</code></pre>
      </div>
    </div>
  </main>
</Layout>
