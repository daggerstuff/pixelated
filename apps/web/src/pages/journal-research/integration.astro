---
export const prerender = false

import { LazyIntegrationPage } from '@/components/journal-research/lazy'
import DashboardLayout from '@/layouts/DashboardLayout.astro'

const { user: _user } = Astro.props as { user: any }

const sessionId = Astro.url.searchParams.get('sessionId')
---

<DashboardLayout
  title="Integration Planning | Pixelated Empathy"
  description="Plan integration of acquired journal data sources"
>
  <div class="container mx-auto space-y-6 py-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold">Integration Planning</h1>
        <p class="mt-1 text-muted-foreground">
          Plan and prepare integration of acquired journal data sources
        </p>
      </div>
    </div>

    <LazyIntegrationPage client:load {sessionId} />
  </div>
</DashboardLayout>
