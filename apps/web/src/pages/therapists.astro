---
import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = false
---

<BaseLayout
  title="Meet Our Therapists - Pixelated Empathy"
  description="Connect with our licensed mental health professionals"
  bgType="default"
>
  <div class="min-h-[80vh] px-4 py-16">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h1 class="text-4xl lg:text-6xl font-bold text-foreground mb-6">
          Meet Our Therapists
        </h1>

        <p class="text-xl text-muted-foreground max-w-3xl mx-auto">
          Our team of licensed mental health professionals is here to support
          your journey to wellness.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        <!-- Sample therapist cards -->
        {[1, 2, 3, 4, 5, 6].map((id) => (
          <div class="bg-card border border-border rounded-none p-6 transition-colors">
            <div class="w-24 h-24 bg-gradient-to-br from-blue-500 to-purple-500 rounded-full mx-auto mb-4 flex items-center justify-center">
              <span class="text-white text-2xl font-bold">Dr</span>
            </div>

            <h3 class="text-xl font-semibold text-foreground text-center mb-2">
              Dr. Therapist {id}
            </h3>

            <p class="text-muted-foreground text-center mb-4">
              Licensed Clinical Psychologist
            </p>

            <div class="space-y-2 text-sm text-muted-foreground">
              <div>• Specializes in anxiety and depression</div>
              <div>• 10+ years of experience</div>
              <div>• Licensed in multiple states</div>
            </div>

            <button class="w-full mt-4 px-4 py-2 text-sm font-semibold text-foreground border border-ring rounded-none hover:bg-accent transition-colors">
              View Profile
            </button>
          </div>
        ))}
      </div>

      <div class="text-center">
        <div class="bg-secondary rounded-none p-8 border border-border">
          <h2 class="text-2xl font-semibold text-foreground mb-4">
            Ready to Get Started?
          </h2>
          <p class="text-muted-foreground mb-6">
            Find the right therapist for your needs and begin your journey to
            wellness.
          </p>

          <a
            href="/book"
            class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1"
          >
            Book Your First Session
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
