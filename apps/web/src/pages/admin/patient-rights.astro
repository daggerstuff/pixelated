---
export const prerender = false
import { Icon } from 'astro-icon/components'

// patient-rights.astro
// Admin page for managing patient data access rights and requests
import AdminLayout from '@/layouts/AdminLayout.astro'

import AccessRequestsLog from '../../components/admin/AccessRequestsLog.astro'
import DataDeletionLog from '../../components/admin/DataDeletionLog.astro'
import PatientRightsSystem from '../../components/admin/PatientRightsSystem.astro'

// Page configuration
const title = 'Patient Rights Management'
const description =
  'Manage patient access requests, data deletion, and HIPAA compliance for patient rights'

// Compliance status summary data
const statusData = {
  fulfilled: 29,
  pending: 8,
  overdue: 2,
  totalRequests: 39,
}

// Quick stats
const quickStats = [
  {
    id: 'access-requests',
    label: 'Access Requests',
    value: '32',
    change: '+15%',
    trend: 'up',
    icon: 'document-search',
  },
  {
    id: 'deletion-requests',
    label: 'Deletion Requests',
    value: '7',
    change: '+3',
    trend: 'up',
    icon: 'trash',
  },
  {
    id: 'avg-response',
    label: 'Avg. Response Time',
    value: '2.3 days',
    change: '-12%',
    trend: 'down',
    icon: 'clock',
  },
  {
    id: 'compliance-rate',
    label: 'Compliance Rate',
    value: '95%',
    change: '+2%',
    trend: 'up',
    icon: 'shield-check',
  },
]

// Get trend class for styling
const getTrendClass = (trend: string) => {
  return trend === 'up'
    ? 'text-muted-foreground'
    : 'text-foreground font-semibold'
}

// Calculate fulfillment percentage
const fulfillmentPercentage = Math.round(
  (statusData.fulfilled / statusData.totalRequests) * 100,
)
---

<AdminLayout {title} {description} activeItem="patient-rights">
  <div class="space-y-6">
    <!-- Header Section -->
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-bold text-foreground">{title}</h1>
        <p class="mt-1 text-muted-foreground">
          Manage patient data rights and access requests in compliance with
          HIPAA regulations
        </p>
      </div>

      <div class="flex items-center gap-3">
        <button
          type="button"
          class="flex items-center rounded-none bg-primary px-4 py-2 text-primary-foreground hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
        >
          <Icon name="plus" class="mr-2 h-5 w-5" />
          New Request
        </button>

        <button
          type="button"
          class="flex items-center rounded-none border border-input px-4 py-2 text-foreground hover:bg-secondary focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
        >
          <Icon name="refresh" class="mr-2 h-5 w-5" />
          Refresh
        </button>
      </div>
    </div>

    <!-- Compliance Summary -->
    <div class="grid grid-cols-1 gap-4 md:grid-cols-5">
      <!-- Fulfillment Status Card -->
      <div class="rounded-none bg-card p-5 md:col-span-2">
        <h3 class="mb-4 text-lg font-medium text-foreground">
          Request Fulfillment Status
        </h3>

        <div class="mb-4 flex items-center">
          <div class="relative h-4 w-full rounded-none bg-secondary">
            <div
              class="h-4 rounded-none bg-primary"
              style={`width: ${fulfillmentPercentage}%`}
            ></div>
          </div>
          <span class="ml-3 text-sm font-medium text-foreground">
            {fulfillmentPercentage}%
          </span>
        </div>

        <div class="grid grid-cols-3 gap-2 text-center">
          <div>
            <div class="text-2xl font-bold text-foreground">
              {statusData.fulfilled}
            </div>
            <div class="text-xs text-muted-foreground">Fulfilled</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-foreground">
              {statusData.pending}
            </div>
            <div class="text-xs text-muted-foreground">Pending</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-foreground">
              {statusData.overdue}
            </div>
            <div class="text-xs text-muted-foreground">Overdue</div>
          </div>
        </div>
      </div>

      <!-- Quick Stats Cards -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:col-span-3 lg:grid-cols-2">
        {quickStats.map((stat) => (
          <div class="rounded-none bg-card p-5">
            <div class="flex items-start justify-between">
              <div>
                <p class="text-sm font-medium text-muted-foreground">
                  {stat.label}
                </p>
                <p class="mt-1 text-2xl font-bold text-foreground">
                  {stat.value}
                </p>
              </div>
              <div class="rounded-none border border-input bg-secondary p-3">
                <Icon name={stat.icon} class="h-6 w-6 text-foreground" />
              </div>
            </div>
            <div class={`mt-4 flex items-center ${getTrendClass(stat.trend)}`}>
              <Icon
                name={stat.trend === 'up' ? 'trending-up' : 'trending-down'}
                class="mr-1 h-4 w-4"
              />
              <span class="text-sm font-medium">
                {stat.change} from last month
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Main Content -->
    <div class="overflow-hidden rounded-none bg-card">
      <div class="border-b border-border">
        <nav class="flex space-x-2 px-4" aria-label="Tabs">
          <button
            id="tab-requests"
            type="button"
            class="border-b-2 border-ring px-1 py-4 text-sm font-medium text-foreground"
            aria-selected="true"
          >
            Access Requests
          </button>
          <button
            id="tab-deletions"
            type="button"
            class="border-transparent border-b-2 px-1 py-4 text-sm font-medium text-muted-foreground hover:border-input hover:text-foreground"
            aria-selected="false"
          >
            Deletion Requests
          </button>
          <button
            id="tab-compliance"
            type="button"
            class="border-transparent border-b-2 px-1 py-4 text-sm font-medium text-muted-foreground hover:border-input hover:text-foreground"
            aria-selected="false"
          >
            Compliance Reports
          </button>
        </nav>
      </div>

      <!-- Tab Content -->
      <div class="p-4">
        <!-- Access Requests Panel (Default Active) -->
        <div id="panel-requests" class="block">
          <PatientRightsSystem />
        </div>

        <!-- Deletion Requests Panel (Initially Hidden) -->
        <div id="panel-deletions" class="hidden">
          <DataDeletionLog />
        </div>

        <!-- Compliance Reports Panel (Initially Hidden) -->
        <div id="panel-compliance" class="hidden">
          <AccessRequestsLog />
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Tab functionality
    const tabs = document.querySelectorAll('[id^="tab-"]')
    const panels = document.querySelectorAll('[id^="panel-"]')

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        // Toggle tabs
        tabs.forEach((t) => {
          t.classList.remove('border-ring', 'text-foreground', '', '')
          t.classList.add(
            'border-transparent',
            'text-muted-foreground',
            'hover:text-foreground',
            'hover:border-input',
            '',
            '',
            '',
          )
          t.setAttribute('aria-selected', 'false')
        })

        tab.classList.remove(
          'border-transparent',
          'text-muted-foreground',
          'hover:text-foreground',
          'hover:border-input',
          '',
          '',
          '',
        )
        tab.classList.add('border-ring', 'text-foreground', '', '')
        tab.setAttribute('aria-selected', 'true')

        // Toggle panels
        const tabName = tab.id.replace('tab-', '')
        panels.forEach((panel) => {
          panel.classList.add('hidden')
        })
        document.getElementById(`panel-${tabName}`)?.classList.remove('hidden')
      })
    })
  })
</script>
