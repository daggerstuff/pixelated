---
export const prerender = false
// data-retention.astro
// Admin page for managing data retention policies and archiving
import AdminLayout from '../../components/admin/AdminLayout.astro'
import DataRetentionSystem from '../../components/admin/DataRetentionSystem.astro'
import RetentionAuditLogs from '../../components/admin/RetentionAuditLogs.astro'
import RetentionReports from '../../components/admin/RetentionReports.astro'
import { Icon } from 'astro-icon/components'

// Page configuration
const title = 'Data Retention Management'
const description =
  'Manage data retention policies, archiving, and secure destruction for HIPAA compliance'

// Compliance status summary data
const statusData = {
  compliant: 12,
  review: 3,
  nonCompliant: 1,
  totalPolicies: 16,
}

// Quick stats
const quickStats = [
  {
    id: 'archived-records',
    label: 'Records Archived',
    value: '287,412',
    change: '+24%',
    trend: 'up',
    icon: 'archive',
  },
  {
    id: 'scheduled-actions',
    label: 'Scheduled Actions',
    value: '8',
    change: '+2',
    trend: 'up',
    icon: 'calendar',
  },
  {
    id: 'destroyed-records',
    label: 'Records Destroyed',
    value: '15,943',
    change: '+12%',
    trend: 'up',
    icon: 'trash',
  },
  {
    id: 'policy-compliance',
    label: 'Policy Compliance',
    value: '94%',
    change: '+5%',
    trend: 'up',
    icon: 'shield-check',
  },
]

// Get trend class for styling
const getTrendClass = (trend: string) => {
  return trend === 'up'
    ? 'text-muted-foreground'
    : 'text-foreground font-semibold'
}

// Calculate compliance percentage
const compliancePercentage = Math.round(
  (statusData.compliant / statusData.totalPolicies) * 100,
)
---

<AdminLayout {title} {description} activeItem="data-retention">
  <div class="space-y-6">
    <!-- Header Section -->
    <div
      class="flex flex-col md:flex-row md:items-center md:justify-between gap-4"
    >
      <div>
        <h1 class="text-2xl font-bold text-foreground">
          {title}
        </h1>
        <p class="mt-1 text-muted-foreground">
          Manage retention policies and automated archiving for patient data
        </p>
      </div>

      <div class="flex items-center gap-3">
        <button
          type="button"
          class="px-4 py-2 bg-primary text-primary-foreground rounded-none hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 flex items-center"
        >
          <Icon name="plus" class="w-5 h-5 mr-2" />
          New Policy
        </button>

        <button
          type="button"
          class="px-4 py-2 border border-input text-foreground rounded-none hover:bg-secondary focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 flex items-center"
        >
          <Icon name="refresh" class="w-5 h-5 mr-2" />
          Refresh
        </button>
      </div>
    </div>

    <!-- Compliance Summary -->
    <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
      <!-- Compliance Status Card -->
      <div class="md:col-span-2 bg-card rounded-none p-5">
        <h3 class="text-lg font-medium text-foreground mb-4">
          Compliance Status
        </h3>

        <div class="flex items-center mb-4">
          <div class="relative w-full h-4 bg-secondary rounded-none">
            <div
              class="h-4 bg-primary rounded-none"
              style={`width: ${compliancePercentage}%`}
            >
            </div>
          </div>
          <span class="ml-3 text-sm font-medium text-foreground"
            >{compliancePercentage}%</span
          >
        </div>

        <div class="grid grid-cols-3 gap-2 text-center">
          <div>
            <div class="text-2xl font-bold text-foreground">
              {statusData.compliant}
            </div>
            <div class="text-xs text-muted-foreground">Compliant</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-foreground">
              {statusData.review}
            </div>
            <div class="text-xs text-muted-foreground">Review Needed</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-foreground">
              {statusData.nonCompliant}
            </div>
            <div class="text-xs text-muted-foreground">Non-Compliant</div>
          </div>
        </div>
      </div>

      <!-- Quick Stats Cards -->
      <div
        class="md:col-span-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"
      >
        {
          quickStats.map((stat) => (
            <div class="bg-card rounded-none p-5">
              <div class="flex justify-between items-start">
                <div>
                  <p class="text-sm font-medium text-muted-foreground">
                    {stat.label}
                  </p>
                  <p class="text-2xl font-bold text-foreground mt-1">
                    {stat.value}
                  </p>
                </div>
                <div class="p-3 rounded-none bg-secondary border border-input">
                  <Icon name={stat.icon} class="w-6 h-6 text-foreground" />
                </div>
              </div>
              <div
                class={`flex items-center mt-4 ${getTrendClass(stat.trend)}`}
              >
                <Icon
                  name={stat.trend === 'up' ? 'trending-up' : 'trending-down'}
                  class="w-4 h-4 mr-1"
                />
                <span class="text-sm font-medium">
                  {stat.change} from last month
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Main Content -->
    <div class="bg-card rounded-none overflow-hidden">
      <div class="border-b border-border">
        <nav class="flex space-x-2 px-4" aria-label="Tabs">
          <button
            id="tab-policies"
            type="button"
            class="py-4 px-1 border-b-2 border-ring text-foreground font-medium text-sm"
            aria-selected="true"
          >
            Retention Policies
          </button>
          <button
            id="tab-audit"
            type="button"
            class="py-4 px-1 border-b-2 border-transparent text-muted-foreground hover:text-foreground hover:border-input font-medium text-sm"
            aria-selected="false"
          >
            Archiving Audit
          </button>
          <button
            id="tab-exports"
            type="button"
            class="py-4 px-1 border-b-2 border-transparent text-muted-foreground hover:text-foreground hover:border-input font-medium text-sm"
            aria-selected="false"
          >
            Export Reports
          </button>
        </nav>
      </div>

      <!-- Tab Content -->
      <div class="p-4">
        <!-- Retention Policies Panel (Default Active) -->
        <div id="panel-policies" class="block">
          <DataRetentionSystem />
        </div>

        <!-- Archiving Audit Panel (Initially Hidden) -->
        <div id="panel-audit" class="hidden">
          <RetentionAuditLogs />
        </div>

        <!-- Export Reports Panel (Initially Hidden) -->
        <div id="panel-exports" class="hidden">
          <RetentionReports />
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Tab functionality
    const tabs = document.querySelectorAll('[id^="tab-"]')
    const panels = document.querySelectorAll('[id^="panel-"]')

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        // Toggle tabs
        tabs.forEach((t) => {
          t.classList.remove('border-ring', 'text-foreground', '', '')
          t.classList.add(
            'border-transparent',
            'text-muted-foreground',
            'hover:text-foreground',
            'hover:border-input',
            '',
            '',
            '',
          )
          t.setAttribute('aria-selected', 'false')
        })

        tab.classList.remove(
          'border-transparent',
          'text-muted-foreground',
          'hover:text-foreground',
          'hover:border-input',
          '',
          '',
          '',
        )
        tab.classList.add('border-ring', 'text-foreground', '', '')
        tab.setAttribute('aria-selected', 'true')

        // Toggle panels
        const tabName = tab.id.replace('tab-', '')
        panels.forEach((panel) => {
          panel.classList.add('hidden')
        })
        document.getElementById(`panel-${tabName}`)?.classList.remove('hidden')
      })
    })
  })
</script>
