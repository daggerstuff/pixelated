---
import RealUserMonitoringComponent from '@/components/monitoring/RealUserMonitoring.astro'
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { getMonitoringConfig } from '@/lib/monitoring/config'

// Get monitoring configuration
const config = getMonitoringConfig()
---

<DashboardLayout title="Real User Monitoring | Admin Dashboard">
  <div class="container mx-auto px-4 py-8">
    <header class="mb-8">
      <h1 class="text-2xl font-bold text-foreground">Real User Monitoring</h1>
      <p class="mt-2 text-muted-foreground">
        Monitor actual user experiences across devices, browsers, and regions.
      </p>
    </header>

    <div class="mb-8">
      <RealUserMonitoringComponent
        title="Performance Overview"
        description="Core Web Vitals and performance metrics across all users"
      />
    </div>

    <div class="mb-8 rounded-none border border-border bg-card p-4">
      <h2 class="mb-3 text-xl font-semibold text-foreground">
        Understanding Real User Monitoring
      </h2>

      <div class="prose dark:prose-invert max-w-none">
        <p>
          Real User Monitoring (RUM) collects performance data from actual users
          of your application. Unlike synthetic testing, RUM provides insights
          into real-world experiences across different:
        </p>

        <ul class="mb-4 ml-6 mt-2 list-disc">
          <li>Device types and capabilities</li>
          <li>Network conditions</li>
          <li>Geographic locations</li>
          <li>Browsers and operating systems</li>
        </ul>

        <h3 class="mb-2 mt-4 text-lg font-medium">Key Benefits</h3>

        <ol class="mb-4 ml-6 list-decimal">
          <li>
            <strong>Real-world data:</strong> See how your site performs for
            actual users
          </li>
          <li>
            <strong>Prioritize improvements:</strong> Focus on fixing issues
            affecting the most users
          </li>
          <li>
            <strong>Track business impact:</strong> Understand how performance
            affects conversion and engagement
          </li>
          <li>
            <strong>Catch regional issues:</strong> Identify problems in
            specific locations or networks
          </li>
        </ol>

        <h3 class="mb-2 mt-4 text-lg font-medium">Using This Dashboard</h3>

        <p>
          The dashboard above shows key metrics from the Web Vitals initiative
          and other important performance indicators. Values are color-coded
          based on the performance budgets defined in our testing framework:
        </p>

        <ul class="mt-2">
          <li>
            <span class="font-semibold text-foreground">Good:</span> Normal -
            Meeting performance targets
          </li>
          <li>
            <span class="font-medium text-foreground">Watch:</span> Needs
            Improvement - Under acceptable limits but could be better
          </li>
          <li>
            <span class="font-semibold text-foreground">Critical:</span> Poor -
            Exceeding acceptable limits, requires attention
          </li>
        </ul>
      </div>
    </div>

    {config.grafana.enableRUM && (
      <div class="mb-6 text-sm text-muted-foreground">
        <p>
          Data is collected using Grafana Faro Web SDK with a sampling rate of{' '}
          {config.grafana.rumSamplingRate * 100}%. Configuration can be adjusted
          in the monitoring settings.
        </p>
      </div>
    )}
  </div>
</DashboardLayout>
