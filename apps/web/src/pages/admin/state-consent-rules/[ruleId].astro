---
export const prerender = false
import { Icon } from 'astro-icon/components'

import AdminLayout from '@/layouts/AdminLayout.astro'
import { requirePageAuth } from '@/lib/auth/serverAuth'

await requirePageAuth(Astro, 'admin')
---

<AdminLayout
  title="State Consent Rule Details"
  description="View and manage individual state consent rule"
  activeItem="state-consent-rules"
>
  <div class="space-y-6">
    <!-- Back link -->
    <div>
      <a
        href="/admin/state-consent-rules"
        class="inline-flex items-center text-sm text-muted-foreground hover:text-foreground"
      >
        <Icon name="tabler:arrow-left" class="mr-1 h-4 w-4" />
        Back to State Consent Rules
      </a>
    </div>

    <!-- Rule Header -->
    <div id="rule-header" class="rounded-none bg-card p-6 shadow-md">
      <div class="flex items-center justify-between">
        <div>
          <h1 id="rule-title" class="text-2xl font-bold text-foreground">
            Loading...
          </h1>
          <p id="rule-subtitle" class="mt-1 text-sm text-muted-foreground"></p>
        </div>
        <div
          id="rule-status-badge"
          class="rounded-none px-3 py-1 text-sm font-medium"
        ></div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div id="action-bar" class="flex hidden flex-wrap gap-3">
      <button
        id="btn-submit-review"
        type="button"
        class="flex hidden items-center rounded-none bg-primary px-4 py-2 text-sm text-primary-foreground hover:bg-accent"
      >
        <Icon name="tabler:eye-check" class="mr-2 h-4 w-4" />
        Submit for Review
      </button>
      <button
        id="btn-approve"
        type="button"
        class="flex hidden items-center rounded-none bg-primary px-4 py-2 text-sm text-primary-foreground hover:bg-accent"
      >
        <Icon name="tabler:check" class="mr-2 h-4 w-4" />
        Approve
      </button>
      <button
        id="btn-activate"
        type="button"
        class="flex hidden items-center rounded-none bg-primary px-4 py-2 text-sm text-primary-foreground hover:bg-accent"
      >
        <Icon name="tabler:bolt" class="mr-2 h-4 w-4" />
        Activate
      </button>
      <button
        id="btn-archive"
        type="button"
        class="flex hidden items-center rounded-none bg-primary px-4 py-2 text-sm text-primary-foreground hover:bg-accent"
      >
        <Icon name="tabler:archive" class="mr-2 h-4 w-4" />
        Archive
      </button>
      <button
        id="btn-delete"
        type="button"
        class="flex hidden items-center rounded-none border border-ring px-4 py-2 text-sm font-semibold text-foreground hover:bg-accent"
      >
        <Icon name="tabler:trash" class="mr-2 h-4 w-4" />
        Delete Draft
      </button>
    </div>

    <!-- Rule Details -->
    <div class="rounded-none bg-card p-6 shadow-md">
      <h2 class="mb-4 text-lg font-semibold text-foreground">
        Rule Configuration
      </h2>
      <div id="rule-config" class="space-y-3">
        <p class="text-muted-foreground">Loading...</p>
      </div>
    </div>

    <!-- Metadata -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="rounded-none bg-card p-6 shadow-md">
        <h2 class="mb-4 text-lg font-semibold text-foreground">
          Rule Metadata
        </h2>
        <dl id="rule-metadata" class="space-y-2 text-sm">
          <p class="text-muted-foreground">Loading...</p>
        </dl>
      </div>

      <div class="rounded-none bg-card p-6 shadow-md">
        <h2 class="mb-4 text-lg font-semibold text-foreground">
          Workflow History
        </h2>
        <dl id="rule-workflow" class="space-y-2 text-sm">
          <p class="text-muted-foreground">Loading...</p>
        </dl>
      </div>
    </div>

    <!-- Audit History -->
    <div class="overflow-hidden rounded-none bg-card shadow-md">
      <div class="border-b border-border px-6 py-4">
        <h2 class="text-lg font-semibold text-foreground">Audit History</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-border">
          <thead class="bg-secondary">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Action
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Actor
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground">
                From
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground">
                To
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Timestamp
              </th>
            </tr>
          </thead>
          <tbody id="audit-tbody" class="divide-y divide-border bg-card">
            <tr>
              <td
                colspan="5"
                class="px-6 py-8 text-center text-muted-foreground"
              >
                Loading audit history...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  const STATUS_COLORS: Record<string, string> = {
    draft: 'bg-secondary text-foreground',
    review: 'bg-secondary border border-ring text-foreground font-medium',
    approved: 'bg-secondary border border-input text-foreground font-medium',
    active: 'bg-secondary border border-input text-muted-foreground',
    superseded: 'bg-secondary border border-input text-foreground font-medium',
    archived:
      'bg-primary text-primary-foreground text-primary-foreground font-semibold',
  }

  function formatDate(dateStr: string | null): string {
    if (!dateStr) return '—'
    try {
      return new Date(dateStr).toLocaleString()
    } catch {
      return dateStr
    }
  }

  function renderConfig(config: Record<string, unknown>): string {
    const fields: Array<{ label: string; value: string }> = [
      {
        label: 'Minimum Consent Level',
        value: String(config.minimumConsentLevel ?? '—'),
      },
      {
        label: 'Override Consent Level',
        value: String(config.overrideConsentLevel ?? '—'),
      },
      {
        label: 'Requires Mental Health Consent',
        value: config.requiresMentalHealthConsent ? 'Yes' : 'No',
      },
      {
        label: 'Requires SUD Consent',
        value: config.requiresSUDConsent ? 'Yes' : 'No',
      },
      {
        label: 'Requires Minor Parental Consent',
        value: config.requiresMinorParentalConsent ? 'Yes' : 'No',
      },
      { label: 'Age of Majority', value: String(config.ageOfMajority ?? '—') },
    ]

    if (
      config.minorConsentCategories &&
      Array.isArray(config.minorConsentCategories)
    ) {
      fields.push({
        label: 'Minor Consent Categories',
        value: (config.minorConsentCategories as string[]).join(', '),
      })
    }

    if (
      config.providerTypeRestrictions &&
      typeof config.providerTypeRestrictions === 'object'
    ) {
      fields.push({
        label: 'Provider Type Restrictions',
        value: JSON.stringify(config.providerTypeRestrictions),
      })
    }

    if (
      config.treatmentCategoryOverrides &&
      typeof config.treatmentCategoryOverrides === 'object'
    ) {
      fields.push({
        label: 'Treatment Category Overrides',
        value: JSON.stringify(config.treatmentCategoryOverrides),
      })
    }

    if (config.legalMetadata && typeof config.legalMetadata === 'object') {
      const lm = config.legalMetadata as Record<string, string>
      if (lm.legalReference)
        fields.push({ label: 'Legal Reference', value: lm.legalReference })
      if (lm.lastLegalReviewDate)
        fields.push({
          label: 'Last Legal Review',
          value: lm.lastLegalReviewDate,
        })
      if (lm.nextReviewDueDate)
        fields.push({ label: 'Next Review Due', value: lm.nextReviewDueDate })
      if (lm.reviewedBy)
        fields.push({ label: 'Reviewed By', value: lm.reviewedBy })
    }

    return fields
      .map(
        (f) => `
    <div class="flex justify-between py-2 border-b border-border">
     <dt class="text-sm font-medium text-muted-foreground">${f.label}</dt>
     <dd class="text-sm text-foreground">${f.value}</dd>
    </div>
   `,
      )
      .join('')
  }

  async function loadRule() {
    const pathParts = window.location.pathname.split('/')
    const ruleId = pathParts[pathParts.length - 1]

    if (!ruleId) {
      showError('No rule ID found in URL')
      return
    }

    try {
      const res = await fetch(`/api/v1/admin/state-consent-rules/${ruleId}`)
      if (!res.ok) {
        const err = await res.json().catch(() => ({ error: 'Request failed' }))
        showError(err.error || 'Failed to load rule')
        return
      }

      const data = await res.json()
      const rule = data.rule
      const auditLog = data.auditLog || []

      // Header
      const titleEl = document.getElementById('rule-title')
      const subtitleEl = document.getElementById('rule-subtitle')
      const statusBadge = document.getElementById('rule-status-badge')

      titleEl!.textContent = `${rule.stateCode} — Version ${rule.version}`
      subtitleEl!.textContent = `Rule ID: ${rule.ruleId}`

      const statusClass = STATUS_COLORS[rule.status] || STATUS_COLORS.draft
      statusBadge!.className = `px-3 py-1 text-sm font-medium rounded-none ${statusClass}`
      statusBadge!.textContent = rule.status

      // Config
      const configEl = document.getElementById('rule-config')
      configEl!.innerHTML = renderConfig(rule.ruleConfig)

      // Metadata
      const metadataEl = document.getElementById('rule-metadata')
      metadataEl!.innerHTML = `
    <div class="flex justify-between"><dt class="text-muted-foreground">Rule ID</dt><dd class="text-foreground font-mono text-xs">${rule.ruleId}</dd></div>
    <div class="flex justify-between"><dt class="text-muted-foreground">Tenant ID</dt><dd class="text-foreground">${rule.tenantId || 'Global'}</dd></div>
    <div class="flex justify-between"><dt class="text-muted-foreground">State Code</dt><dd class="text-foreground">${rule.stateCode}</dd></div>
    <div class="flex justify-between"><dt class="text-muted-foreground">Version</dt><dd class="text-foreground">v${rule.version}</dd></div>
    <div class="flex justify-between"><dt class="text-muted-foreground">Effective Date</dt><dd class="text-foreground">${formatDate(rule.effectiveDate)}</dd></div>
    <div class="flex justify-between"><dt class="text-muted-foreground">Expiry Date</dt><dd class="text-foreground">${formatDate(rule.expiryDate)}</dd></div>
    <div class="flex justify-between"><dt class="text-muted-foreground">Notes</dt><dd class="text-foreground">${rule.notes || '—'}</dd></div>
   `

      // Workflow
      const workflowEl = document.getElementById('rule-workflow')
      workflowEl!.innerHTML = `
    <div class="flex justify-between"><dt class="text-muted-foreground">Created By</dt><dd class="text-foreground">${rule.createdByRole || rule.createdBy.substring(0, 8)}</dd></div>
    <div class="flex justify-between"><dt class="text-muted-foreground">Created At</dt><dd class="text-foreground">${formatDate(rule.createdAt)}</dd></div>
    <div class="flex justify-between"><dt class="text-muted-foreground">Reviewed By</dt><dd class="text-foreground">${rule.reviewedByRole || '—'}</dd></div>
    <div class="flex justify-between"><dt class="text-muted-foreground">Reviewed At</dt><dd class="text-foreground">${formatDate(rule.reviewedAt)}</dd></div>
    <div class="flex justify-between"><dt class="text-muted-foreground">Approved By</dt><dd class="text-foreground">${rule.approvedByRole || '—'}</dd></div>
    <div class="flex justify-between"><dt class="text-muted-foreground">Approved At</dt><dd class="text-foreground">${formatDate(rule.approvedAt)}</dd></div>
    <div class="flex justify-between"><dt class="text-muted-foreground">Activated At</dt><dd class="text-foreground">${formatDate(rule.activatedAt)}</dd></div>
    <div class="flex justify-between"><dt class="text-muted-foreground">Superseded By</dt><dd class="text-foreground">${rule.supersededBy || '—'}</dd></div>
   `

      // Action buttons
      const actionBar = document.getElementById('action-bar')
      actionBar?.classList.remove('hidden')

      const btnSubmitReview = document.getElementById('btn-submit-review')
      const btnApprove = document.getElementById('btn-approve')
      const btnActivate = document.getElementById('btn-activate')
      const btnArchive = document.getElementById('btn-archive')
      const btnDelete = document.getElementById('btn-delete')

      if (rule.status === 'draft') {
        btnSubmitReview?.classList.remove('hidden')
        btnDelete?.classList.remove('hidden')
      }
      if (rule.status === 'review') {
        btnApprove?.classList.remove('hidden')
      }
      if (rule.status === 'approved') {
        btnActivate?.classList.remove('hidden')
      }
      if (rule.status !== 'active' && rule.status !== 'archived') {
        btnArchive?.classList.remove('hidden')
      }

      // Audit table
      const auditTbody = document.getElementById('audit-tbody')
      if (auditLog.length === 0) {
        auditTbody!.innerHTML =
          '<tr><td colspan="5" class="px-6 py-8 text-center text-muted-foreground">No audit entries</td></tr>'
      } else {
        auditTbody!.innerHTML = auditLog
          .map(
            (entry: {
              action: string
              actorId: string
              actorRole: string
              oldStatus: string | null
              newStatus: string | null
              timestamp: string
            }) => `
      <tr>
       <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-foreground">
        ${entry.action.replace(/_/g, ' ')}
       </td>
       <td class="px-6 py-4 whitespace-nowrap text-sm text-muted-foreground">
        ${entry.actorRole || entry.actorId.substring(0, 8)}
       </td>
       <td class="px-6 py-4 whitespace-nowrap text-sm text-muted-foreground">
        ${entry.oldStatus || '—'}
       </td>
       <td class="px-6 py-4 whitespace-nowrap text-sm text-muted-foreground">
        ${entry.newStatus || '—'}
       </td>
       <td class="px-6 py-4 whitespace-nowrap text-sm text-muted-foreground">
        ${formatDate(entry.timestamp)}
       </td>
      </tr>
     `,
          )
          .join('')
      }

      // Wire up action buttons
      btnSubmitReview?.addEventListener('click', () =>
        doAction('submit-review'),
      )
      btnApprove?.addEventListener('click', () => doAction('approve'))
      btnActivate?.addEventListener('click', () => doAction('activate'))
      btnArchive?.addEventListener('click', () => doAction('archive'))
      btnDelete?.addEventListener('click', () => doDelete())
    } catch (err) {
      showError('Failed to load rule')
    }
  }

  async function doAction(action: string) {
    if (
      !confirm(
        `Are you sure you want to ${action.replace('-', ' ')} this rule?`,
      )
    )
      return

    const pathParts = window.location.pathname.split('/')
    const ruleId = pathParts[pathParts.length - 1]

    try {
      const res = await fetch(
        `/api/v1/admin/state-consent-rules/${ruleId}/${action}`,
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({}),
        },
      )

      if (!res.ok) {
        const err = await res.json().catch(() => ({ error: 'Request failed' }))
        alert(err.error || `Failed to ${action}`)
        return
      }

      window.location.reload()
    } catch (err) {
      alert('Network error occurred')
    }
  }

  async function doDelete() {
    if (
      !confirm(
        'Are you sure you want to permanently delete this draft rule? This cannot be undone.',
      )
    )
      return

    const pathParts = window.location.pathname.split('/')
    const ruleId = pathParts[pathParts.length - 1]

    try {
      const res = await fetch(`/api/v1/admin/state-consent-rules/${ruleId}`, {
        method: 'DELETE',
      })

      if (!res.ok) {
        const err = await res.json().catch(() => ({ error: 'Request failed' }))
        alert(err.error || 'Failed to delete')
        return
      }

      window.location.href = '/admin/state-consent-rules'
    } catch (err) {
      alert('Network error occurred')
    }
  }

  function showError(msg: string) {
    const titleEl = document.getElementById('rule-title')
    titleEl!.textContent = 'Error'
    const configEl = document.getElementById('rule-config')
    configEl!.innerHTML = `<p class="text-foreground font-semibold">${msg}</p>`
  }

  document.addEventListener('DOMContentLoaded', loadRule)
</script>
