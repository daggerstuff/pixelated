---
export const prerender = false
import AdminLayout from '@/components/admin/AdminLayout.astro'
import { requirePageAuth } from '@/lib/auth/serverAuth'
import { Icon } from 'astro-icon/components'

await requirePageAuth(Astro, 'admin')
---

<AdminLayout
  title="State Consent Rules"
  description="Manage state-by-state consent rules with legal sign-off workflow"
  activeItem="state-consent-rules"
>
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
          State Consent Rules
        </h1>
        <p class="mt-1 text-gray-500 dark:text-gray-400">
          Manage versioned state-by-state consent rules with a
          draft&rarr;review&rarr;approved&rarr;active workflow.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <button
          id="btn-create"
          type="button"
          class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:bg-blue-700 dark:hover:bg-blue-600 flex items-center"
        >
          <Icon name="tabler:plus" class="w-5 h-5 mr-2" />
          Create New Rule
        </button>
        <button
          id="btn-refresh"
          type="button"
          class="px-4 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700 flex items-center"
        >
          <Icon name="tabler:refresh" class="w-5 h-5 mr-2" />
          Refresh
        </button>
      </div>
    </div>

    <!-- Filters -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-4">
      <form id="filter-form" class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div>
          <label for="filter-state" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            State
          </label>
          <select
            id="filter-state"
            class="w-full rounded-md border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">All States</option>
          </select>
        </div>
        <div>
          <label for="filter-status" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Status
          </label>
          <select
            id="filter-status"
            class="w-full rounded-md border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">All Statuses</option>
            <option value="draft">Draft</option>
            <option value="review">Review</option>
            <option value="approved">Approved</option>
            <option value="active">Active</option>
            <option value="superseded">Superseded</option>
            <option value="archived">Archived</option>
          </select>
        </div>
        <div>
          <label for="filter-search" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Search
          </label>
          <input
            type="text"
            id="filter-search"
            placeholder="Search by state code..."
            class="w-full rounded-md border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>
        <div class="flex items-end">
          <button
            type="submit"
            class="w-full px-4 py-2 bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600 text-sm font-medium"
          >
            Apply Filters
          </button>
        </div>
      </form>
    </div>

    <!-- Rules Table -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
          <thead class="bg-gray-50 dark:bg-gray-700">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                State
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                Version
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                Status
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                Created By
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                Created At
              </th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                Actions
              </th>
            </tr>
          </thead>
          <tbody
            id="rules-tbody"
            class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700"
          >
            <tr id="loading-row">
              <td colspan="6" class="px-6 py-8 text-center text-gray-400">
                Loading rules...
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div
        id="pagination-bar"
        class="px-6 py-3 bg-gray-50 dark:bg-gray-700 flex items-center justify-between hidden"
      >
        <div id="pagination-info" class="text-sm text-gray-600 dark:text-gray-300">
        </div>
        <div class="flex items-center gap-2">
          <button
            id="btn-prev"
            type="button"
            class="px-3 py-1 text-sm border border-gray-300 rounded-md hover:bg-gray-100 dark:border-gray-600 dark:hover:bg-gray-600 disabled:opacity-50 disabled:cursor-not-allowed"
            disabled
          >
            Previous
          </button>
          <span id="page-indicator" class="text-sm text-gray-600 dark:text-gray-300">1</span>
          <button
            id="btn-next"
            type="button"
            class="px-3 py-1 text-sm border border-gray-300 rounded-md hover:bg-gray-100 dark:border-gray-600 dark:hover:bg-gray-600 disabled:opacity-50 disabled:cursor-not-allowed"
            disabled
          >
            Next
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Create Modal -->
  <div
    id="create-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black bg-opacity-50"
  >
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">
          Create New State Consent Rule
        </h2>
      </div>
      <form id="create-form" class="px-6 py-4 space-y-4">
        <div>
          <label for="create-state" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            State Code <span class="text-red-500">*</span>
          </label>
          <select
            id="create-state"
            name="stateCode"
            required
            class="w-full rounded-md border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">Select a state...</option>
          </select>
        </div>

        <div>
          <label for="create-consent-level" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Minimum Consent Level <span class="text-red-500">*</span>
          </label>
          <select
            id="create-consent-level"
            name="minimumConsentLevel"
            required
            class="w-full rounded-md border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="none">None</option>
            <option value="minimal">Minimal</option>
            <option value="limited">Limited</option>
            <option value="full">Full</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
              <input type="checkbox" name="requiresMentalHealthConsent" class="rounded" />
              Requires Mental Health Consent
            </label>
          </div>
          <div>
            <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
              <input type="checkbox" name="requiresSUDConsent" class="rounded" />
              Requires SUD Consent
            </label>
          </div>
          <div>
            <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
              <input type="checkbox" name="requiresMinorParentalConsent" class="rounded" />
              Requires Minor Parental Consent
            </label>
          </div>
          <div>
            <label for="create-age-majority" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              Age of Majority <span class="text-red-500">*</span>
            </label>
            <input
              type="number"
              id="create-age-majority"
              name="ageOfMajority"
              min="16"
              max="21"
              value="18"
              required
              class="w-full rounded-md border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
        </div>

        <div>
          <label for="create-notes" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Notes
          </label>
          <textarea
            id="create-notes"
            name="notes"
            rows="3"
            class="w-full rounded-md border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Optional notes for this rule..."
          ></textarea>
        </div>

        <div id="create-error" class="hidden text-sm text-red-600 dark:text-red-400"></div>

        <div class="flex justify-end gap-3 pt-2">
          <button
            type="button"
            id="btn-cancel-create"
            class="px-4 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700 text-sm"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-600 text-sm"
          >
            Create Draft
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  const US_STATES = [
    'AL','AK','AZ','AR','CA','CO','CT','DE','FL','GA','HI','ID','IL','IN','IA',
    'KS','KY','LA','ME','MD','MA','MI','MN','MS','MO','MT','NE','NV','NH','NJ',
    'NM','NY','NC','ND','OH','OK','OR','PA','RI','SC','SD','TN','TX','UT','VT',
    'VA','WA','WV','WI','WY','DC','PR','GU','VI','AS','MP',
  ]

  const STATUS_COLORS: Record<string, string> = {
    draft: 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300',
    review: 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300',
    approved: 'bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300',
    active: 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300',
    superseded: 'bg-purple-100 text-purple-700 dark:bg-purple-900 dark:text-purple-300',
    archived: 'bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300',
  }

  let currentPage = 1
  let currentLimit = 20
  let currentRules: Array<{ ruleId: string; stateCode: string; version: number; status: string; createdBy: string; createdAt: string }> = []

  // Populate state dropdowns
  function populateStates() {
    const filterState = document.getElementById('filter-state') as HTMLSelectElement
    const createState = document.getElementById('create-state') as HTMLSelectElement

    for (const code of US_STATES) {
      const opt1 = document.createElement('option')
      opt1.value = code
      opt1.textContent = code
      filterState.appendChild(opt1)

      const opt2 = document.createElement('option')
      opt2.value = code
      opt2.textContent = code
      createState.appendChild(opt2)
    }
  }

  async function fetchRules() {
    const tbody = document.getElementById('rules-tbody') as HTMLTableSectionElement
    tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-gray-400">Loading rules...</td></tr>'

    const filterState = (document.getElementById('filter-state') as HTMLSelectElement).value
    const filterStatus = (document.getElementById('filter-status') as HTMLSelectElement).value
    const filterSearch = (document.getElementById('filter-search') as HTMLInputElement).value

    const params = new URLSearchParams()
    if (filterState) params.set('stateCode', filterState)
    if (filterStatus) params.set('status', filterStatus)
    if (filterSearch) params.set('stateCode', filterSearch.toUpperCase())
    params.set('page', String(currentPage))
    params.set('limit', String(currentLimit))

    try {
      const res = await fetch(`/api/v1/admin/state-consent-rules?${params.toString()}`)
      if (!res.ok) {
        const err = await res.json().catch(() => ({ error: 'Request failed' }))
        tbody.innerHTML = `<tr><td colspan="6" class="px-6 py-8 text-center text-red-500">${err.error || 'Failed to load'}</td></tr>`
        return
      }

      const data = await res.json()
      currentRules = data.rules || []

      if (currentRules.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-gray-400">No rules found</td></tr>'
      } else {
        tbody.innerHTML = currentRules.map((rule) => {
          const statusClass = STATUS_COLORS[rule.status] || STATUS_COLORS.draft
          const createdDate = new Date(rule.createdAt).toLocaleDateString()
          return `
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">
                ${rule.stateCode}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                v${rule.version}
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs font-medium rounded-full ${statusClass}">
                  ${rule.status}
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                ${rule.createdByRole || rule.createdBy.substring(0, 8)}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                ${createdDate}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                <a href="/admin/state-consent-rules/${rule.ruleId}" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 font-medium">
                  View
                </a>
              </td>
            </tr>
          `
        }).join('')
      }

      // Pagination
      const paginationBar = document.getElementById('pagination-bar')
      const paginationInfo = document.getElementById('pagination-info')
      const btnPrev = document.getElementById('btn-prev') as HTMLButtonElement
      const btnNext = document.getElementById('btn-next') as HTMLButtonElement
      const pageIndicator = document.getElementById('page-indicator')

      if (currentRules.length > 0) {
        paginationBar?.classList.remove('hidden')
        paginationBar?.classList.add('flex')
        if (paginationInfo) {
          paginationInfo.textContent = `Showing ${currentRules.length} rule(s) on page ${currentPage}`
        }
        btnPrev.disabled = currentPage <= 1
        btnNext.disabled = currentRules.length < currentLimit
        pageIndicator!.textContent = String(currentPage)
      } else {
        paginationBar?.classList.add('hidden')
        paginationBar?.classList.remove('flex')
      }
    } catch (err) {
      tbody.innerHTML = `<tr><td colspan="6" class="px-6 py-8 text-center text-red-500">Failed to load rules</td></tr>`
    }
  }

  // Create modal
  function setupCreateModal() {
    const modal = document.getElementById('create-modal')
    const btnCreate = document.getElementById('btn-create')
    const btnCancel = document.getElementById('btn-cancel-create')
    const form = document.getElementById('create-form') as HTMLFormElement
    const errorDiv = document.getElementById('create-error')

    btnCreate?.addEventListener('click', () => {
      modal?.classList.remove('hidden')
      modal?.classList.add('flex')
    })

    btnCancel?.addEventListener('click', () => {
      modal?.classList.add('hidden')
      modal?.classList.remove('flex')
      form.reset()
      errorDiv?.classList.add('hidden')
    })

    form?.addEventListener('submit', async (e) => {
      e.preventDefault()
      errorDiv?.classList.add('hidden')

      const formData = new FormData(form)
      const stateCode = formData.get('stateCode') as string
      const minimumConsentLevel = formData.get('minimumConsentLevel') as string
      const ageOfMajority = parseInt(formData.get('ageOfMajority') as string, 10)
      const requiresMentalHealthConsent = formData.get('requiresMentalHealthConsent') === 'on'
      const requiresSUDConsent = formData.get('requiresSUDConsent') === 'on'
      const requiresMinorParentalConsent = formData.get('requiresMinorParentalConsent') === 'on'
      const notes = (formData.get('notes') as string) || undefined

      const ruleConfig = {
        minimumConsentLevel,
        requiresMentalHealthConsent,
        requiresSUDConsent,
        requiresMinorParentalConsent,
        ageOfMajority,
      }

      try {
        const res = await fetch('/api/v1/admin/state-consent-rules', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ stateCode, ruleConfig, notes }),
        })

        if (!res.ok) {
          const err = await res.json().catch(() => ({ error: 'Request failed' }))
          errorDiv!.textContent = err.error || err.details?.[0]?.message || 'Failed to create rule'
          errorDiv?.classList.remove('hidden')
          return
        }

        const data = await res.json()
        modal?.classList.add('hidden')
        modal?.classList.remove('flex')
        form.reset()
        window.location.href = `/admin/state-consent-rules/${data.rule.ruleId}`
      } catch (err) {
        errorDiv!.textContent = 'Network error occurred'
        errorDiv?.classList.remove('hidden')
      }
    })
  }

  // Init
  document.addEventListener('DOMContentLoaded', () => {
    populateStates()

    document.getElementById('filter-form')?.addEventListener('submit', (e) => {
      e.preventDefault()
      currentPage = 1
      fetchRules()
    })

    document.getElementById('btn-refresh')?.addEventListener('click', fetchRules)

    document.getElementById('btn-prev')?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--
        fetchRules()
      }
    })

    document.getElementById('btn-next')?.addEventListener('click', () => {
      currentPage++
      fetchRules()
    })

    setupCreateModal()
    fetchRules()
  })
</script>
