---
import AdminLayout from '../../../../../layouts/AdminLayout.astro'
import { ComplianceVerificationService } from '../../../../../lib/security/baa/ComplianceVerificationService'
import {
  BusinessAssociateType,
  ComplianceLevel,
  ServiceCategory,
  VerificationMethod,
} from '../../../../../lib/security/baa/types'

// Initialize service
const verificationService = new ComplianceVerificationService()

// Initialize with default requirements if empty
if (verificationService.getAllRequirements().length === 0) {
  verificationService.initializeDefaultRequirements()
}

// Get all requirements
const requirements = verificationService.getAllRequirements()

// Generate options for select fields
const associateTypeOptions = Object.values(BusinessAssociateType).map(
  (type) => ({
    value: type,
    label: type
      .replace(/_/g, ' ')
      .replace(/\b\w/g, (char) => char.toUpperCase()),
  }),
)

const serviceCategoryOptions = Object.values(ServiceCategory).map(
  (category) => ({
    value: category,
    label: category
      .replace(/_/g, ' ')
      .replace(/\b\w/g, (char) => char.toUpperCase()),
  }),
)

const complianceLevelOptions = Object.values(ComplianceLevel).map((level) => ({
  value: level,
  label: level
    .replace(/_/g, ' ')
    .replace(/\b\w/g, (char) => char.toUpperCase()),
}))

const verificationMethodOptions = Object.values(VerificationMethod).map(
  (method) => ({
    value: method,
    label: method
      .replace(/_/g, ' ')
      .replace(/\b\w/g, (char) => char.toUpperCase()),
  }),
)

const frequencyOptions = [
  { value: 'once', label: 'Once' },
  { value: 'monthly', label: 'Monthly' },
  { value: 'quarterly', label: 'Quarterly' },
  { value: 'semi_annually', label: 'Semi-Annually' },
  { value: 'annually', label: 'Annually' },
  { value: 'biannually', label: 'Biannually' },
]
---

<AdminLayout
  title="Compliance Requirements"
  description="Manage HIPAA compliance requirements for vendors"
>
  <div class="px-6 py-8">
    <div class="mb-6 flex items-center justify-between">
      <div class="flex items-center">
        <a
          href="/admin/security/baa/vendors"
          class="mr-4 text-foreground hover:underline"
        >
          &larr; Back to Vendors
        </a>
        <h1 class="text-2xl font-bold text-foreground">
          Compliance Requirements
        </h1>
      </div>
      <button
        id="add-requirement-btn"
        class="rounded-none bg-primary px-4 py-2 text-primary-foreground transition-colors hover:bg-accent"
      >
        Add New Requirement
      </button>
    </div>

    <!-- Requirements Overview Card -->
    <div class="mb-6 rounded-none bg-card p-6">
      <h2 class="mb-4 text-xl font-semibold">Requirements Overview</h2>
      <p class="mb-4 text-muted-foreground">
        Compliance requirements define the criteria vendors must meet to achieve
        specific compliance levels. These requirements help ensure your business
        associates handle PHI in accordance with HIPAA regulations.
      </p>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <div class="rounded-none border border-border bg-secondary p-4">
          <h3 class="mb-1 font-medium text-foreground">Total Requirements</h3>
          <p class="text-3xl font-bold text-foreground">
            {requirements.length}
          </p>
        </div>
        <div class="rounded-none border border-border bg-secondary p-4">
          <h3 class="mb-1 font-medium text-foreground">Required</h3>
          <p class="text-3xl font-bold text-foreground">
            {requirements.filter((r) => r.isRequired).length}
          </p>
        </div>
        <div class="rounded-none border border-border bg-secondary p-4">
          <h3 class="mb-1 font-medium text-foreground">Optional</h3>
          <p class="text-3xl font-bold text-foreground">
            {requirements.filter((r) => !r.isRequired).length}
          </p>
        </div>
      </div>
    </div>

    <!-- Requirements Table -->
    <div class="mb-8 overflow-hidden rounded-none bg-card">
      <div class="border-b border-border px-6 py-4">
        <h2 class="text-lg font-semibold">Compliance Requirements</h2>
      </div>

      {requirements.length === 0 ? (
        <div class="p-6 text-center text-muted-foreground">
          No compliance requirements defined yet. Click "Add New Requirement" to
          create your first requirement.
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-border">
            <thead class="bg-secondary">
              <tr>
                <th
                  scope="col"
                  class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
                >
                  Requirement
                </th>
                <th
                  scope="col"
                  class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
                >
                  Description
                </th>
                <th
                  scope="col"
                  class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
                >
                  Applies To
                </th>
                <th
                  scope="col"
                  class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
                >
                  Required Level
                </th>
                <th
                  scope="col"
                  class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
                >
                  Verification
                </th>
                <th
                  scope="col"
                  class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
                >
                  Status
                </th>
                <th
                  scope="col"
                  class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
                >
                  Actions
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border bg-card">
              {requirements.map((req) => (
                <tr>
                  <td class="whitespace-nowrap px-6 py-4">
                    <div class="text-sm font-medium text-foreground">
                      {req.name}
                    </div>
                    <div class="text-xs text-muted-foreground">
                      Frequency: {req.frequency.replace(/_/g, ' ')}
                    </div>
                  </td>
                  <td class="px-6 py-4 text-sm text-muted-foreground">
                    <div class="max-w-md truncate">{req.description}</div>
                  </td>
                  <td class="whitespace-nowrap px-6 py-4">
                    <div class="mb-1 text-xs text-muted-foreground">Types:</div>
                    <div class="flex flex-wrap gap-1">
                      {req.applicableTypes.map((type) => (
                        <span class="inline-flex items-center rounded-none border border-input bg-secondary px-2 py-0.5 text-xs font-medium text-muted-foreground">
                          {type.replace(/_/g, ' ')}
                        </span>
                      ))}
                    </div>
                  </td>
                  <td class="whitespace-nowrap px-6 py-4">
                    {(() => {
                      switch (req.minimumComplianceLevel) {
                        case ComplianceLevel.HIPAA_CERTIFIED:
                          return (
                            <span class="inline-flex items-center rounded-none border border-input bg-secondary px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
                              HIPAA Certified
                            </span>
                          )
                        case ComplianceLevel.THIRD_PARTY_VERIFIED:
                          return (
                            <span class="inline-flex items-center rounded-none border border-input bg-secondary px-2.5 py-0.5 text-xs font-medium text-foreground">
                              Third Party Verified
                            </span>
                          )
                        case ComplianceLevel.SELF_ATTESTED:
                          return (
                            <span class="inline-flex items-center rounded-none border border-ring bg-secondary px-2.5 py-0.5 text-xs font-medium text-foreground">
                              Self Attested
                            </span>
                          )
                        default:
                          return (
                            <span class="inline-flex items-center rounded-none bg-secondary px-2.5 py-0.5 text-xs font-medium text-foreground">
                              {req.minimumComplianceLevel.replace(/_/g, ' ')}
                            </span>
                          )
                      }
                    })()}
                  </td>
                  <td class="whitespace-nowrap px-6 py-4 text-sm capitalize text-muted-foreground">
                    {req.verificationMethod.replace(/_/g, ' ')}
                  </td>
                  <td class="whitespace-nowrap px-6 py-4">
                    {req.isRequired ? (
                      <span class="inline-flex items-center rounded-none bg-primary px-2.5 py-0.5 text-xs font-medium text-primary-foreground">
                        Required
                      </span>
                    ) : (
                      <span class="inline-flex items-center rounded-none bg-secondary px-2.5 py-0.5 text-xs font-medium text-foreground">
                        Optional
                      </span>
                    )}
                  </td>
                  <td class="whitespace-nowrap px-6 py-4 text-sm font-medium">
                    <button
                      data-req-id={req.id}
                      class="edit-requirement mr-3 text-foreground hover:underline"
                    >
                      Edit
                    </button>
                    <button
                      data-req-id={req.id}
                      class="delete-requirement font-semibold text-foreground hover:text-foreground"
                    >
                      Delete
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <!-- Best Practices Card -->
    <div class="rounded-none bg-card p-6">
      <h2 class="mb-4 text-lg font-semibold">
        Compliance Requirement Best Practices
      </h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <h3 class="mb-2 font-medium text-foreground">
            Creating Effective Requirements
          </h3>
          <ul class="list-inside list-disc space-y-1 text-muted-foreground">
            <li>
              Focus on specific, measurable criteria that directly relate to PHI
              protection
            </li>
            <li>
              Tailor requirements based on the type of business associate and
              services provided
            </li>
            <li>
              Consider the risk level associated with the vendor's access to PHI
            </li>
            <li>
              Align requirements with recognized security frameworks (NIST,
              HITRUST, etc.)
            </li>
            <li>
              Specify clear documentation that provides evidence of compliance
            </li>
          </ul>
        </div>
        <div>
          <h3 class="mb-2 font-medium text-foreground">Verification Methods</h3>
          <ul class="list-inside list-disc space-y-1 text-muted-foreground">
            <li>
              <span class="font-medium">Self-Assessment:</span> The vendor
              completes a questionnaire about their practices
            </li>
            <li>
              <span class="font-medium">Documentation Review:</span> Evaluating
              policies, procedures, and other written evidence
            </li>
            <li>
              <span class="font-medium">Third-Party Audit:</span> Independent
              verification by qualified security assessors
            </li>
            <li>
              <span class="font-medium">Certification Validation:</span>{' '}
              Verifying industry-recognized certifications
            </li>
            <li>
              <span class="font-medium">Onsite Assessment:</span> Direct
              observation of security controls at vendor locations
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<!-- Add Requirement Modal (would use a proper component in production) -->
<div
  id="add-requirement-modal"
  class="bg-secondary0 fixed inset-0 z-50 flex hidden items-center justify-center bg-opacity-75 p-4"
>
  <div class="max-h-screen w-full max-w-3xl overflow-y-auto rounded-none bg-card p-6">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-xl font-semibold">Add New Compliance Requirement</h2>
      <button
        id="close-modal"
        class="text-muted-foreground hover:text-muted-foreground"
      >
        <svg
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>
    </div>

    <form id="requirement-form" class="space-y-4">
      <div>
        <label
          for="name"
          class="mb-1 block text-sm font-medium text-foreground"
        >
          Requirement Name*
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full rounded-none border border-input px-3 py-2 focus:border-ring focus:outline-none focus:ring-ring"
          placeholder="e.g., Security Risk Assessment"
        />
      </div>

      <div>
        <label
          for="description"
          class="mb-1 block text-sm font-medium text-foreground"
        >
          Description*
        </label>
        <textarea
          id="description"
          name="description"
          required
          rows="3"
          class="w-full rounded-none border border-input px-3 py-2 focus:border-ring focus:outline-none focus:ring-ring"
          placeholder="Describe what this requirement involves and why it's important..."
        ></textarea>
      </div>

      <div>
        <label class="mb-1 block text-sm font-medium text-foreground">
          Applicable Business Associate Types*
        </label>
        <div class="grid grid-cols-2 gap-2 md:grid-cols-3">
          {associateTypeOptions.map((option) => (
            <label class="inline-flex items-center">
              <input
                type="checkbox"
                name="applicableTypes"
                value={option.value}
                class="rounded-none border-input text-foreground focus:border-ring focus:ring focus:ring-ring focus:ring-opacity-50"
              />
              <span class="ml-2 text-sm text-foreground">{option.label}</span>
            </label>
          ))}
        </div>
      </div>

      <div>
        <label class="mb-1 block text-sm font-medium text-foreground">
          Applicable Service Categories*
        </label>
        <div class="grid grid-cols-2 gap-2">
          {serviceCategoryOptions.map((option) => (
            <label class="inline-flex items-center">
              <input
                type="checkbox"
                name="applicableCategories"
                value={option.value}
                class="rounded-none border-input text-foreground focus:border-ring focus:ring focus:ring-ring focus:ring-opacity-50"
              />
              <span class="ml-2 text-sm text-foreground">{option.label}</span>
            </label>
          ))}
        </div>
      </div>

      <div>
        <label
          for="requiredDocuments"
          class="mb-1 block text-sm font-medium text-foreground"
        >
          Required Documents*
        </label>
        <input
          type="text"
          id="requiredDocuments"
          name="requiredDocuments"
          required
          class="w-full rounded-none border border-input px-3 py-2 focus:border-ring focus:outline-none focus:ring-ring"
          placeholder="Comma-separated list of required documents (e.g., SOC 2 Report, Security Policy)"
        />
      </div>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
          <label
            for="minimumComplianceLevel"
            class="mb-1 block text-sm font-medium text-foreground"
          >
            Minimum Compliance Level*
          </label>
          <select
            id="minimumComplianceLevel"
            name="minimumComplianceLevel"
            required
            class="w-full rounded-none border border-input px-3 py-2 focus:border-ring focus:outline-none focus:ring-ring"
          >
            {complianceLevelOptions.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </div>

        <div>
          <label
            for="verificationMethod"
            class="mb-1 block text-sm font-medium text-foreground"
          >
            Verification Method*
          </label>
          <select
            id="verificationMethod"
            name="verificationMethod"
            required
            class="w-full rounded-none border border-input px-3 py-2 focus:border-ring focus:outline-none focus:ring-ring"
          >
            {verificationMethodOptions.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </div>

        <div>
          <label
            for="frequency"
            class="mb-1 block text-sm font-medium text-foreground"
          >
            Verification Frequency*
          </label>
          <select
            id="frequency"
            name="frequency"
            required
            class="w-full rounded-none border border-input px-3 py-2 focus:border-ring focus:outline-none focus:ring-ring"
          >
            {frequencyOptions.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </div>

        <div>
          <label class="mb-3 block text-sm font-medium text-foreground">
            Requirement Status*
          </label>
          <div class="flex space-x-4">
            <label class="inline-flex items-center">
              <input
                type="radio"
                name="isRequired"
                value="true"
                checked
                class="text-foreground focus:ring-ring"
              />
              <span class="ml-2 text-sm text-foreground">Required</span>
            </label>
            <label class="inline-flex items-center">
              <input
                type="radio"
                name="isRequired"
                value="false"
                class="text-foreground focus:ring-ring"
              />
              <span class="ml-2 text-sm text-foreground">Optional</span>
            </label>
          </div>
        </div>
      </div>

      <div class="flex justify-end pt-4">
        <button
          type="button"
          id="cancel-button"
          class="mr-3 inline-flex justify-center rounded-none border border-input bg-card px-4 py-2 text-sm font-medium text-foreground hover:bg-secondary focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="border-transparent inline-flex justify-center rounded-none border bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
        >
          Save Requirement
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('add-requirement-modal')
    const addButton = document.getElementById('add-requirement-btn')
    const closeButton = document.getElementById('close-modal')
    const cancelButton = document.getElementById('cancel-button')
    const requirementForm = document.getElementById('requirement-form')

    // Open modal
    addButton?.addEventListener('click', () => {
      modal?.classList.remove('hidden')
    })

    // Close modal functions
    const closeModal = () => {
      modal?.classList.add('hidden')
    }

    closeButton?.addEventListener('click', closeModal)
    cancelButton?.addEventListener('click', closeModal)

    // Close when clicking outside the modal content
    modal?.addEventListener('click', (e: any) => {
      if (e.target === modal) {
        closeModal()
      }
    })

    // Form submission
    requirementForm?.addEventListener('submit', (e: any) => {
      e.preventDefault()

      // In a real implementation, this would save the requirement via API
      alert('Requirement would be saved here with a real backend API.')

      closeModal()
      // In practice, we would show a success message and reload/update the page
      window.location.reload()
    })

    // Handle edit buttons
    const editButtons = document.querySelectorAll('.edit-requirement')
    editButtons.forEach((button) => {
      button.addEventListener('click', (e: any) => {
        const reqId = (e.target as HTMLElement).getAttribute('data-req-id')
        // In a real implementation, this would open the modal with the requirement data
        alert(
          `In a production environment, this would open the edit form for requirement ID: ${reqId}`,
        )
      })
    })

    // Handle delete buttons
    const deleteButtons = document.querySelectorAll('.delete-requirement')
    deleteButtons.forEach((button) => {
      button.addEventListener('click', (e: any) => {
        const reqId = (e.target as HTMLElement).getAttribute('data-req-id')
        if (
          reqId &&
          confirm(
            'Are you sure you want to delete this requirement? This action cannot be undone.',
          )
        ) {
          // In a real implementation, this would delete the requirement via API
          alert(`Delete requirement ${reqId}`)
          // Then reload the page
          window.location.reload()
        }
      })
    })
  })
</script>
