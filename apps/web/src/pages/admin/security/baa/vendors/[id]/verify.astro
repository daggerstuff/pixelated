---
/// <reference types="astro/client" />
import AdminLayout from '../../../../../../layouts/AdminLayout.astro'

export const prerender = false

// Types
interface Document {
  id: string
  name: string
  description?: string
  type: string
  documentUrl: string
  uploadDate: string
  expiryDate?: string
  isValid: boolean
}

interface Verification {
  complianceLevel: string
  verificationDate: string
  verificationMethod: string
  expiryDate?: string
  notes?: string
  attachments?: string[]
}

// Demo data (replace with real data fetching)
const documents: Document[] = []
const verificationHistory: Verification[] = []
---

<AdminLayout>
  <div class="mx-auto max-w-5xl py-8">
    <h1 class="mb-6 text-2xl font-bold">Vendor Document Verification</h1>

    <!-- Upload Document Form -->
    <form
      id="document-form"
      class="mb-8 rounded-none bg-card p-6"
      autocomplete="off"
    >
      <h2 class="mb-4 text-lg font-semibold">Upload Compliance Document</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <label
            for="documentDescription"
            class="mb-1 block text-sm font-medium text-foreground"
          >
            Description
          </label>
          <textarea
            id="documentDescription"
            name="documentDescription"
            rows="2"
            class="w-full rounded-none border border-input px-3 py-2 focus:border-ring focus:outline-none focus:ring-ring"
            placeholder="Brief description of the document..."
          ></textarea>
        </div>
        <div>
          <label
            for="documentExpiryDate"
            class="mb-1 block text-sm font-medium text-foreground"
          >
            Document Expiry Date
          </label>
          <input
            type="date"
            id="documentExpiryDate"
            name="documentExpiryDate"
            class="w-full rounded-none border border-input px-3 py-2 focus:border-ring focus:outline-none focus:ring-ring"
          />
        </div>
        <div class="md:col-span-2">
          <label
            for="documentFile"
            class="mb-1 block text-sm font-medium text-foreground"
          >
            Upload Document<span class="text-foreground">*</span>
          </label>
          <input
            type="file"
            id="documentFile"
            name="documentFile"
            required
            accept=".pdf,.doc,.docx,.xls,.xlsx"
            class="w-full rounded-none border border-input px-3 py-2 focus:border-ring focus:outline-none focus:ring-ring"
          />
          <p class="mt-1 text-xs text-muted-foreground">
            Accepted formats: PDF, DOC, DOCX, XLS, XLSX (max 10MB)
          </p>
        </div>
      </div>
      <div class="flex justify-end pt-4">
        <button
          type="submit"
          class="border-transparent inline-flex justify-center rounded-none border bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
        >
          Upload Document
        </button>
      </div>
    </form>

    <!-- Documents and Verification History -->
    <div class="mb-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <!-- Documents Section -->
      <div class="rounded-none bg-card p-6">
        <h2 class="mb-4 text-lg font-semibold">Compliance Documents</h2>
        {documents.length === 0 ? (
          <p class="text-muted-foreground">
            No documents have been uploaded for this vendor.
          </p>
        ) : (
          <div class="max-h-96 overflow-y-auto">
            <table class="min-w-full divide-y divide-border">
              <thead class="bg-secondary">
                <tr>
                  <th
                    scope="col"
                    class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
                  >
                    Document
                  </th>
                  <th
                    scope="col"
                    class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
                  >
                    Type
                  </th>
                  <th
                    scope="col"
                    class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
                  >
                    Uploaded
                  </th>
                  <th
                    scope="col"
                    class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
                  >
                    Status
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border bg-card">
                {documents.map((doc) => (
                  <tr>
                    <td class="whitespace-nowrap px-4 py-3 text-sm font-medium text-foreground hover:underline">
                      <a
                        href={doc.documentUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {doc.name}
                      </a>
                      {doc.description && (
                        <p class="truncate text-xs text-muted-foreground">
                          {doc.description}
                        </p>
                      )}
                    </td>
                    <td class="whitespace-nowrap px-4 py-3 text-sm capitalize text-muted-foreground">
                      {doc.type.replace(/_/g, ' ')}
                    </td>
                    <td class="whitespace-nowrap px-4 py-3 text-sm text-muted-foreground">
                      {new Date(doc.uploadDate).toLocaleDateString()}
                      {doc.expiryDate && (
                        <div class="text-xs text-muted-foreground">
                          Expires:{' '}
                          {new Date(doc.expiryDate).toLocaleDateString()}
                        </div>
                      )}
                    </td>
                    <td class="whitespace-nowrap px-4 py-3">
                      {doc.isValid ? (
                        <span class="inline-flex items-center rounded-none border border-input bg-secondary px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
                          Valid
                        </span>
                      ) : (
                        <span class="inline-flex items-center rounded-none bg-primary px-2.5 py-0.5 text-xs font-medium text-primary-foreground">
                          Invalid
                        </span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>

      <!-- Verification History Section -->
      <div class="rounded-none bg-card p-6">
        <h2 class="mb-4 text-lg font-semibold">Verification History</h2>
        {verificationHistory.length === 0 ? (
          <p class="text-muted-foreground">
            No verification history found for this vendor.
          </p>
        ) : (
          <div class="max-h-96 overflow-y-auto">
            <div class="space-y-4">
              {verificationHistory.map((verification) => (
                <div class="rounded-none border border-border p-4">
                  <div class="flex items-start justify-between">
                    <div>
                      <p class="text-sm font-medium">
                        {verification.complianceLevel
                          .replace(/_/g, ' ')
                          .replace(/\b\w/g, (char) => char.toUpperCase())}
                      </p>
                      <p class="text-xs text-muted-foreground">
                        Verified on{' '}
                        {new Date(
                          verification.verificationDate,
                        ).toLocaleDateString()}{' '}
                        via {verification.verificationMethod.replace(/_/g, ' ')}
                      </p>
                    </div>
                    {verification.expiryDate && (
                      <div class="text-right">
                        <p class="text-xs text-muted-foreground">
                          {new Date(verification.expiryDate) > new Date()
                            ? `Expires on ${new Date(verification.expiryDate).toLocaleDateString()}`
                            : `Expired on ${new Date(verification.expiryDate).toLocaleDateString()}`}
                        </p>
                      </div>
                    )}
                  </div>
                  {verification.notes && (
                    <div class="mt-2 border-t border-border pt-2 text-sm text-muted-foreground">
                      {verification.notes}
                    </div>
                  )}
                  {verification.attachments &&
                    verification.attachments.length > 0 && (
                      <div class="mt-2">
                        <p class="text-xs font-medium text-muted-foreground">
                          Attached Documents:
                        </p>
                        <ul class="mt-1 text-xs text-foreground">
                          {verification.attachments.map((docId) => {
                            const doc = documents.find((d) => d.id === docId)
                            return doc ? (
                              <li class="mr-2 inline-block">
                                <a
                                  href={doc.documentUrl}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="hover:text-foreground"
                                >
                                  {doc.name}
                                </a>
                              </li>
                            ) : null
                          })}
                        </ul>
                      </div>
                    )}
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</AdminLayout>
<script>
  // Document form submission (demo only)
  document.addEventListener('DOMContentLoaded', (_event: Event) => {
    const documentForm = document.getElementById('document-form')
    documentForm?.addEventListener('submit', (e: Event) => {
      e.preventDefault()
      alert('Document upload would be processed here with a real backend API.')
      window.location.reload()
    })
  })
</script>
>Document Expiry Date
<input
  type="date"
  id="documentExpiryDate"
  name="documentExpiryDate"
  class="w-full rounded-none border border-input px-3 py-2 focus:border-ring focus:outline-none focus:ring-ring"
/>
<div>
  <label
    for="documentFile"
    class="mb-1 block text-sm font-medium text-foreground"
  >
    Upload Document*
  </label>
  <input
    type="file"
    id="documentFile"
    name="documentFile"
    required
    class="w-full rounded-none border border-input px-3 py-2 focus:border-ring focus:outline-none focus:ring-ring"
  />
  <p class="mt-1 text-xs text-muted-foreground">
    Accepted formats: PDF, DOC, DOCX, XLS, XLSX (max 10MB)
  </p>
</div>
<div class="flex justify-end pt-4">
  <button
    type="submit"
    class="border-transparent inline-flex justify-center rounded-none border bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
  >
    Upload Document
  </button>
</div>
<!-- Documents and Verification History -->
<div class="mb-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
  <!-- Documents Section -->
  <div class="rounded-none bg-card p-6">
    <h2 class="mb-4 text-lg font-semibold">Compliance Documents</h2>

    {documents.length === 0 ? (
      <p class="text-muted-foreground">
        No documents have been uploaded for this vendor.
      </p>
    ) : (
      <div class="max-h-96 overflow-y-auto">
        <table class="min-w-full divide-y divide-border">
          <thead class="bg-secondary">
            <tr>
              <th
                scope="col"
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Document
              </th>
              <th
                scope="col"
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Type
              </th>
              <th
                scope="col"
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Uploaded
              </th>
              <th
                scope="col"
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Status
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border bg-card">
            {documents.map((doc) => (
              <tr>
                <td class="whitespace-nowrap px-4 py-3 text-sm font-medium text-foreground hover:underline">
                  <a
                    href={doc.documentUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {doc.name}
                  </a>
                  {doc.description && (
                    <p class="truncate text-xs text-muted-foreground">
                      {doc.description}
                    </p>
                  )}
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-sm capitalize text-muted-foreground">
                  {doc.type.replace(/_/g, ' ')}
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-sm text-muted-foreground">
                  {new Date(doc.uploadDate).toLocaleDateString()}
                  {doc.expiryDate && (
                    <div class="text-xs text-muted-foreground">
                      Expires: {new Date(doc.expiryDate).toLocaleDateString()}
                    </div>
                  )}
                </td>
                <td class="whitespace-nowrap px-4 py-3">
                  {doc.isValid ? (
                    <span class="inline-flex items-center rounded-none border border-input bg-secondary px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
                      Valid
                    </span>
                  ) : (
                    <span class="inline-flex items-center rounded-none bg-primary px-2.5 py-0.5 text-xs font-medium text-primary-foreground">
                      Invalid
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

  <!-- Verification History Section -->
  <div class="rounded-none bg-card p-6">
    <h2 class="mb-4 text-lg font-semibold">Verification History</h2>

    {verificationHistory.length === 0 ? (
      <p class="text-muted-foreground">
        No verification history found for this vendor.
      </p>
    ) : (
      <div class="max-h-96 overflow-y-auto">
        <div class="space-y-4">
          {verificationHistory.map((verification) => (
            <div class="rounded-none border border-border p-4">
              <div class="flex items-start justify-between">
                <div>
                  <p class="text-sm font-medium">
                    {verification.complianceLevel
                      .replace(/_/g, ' ')
                      .replace(/\b\w/g, (char) => char.toUpperCase())}
                  </p>
                  <p class="text-xs text-muted-foreground">
                    Verified on{' '}
                    {new Date(
                      verification.verificationDate,
                    ).toLocaleDateString()}
                    via {verification.verificationMethod.replace(/_/g, ' ')}
                  </p>
                </div>
                {verification.expiryDate && (
                  <div class="text-right">
                    <p class="text-xs text-muted-foreground">
                      {new Date(verification.expiryDate) > new Date()
                        ? `Expires on ${new Date(verification.expiryDate).toLocaleDateString()}`
                        : `Expired on ${new Date(verification.expiryDate).toLocaleDateString()}`}
                    </p>
                  </div>
                )}
              </div>

              {verification.notes && (
                <div class="mt-2 border-t border-border pt-2 text-sm text-muted-foreground">
                  {verification.notes}
                </div>
              )}

              {verification.attachments &&
                verification.attachments.length > 0 && (
                  <div class="mt-2">
                    <p class="text-xs font-medium text-muted-foreground">
                      Attached Documents:
                    </p>
                    <ul class="mt-1 text-xs text-foreground">
                      {verification.attachments.map((docId) => {
                        const doc = documents.find((d) => d.id === docId)
                        return doc ? (
                          <li class="mr-2 inline-block">
                            <a
                              href={doc.documentUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="hover:text-foreground"
                            >
                              {doc.name}
                            </a>
                          </li>
                        ) : null
                      })}
                    </ul>
                  </div>
                )}
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</div>
<script>
  // Document selection modal - this would be implemented with a proper modal in production
  document.addEventListener('DOMContentLoaded', () => {
    const selectDocumentsBtn = document.getElementById('select-documents-btn')
    selectDocumentsBtn?.addEventListener('click', () => {
      alert(
        'In a production environment, this would open a modal for selecting from existing documents. For this demo, please upload documents first and then reference them in your verification.',
      )
    })

    // Handle document form submission
    const documentForm = document.getElementById('document-form')
    documentForm?.addEventListener('submit', (e) => {
      e.preventDefault()
      // In a real implementation, this would upload the document via API
      alert('Document upload would be processed here with a real backend API.')
      // In practice, we would show a success message and reload/update the page
      window.location.reload()
    })

    // Handle verification form submission
    const verificationForm = document.getElementById('verification-form')
    verificationForm?.addEventListener('submit', (e) => {
      e.preventDefault()
      // In a real implementation, this would record the verification via API
      alert('Verification would be recorded here with a real backend API.')
      // In practice, we would show a success message and reload/update the page
      window.location.reload()
    })
  })
</script>
