---
import AdminLayout from '../../../../layouts/AdminLayout.astro'

// Define types for our data structures
interface RiskMetrics {
  totalVulnerabilities: number
  criticalVulnerabilities: number
  highVulnerabilities: number
  mediumVulnerabilities: number
  lowVulnerabilities: number
  complianceScore: number
  lastScanDate: Date
}

interface Finding {
  id: string
  title: string
  severity: 'critical' | 'high' | 'medium' | 'low'
  affectedSystem: string
  discoveryDate: Date
  status:
    | 'remediation-in-progress'
    | 'remediation-planned'
    | 'remediation-complete'
    | 'remediation-verified'
}

interface ScheduledScan {
  id: string
  name: string
  target: string
  frequency: string
  nextRun: Date
}

// Mock data for the risk assessment dashboard
const riskMetrics: RiskMetrics = {
  totalVulnerabilities: 42,
  criticalVulnerabilities: 3,
  highVulnerabilities: 8,
  mediumVulnerabilities: 18,
  lowVulnerabilities: 13,
  complianceScore: 92,
  lastScanDate: new Date(Date.now() - 2 * 24 * 60 * 60 * 1000), // 2 days ago
}

const recentFindings: Finding[] = [
  {
    id: 'F-2025-001',
    title: 'TLS 1.2 Configuration Weakness',
    severity: 'high',
    affectedSystem: 'API Gateway',
    discoveryDate: new Date(Date.now() - 3 * 24 * 60 * 60 * 1000),
    status: 'remediation-in-progress',
  },
  {
    id: 'F-2025-002',
    title: 'Missing HSTS Headers',
    severity: 'medium',
    affectedSystem: 'Web Application',
    discoveryDate: new Date(Date.now() - 5 * 24 * 60 * 60 * 1000),
    status: 'remediation-planned',
  },
  {
    id: 'F-2025-003',
    title: 'Outdated NPM Dependencies',
    severity: 'medium',
    affectedSystem: 'Frontend Application',
    discoveryDate: new Date(Date.now() - 7 * 24 * 60 * 60 * 1000),
    status: 'remediation-complete',
  },
  {
    id: 'F-2025-004',
    title: 'Insecure Password Policy',
    severity: 'high',
    affectedSystem: 'User Management',
    discoveryDate: new Date(Date.now() - 10 * 24 * 60 * 60 * 1000),
    status: 'remediation-verified',
  },
  {
    id: 'F-2025-005',
    title: 'Excessive Session Timeout',
    severity: 'low',
    affectedSystem: 'Authentication Service',
    discoveryDate: new Date(Date.now() - 12 * 24 * 60 * 60 * 1000),
    status: 'remediation-complete',
  },
]

const scheduledScans: ScheduledScan[] = [
  {
    id: 'SCAN-001',
    name: 'Full Infrastructure Scan',
    target: 'All Systems',
    frequency: 'Weekly',
    nextRun: new Date(Date.now() + 3 * 24 * 60 * 60 * 1000),
  },
  {
    id: 'SCAN-002',
    name: 'Patient Data Systems Scan',
    target: 'Database and Storage Services',
    frequency: 'Daily',
    nextRun: new Date(Date.now() + 6 * 60 * 60 * 1000),
  },
  {
    id: 'SCAN-003',
    name: 'HIPAA Compliance Scan',
    target: 'All PHI Systems',
    frequency: 'Bi-weekly',
    nextRun: new Date(Date.now() + 5 * 24 * 60 * 60 * 1000),
  },
]

// Helper function to format dates
function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(date)
}

// Helper function to get status badge class
function getStatusBadgeClass(status: Finding['status']): string {
  switch (status) {
    case 'remediation-in-progress':
      return 'bg-secondary border border-ring text-foreground font-medium'
    case 'remediation-planned':
      return 'bg-secondary border border-input text-muted-foreground'
    case 'remediation-complete':
      return 'bg-secondary border border-input text-muted-foreground'
    case 'remediation-verified':
      return 'bg-secondary border border-input text-foreground font-medium'
    default:
      return 'bg-secondary text-foreground'
  }
}

// Helper function to get status display text
function getStatusDisplayText(status: Finding['status']): string {
  switch (status) {
    case 'remediation-in-progress':
      return 'In Progress'
    case 'remediation-planned':
      return 'Planned'
    case 'remediation-complete':
      return 'Complete'
    case 'remediation-verified':
      return 'Verified'
    default:
      return 'Unknown'
  }
}

// Helper function to get severity badge class
function getSeverityBadgeClass(severity: Finding['severity']): string {
  switch (severity) {
    case 'critical':
      return 'bg-primary text-primary-foreground text-primary-foreground'
    case 'high':
      return 'bg-secondary border border-ring text-foreground font-medium'
    case 'medium':
      return 'bg-secondary border border-ring text-foreground font-medium'
    case 'low':
      return 'bg-secondary border border-input text-muted-foreground'
    default:
      return 'bg-secondary text-foreground'
  }
}
---

<AdminLayout
  title="Risk Assessment"
  description="Security Risk Assessment Dashboard"
>
  <div class="px-6 py-8">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-foreground">
        Security Risk Assessment
      </h1>
      <div class="flex space-x-3">
        <a
          href="#scans"
          class="rounded-none bg-primary px-4 py-2 text-primary-foreground transition-colors hover:bg-accent"
        >
          Manage Scans
        </a>
        <a
          href="#findings"
          class="rounded-none bg-primary px-4 py-2 text-primary-foreground transition-colors hover:bg-accent"
        >
          View Vulnerabilities
        </a>
        <button
          id="start-scan-btn"
          class="rounded-none bg-primary px-4 py-2 text-primary-foreground transition-colors hover:bg-accent"
        >
          Start New Scan
        </button>
      </div>
    </div>

    <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-3">
      <div class="rounded-none bg-card p-4">
        <div class="flex justify-between">
          <div>
            <h3 class="text-sm font-medium text-muted-foreground">
              Current Compliance Score
            </h3>
            <p class="text-3xl font-bold text-muted-foreground">
              {riskMetrics.complianceScore}%
            </p>
          </div>
          <div class="flex h-16 w-16 items-center justify-center rounded-none border border-input bg-secondary">
            <span class="text-2xl text-muted-foreground">✓</span>
          </div>
        </div>
        <p class="mt-2 text-xs text-muted-foreground">
          Last assessment: {formatDate(riskMetrics.lastScanDate)}
        </p>
      </div>

      <div class="rounded-none bg-card p-4">
        <h3 class="text-sm font-medium text-muted-foreground">
          Vulnerability Distribution
        </h3>
        <div class="mt-2 flex items-center">
          <div class="h-2.5 w-full rounded-none bg-secondary">
            <div class="flex h-2.5 rounded-none">
              <div
                class="bg-card0 h-2.5 rounded-l-full"
                style={`width: ${(riskMetrics.criticalVulnerabilities / riskMetrics.totalVulnerabilities) * 100}%`}
              ></div>
              <div
                class="bg-orange-500 h-2.5"
                style={`width: ${(riskMetrics.highVulnerabilities / riskMetrics.totalVulnerabilities) * 100}%`}
              ></div>
              <div
                class="bg-amber-400 h-2.5"
                style={`width: ${(riskMetrics.mediumVulnerabilities / riskMetrics.totalVulnerabilities) * 100}%`}
              ></div>
              <div
                class="bg-blue-400 h-2.5 rounded-none"
                style={`width: ${(riskMetrics.lowVulnerabilities / riskMetrics.totalVulnerabilities) * 100}%`}
              ></div>
            </div>
          </div>
        </div>
        <div class="mt-3 grid grid-cols-4 gap-2">
          <div>
            <p class="text-xs text-muted-foreground">Critical</p>
            <p class="text-lg font-semibold text-foreground">
              {riskMetrics.criticalVulnerabilities}
            </p>
          </div>
          <div>
            <p class="text-xs text-muted-foreground">High</p>
            <p class="text-lg font-medium font-semibold text-foreground">
              {riskMetrics.highVulnerabilities}
            </p>
          </div>
          <div>
            <p class="text-xs text-muted-foreground">Medium</p>
            <p class="text-lg font-medium font-semibold text-foreground">
              {riskMetrics.mediumVulnerabilities}
            </p>
          </div>
          <div>
            <p class="text-xs text-muted-foreground">Low</p>
            <p class="text-lg font-semibold text-foreground">
              {riskMetrics.lowVulnerabilities}
            </p>
          </div>
        </div>
      </div>

      <div id="scans" class="rounded-none bg-card p-4">
        <h3 class="text-sm font-medium text-muted-foreground">
          Upcoming Scheduled Scans
        </h3>
        <ul class="mt-2 space-y-2">
          {scheduledScans.map((scan) => (
            <li class="text-sm">
              <div class="flex justify-between">
                <span class="font-medium text-foreground">{scan.name}</span>
                <span class="text-xs text-muted-foreground">
                  {formatDate(scan.nextRun)}
                </span>
              </div>
              <p class="text-xs text-muted-foreground">{scan.target}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div id="findings" class="mb-6 rounded-none bg-card p-6">
      <h2 class="mb-4 text-lg font-semibold">Recent Security Findings</h2>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-border">
          <thead class="bg-secondary">
            <tr>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Finding ID
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Title
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Severity
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Affected System
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Discovery Date
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Status
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border bg-card">
            {recentFindings.map((finding) => (
              <tr>
                <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-foreground">
                  {finding.id}
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-muted-foreground">
                  {finding.title}
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <span
                    class={`inline-flex items-center rounded-none px-2.5 py-0.5 text-xs font-medium ${getSeverityBadgeClass(finding.severity)}`}
                  >
                    {finding.severity.charAt(0).toUpperCase() +
                      finding.severity.slice(1)}
                  </span>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-muted-foreground">
                  {finding.affectedSystem}
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-muted-foreground">
                  {formatDate(finding.discoveryDate)}
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <span
                    class={`inline-flex items-center rounded-none px-2.5 py-0.5 text-xs font-medium ${getStatusBadgeClass(finding.status)}`}
                  >
                    {getStatusDisplayText(finding.status)}
                  </span>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm font-medium">
                  <a
                    href="#findings"
                    class="mr-3 text-foreground hover:text-foreground"
                  >
                    View Details
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-4 text-right">
        <a
          href="#findings"
          class="text-sm font-medium text-foreground hover:text-foreground"
        >
          View All Findings
        </a>
      </div>
    </div>

    <div class="mb-6 rounded-none bg-card p-6">
      <h2 class="mb-4 text-lg font-semibold">HIPAA Compliance Status</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <div>
          <h3 class="mb-2 font-medium text-foreground">Technical Safeguards</h3>
          <div class="mb-4 flex items-center">
            <div class="mr-2 h-2.5 w-full rounded-none bg-secondary">
              <div
                class="h-2.5 rounded-none bg-primary"
                style="width: 95%"
              ></div>
            </div>
            <span class="text-sm font-medium text-foreground">95%</span>
          </div>
          <ul class="space-y-1 text-sm">
            <li class="flex items-center text-muted-foreground">
              <span class="mr-2">✓</span>
              <span>Access Controls</span>
            </li>
            <li class="flex items-center text-muted-foreground">
              <span class="mr-2">✓</span>
              <span>Audit Controls</span>
            </li>
            <li class="flex items-center text-muted-foreground">
              <span class="mr-2">✓</span>
              <span>Integrity Controls</span>
            </li>
            <li class="flex items-center font-medium text-foreground">
              <span class="mr-2">⚠</span>
              <span>Transmission Security</span>
            </li>
          </ul>
        </div>
        <div>
          <h3 class="mb-2 font-medium text-foreground">
            Administrative Safeguards
          </h3>
          <div class="mb-4 flex items-center">
            <div class="mr-2 h-2.5 w-full rounded-none bg-secondary">
              <div
                class="h-2.5 rounded-none bg-primary"
                style="width: 90%"
              ></div>
            </div>
            <span class="text-sm font-medium text-foreground">90%</span>
          </div>
          <ul class="space-y-1 text-sm">
            <li class="flex items-center text-muted-foreground">
              <span class="mr-2">✓</span>
              <span>Risk Analysis</span>
            </li>
            <li class="flex items-center text-muted-foreground">
              <span class="mr-2">✓</span>
              <span>Risk Management</span>
            </li>
            <li class="flex items-center text-muted-foreground">
              <span class="mr-2">✓</span>
              <span>Sanction Policy</span>
            </li>
            <li class="flex items-center font-medium text-foreground">
              <span class="mr-2">⚠</span>
              <span>Training Updates</span>
            </li>
          </ul>
        </div>
        <div>
          <h3 class="mb-2 font-medium text-foreground">Physical Safeguards</h3>
          <div class="mb-4 flex items-center">
            <div class="mr-2 h-2.5 w-full rounded-none bg-secondary">
              <div
                class="h-2.5 rounded-none bg-primary"
                style="width: 88%"
              ></div>
            </div>
            <span class="text-sm font-medium text-foreground">88%</span>
          </div>
          <ul class="space-y-1 text-sm">
            <li class="flex items-center text-muted-foreground">
              <span class="mr-2">✓</span>
              <span>Facility Access</span>
            </li>
            <li class="flex items-center text-muted-foreground">
              <span class="mr-2">✓</span>
              <span>Workstation Use</span>
            </li>
            <li class="flex items-center text-muted-foreground">
              <span class="mr-2">✓</span>
              <span>Device Security</span>
            </li>
            <li class="flex items-center font-medium text-foreground">
              <span class="mr-2">⚠</span>
              <span>Media Disposal</span>
            </li>
          </ul>
        </div>
      </div>
      <div class="mt-4 text-right">
        <a
          href="/admin/security-dashboard"
          class="text-sm font-medium text-foreground hover:text-foreground"
        >
          View Detailed Compliance Report
        </a>
      </div>
    </div>
  </div>
</AdminLayout>

