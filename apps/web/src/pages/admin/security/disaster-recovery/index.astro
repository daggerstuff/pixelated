---
import AdminLayout from '../../../../layouts/AdminLayout.astro'

// Mock data for the disaster recovery dashboard
const recoveryMetrics = {
  totalRecoveryPlans: 8,
  testedPlans: 6,
  averageRecoveryTime: 45, // minutes
  successfulTests: 18,
  failedTests: 2,
  lastTestDate: new Date(Date.now() - 7 * 24 * 60 * 60 * 1000), // 7 days ago
}

const recoveryPlans = [
  {
    id: 'DR-001',
    name: 'Database Failure Recovery',
    systems: ['Patient Database', 'Analytics Database'],
    rto: 30, // minutes
    rpo: 15, // minutes
    lastTested: new Date(Date.now() - 14 * 24 * 60 * 60 * 1000),
    status: 'verified',
  },
  {
    id: 'DR-002',
    name: 'API Service Recovery',
    systems: ['Authentication API', 'Data Access API'],
    rto: 15, // minutes
    rpo: 5, // minutes
    lastTested: new Date(Date.now() - 30 * 24 * 60 * 60 * 1000),
    status: 'needs-testing',
  },
  {
    id: 'DR-003',
    name: 'Web Application Recovery',
    systems: ['Admin Portal', 'Patient Portal'],
    rto: 60, // minutes
    rpo: 30, // minutes
    lastTested: new Date(Date.now() - 21 * 24 * 60 * 60 * 1000),
    status: 'verified',
  },
  {
    id: 'DR-004',
    name: 'Ransomware Response',
    systems: ['All Systems'],
    rto: 120, // minutes
    rpo: 30, // minutes
    lastTested: new Date(Date.now() - 45 * 24 * 60 * 60 * 1000),
    status: 'needs-update',
  },
  {
    id: 'DR-005',
    name: 'Data Center Outage',
    systems: ['All Systems'],
    rto: 240, // minutes
    rpo: 60, // minutes
    lastTested: new Date(Date.now() - 60 * 24 * 60 * 60 * 1000),
    status: 'needs-testing',
  },
]

const scheduledTests = [
  {
    id: 'TEST-001',
    plan: 'Database Failure Recovery',
    scheduledDate: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000),
    type: 'Automated',
    duration: '45 minutes',
  },
  {
    id: 'TEST-002',
    plan: 'API Service Recovery',
    scheduledDate: new Date(Date.now() + 3 * 24 * 60 * 60 * 1000),
    type: 'Automated',
    duration: '30 minutes',
  },
  {
    id: 'TEST-003',
    plan: 'Ransomware Response',
    scheduledDate: new Date(Date.now() + 14 * 24 * 60 * 60 * 1000),
    type: 'Tabletop Exercise',
    duration: '2 hours',
  },
]

// Helper function to format dates
function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(date)
}

// Helper function to get status badge class
function getStatusBadgeClass(
  status: 'verified' | 'needs-testing' | 'needs-update' | 'in-development',
): string {
  switch (status) {
    case 'verified':
      return 'bg-secondary border border-input text-muted-foreground'
    case 'needs-testing':
      return 'bg-secondary border border-ring text-foreground font-semibold'
    case 'needs-update':
      return 'bg-primary text-primary-foreground font-semibold'
    case 'in-development':
      return 'bg-secondary border border-input text-muted-foreground'
    default:
      return 'bg-secondary text-foreground'
  }
}

// Helper function to get status display text
function getStatusDisplayText(
  status: 'verified' | 'needs-testing' | 'needs-update' | 'in-development',
): string {
  switch (status) {
    case 'verified':
      return 'Verified'
    case 'needs-testing':
      return 'Needs Testing'
    case 'needs-update':
      return 'Needs Update'
    case 'in-development':
      return 'In Development'
    default:
      return 'Unknown'
  }
}
---

<AdminLayout
  title="Disaster Recovery"
  description="Disaster Recovery and Business Continuity Planning"
>
  <div class="px-6 py-8">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-foreground">
        Disaster Recovery Management
      </h1>
      <div class="flex space-x-3">
        <a
          href="#plans"
          class="rounded-none bg-primary px-4 py-2 text-primary-foreground transition-colors hover:bg-accent"
        >
          Recovery Plans
        </a>
        <a
          href="#results"
          class="rounded-none bg-primary px-4 py-2 text-primary-foreground transition-colors hover:bg-accent"
        >
          Test Results
        </a>
        <button
          id="run-test-btn"
          class="rounded-none bg-primary px-4 py-2 text-primary-foreground transition-colors hover:bg-accent"
        >
          Run Test
        </button>
      </div>
    </div>

    <!-- Recovery Metrics Cards -->
    <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-none bg-card p-4">
        <h3 class="text-sm font-medium text-muted-foreground">
          Recovery Plans
        </h3>
        <p class="text-2xl font-bold text-foreground">
          {recoveryMetrics.totalRecoveryPlans}
        </p>
        <p class="mt-1 text-xs text-muted-foreground">
          {recoveryMetrics.testedPlans} tested in last 90 days
        </p>
      </div>
      <div class="rounded-none bg-card p-4">
        <h3 class="text-sm font-medium text-muted-foreground">
          Avg Recovery Time
        </h3>
        <p class="text-2xl font-bold text-foreground">
          {recoveryMetrics.averageRecoveryTime} min
        </p>
        <p class="mt-1 text-xs text-muted-foreground">Target: 60 minutes</p>
      </div>
      <div class="rounded-none bg-card p-4">
        <h3 class="text-sm font-medium text-muted-foreground">
          Test Success Rate
        </h3>
        <p class="text-2xl font-bold text-muted-foreground">
          {Math.round(
            (recoveryMetrics.successfulTests /
              (recoveryMetrics.successfulTests + recoveryMetrics.failedTests)) *
              100,
          )}
          %
        </p>
        <p class="mt-1 text-xs text-muted-foreground">
          {recoveryMetrics.successfulTests} of{' '}
          {recoveryMetrics.successfulTests + recoveryMetrics.failedTests} tests
          passed
        </p>
      </div>
      <div class="rounded-none bg-card p-4">
        <h3 class="text-sm font-medium text-muted-foreground">
          Last Test Conducted
        </h3>
        <p class="text-2xl font-bold text-foreground">
          {formatDate(recoveryMetrics.lastTestDate)}
        </p>
        <p class="mt-1 text-xs text-muted-foreground">
          Database Recovery Simulation
        </p>
      </div>
    </div>

    <!-- Recovery Plans Table -->
    <div id="plans" class="mb-6 rounded-none bg-card p-6">
      <h2 class="mb-4 text-lg font-semibold">Disaster Recovery Plans</h2>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-border">
          <thead class="bg-secondary">
            <tr>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Plan ID
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Recovery Plan
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Systems
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                RTO
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                RPO
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Last Tested
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Status
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border bg-card">
            {recoveryPlans.map((plan) => (
              <tr>
                <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-foreground">
                  {plan.id}
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-muted-foreground">
                  {plan.name}
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-muted-foreground">
                  <div class="flex flex-wrap gap-1">
                    {plan.systems.map((system) => (
                      <span class="inline-flex items-center rounded-none bg-secondary px-2 py-0.5 text-xs font-medium text-foreground">
                        {system}
                      </span>
                    ))}
                  </div>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-muted-foreground">
                  {plan.rto} min
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-muted-foreground">
                  {plan.rpo} min
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-muted-foreground">
                  {formatDate(plan.lastTested)}
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <span
                    class={`inline-flex items-center rounded-none px-2.5 py-0.5 text-xs font-medium ${getStatusBadgeClass(plan.status as any)}`}
                  >
                    {getStatusDisplayText(plan.status as any)}
                  </span>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm font-medium">
                  <a href="#plans" class="mr-3 text-foreground hover:underline">
                    View
                  </a>
                  <button
                    data-plan-id={plan.id}
                    class="test-plan mr-3 text-muted-foreground hover:text-muted-foreground"
                  >
                    Test
                  </button>
                  <button
                    data-plan-id={plan.id}
                    class="edit-plan font-medium font-semibold text-foreground hover:text-foreground"
                  >
                    Edit
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-4 text-right">
        <a
          href="#plans"
          class="text-sm font-medium text-foreground hover:underline"
        >
          View All Recovery Plans
        </a>
      </div>
    </div>

    <!-- Scheduled Tests and Business Continuity -->
    <div class="mb-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <div id="tests" class="rounded-none bg-card p-6">
        <h2 class="mb-4 text-lg font-semibold">Upcoming Recovery Tests</h2>
        {scheduledTests.length === 0 ? (
          <p class="py-4 text-center text-muted-foreground">
            No scheduled tests found.
          </p>
        ) : (
          <ul class="divide-y divide-border">
            {scheduledTests.map((test) => (
              <li class="py-4">
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="text-sm font-medium text-foreground">
                      {test.plan}
                    </h3>
                    <p class="text-xs text-muted-foreground">
                      Type: {test.type} | Duration: {test.duration}
                    </p>
                  </div>
                  <div class="text-right">
                    <p class="text-sm font-medium text-foreground">
                      {formatDate(test.scheduledDate)}
                    </p>
                    <div class="mt-1">
                      <button
                        data-test-id={test.id}
                        class="text-xs text-foreground hover:underline"
                      >
                        View Details
                      </button>
                    </div>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        )}
        <div class="mt-4">
          <button
            id="schedule-test-btn"
            class="w-full rounded-none bg-secondary px-4 py-2 text-sm text-foreground transition-colors hover:bg-secondary"
          >
            Schedule New Test
          </button>
        </div>
      </div>

      <div id="bcp" class="rounded-none bg-card p-6">
        <h2 class="mb-4 text-lg font-semibold">Business Continuity Planning</h2>
        <div class="space-y-4">
          <div class="rounded-none bg-secondary p-4">
            <h3 class="mb-2 text-sm font-medium text-foreground">
              Critical Business Functions
            </h3>
            <div class="space-y-2">
              <div class="flex items-center">
                <div class="w-32 text-xs text-muted-foreground">
                  Patient Data Access
                </div>
                <div class="h-2 w-full rounded-none bg-secondary">
                  <div
                    class="h-2 rounded-none bg-primary"
                    style="width: 95%"
                  ></div>
                </div>
                <div class="w-12 text-right text-xs font-medium text-foreground">
                  95%
                </div>
              </div>
              <div class="flex items-center">
                <div class="w-32 text-xs text-muted-foreground">
                  Authentication
                </div>
                <div class="h-2 w-full rounded-none bg-secondary">
                  <div
                    class="h-2 rounded-none bg-primary"
                    style="width: 100%"
                  ></div>
                </div>
                <div class="w-12 text-right text-xs font-medium text-foreground">
                  100%
                </div>
              </div>
              <div class="flex items-center">
                <div class="w-32 text-xs text-muted-foreground">Analytics</div>
                <div class="h-2 w-full rounded-none bg-secondary">
                  <div
                    class="h-2 rounded-none bg-primary"
                    style="width: 80%"
                  ></div>
                </div>
                <div class="w-12 text-right text-xs font-medium text-foreground">
                  80%
                </div>
              </div>
              <div class="flex items-center">
                <div class="w-32 text-xs text-muted-foreground">Reporting</div>
                <div class="h-2 w-full rounded-none bg-secondary">
                  <div
                    class="h-2 rounded-none bg-primary"
                    style="width: 75%"
                  ></div>
                </div>
                <div class="w-12 text-right text-xs font-medium text-foreground">
                  75%
                </div>
              </div>
            </div>
          </div>

          <div class="space-y-2">
            <h3 class="text-sm font-medium text-foreground">
              BCP Documentation
            </h3>
            <ul class="space-y-2">
              <li class="flex items-center justify-between text-sm">
                <span>Business Impact Analysis</span>
                <a href="#bcp" class="text-foreground hover:underline">
                  View
                </a>
              </li>
              <li class="flex items-center justify-between text-sm">
                <span>Recovery Strategies</span>
                <a href="#bcp" class="text-foreground hover:underline">
                  View
                </a>
              </li>
              <li class="flex items-center justify-between text-sm">
                <span>Communication Plan</span>
                <a href="#bcp" class="text-foreground hover:underline">
                  View
                </a>
              </li>
              <li class="flex items-center justify-between text-sm">
                <span>Training Materials</span>
                <a href="#bcp" class="text-foreground hover:underline">
                  View
                </a>
              </li>
            </ul>
          </div>

          <div class="mt-4">
            <a
              href="/admin/backup-security"
              class="block w-full rounded-none bg-secondary px-4 py-2 text-center text-sm text-foreground transition-colors hover:bg-accent"
            >
              Manage Backup & Continuity Settings
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Testing History -->
    <div id="results" class="rounded-none bg-card p-6">
      <h2 class="mb-4 text-lg font-semibold">Recent Test Results</h2>
      <div class="overflow-hidden">
        <div class="mb-4 flex items-center rounded-none border border-border bg-secondary p-4">
          <div class="mr-4 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-none border border-input bg-secondary">
            <span class="text-lg text-muted-foreground">✓</span>
          </div>
          <div>
            <h3 class="text-sm font-medium text-foreground">
              Database Recovery Test
            </h3>
            <p class="text-xs text-muted-foreground">
              Successfully completed on{' '}
              {formatDate(new Date(Date.now() - 7 * 24 * 60 * 60 * 1000))}
            </p>
          </div>
          <div class="ml-auto text-right">
            <span class="inline-flex items-center rounded-none border border-input bg-secondary px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
              Success
            </span>
            <p class="mt-1 text-xs text-muted-foreground">
              Recovery time: 28 minutes
            </p>
          </div>
        </div>

        <div class="mb-4 flex items-center rounded-none border border-border bg-card p-4">
          <div class="mr-4 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-none bg-primary">
            <span class="text-lg font-semibold text-foreground">×</span>
          </div>
          <div>
            <h3 class="text-sm font-medium text-foreground">
              Ransomware Recovery Test
            </h3>
            <p class="text-xs text-muted-foreground">
              Failed on{' '}
              {formatDate(new Date(Date.now() - 21 * 24 * 60 * 60 * 1000))}
            </p>
          </div>
          <div class="ml-auto text-right">
            <span class="inline-flex items-center rounded-none bg-primary px-2.5 py-0.5 text-xs font-medium font-semibold text-primary-foreground">
              Failed
            </span>
            <p class="mt-1 text-xs text-muted-foreground">
              Issue: Incomplete data recovery
            </p>
          </div>
        </div>

        <div class="flex items-center rounded-none border border-border bg-secondary p-4">
          <div class="mr-4 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-none border border-input bg-secondary">
            <span class="text-lg text-muted-foreground">✓</span>
          </div>
          <div>
            <h3 class="text-sm font-medium text-foreground">
              API Service Recovery Test
            </h3>
            <p class="text-xs text-muted-foreground">
              Successfully completed on{' '}
              {formatDate(new Date(Date.now() - 30 * 24 * 60 * 60 * 1000))}
            </p>
          </div>
          <div class="ml-auto text-right">
            <span class="inline-flex items-center rounded-none border border-input bg-secondary px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
              Success
            </span>
            <p class="mt-1 text-xs text-muted-foreground">
              Recovery time: 12 minutes
            </p>
          </div>
        </div>
      </div>

      <div class="mt-4 text-right">
        <a
          href="#results"
          class="text-sm font-medium text-foreground hover:underline"
        >
          View All Test Results
        </a>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Handle "Run Test" button
    const runTestBtn = document.getElementById('run-test-btn')
    runTestBtn?.addEventListener('click', () => {
      alert(
        'In a production environment, this would open the test configuration dialog.',
      )
    })

    // Handle "Schedule Test" button
    const scheduleTestBtn = document.getElementById('schedule-test-btn')
    scheduleTestBtn?.addEventListener('click', () => {
      alert('Test scheduling is enabled on staging/production environments.')
    })

    // Handle "Test Plan" buttons
    const testPlanBtns = document.querySelectorAll('.test-plan')
    testPlanBtns.forEach((button) => {
      button.addEventListener('click', (e: any) => {
        const planId = (e.target as HTMLElement).getAttribute('data-plan-id')
        alert(`Disaster recovery test simulation triggered for ${planId}`)
      })
    })

    // Handle "Edit Plan" buttons
    const editPlanBtns = document.querySelectorAll('.edit-plan')
    editPlanBtns.forEach((button) => {
      button.addEventListener('click', (e: any) => {
        const planId = (e.target as HTMLElement).getAttribute('data-plan-id')
        alert(`Editing plan parameters for ${planId}`)
      })
    })

    // Handle test detail buttons
    const testDetailBtns = document.querySelectorAll('[data-test-id]')
    testDetailBtns.forEach((button) => {
      button.addEventListener('click', (e: any) => {
        const testId = (e.target as HTMLElement).getAttribute('data-test-id')
        alert(`Details for test execution ${testId}`)
      })
    })
  })
</script>
