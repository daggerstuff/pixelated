---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { getConsentExpiryService } from '@/lib/consent'
import type { ExpiryCheckResult } from '@/lib/consent'
import { initializeDatabase } from '@/lib/db'
import { consentManagementService } from '@/lib/research/services/ConsentManagementService'
import type {
  ConsentAuditLog,
  ConsentStatistics,
} from '@/lib/research/services/ConsentManagementService'
import type { ConsentRecord } from '@/lib/research/types/research-types'

// Ensure DB pool exists even if app.astro startup was skipped (e.g. SSR guard failed)
try {
  initializeDatabase()
} catch {
  // In environments without DB config (e.g. preview), continue with empty state
}

// Fetch data server-side — degrade gracefully if DB is unavailable
let statistics: ConsentStatistics
let auditTrail: ConsentAuditLog[]
let expiryResult: ExpiryCheckResult
try {
  statistics = await consentManagementService.getConsentStatistics()
  auditTrail = await consentManagementService.getAuditTrail()
  const expiryService = getConsentExpiryService()
  expiryResult = await expiryService.checkExpiries()
} catch {
  statistics = {
    totalClients: 0,
    activeConsents: 0,
    consentLevels: { none: 0, minimal: 0, limited: 0, full: 0 },
    withdrawalRequests: 0,
    expiredConsents: 0,
  }
  auditTrail = []
  expiryResult = {
    checkedAt: new Date().toISOString(),
    totalChecked: 0,
    reminders: [],
    summary: { expiringSoon: 0, expiringCritical: 0, expired: 0 },
  }
}

// Get all consent records — resilient to per-record DB failures
const clientIds = new Set(auditTrail.map((entry) => entry.clientId))
const records: ConsentRecord[] = []
for (const id of clientIds) {
  try {
    const record = await consentManagementService.getConsentRecord(id)
    if (record) records.push(record)
  } catch {
    // Skip records that fail to load; page still renders
  }
}
---

<DashboardLayout
  title="Consent Management"
  description="HIPAA-compliant consent record management with audit trail and automated expiry checks"
>
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight">Consent Management</h1>
        <p class="mt-1 text-sm text-muted-foreground">
          HIPAA-compliant consent CRUD with automated expiry checks and audit
          trail
        </p>
      </div>
      <div class="flex gap-2">
        <a
          href="/admin/consent"
          class="rounded-none border px-3 py-2 text-sm hover:bg-accent"
        >
          MongoDB Dashboard
        </a>
        <a
          href="/admin"
          class="rounded-none border px-3 py-2 text-sm hover:bg-accent"
        >
          Admin Home
        </a>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-none border p-4">
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium">Total Clients</span>
          <span class="rounded-none border border-input bg-secondary px-2 py-1 text-xs font-medium text-foreground">
            CRUD
          </span>
        </div>
        <p class="mt-2 text-2xl font-bold" id="stat-total">
          {statistics.totalClients}
        </p>
      </div>
      <div class="rounded-none border p-4">
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium">Active Consents</span>
          <span class="rounded-none border border-input bg-secondary px-2 py-1 text-xs text-muted-foreground">
            Active
          </span>
        </div>
        <p
          class="mt-2 text-2xl font-bold text-muted-foreground"
          id="stat-active"
        >
          {statistics.activeConsents}
        </p>
      </div>
      <div class="rounded-none border p-4">
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium">Withdrawals</span>
          <span class="rounded-none border border-ring bg-secondary px-2 py-1 text-xs font-medium text-foreground">
            Pending
          </span>
        </div>
        <p
          class="mt-2 text-2xl font-bold font-medium text-foreground"
          id="stat-withdrawals"
        >
          {statistics.withdrawalRequests}
        </p>
      </div>
      <div class="rounded-none border p-4">
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium">Expired Consents</span>
          <span class="rounded-none bg-primary px-2 py-1 text-xs font-semibold text-foreground text-primary-foreground">
            Alert
          </span>
        </div>
        <p
          class="mt-2 text-2xl font-bold font-semibold text-foreground"
          id="stat-expired"
        >
          {statistics.expiredConsents}
        </p>
      </div>
    </div>

    <!-- Consent Levels Breakdown -->
    <div class="rounded-none border p-4">
      <h2 class="mb-3 text-lg font-semibold">Consent Level Distribution</h2>
      <div class="space-y-2">
        {Object.entries(statistics.consentLevels).map(([level, count]) => (
          <div class="flex items-center justify-between">
            <span class="text-sm capitalize">{level}</span>
            <div class="flex items-center gap-2">
              <div class="h-2 w-32 overflow-hidden rounded-none bg-secondary">
                <div
                  class="h-full rounded-none"
                  style={`width: ${statistics.activeConsents > 0 ? Math.round((count / statistics.activeConsents) * 100) : 0}%`}
                  class:list={[
                    level === 'full' ? 'bg-primary' : '',
                    level === 'limited' ? 'bg-primary' : '',
                    level === 'minimal' ? 'bg-primary' : '',
                    level === 'none' ? 'border border-input bg-secondary' : '',
                  ]}
                />
              </div>
              <span class="w-8 text-sm font-medium">{count}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Expiry Check Results -->
    <div class="rounded-none border p-4">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-lg font-semibold">Automated Expiry Check</h2>
        <span class="text-xs text-muted-foreground">
          Checked: {new Date(expiryResult.checkedAt).toLocaleString()}
        </span>
      </div>

      <div class="mb-4 grid gap-3 md:grid-cols-3">
        <div class="rounded-none border border-ring bg-secondary p-3 text-center">
          <p class="text-2xl font-bold font-medium text-foreground">
            {expiryResult.summary.expiringSoon}
          </p>
          <p class="text-xs text-muted-foreground">Expiring Soon (≤30d)</p>
        </div>
        <div class="rounded-none border border-ring bg-secondary p-3 text-center">
          <p class="text-2xl font-bold font-medium text-foreground">
            {expiryResult.summary.expiringCritical}
          </p>
          <p class="text-xs text-muted-foreground">Expiring Critical (≤7d)</p>
        </div>
        <div class="rounded-none border border-ring bg-card p-3 text-center">
          <p class="text-2xl font-bold font-semibold text-foreground">
            {expiryResult.summary.expired}
          </p>
          <p class="text-xs text-muted-foreground">
            Expired (re-consent required)
          </p>
        </div>
      </div>

      {expiryResult.reminders.length > 0 && (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b">
                <th class="px-3 py-2 text-left">Client ID</th>
                <th class="px-3 py-2 text-left">Level</th>
                <th class="px-3 py-2 text-left">Expires</th>
                <th class="px-3 py-2 text-left">Days</th>
                <th class="px-3 py-2 text-left">Status</th>
                <th class="px-3 py-2 text-left">Message</th>
              </tr>
            </thead>
            <tbody>
              {expiryResult.reminders.map((reminder) => (
                <tr class="border-b hover:bg-secondary">
                  <td class="px-3 py-2 font-mono text-xs">
                    {reminder.clientId}
                  </td>
                  <td class="px-3 py-2 capitalize">{reminder.consentLevel}</td>
                  <td class="px-3 py-2">
                    {new Date(reminder.expirationDate).toLocaleDateString()}
                  </td>
                  <td class="px-3 py-2">{reminder.daysUntilExpiry}</td>
                  <td class="px-3 py-2">
                    <span
                      class:list={[
                        'rounded-none px-2 py-1 text-xs font-medium',
                        reminder.reminderType === 'expired'
                          ? 'bg-primary font-semibold text-foreground text-primary-foreground'
                          : '',
                        reminder.reminderType === 'expiring-critical'
                          ? 'border border-ring bg-secondary font-medium text-foreground'
                          : '',
                        reminder.reminderType === 'expiring-soon'
                          ? 'border border-ring bg-secondary font-medium text-foreground'
                          : '',
                      ]}
                    >
                      {reminder.reminderType}
                    </span>
                  </td>
                  <td class="px-3 py-2 text-xs text-muted-foreground">
                    {reminder.message}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {expiryResult.reminders.length === 0 && (
        <p class="py-4 text-center text-muted-foreground">
          No expiring or expired consents. All consent records are current.
        </p>
      )}
    </div>

    <!-- Initialize New Consent -->
    <div class="rounded-none border p-4">
      <h2 class="mb-3 text-lg font-semibold">Initialize New Consent</h2>
      <div class="flex flex-wrap items-end gap-3">
        <div>
          <label class="mb-1 block text-sm font-medium">Client ID</label>
          <input
            type="text"
            id="new-client-id"
            placeholder="client-123"
            class="w-48 rounded-none border px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium">Consent Level</label>
          <select
            id="new-consent-level"
            class="rounded-none border px-3 py-2 text-sm"
          >
            <option value="minimal">Minimal</option>
            <option value="limited">Limited</option>
            <option value="full">Full</option>
          </select>
        </div>
        <button
          id="init-consent-btn"
          class="rounded-none bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-accent"
        >
          Initialize Consent
        </button>
      </div>
    </div>

    <!-- Consent Records Table -->
    <div class="rounded-none border p-4">
      <h2 class="mb-3 text-lg font-semibold">
        Consent Records ({records.length})
      </h2>
      {records.length > 0 ? (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b">
                <th class="px-3 py-2 text-left">Client ID</th>
                <th class="px-3 py-2 text-left">Level</th>
                <th class="px-3 py-2 text-left">Last Updated</th>
                <th class="px-3 py-2 text-left">Expires</th>
                <th class="px-3 py-2 text-left">Withdrawal</th>
                <th class="px-3 py-2 text-left">Actions</th>
              </tr>
            </thead>
            <tbody>
              {records.map((record) => (
                <tr class="border-b hover:bg-secondary">
                  <td class="px-3 py-2 font-mono text-xs">{record.clientId}</td>
                  <td class="px-3 py-2 capitalize">{record.currentLevel}</td>
                  <td class="px-3 py-2 text-xs">
                    {new Date(record.lastUpdated).toLocaleDateString()}
                  </td>
                  <td class="px-3 py-2 text-xs">
                    {new Date(record.expirationDate).toLocaleDateString()}
                  </td>
                  <td class="px-3 py-2">
                    {record.withdrawalRequested ? (
                      <span class="rounded-none bg-primary px-2 py-1 text-xs font-semibold text-foreground text-primary-foreground">
                        Requested
                      </span>
                    ) : (
                      <span class="rounded-none border border-input bg-secondary px-2 py-1 text-xs text-muted-foreground">
                        Active
                      </span>
                    )}
                  </td>
                  <td class="px-3 py-2">
                    <div class="flex gap-1">
                      <button
                        class="rounded-none border px-2 py-1 text-xs hover:bg-accent"
                        data-action="update"
                        data-client-id={record.clientId}
                      >
                        Update
                      </button>
                      <button
                        class="rounded-none border px-2 py-1 text-xs font-semibold text-foreground hover:bg-card"
                        data-action="withdraw"
                        data-client-id={record.clientId}
                      >
                        Withdraw
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="py-4 text-center text-muted-foreground">
          No consent records. Initialize a new consent above.
        </p>
      )}
    </div>

    <!-- Audit Trail -->
    <div class="rounded-none border p-4">
      <h2 class="mb-3 text-lg font-semibold">
        HIPAA Audit Trail ({auditTrail.length} entries)
      </h2>
      {auditTrail.length > 0 ? (
        <div class="max-h-96 overflow-x-auto overflow-y-auto">
          <table class="w-full text-sm">
            <thead class="sticky top-0 bg-card">
              <tr class="border-b">
                <th class="px-3 py-2 text-left">Timestamp</th>
                <th class="px-3 py-2 text-left">Client ID</th>
                <th class="px-3 py-2 text-left">Operation</th>
                <th class="px-3 py-2 text-left">Old Level</th>
                <th class="px-3 py-2 text-left">New Level</th>
                <th class="px-3 py-2 text-left">Reason</th>
              </tr>
            </thead>
            <tbody>
              {auditTrail
                .slice()
                .reverse()
                .slice(0, 100)
                .map((entry) => (
                  <tr class="border-b hover:bg-secondary">
                    <td class="px-3 py-1 text-xs text-muted-foreground">
                      {new Date(entry.timestamp).toLocaleString()}
                    </td>
                    <td class="px-3 py-1 font-mono text-xs">
                      {entry.clientId}
                    </td>
                    <td class="px-3 py-1">
                      <span class="rounded-none bg-secondary px-2 py-1 text-xs">
                        {entry.operation}
                      </span>
                    </td>
                    <td class="px-3 py-1 text-xs capitalize">
                      {entry.oldLevel ?? '-'}
                    </td>
                    <td class="px-3 py-1 text-xs capitalize">
                      {entry.newLevel ?? '-'}
                    </td>
                    <td class="px-3 py-1 text-xs text-muted-foreground">
                      {entry.reason ?? '-'}
                    </td>
                  </tr>
                ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="py-4 text-center text-muted-foreground">
          No audit trail entries. Consent operations will appear here.
        </p>
      )}
    </div>

    <!-- API Documentation -->
    <div class="rounded-none border p-4">
      <h2 class="mb-3 text-lg font-semibold">API Endpoints</h2>
      <div class="space-y-2 font-mono text-sm">
        <div>
          <span class="font-bold text-muted-foreground">GET</span>{' '}
          /api/v1/admin/consent — List all records + stats
        </div>
        <div>
          <span class="font-bold text-muted-foreground">GET</span>{' '}
          /api/v1/admin/consent?clientId=X — Get one record
        </div>
        <div>
          <span class="font-bold text-foreground">POST</span>{' '}
          /api/v1/admin/consent — Initialize consent
        </div>
        <div>
          <span class="font-bold text-muted-foreground">GET</span>{' '}
          /api/v1/admin/consent/:clientId — Get specific record
        </div>
        <div>
          <span class="font-bold font-medium text-foreground">PATCH</span>{' '}
          /api/v1/admin/consent/:clientId — Update consent level
        </div>
        <div>
          <span class="font-bold font-semibold text-foreground">DELETE</span>{' '}
          /api/v1/admin/consent/:clientId — Request withdrawal
        </div>
        <div>
          <span class="font-bold text-foreground">POST</span>{' '}
          /api/v1/admin/consent/:clientId/complete-withdrawal — Complete
          withdrawal
        </div>
        <div>
          <span class="font-bold text-muted-foreground">GET</span>{' '}
          /api/v1/admin/consent/audit — Full audit trail
        </div>
        <div>
          <span class="font-bold text-muted-foreground">GET</span>{' '}
          /api/v1/admin/consent/audit?clientId=X — Client audit trail
        </div>
        <div>
          <span class="font-bold text-muted-foreground">GET</span>{' '}
          /api/v1/admin/consent/export — Export all consent data
        </div>
        <div>
          <span class="font-bold text-muted-foreground">GET</span>{' '}
          /api/v1/admin/consent/expiry-check — Run expiry check
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  // Initialize consent
  document
    .getElementById('init-consent-btn')
    ?.addEventListener('click', async () => {
      const clientId = (
        document.getElementById('new-client-id') as HTMLInputElement | null
      )?.value
      const level = (
        document.getElementById('new-consent-level') as HTMLSelectElement | null
      )?.value
      if (!clientId) {
        alert('Client ID is required')
        return
      }
      try {
        const res = await fetch('/api/v1/admin/consent', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ clientId, level }),
        })
        if (res.ok) {
          alert('Consent initialized successfully')
          window.location.reload()
        } else {
          const err = await res.json()
          alert('Failed: ' + (err.error || 'Unknown error'))
        }
      } catch (err) {
        alert('Error: ' + (err instanceof Error ? err.message : String(err)))
      }
    })

  // Update / Withdraw actions
  document.querySelectorAll('button[data-action]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const htmlBtn = btn as HTMLElement
      const action = htmlBtn.dataset['action']
      const clientId = htmlBtn.dataset['clientId']
      if (action === 'update') {
        const newLevel = prompt(
          'Enter new consent level (minimal, limited, full):',
        )
        if (!newLevel) return
        const reason = prompt('Reason for update (optional):') || undefined
        try {
          const res = await fetch(`/api/v1/admin/consent/${clientId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ newLevel, reason }),
          })
          if (res.ok) {
            alert('Consent updated')
            window.location.reload()
          } else {
            const err = await res.json()
            alert('Failed: ' + (err.error || 'Unknown error'))
          }
        } catch (updateErr) {
          alert(
            'Error: ' +
              (updateErr instanceof Error
                ? updateErr.message
                : String(updateErr)),
          )
        }
      } else if (action === 'withdraw') {
        const reason = prompt('Reason for withdrawal (optional):') || undefined
        if (!confirm('Are you sure you want to request consent withdrawal?'))
          return
        try {
          const res = await fetch(`/api/v1/admin/consent/${clientId}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reason }),
          })
          if (res.ok) {
            alert('Withdrawal requested')
            window.location.reload()
          } else {
            const err = await res.json()
            alert('Failed: ' + (err.error || 'Unknown error'))
          }
        } catch (withdrawErr) {
          alert(
            'Error: ' +
              (withdrawErr instanceof Error
                ? withdrawErr.message
                : String(withdrawErr)),
          )
        }
      }
    })
  })
</script>
