---
import AIPerformanceDashboard from '@/components/monitoring/AIPerformanceDashboard.astro'
import DashboardLayout from '@/layouts/DashboardLayout.astro'

// Inlined from AIPerformanceDashboard.astro for type safety
type AIOperationType =
  | 'emotion-detection'
  | 'pattern-recognition'
  | 'documentation-generation'
  | 'summary-generation'
  | 'recommendation-generation'
  | 'time-series-analysis'
  | 'trend-detection'
  | 'risk-assessment'
  | 'custom'

// Get configuration and metrics
const operationTypes: AIOperationType[] = [
  'emotion-detection',
  'pattern-recognition',
  'documentation-generation',
  'summary-generation',
  'recommendation-generation',
  'time-series-analysis',
]

// Page title and description
const pageTitle = 'AI Performance Monitoring'
const pageDescription =
  'Monitor and analyze AI processing performance across all AI operations.'
---

<DashboardLayout title={`${pageTitle} | Admin`}>
  <div class="container mx-auto px-4 py-8">
    <header class="mb-8">
      <h1 class="text-2xl font-bold text-foreground">{pageTitle}</h1>
      <p class="mt-2 text-muted-foreground">{pageDescription}</p>
    </header>

    <div class="mb-8">
      <AIPerformanceDashboard
        title="AI Performance Metrics"
        description="Monitor AI processing time, token usage, and performance metrics"
        refreshInterval={30000}
      />
    </div>

    <!-- Documentation Link -->
    <div class="mb-8 rounded-none border border-border bg-card p-6">
      <h2 class="mb-4 text-xl font-semibold text-foreground">
        Integration Documentation
      </h2>
      <p class="mb-4 text-muted-foreground">
        Learn how to integrate AI performance monitoring into your AI services
        and operations.
      </p>
      <div class="mb-4 rounded-none bg-secondary p-4">
        <h3 class="mb-2 text-lg font-medium text-foreground">Usage Example</h3>
        <pre class="overflow-x-auto rounded-none bg-popover p-4 text-sm text-foreground">
{`// Import the performance monitoring decorator
import { monitorPerformance } from '@/lib/ai/performance';

class EmotionAnalysisService {
  @monitorPerformance('emotion-detection', {
    getInputTokens: (args) => estimateTokens(args[0]),
    getOutputTokens: (result) => result.emotions.length * 10
  })
  async detectEmotions(text) {
    // Your emotion detection logic here
    return { emotions: [] };
  }
}`}
        </pre>
      </div>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href="/docs/api/ai/performance-monitoring"
          class="border-transparent inline-flex items-center rounded-none border bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
        >
          View Documentation
        </a>
        <a
          href="/docs/examples/ai-performance-monitoring"
          class="inline-flex items-center rounded-none border border-input bg-card px-4 py-2 text-sm font-medium text-foreground hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
        >
          View Examples
        </a>
      </div>
    </div>
  </div>
</DashboardLayout>
