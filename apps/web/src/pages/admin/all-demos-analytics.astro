---
import { ChartBar } from 'lucide-react'

import Badge from '@/components/ui/Badge.astro'
import { Button } from '@/components/ui/button/button.tsx'
import Card from '@/components/ui/Card.astro'
import CardContent from '@/components/ui/CardContent.astro'
import CardDescription from '@/components/ui/CardDescription.astro'
import CardHeader from '@/components/ui/CardHeader.astro'
import CardTitle from '@/components/ui/CardTitle.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = false // Enable SSR for real-time data

const demoPages = [
  {
    name: 'clinical-vault-trainer',
    title: 'ClinicalVault Trainer',
    color: 'red',
    description: 'HIPAA-impossible training made possible',
  },
  {
    name: 'synthetic-training-generator',
    title: 'Synthetic Training Generator',
    color: 'cyan',
    description: 'AI patient generation in 12 seconds',
  },
  {
    name: 'psychology-pipeline-processor',
    title: 'Psychology Pipeline Processor',
    color: 'orange',
    description: 'Industrial-scale content processing',
  },
  {
    name: 'security-bias-detection-engine',
    title: 'Security & Bias Detection Engine',
    color: 'red',
    description: 'Real-time bias protection',
  },
]
---

<BaseLayout
  title="All Demos Analytics Dashboard"
  description="Comprehensive analytics and A/B testing results across all demo pages"
  bgType="plum"
>
  <div class="relative min-h-screen text-foreground">
    {/* Floating Particles */}
    <div class="particles-container pointer-events-none absolute inset-0 overflow-hidden">
      <div class="particle particle-1"></div>
      <div class="particle particle-2"></div>
      <div class="particle particle-3"></div>
      <div class="particle particle-4"></div>
      <div class="particle particle-5"></div>
    </div>

    <div class="relative z-10 py-8">
      <div class="container mx-auto px-4">
        {/* Header */}
        <div class="mb-12 text-center">
          <h1 class="mb-6 text-4xl font-bold lg:text-5xl">
            Demo Analytics Command Center
            <span class="mt-2 block text-foreground">
              All Pages • Real-Time Results
            </span>
          </h1>
          <div class="mb-6 flex justify-center gap-4">
            <Badge class="bg-primary/20 inline-flex items-center gap-2 rounded-none border border-ring px-4 py-2 text-sm text-foreground">
              <span class="relative flex h-3 w-3">
                <span class="absolute inline-flex h-full w-full animate-pulse rounded-none bg-primary opacity-75"></span>
                <span class="relative inline-flex h-3 w-3 rounded-none bg-primary"></span>
              </span>
              Live Data Stream
            </Badge>
            <Badge class="bg-primary/20 inline-flex items-center gap-2 rounded-none border border-ring px-4 py-2 text-sm text-foreground">
              <span class="text-foreground">🧪</span>
              A/B Testing Active
            </Badge>
          </div>
        </div>

        {/* Overall Performance Summary */}
        <div class="mb-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
          <Card class="border border-input bg-secondary">
            <CardHeader class="pb-2">
              <CardTitle class="text-lg text-foreground">
                Total Sessions
              </CardTitle>
            </CardHeader>
            <CardContent>
              <div
                id="total-sessions-all"
                class="text-3xl font-bold text-foreground"
              >
                0
              </div>
              <div class="text-sm text-muted-foreground">Across all demos</div>
            </CardContent>
          </Card>

          <Card class="border border-input bg-secondary">
            <CardHeader class="pb-2">
              <CardTitle class="text-lg text-foreground">
                Overall Conversion
              </CardTitle>
            </CardHeader>
            <CardContent>
              <div
                id="overall-conversion-rate"
                class="text-3xl font-bold text-foreground"
              >
                0%
              </div>
              <div class="text-sm text-muted-foreground">Weighted average</div>
            </CardContent>
          </Card>

          <Card class="border border-input bg-secondary">
            <CardHeader class="pb-2">
              <CardTitle class="text-lg text-foreground">
                Best Performing Demo
              </CardTitle>
            </CardHeader>
            <CardContent>
              <div id="best-demo" class="text-2xl font-bold text-foreground">
                Loading...
              </div>
              <div class="text-sm text-muted-foreground">
                Highest conversion rate
              </div>
            </CardContent>
          </Card>

          <Card class="border border-input bg-secondary">
            <CardHeader class="pb-2">
              <CardTitle class="text-lg text-foreground">
                A/B Test Winners
              </CardTitle>
            </CardHeader>
            <CardContent>
              <div id="ab-winners" class="text-2xl font-bold text-foreground">
                0/4
              </div>
              <div class="text-sm text-muted-foreground">
                Statistically significant
              </div>
            </CardContent>
          </Card>
        </div>

        {/* Individual Demo Performance */}
        <div class="mb-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
          {demoPages.map((demo) => (
            <Card class="border border-input bg-card">
              <CardHeader>
                <div class="flex items-start justify-between">
                  <div>
                    <CardTitle class={`text-${demo.color}-100 text-xl`}>
                      {demo.title}
                    </CardTitle>
                    <CardDescription class={`text-${demo.color}-200/80`}>
                      {demo.description}
                    </CardDescription>
                  </div>
                  <Badge
                    class={`bg-${demo.color}-500/20 text-${demo.color}-300`}
                  >
                    <span id={`${demo.name}-status`}>Active</span>
                  </Badge>
                </div>
              </CardHeader>
              <CardContent>
                {/* Performance Metrics */}
                <div class="mb-6 grid grid-cols-3 gap-4">
                  <div class="text-center">
                    <div
                      id={`${demo.name}-sessions`}
                      class={`text-2xl font-bold text-${demo.color}-400`}
                    >
                      0
                    </div>
                    <div class={`text-sm text-${demo.color}-200/70`}>
                      Sessions
                    </div>
                  </div>
                  <div class="text-center">
                    <div
                      id={`${demo.name}-conversion`}
                      class={`text-2xl font-bold text-${demo.color}-400`}
                    >
                      0%
                    </div>
                    <div class={`text-sm text-${demo.color}-200/70`}>
                      Conversion
                    </div>
                  </div>
                  <div class="text-center">
                    <div
                      id={`${demo.name}-time`}
                      class={`text-2xl font-bold text-${demo.color}-400`}
                    >
                      0s
                    </div>
                    <div class={`text-sm text-${demo.color}-200/70`}>
                      Avg Time
                    </div>
                  </div>
                </div>

                {/* A/B Test Results */}
                <div class="rounded-none bg-secondary p-4">
                  <h4 class={`text-${demo.color}-300 mb-3 font-medium`}>
                    A/B Test Performance
                  </h4>
                  <div class="space-y-2">
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-muted-foreground">
                        Variant A
                      </span>
                      <div class="flex items-center gap-2">
                        <span
                          id={`${demo.name}-variant-a-rate`}
                          class={`text-${demo.color}-400 text-sm font-bold`}
                        >
                          0%
                        </span>
                        <div class="h-1 w-16 rounded-none bg-secondary">
                          <div
                            id={`${demo.name}-variant-a-bar`}
                            class={`bg-${demo.color}-500 h-1 rounded-none`}
                            style="width: 0%"
                          />
                        </div>
                      </div>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-muted-foreground">
                        Variant B
                      </span>
                      <div class="flex items-center gap-2">
                        <span
                          id={`${demo.name}-variant-b-rate`}
                          class={`text-${demo.color}-400 text-sm font-bold`}
                        >
                          0%
                        </span>
                        <div class="h-1 w-16 rounded-none bg-secondary">
                          <div
                            id={`${demo.name}-variant-b-bar`}
                            class={`bg-${demo.color}-500 h-1 rounded-none`}
                            style="width: 0%"
                          />
                        </div>
                      </div>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-muted-foreground">
                        Variant C
                      </span>
                      <div class="flex items-center gap-2">
                        <span
                          id={`${demo.name}-variant-c-rate`}
                          class={`text-${demo.color}-400 text-sm font-bold`}
                        >
                          0%
                        </span>
                        <div class="h-1 w-16 rounded-none bg-secondary">
                          <div
                            id={`${demo.name}-variant-c-bar`}
                            class={`bg-${demo.color}-500 h-1 rounded-none`}
                            style="width: 0%"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="mt-3 border-t border-border pt-3">
                    <div class="flex items-center justify-between">
                      <span class="text-xs text-muted-foreground">
                        Statistical Significance
                      </span>
                      <span
                        id={`${demo.name}-significance`}
                        class="text-xs font-medium"
                      >
                        Collecting data...
                      </span>
                    </div>
                  </div>
                </div>

                {/* Quick Actions */}
                <div class="mt-4 flex gap-2">
                  <Button
                    size="sm"
                    variant="outline"
                    className={`border-${demo.color}-500/50 text-${demo.color}-300 hover:bg-${demo.color}-500/10`}
                  >
                    View Details
                  </Button>
                  <Button
                    size="sm"
                    variant="outline"
                    className={`border-${demo.color}-500/50 text-${demo.color}-300 hover:bg-${demo.color}-500/10`}
                  >
                    Export Data
                  </Button>
                </div>
              </CardContent>
            </Card>
          ))}
        </div>

        {/* Comparative Analysis */}
        <div class="mb-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
          {/* Conversion Funnel Comparison */}
          <Card class="border border-input bg-card">
            <CardHeader>
              <CardTitle class="text-foreground">
                Conversion Funnel Comparison
              </CardTitle>
              <CardDescription class="text-muted-foreground">
                Drop-off rates across all demo pages
              </CardDescription>
            </CardHeader>
            <CardContent>
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-foreground">Page Views</span>
                  <div class="flex items-center gap-4">
                    <div
                      id="funnel-page-views-total"
                      class="font-bold text-foreground"
                    >
                      0
                    </div>
                    <div class="h-2 w-32 rounded-none bg-secondary">
                      <div
                        class="bg-indigo-500 h-2 rounded-none"
                        style="width: 100%"
                      ></div>
                    </div>
                    <span class="text-sm text-foreground">100%</span>
                  </div>
                </div>

                <div class="flex items-center justify-between">
                  <span class="text-foreground">Demo Interactions</span>
                  <div class="flex items-center gap-4">
                    <div
                      id="funnel-interactions-total"
                      class="font-bold text-foreground"
                    >
                      0
                    </div>
                    <div class="h-2 w-32 rounded-none bg-secondary">
                      <div
                        id="funnel-interactions-bar"
                        class="h-2 rounded-none bg-primary"
                        style="width: 0%"
                      ></div>
                    </div>
                    <span
                      id="funnel-interactions-pct"
                      class="text-sm text-foreground"
                    >
                      0%
                    </span>
                  </div>
                </div>

                <div class="flex items-center justify-between">
                  <span class="text-foreground">CTA Clicks</span>
                  <div class="flex items-center gap-4">
                    <div
                      id="funnel-cta-total"
                      class="font-bold text-foreground"
                    >
                      0
                    </div>
                    <div class="h-2 w-32 rounded-none bg-secondary">
                      <div
                        id="funnel-cta-bar"
                        class="h-2 rounded-none bg-primary"
                        style="width: 0%"
                      ></div>
                    </div>
                    <span id="funnel-cta-pct" class="text-sm text-foreground">
                      0%
                    </span>
                  </div>
                </div>
              </div>
            </CardContent>
          </Card>

          {/* A/B Test Summary */}
          <Card class="border border-input bg-card">
            <CardHeader>
              <CardTitle class="text-foreground">A/B Test Summary</CardTitle>
              <CardDescription class="text-muted-foreground">
                Statistical significance across all tests
              </CardDescription>
            </CardHeader>
            <CardContent>
              <div class="space-y-4">
                <div class="rounded-none bg-secondary p-4">
                  <div class="mb-2 font-medium text-foreground">
                    Overall Test Status
                  </div>
                  <div
                    id="overall-test-status"
                    class="font-bold text-foreground"
                  >
                    Collecting Data...
                  </div>
                  <div class="mt-1 text-sm text-muted-foreground">
                    Across all demo pages
                  </div>
                </div>

                <div class="rounded-none bg-secondary p-4">
                  <div class="mb-2 font-medium text-foreground">
                    Winning Variants
                  </div>
                  <div class="space-y-2">
                    <div class="flex justify-between text-sm">
                      <span class="text-muted-foreground">
                        ClinicalVault Trainer
                      </span>
                      <span id="clinical-winner" class="text-foreground">
                        TBD
                      </span>
                    </div>
                    <div class="flex justify-between text-sm">
                      <span class="text-muted-foreground">
                        Synthetic Generator
                      </span>
                      <span id="synthetic-winner" class="text-foreground">
                        TBD
                      </span>
                    </div>
                    <div class="flex justify-between text-sm">
                      <span class="text-muted-foreground">
                        Pipeline Processor
                      </span>
                      <span id="pipeline-winner" class="text-foreground">
                        TBD
                      </span>
                    </div>
                    <div class="flex justify-between text-sm">
                      <span class="text-muted-foreground">Security Engine</span>
                      <span id="security-winner" class="text-foreground">
                        TBD
                      </span>
                    </div>
                  </div>
                </div>

                <div class="rounded-none bg-secondary p-4">
                  <div class="mb-2 font-medium text-foreground">
                    Recommendations
                  </div>
                  <div
                    id="overall-recommendations"
                    class="text-sm font-bold text-foreground"
                  >
                    Continue testing all variants
                  </div>
                </div>
              </div>
            </CardContent>
          </Card>
        </div>

        {/* Live Event Stream */}
        <Card class="mb-12 border border-border bg-card">
          <CardHeader>
            <CardTitle class="text-foreground">Live Event Stream</CardTitle>
            <CardDescription class="text-muted-foreground">
              Real-time user interactions across all demo pages
            </CardDescription>
          </CardHeader>
          <CardContent>
            <div
              id="live-event-stream"
              class="max-h-96 space-y-2 overflow-y-auto"
            >
              <div class="py-8 text-center text-muted-foreground">
                Waiting for events across all demos...
              </div>
            </div>
          </CardContent>
        </Card>

        {/* Export and Actions */}
        <div class="flex justify-center gap-4">
          <Button
            variant="outline"
            className="bg-primary px-6 py-3 text-primary-foreground hover:bg-accent"
          >
            <ChartBar className="mr-2 h-4 w-4" /> Export All Data
          </Button>
          <Button
            variant="outline"
            className="hover:bg-primary/10 border-input px-6 py-3 text-foreground"
          >
            📧 Email Report
          </Button>
          <Button
            variant="outline"
            className="hover:bg-primary/10 border-input px-6 py-3 text-foreground"
          >
            ⚙️ Configure Alerts
          </Button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    class AllDemosAnalyticsDashboard {
      constructor() {
        this.demoPages = [
          'clinical-vault-trainer',
          'synthetic-training-generator',
          'psychology-pipeline-processor',
          'security-bias-detection-engine',
        ]
        this.data = {}
        this.init()
      }

      init() {
        this.loadAllData()
        this.setupRealTimeUpdates()
        this.startPeriodicRefresh()
      }

      async loadAllData() {
        try {
          // Load data for each demo page
          const promises = this.demoPages.map(async (pageName) => {
            const response = await fetch(
              `/api/analytics/demo-tracking?page=${pageName}`,
            )
            const data = await response.json()
            return { pageName, data }
          })

          const results = await Promise.all(promises)

          results.forEach(({ pageName, data }) => {
            this.data[pageName] = data
          })

          this.updateDashboard()
        } catch (error) {
          console.error('Failed to load analytics data:', error)
        }
      }

      updateDashboard() {
        this.updateOverallStats()
        this.updateIndividualDemos()
        this.updateComparativeAnalysis()
        this.updateABTestSummary()
      }

      updateOverallStats() {
        let totalSessions = 0
        let totalConversions = 0
        let bestDemo = { name: '', rate: 0 }
        let significantTests = 0

        Object.entries(this.data).forEach(([pageName, data]) => {
          const sessions = data.summary?.unique_sessions || 0
          const conversions = data.summary?.conversion_funnel?.cta_clicks || 0
          const rate = sessions > 0 ? (conversions / sessions) * 100 : 0

          totalSessions += sessions
          totalConversions += conversions

          if (rate > bestDemo.rate) {
            bestDemo = { name: pageName, rate }
          }

          // Check if test is statistically significant (simplified)
          if (conversions > 50) significantTests++
        })

        const overallRate =
          totalSessions > 0 ? (totalConversions / totalSessions) * 100 : 0

        const totalSessionsEl = document.getElementById('total-sessions-all')
        if (totalSessionsEl) totalSessionsEl.textContent = String(totalSessions)
        const overallRateEl = document.getElementById('overall-conversion-rate')
        if (overallRateEl)
          overallRateEl.textContent = overallRate.toFixed(1) + '%'
        const bestDemoEl = document.getElementById('best-demo')
        if (bestDemoEl)
          bestDemoEl.textContent = this.formatDemoName(bestDemo.name)
        const abWinnersEl = document.getElementById('ab-winners')
        if (abWinnersEl) abWinnersEl.textContent = `${significantTests}/4`
      }

      updateIndividualDemos() {
        this.demoPages.forEach((pageName) => {
          const data = this.data[pageName]
          if (!data) return

          const sessions = data.summary?.unique_sessions || 0
          const conversions = data.summary?.conversion_funnel?.cta_clicks || 0
          const rate = sessions > 0 ? (conversions / sessions) * 100 : 0
          const avgTime = data.summary?.avg_time_to_cta
            ? Math.round(data.summary.avg_time_to_cta / 1000)
            : 0

          const sessionsEl = document.getElementById(`${pageName}-sessions`)
          if (sessionsEl) sessionsEl.textContent = String(sessions)
          const conversionEl = document.getElementById(`${pageName}-conversion`)
          if (conversionEl) conversionEl.textContent = rate.toFixed(1) + '%'
          const timeEl = document.getElementById(`${pageName}-time`)
          if (timeEl) timeEl.textContent = avgTime + 's'

          // Update A/B test results
          this.updateABTestResults(pageName, data)
        })
      }

      updateABTestResults(pageName, data) {
        const variants = ['A', 'B', 'C']

        variants.forEach((variant) => {
          const variantEvents =
            data.events?.filter((e) => e.ab_variant === variant) || []
          const sessions = new Set(variantEvents.map((e) => e.session_id)).size
          const conversions = variantEvents.filter(
            (e) => e.event === 'demo_cta_click',
          ).length
          const rate = sessions > 0 ? (conversions / sessions) * 100 : 0

          const rateElement = document.getElementById(
            `${pageName}-variant-${variant.toLowerCase()}-rate`,
          )
          const barElement = document.getElementById(
            `${pageName}-variant-${variant.toLowerCase()}-bar`,
          )

          if (rateElement) rateElement.textContent = rate.toFixed(1) + '%'
          if (barElement) barElement.style.width = Math.min(rate, 100) + '%'
        })

        // Update significance
        const significanceElement = document.getElementById(
          `${pageName}-significance`,
        )
        if (significanceElement) {
          const totalConversions =
            data.summary?.conversion_funnel?.cta_clicks || 0
          if (totalConversions > 100) {
            significanceElement.textContent = 'Statistically significant'
            significanceElement.className =
              'text-xs font-medium text-foreground'
          } else {
            significanceElement.textContent = `${totalConversions}/100 conversions`
            significanceElement.className =
              'text-xs font-medium text-foreground'
          }
        }
      }

      updateComparativeAnalysis() {
        let totalPageViews = 0
        let totalInteractions = 0
        let totalCTAClicks = 0

        Object.values(this.data).forEach((data) => {
          totalPageViews += data.summary?.conversion_funnel?.page_views || 0
          totalInteractions +=
            data.summary?.conversion_funnel?.demo_interactions || 0
          totalCTAClicks += data.summary?.conversion_funnel?.cta_clicks || 0
        })

        const interactionRate =
          totalPageViews > 0 ? (totalInteractions / totalPageViews) * 100 : 0
        const ctaRate =
          totalPageViews > 0 ? (totalCTAClicks / totalPageViews) * 100 : 0

        document.getElementById('funnel-page-views-total').textContent =
          totalPageViews
        document.getElementById('funnel-interactions-total').textContent =
          totalInteractions
        document.getElementById('funnel-cta-total').textContent = totalCTAClicks

        document.getElementById('funnel-interactions-pct').textContent =
          interactionRate.toFixed(1) + '%'
        document.getElementById('funnel-cta-pct').textContent =
          ctaRate.toFixed(1) + '%'

        document.getElementById('funnel-interactions-bar').style.width =
          interactionRate + '%'
        document.getElementById('funnel-cta-bar').style.width = ctaRate + '%'
      }

      updateABTestSummary() {
        let significantTests = 0
        const winners = {}

        this.demoPages.forEach((pageName) => {
          const data = this.data[pageName]
          if (!data) return

          const totalConversions =
            data.summary?.conversion_funnel?.cta_clicks || 0
          if (totalConversions > 100) {
            significantTests++
            // Simplified winner determination
            winners[pageName] = 'Variant B' // This would be calculated properly
          } else {
            winners[pageName] = 'TBD'
          }
        })

        const overallTestStatusEl = document.getElementById(
          'overall-test-status',
        )
        if (overallTestStatusEl) {
          overallTestStatusEl.textContent =
            significantTests > 0
              ? `${significantTests} tests ready for analysis`
              : 'Collecting data across all tests'
        }

        // Update individual winners
        const clinicalWinnerEl = document.getElementById('clinical-winner')
        if (clinicalWinnerEl)
          clinicalWinnerEl.textContent =
            winners['clinical-vault-trainer'] || 'TBD'
        const syntheticWinnerEl = document.getElementById('synthetic-winner')
        if (syntheticWinnerEl)
          syntheticWinnerEl.textContent =
            winners['synthetic-training-generator'] || 'TBD'
        const pipelineWinnerEl = document.getElementById('pipeline-winner')
        if (pipelineWinnerEl)
          pipelineWinnerEl.textContent =
            winners['psychology-pipeline-processor'] || 'TBD'
        const securityWinnerEl = document.getElementById('security-winner')
        if (securityWinnerEl)
          securityWinnerEl.textContent =
            winners['security-bias-detection-engine'] || 'TBD'

        const overallRecommendationsEl = document.getElementById(
          'overall-recommendations',
        )
        if (overallRecommendationsEl) {
          overallRecommendationsEl.textContent =
            significantTests > 2
              ? 'Ready to implement winning variants'
              : 'Continue testing all variants'
        }
      }

      setupRealTimeUpdates() {
        // Simulate real-time event stream
        setInterval(() => {
          this.updateEventStream()
        }, 3000)
      }

      updateEventStream() {
        const events = [
          'User started ClinicalVault demo',
          'A/B test variant assigned: Synthetic Generator B',
          'CTA clicked: Pipeline Processor',
          'Demo interaction: Security Engine',
          'Page view: Clinical Vault Trainer',
        ]

        const eventStream = document.getElementById('live-event-stream')
        if (!eventStream) return

        const randomEvent = events[Math.floor(Math.random() * events.length)]
        const time = new Date().toLocaleTimeString()

        const eventElement = document.createElement('div')
        eventElement.className =
          'flex items-center justify-between bg-secondary rounded-none p-3 animate-fade-in'
        eventElement.innerHTML = `
    <span class="text-muted-foreground">${randomEvent}</span>
    <span class="text-muted-foreground text-sm">${time}</span>
   `

        eventStream.insertBefore(eventElement, eventStream.firstChild)

        // Keep only last 10 events
        while (eventStream.children.length > 10) {
          eventStream.removeChild(eventStream.lastChild)
        }
      }

      startPeriodicRefresh() {
        // Refresh data every 30 seconds
        setInterval(() => {
          this.loadAllData()
        }, 30000)
      }

      formatDemoName(pageName) {
        const names = {
          'clinical-vault-trainer': 'Clinical Vault',
          'synthetic-training-generator': 'Synthetic Generator',
          'psychology-pipeline-processor': 'Pipeline Processor',
          'security-bias-detection-engine': 'Security Engine',
        }
        return names[pageName] || 'Unknown'
      }
    }

    // Initialize dashboard when DOM is ready
    document.addEventListener('DOMContentLoaded', () => {
      const dashboard = new AllDemosAnalyticsDashboard()
      dashboard.init() // Assuming there's an init method, or you can use any other method
    })
  </script>
