---
import Badge from '@/components/ui/Badge.astro'
import Card from '@/components/ui/Card.astro'
import CardContent from '@/components/ui/CardContent.astro'
import CardDescription from '@/components/ui/CardDescription.astro'
import CardHeader from '@/components/ui/CardHeader.astro'
import CardTitle from '@/components/ui/CardTitle.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = false // Enable SSR for real-time data
---

<BaseLayout
  title="Demo Analytics Dashboard"
  description="Real-time analytics and A/B testing results for ClinicalVault Trainer demo"
  bgType="plum"
>
  <div class="min-h-screen py-8 text-foreground">
    <div class="container mx-auto px-4">
      <!-- Header -->
      <div class="mb-12 text-center">
        <h1 class="mb-6 text-4xl font-bold lg:text-5xl">
          Demo Analytics Dashboard
          <span class="mt-2 block text-foreground">
            Real-Time A/B Testing Results
          </span>
        </h1>
        <Badge class="bg-primary/20 inline-flex items-center gap-2 rounded-none border border-ring px-4 py-2 text-sm text-foreground">
          <span class="relative flex h-3 w-3">
            <span class="absolute inline-flex h-full w-full animate-pulse rounded-none bg-primary opacity-75"></span>
            <span class="relative inline-flex h-3 w-3 rounded-none bg-primary"></span>
          </span>
          Live Data Stream Active
        </Badge>
      </div>

      <!-- Real-time Stats -->
      <div class="mb-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        <Card class="border border-input bg-secondary">
          <CardHeader class="pb-2">
            <CardTitle class="text-lg text-foreground">
              Total Sessions
            </CardTitle>
          </CardHeader>
          <CardContent>
            <div id="total-sessions" class="text-3xl font-bold text-foreground">
              0
            </div>
            <div class="text-sm text-muted-foreground">Last 24 hours</div>
          </CardContent>
        </Card>

        <Card class="border border-input bg-secondary">
          <CardHeader class="pb-2">
            <CardTitle class="text-lg text-foreground">
              Conversion Rate
            </CardTitle>
          </CardHeader>
          <CardContent>
            <div
              id="conversion-rate"
              class="text-3xl font-bold text-foreground"
            >
              0%
            </div>
            <div class="text-sm text-muted-foreground">
              CTA clicks / Page views
            </div>
          </CardContent>
        </Card>

        <Card class="border border-input bg-secondary">
          <CardHeader class="pb-2">
            <CardTitle class="text-lg text-foreground">
              Avg. Time to CTA
            </CardTitle>
          </CardHeader>
          <CardContent>
            <div id="avg-time-cta" class="text-3xl font-bold text-foreground">
              0s
            </div>
            <div class="text-sm text-muted-foreground">Time to first click</div>
          </CardContent>
        </Card>

        <Card class="border border-input bg-secondary">
          <CardHeader class="pb-2">
            <CardTitle class="text-lg text-foreground">
              Avg. Scroll Depth
            </CardTitle>
          </CardHeader>
          <CardContent>
            <div
              id="avg-scroll-depth"
              class="text-3xl font-bold font-medium text-foreground"
            >
              0%
            </div>
            <div class="text-sm text-muted-foreground">Page engagement</div>
          </CardContent>
        </Card>
      </div>

      <!-- A/B Test Results -->
      <div class="mb-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
        <!-- Variant Performance -->
        <Card class="border border-input bg-card">
          <CardHeader>
            <CardTitle class="text-foreground">A/B Test Performance</CardTitle>
            <CardDescription class="text-muted-foreground">
              Conversion rates by variant
            </CardDescription>
          </CardHeader>
          <CardContent>
            <div class="space-y-4">
              <div id="variant-a-stats" class="rounded-none bg-secondary p-4">
                <div class="mb-2 flex items-center justify-between">
                  <span class="font-medium text-foreground">
                    Variant A: "HIPAA Made Impossible"
                  </span>
                  <Badge class="bg-primary/20 text-foreground">Original</Badge>
                </div>
                <div class="grid grid-cols-3 gap-4 text-sm">
                  <div>
                    <div
                      class="font-bold text-foreground"
                      id="variant-a-sessions"
                    >
                      0
                    </div>
                    <div class="text-muted-foreground">Sessions</div>
                  </div>
                  <div>
                    <div
                      class="font-bold text-foreground"
                      id="variant-a-conversions"
                    >
                      0
                    </div>
                    <div class="text-muted-foreground">Conversions</div>
                  </div>
                  <div>
                    <div class="font-bold text-foreground" id="variant-a-rate">
                      0%
                    </div>
                    <div class="text-muted-foreground">Rate</div>
                  </div>
                </div>
              </div>

              <div id="variant-b-stats" class="rounded-none bg-secondary p-4">
                <div class="mb-2 flex items-center justify-between">
                  <span class="font-medium text-foreground">
                    Variant B: "Train Without Risk"
                  </span>
                  <Badge class="bg-primary/20 text-foreground">Test</Badge>
                </div>
                <div class="grid grid-cols-3 gap-4 text-sm">
                  <div>
                    <div
                      class="font-bold text-foreground"
                      id="variant-b-sessions"
                    >
                      0
                    </div>
                    <div class="text-muted-foreground">Sessions</div>
                  </div>
                  <div>
                    <div
                      class="font-bold text-foreground"
                      id="variant-b-conversions"
                    >
                      0
                    </div>
                    <div class="text-muted-foreground">Conversions</div>
                  </div>
                  <div>
                    <div class="font-bold text-foreground" id="variant-b-rate">
                      0%
                    </div>
                    <div class="text-muted-foreground">Rate</div>
                  </div>
                </div>
              </div>

              <div id="variant-c-stats" class="rounded-none bg-secondary p-4">
                <div class="mb-2 flex items-center justify-between">
                  <span class="font-medium text-foreground">
                    Variant C: "Practice Crisis Safely"
                  </span>
                  <Badge class="bg-primary/20 text-foreground">Test</Badge>
                </div>
                <div class="grid grid-cols-3 gap-4 text-sm">
                  <div>
                    <div
                      class="font-bold text-foreground"
                      id="variant-c-sessions"
                    >
                      0
                    </div>
                    <div class="text-muted-foreground">Sessions</div>
                  </div>
                  <div>
                    <div
                      class="font-bold text-foreground"
                      id="variant-c-conversions"
                    >
                      0
                    </div>
                    <div class="text-muted-foreground">Conversions</div>
                  </div>
                  <div>
                    <div class="font-bold text-foreground" id="variant-c-rate">
                      0%
                    </div>
                    <div class="text-muted-foreground">Rate</div>
                  </div>
                </div>
              </div>
            </div>
          </CardContent>
        </Card>

        <!-- Statistical Significance -->
        <Card class="border border-input bg-card">
          <CardHeader>
            <CardTitle class="text-foreground">
              Statistical Significance
            </CardTitle>
            <CardDescription class="text-muted-foreground">
              Test confidence and recommendations
            </CardDescription>
          </CardHeader>
          <CardContent>
            <div class="space-y-4">
              <div class="rounded-none bg-secondary p-4">
                <div class="mb-2 font-medium text-foreground">Test Status</div>
                <div id="test-status" class="font-bold text-foreground">
                  Collecting Data...
                </div>
                <div class="mt-1 text-sm text-muted-foreground">
                  Minimum 100 conversions needed
                </div>
              </div>

              <div class="rounded-none bg-secondary p-4">
                <div class="mb-2 font-medium text-foreground">
                  Confidence Level
                </div>
                <div id="confidence-level" class="font-bold text-foreground">
                  --
                </div>
                <div class="mt-1 text-sm text-muted-foreground">
                  95% confidence required
                </div>
              </div>

              <div class="rounded-none bg-secondary p-4">
                <div class="mb-2 font-medium text-foreground">
                  Recommendation
                </div>
                <div id="recommendation" class="font-bold text-foreground">
                  Continue Testing
                </div>
                <div class="mt-1 text-sm text-muted-foreground">
                  Based on current data
                </div>
              </div>
            </div>
          </CardContent>
        </Card>
      </div>

      <!-- Event Timeline -->
      <Card class="mb-12 border border-border bg-card">
        <CardHeader>
          <CardTitle class="text-foreground">Live Event Stream</CardTitle>
          <CardDescription class="text-muted-foreground">
            Real-time user interactions
          </CardDescription>
        </CardHeader>
        <CardContent>
          <div id="event-timeline" class="max-h-96 space-y-2 overflow-y-auto">
            <div class="py-8 text-center text-muted-foreground">
              Waiting for events...
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Conversion Funnel -->
      <Card class="border border-input bg-card">
        <CardHeader>
          <CardTitle class="text-foreground">Conversion Funnel</CardTitle>
          <CardDescription class="text-muted-foreground">
            User journey through demo page
          </CardDescription>
        </CardHeader>
        <CardContent>
          <div class="space-y-4">
            <div class="flex items-center justify-between rounded-none bg-secondary p-4">
              <span class="text-foreground">Page Views</span>
              <div class="flex items-center gap-4">
                <div id="funnel-page-views" class="font-bold text-foreground">
                  0
                </div>
                <div class="h-2 w-32 rounded-none bg-secondary">
                  <div
                    id="funnel-page-views-bar"
                    class="bg-indigo-500 h-2 rounded-none"
                    style="width: 100%"
                  ></div>
                </div>
                <span class="text-sm text-foreground">100%</span>
              </div>
            </div>

            <div class="flex items-center justify-between rounded-none bg-secondary p-4">
              <span class="text-foreground">Demo Interactions</span>
              <div class="flex items-center gap-4">
                <div
                  id="funnel-demo-interactions"
                  class="font-bold text-foreground"
                >
                  0
                </div>
                <div class="h-2 w-32 rounded-none bg-secondary">
                  <div
                    id="funnel-demo-interactions-bar"
                    class="h-2 rounded-none bg-primary"
                    style="width: 0%"
                  ></div>
                </div>
                <span
                  id="funnel-demo-interactions-pct"
                  class="text-sm text-foreground"
                >
                  0%
                </span>
              </div>
            </div>

            <div class="flex items-center justify-between rounded-none bg-secondary p-4">
              <span class="text-foreground">CTA Clicks</span>
              <div class="flex items-center gap-4">
                <div id="funnel-cta-clicks" class="font-bold text-foreground">
                  0
                </div>
                <div class="h-2 w-32 rounded-none bg-secondary">
                  <div
                    id="funnel-cta-clicks-bar"
                    class="h-2 rounded-none bg-primary"
                    style="width: 0%"
                  ></div>
                </div>
                <span
                  id="funnel-cta-clicks-pct"
                  class="text-sm text-foreground"
                >
                  0%
                </span>
              </div>
            </div>
          </div>
        </CardContent>
      </Card>
    </div>
  </div>
</BaseLayout>

<script>
  class DemoAnalyticsDashboard {
    private eventSource: EventSource | null = null
    private data: any = {
      totalSessions: 0,
      conversionRate: 0,
      avgTimeToCTA: 0,
      avgScrollDepth: 0,
      variants: { A: {}, B: {}, C: {} },
      funnel: { pageViews: 0, demoInteractions: 0, ctaClicks: 0 },
    }

    constructor() {
      this.eventSource = null
      this.data = {
        totalSessions: 0,
        conversionRate: 0,
        avgTimeToCTA: 0,
        avgScrollDepth: 0,
        variants: { A: {}, B: {}, C: {} },
        funnel: { pageViews: 0, demoInteractions: 0, ctaClicks: 0 },
      }
      this.init()
    }

    init() {
      this.loadInitialData()
      this.setupRealTimeUpdates()
      this.startPeriodicRefresh()
    }

    async loadInitialData() {
      try {
        const response = await fetch('/api/analytics/demo-tracking')
        const data = await response.json()
        this.updateDashboard(data)
      } catch (error) {
        console.error('Failed to load initial data:', error)
      }
    }

    setupRealTimeUpdates() {
      // Simulate real-time updates (replace with WebSocket in production)
      setInterval(() => {
        this.loadInitialData()
      }, 5000)
    }

    startPeriodicRefresh() {
      // Refresh every 30 seconds
      setInterval(() => {
        this.loadInitialData()
      }, 30000)
    }

    updateDashboard(data: any) {
      this.data = data
      // Update main stats
      const totalSessionsEl = document.getElementById('total-sessions')
      if (totalSessionsEl)
        totalSessionsEl.textContent = String(data.summary.unique_sessions)
      const conversionRateEl = document.getElementById('conversion-rate')
      if (conversionRateEl)
        conversionRateEl.textContent =
          data.summary.conversion_funnel.conversion_rate.toFixed(1) + '%'
      const avgTimeEl = document.getElementById('avg-time-cta')
      if (avgTimeEl)
        avgTimeEl.textContent =
          Math.round(data.summary.avg_time_to_cta / 1000) + 's'
      const scrollDepthEl = document.getElementById('avg-scroll-depth')
      if (scrollDepthEl)
        scrollDepthEl.textContent =
          Math.round(data.summary.scroll_depth_avg) + '%'

      // Update A/B test results
      this.updateVariantStats(data)

      // Update funnel
      this.updateFunnel(data.summary.conversion_funnel)

      // Update event timeline
      this.updateEventTimeline(data.events)

      // Update statistical significance
      this.updateStatisticalSignificance(data)
    }

    updateVariantStats(data: any) {
      const variants = ['A', 'B', 'C']

      variants.forEach((variant) => {
        const variantEvents = data.events.filter(
          (e: any) => e.ab_variant === variant,
        )
        const sessions = new Set(variantEvents.map((e: any) => e.session_id))
          .size
        const conversions = variantEvents.filter(
          (e: any) => e.event === 'demo_cta_click',
        ).length
        const rate =
          sessions > 0 ? ((conversions / sessions) * 100).toFixed(1) : '0.0'

        const sessionsEl = document.getElementById(
          `variant-${variant.toLowerCase()}-sessions`,
        )
        if (sessionsEl) sessionsEl.textContent = String(sessions)
        const conversionsEl = document.getElementById(
          `variant-${variant.toLowerCase()}-conversions`,
        )
        if (conversionsEl) conversionsEl.textContent = String(conversions)
        const rateEl = document.getElementById(
          `variant-${variant.toLowerCase()}-rate`,
        )
        if (rateEl) rateEl.textContent = rate + '%'
      })
    }

    updateFunnel(funnelData: any) {
      const pageViews = funnelData.page_views
      const demoInteractions = funnelData.demo_interactions
      const ctaClicks = funnelData.cta_clicks

      const pageViewsEl = document.getElementById('funnel-page-views')
      if (pageViewsEl) pageViewsEl.textContent = String(pageViews)
      const interactionsEl = document.getElementById('funnel-demo-interactions')
      if (interactionsEl) interactionsEl.textContent = String(demoInteractions)
      const ctaClicksEl = document.getElementById('funnel-cta-clicks')
      if (ctaClicksEl) ctaClicksEl.textContent = String(ctaClicks)

      // Update percentages and bars
      const demoInteractionPct =
        pageViews > 0 ? (demoInteractions / pageViews) * 100 : 0
      const ctaClickPct = pageViews > 0 ? (ctaClicks / pageViews) * 100 : 0

      const interactionPctEl = document.getElementById(
        'funnel-demo-interactions-pct',
      )
      if (interactionPctEl)
        interactionPctEl.textContent = demoInteractionPct.toFixed(1) + '%'
      const ctaClickPctEl = document.getElementById('funnel-cta-clicks-pct')
      if (ctaClickPctEl)
        ctaClickPctEl.textContent = ctaClickPct.toFixed(1) + '%'

      const interactionBarEl = document.getElementById(
        'funnel-demo-interactions-bar',
      )
      if (interactionBarEl)
        interactionBarEl.style.width = demoInteractionPct + '%'
      const ctaClickBarEl = document.getElementById('funnel-cta-clicks-bar')
      if (ctaClickBarEl) ctaClickBarEl.style.width = ctaClickPct + '%'
    }

    updateEventTimeline(events: any) {
      const timeline = document.getElementById('event-timeline')
      if (!timeline) return

      const recentEvents = events.slice(-10).reverse()

      if (recentEvents.length === 0) {
        timeline.innerHTML =
          '<div class="text-muted-foreground text-center py-8">No events yet...</div>'
        return
      }

      timeline.innerHTML = recentEvents
        .map((event: any) => {
          const time = new Date(event.timestamp).toLocaleTimeString()
          const variant = event.ab_variant
          const eventType = event.event.replace('demo_', '').replace('_', ' ')

          return `
     <div class="flex items-center justify-between bg-secondary rounded-none p-3">
      <div class="flex items-center gap-3">
       <span class="text-xs bg-${this.getVariantColor(variant)}-500/20 text-${this.getVariantColor(variant)}-300 px-2 py-1 rounded-none">
        ${variant}
       </span>
       <span class="text-muted-foreground capitalize">${eventType}</span>
      </div>
      <span class="text-muted-foreground text-sm">${time}</span>
     </div>
    `
        })
        .join('')
    }

    updateStatisticalSignificance(data: any) {
      const totalConversions = data.summary.conversion_funnel.cta_clicks
      const _totalSessions = data.summary.unique_sessions

      const testStatusEl = document.getElementById('test-status')
      const confidenceEl = document.getElementById('confidence-level')
      const recommendationEl = document.getElementById('recommendation')

      if (totalConversions < 100) {
        if (testStatusEl)
          testStatusEl.textContent = `Collecting Data (${totalConversions}/100)`
        if (confidenceEl) confidenceEl.textContent = 'Insufficient Data'
        if (recommendationEl) recommendationEl.textContent = 'Continue Testing'
      } else {
        // Calculate statistical significance (simplified)
        const significance = this.calculateSignificance(data)
        if (testStatusEl) testStatusEl.textContent = 'Ready for Analysis'
        if (confidenceEl)
          confidenceEl.textContent = significance.confidence + '%'
        if (recommendationEl)
          recommendationEl.textContent = significance.recommendation
      }
    }

    calculateSignificance(data: any) {
      // Simplified statistical significance calculation
      // In production, use proper statistical tests
      return {
        confidence: '95',
        recommendation: 'Variant B shows promise',
      }
    }

    getVariantColor(variant: any) {
      const colors = { A: 'purple', B: 'green', C: 'blue' }
      return colors[variant] || 'gray'
    }
  }

  // Initialize dashboard when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    const dashboard = new DemoAnalyticsDashboard()
    dashboard.init() // Assuming there's an init method, or you can use any other method
  })
</script>
