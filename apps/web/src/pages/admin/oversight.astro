---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
---

<DashboardLayout title="Human Oversight Dashboard | Admin">
  <div class="container px-4 py-8 mx-auto max-w-6xl">
    <header class="mb-8">
      <h1 class="text-2xl font-bold text-foreground">
        Human Oversight Dashboard
      </h1>
      <p class="mt-2 text-muted-foreground">
        Intervention approval queue, manual override tracking, audit trail, and
        clinical governance checklist for supervised AI response review.
      </p>
    </header>

    <!-- Mode indicator -->
    <section id="mode-indicator" class="mb-8">
      <div class="rounded-none border border-input bg-secondary p-4">
        <div class="flex items-center gap-3">
          <span
            class="inline-flex items-center rounded-none bg-secondary border border-input px-2.5 py-0.5 text-xs font-medium text-muted-foreground"
            id="oversight-mode-badge">Supervised Mode</span
          >
          <p class="text-sm text-foreground font-medium">
            All AI responses require human approval before delivery. Manual
            overrides are logged with full audit trail.
          </p>
        </div>
      </div>
    </section>

    <!-- Queue statistics -->
    <section
      id="queue-stats"
      class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3 lg:grid-cols-6"
    >
      <div class="rounded-none border border-border bg-card p-4">
        <h2
          class="text-xs font-medium uppercase tracking-wider text-muted-foreground"
        >
          Total
        </h2>
        <p id="stat-total" class="mt-2 text-2xl font-bold text-foreground">0</p>
      </div>
      <div class="rounded-none border border-ring bg-secondary p-4">
        <h2
          class="text-xs font-medium uppercase tracking-wider text-foreground font-medium font-medium"
        >
          Pending
        </h2>
        <p
          id="stat-pending"
          class="mt-2 text-2xl font-bold text-foreground font-medium"
        >
          0
        </p>
      </div>
      <div class="rounded-none border border-input bg-secondary p-4">
        <h2
          class="text-xs font-medium uppercase tracking-wider text-muted-foreground"
        >
          Approved
        </h2>
        <p
          id="stat-approved"
          class="mt-2 text-2xl font-bold text-muted-foreground"
        >
          0
        </p>
      </div>
      <div class="rounded-none border border-ring bg-card p-4">
        <h2
          class="text-xs font-medium uppercase tracking-wider text-foreground font-semibold"
        >
          Rejected
        </h2>
        <p
          id="stat-rejected"
          class="mt-2 text-2xl font-bold text-foreground font-semibold font-semibold"
        >
          0
        </p>
      </div>
      <div class="rounded-none border border-input bg-secondary p-4">
        <h2
          class="text-xs font-medium uppercase tracking-wider text-foreground font-semibold"
        >
          Overridden
        </h2>
        <p id="stat-overridden" class="mt-2 text-2xl font-bold text-foreground">
          0
        </p>
      </div>
      <div class="rounded-none border border-border bg-secondary p-4">
        <h2
          class="text-xs font-medium uppercase tracking-wider text-muted-foreground"
        >
          Expired
        </h2>
        <p id="stat-expired" class="mt-2 text-2xl font-bold text-foreground">
          0
        </p>
      </div>
    </section>

    <!-- Governance Checklist -->
    <section id="governance-checklist" class="mb-8">
      <h2 class="mb-4 text-lg font-semibold text-foreground">
        Clinical Governance Checklist
      </h2>
      <div class="rounded-none border border-border bg-card p-6">
        <p class="mb-4 text-sm text-muted-foreground">
          All items must be satisfied before an intervention can be approved.
        </p>
        <div id="checklist-items" class="space-y-3">
          <!-- Checklist items rendered client-side -->
        </div>
        <div class="mt-4 flex items-center gap-3">
          <button
            id="checklist-demo-btn"
            class="rounded-none bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-accent"
          >
            Demo: Complete Checklist
          </button>
          <span id="checklist-status" class="text-sm text-muted-foreground"
          ></span>
        </div>
      </div>
    </section>

    <!-- Pending Interventions Queue -->
    <section id="pending-queue" class="mb-8">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-foreground">
          Pending Interventions
        </h2>
        <button
          id="enqueue-demo-btn"
          class="rounded-none bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-accent"
        >
          Demo: Enqueue Sample
        </button>
      </div>
      <div class="overflow-hidden rounded-none border border-border bg-card">
        <table class="min-w-full divide-y divide-border">
          <thead class="bg-secondary">
            <tr>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Request ID
              </th>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Session
              </th>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Priority
              </th>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Response Preview
              </th>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Confidence
              </th>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Queued At
              </th>
            </tr>
          </thead>
          <tbody id="pending-table-body" class="divide-y divide-border bg-card">
            <tr>
              <td
                colspan="6"
                class="px-4 py-8 text-center text-muted-foreground"
              >
                No pending interventions
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Recent Audit Trail -->
    <section id="audit-trail" class="mb-8">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-foreground">
          Recent Audit Trail
        </h2>
        <button
          id="refresh-audit-btn"
          class="rounded-none bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-accent"
        >
          Refresh
        </button>
      </div>
      <div class="overflow-hidden rounded-none border border-border bg-card">
        <table class="min-w-full divide-y divide-border">
          <thead class="bg-secondary">
            <tr>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Action
              </th>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Session
              </th>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Therapist
              </th>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Timestamp
              </th>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Reason
              </th>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Checklist
              </th>
            </tr>
          </thead>
          <tbody id="audit-table-body" class="divide-y divide-border bg-card">
            <tr>
              <td
                colspan="6"
                class="px-4 py-8 text-center text-muted-foreground"
              >
                No audit entries
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Recent Manual Overrides -->
    <section id="manual-overrides" class="mb-8">
      <h2 class="mb-4 text-lg font-semibold text-foreground">
        Recent Manual Overrides
      </h2>
      <div class="overflow-hidden rounded-none border border-border bg-card">
        <table class="min-w-full divide-y divide-border">
          <thead class="bg-secondary">
            <tr>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Override ID
              </th>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Session
              </th>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Action
              </th>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Therapist
              </th>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Reason
              </th>
              <th
                class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground"
              >
                Timestamp
              </th>
            </tr>
          </thead>
          <tbody
            id="overrides-table-body"
            class="divide-y divide-border bg-card"
          >
            <tr>
              <td
                colspan="6"
                class="px-4 py-8 text-center text-muted-foreground"
              >
                No manual overrides
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</DashboardLayout>

<script>
  const CHECKLIST_ITEMS = [
    {
      id: 'risk_assessed',
      label: 'Risk level has been assessed and is appropriate',
    },
    {
      id: 'technique_appropriate',
      label: 'Therapeutic technique is appropriate for the clinical context',
    },
    {
      id: 'no_harmful_content',
      label: 'Response contains no harmful or contraindicated content',
    },
    {
      id: 'privacy_preserved',
      label: 'Patient privacy and confidentiality are preserved',
    },
    {
      id: 'cultural_sensitivity',
      label: 'Response is culturally sensitive and appropriate',
    },
    {
      id: 'clinical_accuracy',
      label: 'Clinical information is accurate and evidence-based',
    },
    {
      id: 'appropriate_boundary',
      label: 'Response maintains appropriate therapeutic boundaries',
    },
    {
      id: 'crisis_protocol',
      label: 'If crisis indicators present, crisis protocol is followed',
    },
  ]

  function renderChecklist(satisfied = false) {
    const container = document.getElementById('checklist-items')
    if (!container) return
    container.innerHTML = CHECKLIST_ITEMS.map((item) => {
      const icon = satisfied
        ? '<span class="text-muted-foreground">\u2713</span>'
        : '<span class="text-muted-foreground">\u25CB</span>'
      return `
    <div class="flex items-center gap-3">
     <span class="text-lg">${icon}</span>
     <span class="text-sm text-foreground">${item.label}</span>
    </div>
   `
    }).join('')
  }

  // Demo: In a real app, this would fetch from /api/v1/admin/oversight/stats
  function updateStats() {
    // Placeholder: would be populated from API
  }

  function renderPending(interventions) {
    const tbody = document.getElementById('pending-table-body')
    if (!tbody) return
    if (!interventions || interventions.length === 0) {
      tbody.innerHTML =
        '<tr><td colspan="6" class="px-4 py-8 text-center text-muted-foreground">No pending interventions</td></tr>'
      return
    }
    tbody.innerHTML = interventions
      .map((i) => {
        const priorityColor =
          {
            critical:
              'bg-primary text-primary-foreground text-primary-foreground font-semibold',
            high: 'bg-secondary border border-ring text-foreground font-medium',
            medium:
              'bg-secondary border border-ring text-foreground font-medium',
            low: 'bg-secondary border border-input text-muted-foreground',
          }[i.priority] || 'bg-secondary text-foreground'
        const preview = (i.response?.content || '').slice(0, 80) + '...'
        return `
    <tr>
     <td class="px-4 py-3 text-sm text-muted-foreground">${i.requestId}</td>
     <td class="px-4 py-3 text-sm text-foreground">${i.sessionId}</td>
     <td class="px-4 py-3"><span class="inline-flex rounded-none px-2 py-0.5 text-xs font-medium ${priorityColor}">${i.priority}</span></td>
     <td class="px-4 py-3 text-sm text-foreground">${preview}</td>
     <td class="px-4 py-3 text-sm text-foreground">${((i.response?.confidence || 0) * 100).toFixed(0)}%</td>
     <td class="px-4 py-3 text-sm text-muted-foreground">${i.queuedAt}</td>
    </tr>
   `
      })
      .join('')
  }

  function renderAuditTrail(entries) {
    const tbody = document.getElementById('audit-table-body')
    if (!tbody) return
    if (!entries || entries.length === 0) {
      tbody.innerHTML =
        '<tr><td colspan="6" class="px-4 py-8 text-center text-muted-foreground">No audit entries</td></tr>'
      return
    }
    const actionColors = {
      approval: 'bg-secondary border border-input text-muted-foreground',
      rejection:
        'bg-primary text-primary-foreground text-primary-foreground font-semibold',
      override: 'bg-secondary border border-input text-foreground font-medium',
      queue: 'bg-secondary border border-input text-muted-foreground',
      expire: 'bg-secondary text-foreground text-foreground',
      checklist: 'bg-secondary border border-ring text-foreground font-medium',
    }
    tbody.innerHTML = entries
      .map((e) => {
        const color =
          actionColors[e.actionType] || 'bg-secondary text-foreground'
        const checklistBadge = e.checklistResult
          ? e.checklistResult.passed
            ? '<span class="text-muted-foreground">PASS</span>'
            : '<span class="text-foreground font-semibold">FAIL</span>'
          : '<span class="text-muted-foreground">N/A</span>'
        return `
    <tr>
     <td class="px-4 py-3"><span class="inline-flex rounded-none px-2 py-0.5 text-xs font-medium ${color}">${e.actionType}</span></td>
     <td class="px-4 py-3 text-sm text-foreground">${e.sessionId}</td>
     <td class="px-4 py-3 text-sm text-foreground">${e.therapistId}</td>
     <td class="px-4 py-3 text-sm text-muted-foreground">${e.timestamp}</td>
     <td class="px-4 py-3 text-sm text-foreground">${e.reason || '-'}</td>
     <td class="px-4 py-3 text-sm">${checklistBadge}</td>
    </tr>
   `
      })
      .join('')
  }

  function renderOverrides(overrides) {
    const tbody = document.getElementById('overrides-table-body')
    if (!tbody) return
    if (!overrides || overrides.length === 0) {
      tbody.innerHTML =
        '<tr><td colspan="6" class="px-4 py-8 text-center text-muted-foreground">No manual overrides</td></tr>'
      return
    }
    tbody.innerHTML = overrides
      .map((o) => {
        const actionColor =
          o.action === 'replace'
            ? 'bg-secondary border border-input text-foreground font-medium'
            : 'bg-primary text-primary-foreground text-primary-foreground font-semibold'
        return `
    <tr>
     <td class="px-4 py-3 text-sm text-muted-foreground">${o.overrideId}</td>
     <td class="px-4 py-3 text-sm text-foreground">${o.sessionId}</td>
     <td class="px-4 py-3"><span class="inline-flex rounded-none px-2 py-0.5 text-xs font-medium ${actionColor}">${o.action}</span></td>
     <td class="px-4 py-3 text-sm text-foreground">${o.therapistId}</td>
     <td class="px-4 py-3 text-sm text-foreground">${o.reason}</td>
     <td class="px-4 py-3 text-sm text-muted-foreground">${o.timestamp}</td>
    </tr>
   `
      })
      .join('')
  }

  // Demo data for initial render
  const demoPending = [
    {
      requestId: 'req-demo-001',
      sessionId: 'session-101',
      priority: 'high',
      response: {
        content:
          'I understand you are feeling overwhelmed. Let us explore grounding techniques.',
        confidence: 0.82,
      },
      queuedAt: new Date().toISOString(),
    },
  ]

  const demoAudit = [
    {
      actionType: 'queue',
      sessionId: 'session-101',
      therapistId: 'system',
      timestamp: new Date().toISOString(),
      reason: null,
      checklistResult: null,
    },
  ]

  const demoOverrides = [
    {
      overrideId: 'override-demo-001',
      sessionId: 'session-099',
      action: 'replace',
      therapistId: 'therapist-001',
      reason: 'Original response was too generic',
      timestamp: new Date().toISOString(),
    },
  ]

  // Initialize
  renderChecklist(false)
  renderPending(demoPending)
  renderAuditTrail(demoAudit)
  renderOverrides(demoOverrides)

  // Checklist demo button
  document
    .getElementById('checklist-demo-btn')
    ?.addEventListener('click', () => {
      renderChecklist(true)
      const status = document.getElementById('checklist-status')
      if (status) {
        status.textContent = 'All items satisfied - checklist passed'
        status.className = 'text-sm text-muted-foreground'
      }
    })

  // Enqueue demo button
  let demoCount = 1
  document.getElementById('enqueue-demo-btn')?.addEventListener('click', () => {
    demoCount++
    demoPending.push({
      requestId: `req-demo-${String(demoCount).padStart(3, '0')}`,
      sessionId: `session-${100 + demoCount}`,
      priority: ['critical', 'high', 'medium', 'low'][demoCount % 4],
      response: {
        content:
          'New intervention queued for review. Please verify clinical appropriateness.',
        confidence: 0.75,
      },
      queuedAt: new Date().toISOString(),
    })
    renderPending(demoPending)
  })

  // Refresh audit button
  document
    .getElementById('refresh-audit-btn')
    ?.addEventListener('click', () => {
      const status = document.getElementById('checklist-status')
      if (status) {
        status.textContent = 'Audit trail refreshed'
        status.className = 'text-sm text-foreground'
      }
    })
</script>
