---
import CardView from '@/components/views/CardView.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const frontmatter = {
  title: 'Highlights',
  subtitle: 'Showcase your creative work or curated posts',
  description: 'Showcase your creative work or curated posts',
  bgType: 'default',
  toc: false,
  ogImage: '/og-image.png',
}
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  bgType={frontmatter.bgType}
>
  <section class="py-12">
    <div class="mx-auto max-w-6xl px-4 text-center">
      <h1 class="text-white mb-4 text-4xl font-bold">{frontmatter.title}</h1>
      <p class="mb-12 text-lg text-muted-foreground">{frontmatter.subtitle}</p>
      <CardView collectionType="highlights" />
    </div>
  </section>
</BaseLayout>
