---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { DynamicSwiperCarousel } from '@/lib/utils/dynamic-components'

const cards = [
  {
    href: '/components/analytics-dashboard',
    title: 'Analytics Dashboard',
    blurb: 'Advanced charting and data visualization tools',
    icon: '📊',
    features: [
      'Multiple chart types (line, bar, pie, scatter)',
      'Real-time data updates',
      'Responsive design',
      'Interactive tooltips',
      'Therapy-focused analytics',
    ],
    cta: 'View Analytics Demo',
  },
  {
    href: '/components/emotion-visualization',
    title: '3D Emotion Visualization',
    blurb: 'Immersive emotion mapping and particle systems',
    icon: '🎭',
    features: [
      'Valence-Arousal-Dominance model',
      'Interactive 3D particle systems',
      'Real-time emotion tracking',
      'Mouse and touch controls',
      'WebGL performance optimization',
    ],
    cta: 'Explore 3D Emotions',
  },
  {
    href: '/components/treatment-plans',
    title: 'Treatment Plan Manager',
    blurb: 'Comprehensive clinical workflow management',
    icon: '🎯',
    features: [
      'SMART goal setting and tracking',
      'Milestone management',
      'Progress visualization',
      'Multi-category treatment plans',
      'Collaborative planning tools',
    ],
    cta: 'Manage Treatment Plans',
  },
  {
    href: '/components/security-demo',
    title: 'Privacy & Security Demo',
    blurb: 'Fully Homomorphic Encryption showcase',
    icon: '🔒',
    features: [
      'Compute on encrypted data',
      'HIPAA compliance demonstration',
      'Performance benchmarking',
      'Interactive FHE operations',
      'Privacy-preserving analytics',
    ],
    cta: 'Test FHE Security',
  },
  {
    href: '/components/ui-showcase',
    title: 'UI Component Showcase',
    blurb: 'Modern carousel and interface elements',
    icon: '🎨',
    features: [
      'Multiple carousel effects',
      'Touch gesture support',
      'Accessibility features',
      'Responsive breakpoints',
      'Custom content integration',
    ],
    cta: 'Explore UI Components',
  },
  {
    href: '/therapy-chat',
    title: 'Therapy Chat System',
    blurb: 'AI-powered therapeutic conversation interface',
    icon: '💬',
    features: [
      'AI therapy assistant integration',
      'Emotion-aware responses',
      'Crisis intervention protocols',
      'Session transcription',
      'Multi-modal communication',
    ],
    cta: 'Try Chat System',
  },
]

const integrations = [
  { name: 'Analytics Dashboard', state: 'integrated' },
  { name: '3D Emotion Visualization', state: 'integrated' },
  { name: 'Treatment Plan Manager', state: 'integrated' },
  { name: 'FHE Security Demo', state: 'integrated' },
  { name: 'UI Component Showcase', state: 'integrated' },
  { name: 'Therapy Chat System', state: 'previous' },
  { name: 'Emotion Temporal Analysis', state: 'previous' },
]
---

<BaseLayout
  title="Enterprise Components - Pixelated Empathy"
  description="Comprehensive showcase of enterprise-grade components for therapy and healthcare applications"
>
  <section class="container mx-auto py-8 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold mb-6 np-text">
          Enterprise Components
        </h1>
        <p class="text-xl max-w-3xl mx-auto np-muted">
          Discover our comprehensive suite of enterprise-grade components
          designed specifically for therapy platforms, healthcare applications,
          and patient management systems.
        </p>
      </div>

      <!-- Component Overview Carousel -->
      <div class="mb-16">
        <DynamicSwiperCarousel
          client:load
          effect="coverflow"
          autoplay={{ delay: 6000, disableOnInteraction: false }}
          navigation={true}
          pagination={{ clickable: true, dynamicBullets: true }}
          loop={true}
          slidesPerView={3}
          spaceBetween={30}
          centeredSlides={true}
          height="350px"
          className="mb-8"
          items={[
            {
              id: 'analytics',
              title: 'Analytics Dashboard',
              description: 'Advanced charting and data visualization',
              icon: 'chart',
              subtitle: 'Comprehensive data visualization and insights',
            },
            {
              id: 'emotion-viz',
              title: '3D Emotion Visualization',
              description: 'Immersive emotion mapping and particle systems',
              icon: '🎭',
              subtitle: 'Interactive emotion visualization systems',
            },
            {
              id: 'treatment',
              title: 'Treatment Planning',
              description: 'Comprehensive treatment plan management',
              icon: 'target',
              subtitle: 'Goal tracking and milestone management',
            },
            {
              id: 'security',
              title: 'Privacy & Security',
              description: 'Fully Homomorphic Encryption demo',
              icon: '🔒',
              subtitle: 'Privacy-preserving computation demo',
            },
            {
              id: 'ui-showcase',
              title: 'UI Components',
              description: 'Interactive user interface elements',
              icon: '🎨',
              subtitle: 'Modern carousel and interface components',
            },
          ]}
        />
      </div>

      <!-- Component Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {
          cards.map((card) => (
            <div
              class="overflow-hidden flex flex-col"
              style="background: var(--np-surface); border: 1px solid var(--np-line);"
            >
              <div class="p-6" style="background: var(--np-elevated);">
                <div class="text-4xl mb-3">{card.icon}</div>
                <h3 class="text-xl font-bold mb-2 np-text">{card.title}</h3>
                <p class="np-muted">{card.blurb}</p>
              </div>
              <div class="p-6 flex flex-col flex-1">
                <ul class="space-y-2 text-sm mb-4 np-mid flex-1">
                  {card.features.map((f) => (
                    <li>✓ {f}</li>
                  ))}
                </ul>
                <a
                  href={card.href}
                  class="inline-block w-full text-center px-4 py-2 font-semibold np-cta"
                >
                  {card.cta}
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Enterprise Features -->
      <div
        class="p-8 mb-16"
        style="background: var(--np-surface); border: 1px solid var(--np-line);"
      >
        <h2 class="text-3xl font-bold text-center mb-8 np-text">
          Enterprise-Grade Features
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="text-center">
            <div
              class="w-16 h-16 flex items-center justify-center mx-auto mb-4"
              style="background: var(--np-elevated); border: 1px solid var(--np-line);"
            >
              <span class="text-2xl">🏥</span>
            </div>
            <h4 class="font-semibold mb-2 np-text">HIPAA Compliant</h4>
            <p class="text-sm np-muted">
              Full healthcare data protection and privacy compliance
            </p>
          </div>
          <div class="text-center">
            <div
              class="w-16 h-16 flex items-center justify-center mx-auto mb-4"
              style="background: var(--np-elevated); border: 1px solid var(--np-line);"
            >
              <span class="text-2xl">📱</span>
            </div>
            <h4 class="font-semibold mb-2 np-text">Mobile First</h4>
            <p class="text-sm np-muted">
              Responsive design optimized for all device sizes
            </p>
          </div>
          <div class="text-center">
            <div
              class="w-16 h-16 flex items-center justify-center mx-auto mb-4"
              style="background: var(--np-elevated); border: 1px solid var(--np-line);"
            >
              <span class="text-2xl">♿</span>
            </div>
            <h4 class="font-semibold mb-2 np-text">Accessibility</h4>
            <p class="text-sm np-muted">
              WCAG 2.1 AA compliant with screen reader support
            </p>
          </div>
          <div class="text-center">
            <div
              class="w-16 h-16 flex items-center justify-center mx-auto mb-4"
              style="background: var(--np-elevated); border: 1px solid var(--np-line);"
            >
              <span class="text-2xl">⚡</span>
            </div>
            <h4 class="font-semibold mb-2 np-text">Performance</h4>
            <p class="text-sm np-muted">
              Optimized for speed with lazy loading and caching
            </p>
          </div>
        </div>
      </div>

      <!-- Integration Status -->
      <div
        class="p-8 mb-12"
        style="background: var(--np-surface); border: 1px solid var(--np-line);"
      >
        <h2 class="text-2xl font-bold mb-6 text-center np-text">
          Platform Integration Status
        </h2>
        <div class="space-y-4">
          {
            integrations.map((row) => (
              <div
                class="flex items-center justify-between p-4"
                style="background: var(--np-elevated); border: 1px solid var(--np-line);"
              >
                <div class="flex items-center space-x-3">
                  <div
                    class="w-3 h-3 np-mid"
                    style="background: var(--np-mid);"
                  />
                  <span class="font-medium np-text">{row.name}</span>
                </div>
                <span class="font-semibold np-mid">
                  {row.state === 'integrated'
                    ? '✓ Integrated'
                    : '✓ Previously Integrated'}
                </span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Call to Action -->
      <div class="text-center">
        <h2 class="text-3xl font-bold mb-4 np-text">Ready to Explore?</h2>
        <p class="text-xl mb-8 max-w-2xl mx-auto np-muted">
          Dive into our comprehensive component library and see how these
          enterprise-grade tools can transform your therapy platform experience.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/demo-hub"
            class="px-8 py-3 text-lg font-semibold np-cta"
            style="background: var(--np-elevated);"
          >
            Interactive Demo Hub
          </a>
          <a
            href="/dashboard"
            class="px-8 py-3 text-lg font-semibold"
            style="background: var(--np-surface); color: var(--np-text); border: 1px solid var(--np-line);"
          >
            Platform Dashboard
          </a>
          <a
            href="/mental-health-demo"
            class="px-8 py-3 text-lg font-semibold"
            style="background: var(--np-bg); color: var(--np-text); border: 1px solid var(--np-line);"
          >
            Mental Health Demo
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
