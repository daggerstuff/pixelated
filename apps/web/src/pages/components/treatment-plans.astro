---
import { ChartBar, Dumbbell, Target } from 'lucide-react'

import BaseLayout from '@/layouts/BaseLayout.astro'
import { DynamicTreatmentPlanManager } from '@/lib/utils/dynamic-components'
---

<BaseLayout
  title="Treatment Plan Management - Pixelated Empathy"
  description="Comprehensive treatment plan management system for therapists and patients"
>
  <section class="container mx-auto px-4 py-8">
    <div class="mx-auto max-w-7xl">
      <h1 class="mb-6 text-center text-3xl font-bold md:text-4xl">
        Treatment Plan Management
      </h1>

      <div class="prose dark:prose-invert mb-8 max-w-none text-center">
        <p class="text-xl">
          Comprehensive treatment planning system with goal tracking, milestone
          management, and progress monitoring for effective therapy outcomes.
        </p>
      </div>

      <!-- Main Treatment Plan Interface -->
      <div class="mb-8">
        <DynamicTreatmentPlanManager
          client:load
          className="w-full"
          readOnly={false}
        />
      </div>

      <!-- Features Overview -->
      <div class="mb-8 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-none border border-border bg-card p-6">
          <div class="mb-4 text-center text-3xl">
            <Target className="h-12 w-12" />
          </div>
          <h3 class="mb-3 text-center text-xl font-semibold">
            Goal Management
          </h3>
          <ul class="space-y-2 text-sm">
            <li>• SMART goal setting and tracking</li>
            <li>• Priority-based organization</li>
            <li>• Category-based classification</li>
            <li>• Progress percentage tracking</li>
            <li>• Target date management</li>
          </ul>
        </div>

        <div class="rounded-none border border-border bg-card p-6">
          <div class="mb-4 text-center text-3xl">📋</div>
          <h3 class="mb-3 text-center text-xl font-semibold">
            Milestone Tracking
          </h3>
          <ul class="space-y-2 text-sm">
            <li>• Detailed milestone breakdown</li>
            <li>• Completion date tracking</li>
            <li>• Notes and observations</li>
            <li>• Progress calculation</li>
            <li>• Visual progress indicators</li>
          </ul>
        </div>

        <div class="rounded-none border border-border bg-card p-6">
          <div class="mb-4 text-center text-3xl">
            <ChartBar className="h-12 w-12" />
          </div>
          <h3 class="mb-3 text-center text-xl font-semibold">
            Progress Analytics
          </h3>
          <ul class="space-y-2 text-sm">
            <li>• Visual progress charts</li>
            <li>• Overall completion metrics</li>
            <li>• Timeline visualization</li>
            <li>• Performance insights</li>
            <li>• Trend analysis</li>
          </ul>
        </div>
      </div>

      <!-- Clinical Categories -->
      <div class="mb-8 rounded-none border border-border bg-card p-6">
        <h2 class="mb-6 text-center text-2xl font-bold">
          Treatment Categories
        </h2>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-5">
          <div class="rounded-none border border-border bg-card p-4 text-center">
            <div class="mb-2 text-3xl">
              <Target className="h-8 w-8" />
            </div>
            <h4 class="font-semibold">Behavioral</h4>
            <p class="text-sm text-muted-foreground">
              Behavior modification and habit formation goals
            </p>
          </div>
          <div class="rounded-none border border-border bg-card p-4 text-center">
            <div class="mb-2 text-3xl">🧠</div>
            <h4 class="font-semibold">Cognitive</h4>
            <p class="text-sm text-muted-foreground">
              Thought pattern restructuring and cognitive therapy
            </p>
          </div>
          <div class="rounded-none border border-border bg-card p-4 text-center">
            <div class="mb-2 text-3xl">❤️</div>
            <h4 class="font-semibold">Emotional</h4>
            <p class="text-sm text-muted-foreground">
              Emotional regulation and awareness development
            </p>
          </div>
          <div class="rounded-none border border-border bg-card p-4 text-center">
            <div class="mb-2 text-3xl">👥</div>
            <h4 class="font-semibold">Social</h4>
            <p class="text-sm text-muted-foreground">
              Relationship building and social skills enhancement
            </p>
          </div>
          <div class="rounded-none border border-border bg-card p-4 text-center">
            <div class="mb-2 text-3xl">
              <Dumbbell className="h-8 w-8" />
            </div>
            <h4 class="font-semibold">Physical</h4>
            <p class="text-sm text-muted-foreground">
              Physical wellness and health-related objectives
            </p>
          </div>
        </div>
      </div>

      <!-- Workflow Integration -->
      <div class="mb-8 rounded-none bg-secondary p-6">
        <h2 class="mb-4 text-2xl font-bold">Clinical Workflow Integration</h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div>
            <h3 class="mb-3 text-lg font-semibold text-foreground">
              For Therapists
            </h3>
            <ul class="space-y-2 text-sm">
              <li>✓ Comprehensive patient assessment tools</li>
              <li>✓ Evidence-based treatment planning</li>
              <li>✓ Progress monitoring and reporting</li>
              <li>✓ Collaborative care coordination</li>
              <li>✓ Outcome measurement tracking</li>
            </ul>
          </div>
          <div>
            <h3 class="mb-3 text-lg font-semibold text-foreground">
              For Patients
            </h3>
            <ul class="space-y-2 text-sm">
              <li>✓ Clear goal visibility and understanding</li>
              <li>✓ Self-monitoring and progress tracking</li>
              <li>✓ Milestone celebration and motivation</li>
              <li>✓ Treatment engagement enhancement</li>
              <li>✓ Shared decision-making participation</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Technical Features -->
      <div class="mb-8 rounded-none bg-secondary p-6">
        <h2 class="mb-6 text-center text-2xl font-bold">
          Technical Capabilities
        </h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
          <div class="text-center">
            <div class="mb-2 text-2xl">🔒</div>
            <h4 class="font-semibold">Synthetic Practice Data</h4>
            <p class="text-sm text-muted-foreground">
              Built for synthetic scenarios, not real client records
            </p>
          </div>
          <div class="text-center">
            <div class="mb-2 text-2xl">📱</div>
            <h4 class="font-semibold">Mobile Ready</h4>
            <p class="text-sm text-muted-foreground">
              Responsive design for all devices
            </p>
          </div>
          <div class="text-center">
            <div class="mb-2 text-2xl">🔄</div>
            <h4 class="font-semibold">Real-time Sync</h4>
            <p class="text-sm text-muted-foreground">
              Instant updates across platforms
            </p>
          </div>
          <div class="text-center">
            <div class="mb-2 text-2xl">
              <ChartBar className="h-6 w-6" />
            </div>
            <h4 class="font-semibold">Analytics Ready</h4>
            <p class="text-sm text-muted-foreground">
              Integrated reporting and insights
            </p>
          </div>
        </div>
      </div>

      <!-- Call to Action -->
      <div class="text-center">
        <h2 class="mb-4 text-2xl font-bold">
          Ready to Transform Your Practice?
        </h2>
        <p class="mx-auto mb-6 max-w-2xl text-muted-foreground">
          Start using our comprehensive treatment planning system to improve
          patient outcomes, streamline workflows, and enhance the therapeutic
          relationship.
        </p>
        <div class="flex justify-center space-x-4">
          <a
            href="/dashboard"
            class="hover:bg-primary/90 rounded-none bg-primary px-6 py-3 text-primary-foreground transition-colors"
          >
            Start Planning
          </a>
          <a
            href="/demo-hub"
            class="hover:bg-primary/90 rounded-none bg-primary px-6 py-3 text-primary-foreground transition-colors"
          >
            View Demo
          </a>
          <a
            href="/components"
            class="rounded-none bg-secondary px-6 py-3 text-foreground transition-colors hover:bg-accent"
          >
            All Components
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
