---
import { ChartBar } from 'lucide-react'

import BaseLayout from '@/layouts/BaseLayout.astro'
import { DynamicFHEDemo } from '@/lib/utils/dynamic-components'
---

<BaseLayout
  title="Privacy & Security Demo - Pixelated Empathy"
  description="Fully Homomorphic Encryption demonstration for privacy-preserving therapy data analysis"
>
  <section class="container mx-auto px-4 py-8">
    <div class="mx-auto max-w-6xl">
      <h1 class="mb-6 text-center text-3xl font-bold md:text-4xl">
        🔒 Privacy & Security Demo
      </h1>

      <div class="prose dark:prose-invert mb-8 max-w-none text-center">
        <p class="text-xl">
          Experience cutting-edge Fully Homomorphic Encryption (FHE) technology
          that enables computation on encrypted therapy data without ever
          exposing sensitive information.
        </p>
      </div>

      <!-- Security Hero Section -->
      <div class="mb-8 rounded-none bg-card p-8 text-foreground">
        <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-2">
          <div>
            <h2 class="mb-4 text-2xl font-bold">
              Why Privacy Matters in Therapy
            </h2>
            <ul class="space-y-2">
              <li>
                ✓ <strong>Patient Trust:</strong> Complete confidentiality
                builds stronger therapeutic relationships
              </li>
              <li>
                ✓ <strong>Data Minimisation:</strong> compute over encrypted
                input without exposing the plaintext to the processor
              </li>
              <li>
                ✓ <strong>Research Ethics:</strong> Enable studies while
                protecting individual privacy
              </li>
              <li>
                ✓ <strong>Data Security:</strong> encryption applied to the data
                before it reaches the processing step
              </li>
            </ul>
          </div>
          <div class="text-center">
            <div class="mb-4 text-6xl">🛡️</div>
            <p class="text-lg font-semibold">Zero-Knowledge Processing</p>
            <p class="text-sm opacity-90">Analyze data without seeing it</p>
          </div>
        </div>
      </div>

      <!-- Interactive FHE Demo -->
      <div class="mb-8">
        <DynamicFHEDemo
          client:load
          className="w-full"
          showAdvanced={true}
          enableBenchmarks={true}
        />
      </div>

      <!-- How FHE Works -->
      <div class="mb-8 rounded-none border border-border bg-card p-6">
        <h2 class="mb-6 text-center text-2xl font-bold">
          How Fully Homomorphic Encryption Works
        </h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          <div class="text-center">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-none bg-secondary">
              <span class="text-2xl">🔐</span>
            </div>
            <h3 class="mb-2 text-lg font-semibold">1. Encrypt Data</h3>
            <p class="text-sm text-muted-foreground">
              Patient therapy data is encrypted using advanced mathematical
              techniques, making it completely unreadable while preserving its
              computational structure.
            </p>
          </div>
          <div class="text-center">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-none bg-secondary">
              <span class="text-2xl">⚙️</span>
            </div>
            <h3 class="mb-2 text-lg font-semibold">2. Compute Encrypted</h3>
            <p class="text-sm text-muted-foreground">
              Perform complex analytics, machine learning, and statistical
              analysis directly on the encrypted data without ever decrypting
              it.
            </p>
          </div>
          <div class="text-center">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-none bg-secondary">
              <ChartBar className="h-6 w-6" />
            </div>
            <h3 class="mb-2 text-lg font-semibold">3. Decrypt Results</h3>
            <p class="text-sm text-muted-foreground">
              Only the final analysis results are decrypted, revealing insights
              while keeping all individual patient data completely private.
            </p>
          </div>
        </div>
      </div>

      <!-- Use Cases -->
      <div class="mb-8 grid grid-cols-1 gap-8 md:grid-cols-2">
        <div class="rounded-none border border-border bg-card p-6">
          <h3 class="mb-4 text-xl font-semibold">🏥 Clinical Applications</h3>
          <div class="space-y-3">
            <div class="flex items-start space-x-3">
              <div class="text-xl text-foreground">•</div>
              <div>
                <strong>Multi-Site Research:</strong> Collaborate across
                institutions without sharing raw patient data
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div class="text-xl text-foreground">•</div>
              <div>
                <strong>Population Analytics:</strong> Analyze trends across
                patient populations while maintaining privacy
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div class="text-xl text-foreground">•</div>
              <div>
                <strong>Outcome Prediction:</strong> Build predictive models
                without exposing individual records
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div class="text-xl text-foreground">•</div>
              <div>
                <strong>Quality Assurance:</strong> Monitor treatment
                effectiveness while protecting patient identity
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-none border border-border bg-card p-6">
          <h3 class="mb-4 text-xl font-semibold">🔬 Research Benefits</h3>
          <div class="space-y-3">
            <div class="flex items-start space-x-3">
              <div class="text-xl text-foreground">•</div>
              <div>
                <strong>Larger Sample Sizes:</strong> Combine datasets from
                multiple sources securely
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div class="text-xl text-foreground">•</div>
              <div>
                <strong>Cross-Border Studies:</strong> International
                collaboration without data transfer restrictions
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div class="text-xl text-foreground">•</div>
              <div>
                <strong>Longitudinal Analysis:</strong> Track patient progress
                over time while maintaining anonymity
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div class="text-xl text-foreground">•</div>
              <div>
                <strong>Algorithm Development:</strong> Train AI models on
                sensitive data without privacy concerns
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Technical Specifications -->
      <div class="mb-8 rounded-none bg-secondary p-6">
        <h2 class="mb-6 text-center text-2xl font-bold">
          Technical Specifications
        </h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
          <div class="text-center">
            <div class="mb-2 text-3xl">🔑</div>
            <h4 class="font-semibold">Encryption Scheme</h4>
            <p class="text-sm text-muted-foreground">
              Microsoft SEAL with BFV/CKKS schemes
            </p>
          </div>
          <div class="text-center">
            <div class="mb-2 text-3xl">🛡️</div>
            <h4 class="font-semibold">Security Level</h4>
            <p class="text-sm text-muted-foreground">
              128-bit security with lattice-based cryptography
            </p>
          </div>
          <div class="text-center">
            <div class="mb-2 text-3xl">⚡</div>
            <h4 class="font-semibold">Performance</h4>
            <p class="text-sm text-muted-foreground">
              Optimized for real-time therapy applications
            </p>
          </div>
          <div class="text-center">
            <div class="mb-2 text-3xl">🌐</div>
            <h4 class="font-semibold">Compatibility</h4>
            <p class="text-sm text-muted-foreground">
              WebAssembly for cross-platform support
            </p>
          </div>
        </div>
      </div>

      <!-- Compliance & Standards -->
      <div class="mb-8 rounded-none bg-secondary p-6">
        <h2 class="mb-4 text-center text-2xl font-bold">
          What This Demo Does Not Claim
        </h2>
        <div class="grid grid-cols-1 gap-6 text-center md:grid-cols-3">
          <div>
            <div class="mb-2 text-4xl">🏥</div>
            <h4 class="font-semibold text-foreground">No HIPAA Claim</h4>
            <p class="text-sm">
              No HIPAA compliance determination has been made for this demo
            </p>
          </div>
          <div>
            <div class="mb-2 text-4xl">🌍</div>
            <h4 class="font-semibold text-foreground">No GDPR Claim</h4>
            <p class="text-sm">
              No GDPR readiness assessment has been performed
            </p>
          </div>
          <div>
            <div class="mb-2 text-4xl">🔒</div>
            <h4 class="font-semibold text-foreground">No SOC 2 Report</h4>
            <p class="text-sm">
              No SOC 2 audit has been performed for this platform
            </p>
          </div>
        </div>
      </div>

      <!-- Performance Comparison -->
      <div class="mb-8 rounded-none bg-secondary p-6">
        <h3 class="mb-4 text-xl font-semibold">
          ⚡ Performance Considerations
        </h3>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div>
            <h4 class="mb-2 font-semibold text-foreground">Trade-offs</h4>
            <ul class="space-y-1 text-sm">
              <li>
                • <strong>Computation Overhead:</strong> 100-1000x slower than
                plaintext operations
              </li>
              <li>
                • <strong>Memory Usage:</strong> Encrypted data requires more
                storage space
              </li>
              <li>
                • <strong>Network Bandwidth:</strong> Larger data packets for
                encrypted transmission
              </li>
            </ul>
          </div>
          <div>
            <h4 class="mb-2 font-semibold text-foreground">Optimizations</h4>
            <ul class="space-y-1 text-sm">
              <li>
                • <strong>Batching:</strong> Process multiple values
                simultaneously
              </li>
              <li>
                • <strong>Caching:</strong> Reuse computed intermediate results
              </li>
              <li>
                • <strong>Parallel Processing:</strong> Distribute computations
                across cores
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Navigation Links -->
      <div class="text-center">
        <h2 class="mb-4 text-2xl font-bold">
          Experience Privacy-First Therapy Technology
        </h2>
        <p class="mx-auto mb-6 max-w-2xl text-muted-foreground">
          Join the future of therapy where patient privacy and data utility
          coexist seamlessly through advanced cryptographic techniques.
        </p>
        <div class="flex justify-center space-x-4">
          <a
            href="/privacy"
            class="hover:bg-primary/90 rounded-none bg-primary px-6 py-3 text-primary-foreground transition-colors"
          >
            Privacy Policy
          </a>
          <a
            href="/admin/security"
            class="hover:bg-primary/90 rounded-none bg-primary px-6 py-3 text-primary-foreground transition-colors"
          >
            Security Details
          </a>
          <a
            href="/components"
            class="rounded-none bg-secondary px-6 py-3 text-foreground transition-colors hover:bg-accent"
          >
            All Components
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
