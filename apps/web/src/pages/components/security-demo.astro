---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { ChartBar } from 'lucide-react'
import { DynamicFHEDemo } from '@/lib/utils/dynamic-components'
---

<BaseLayout
  title="Privacy & Security Demo - Pixelated Empathy"
  description="Fully Homomorphic Encryption demonstration for privacy-preserving therapy data analysis"
>
  <section class="container mx-auto py-8 px-4">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold mb-6 text-center">
        🔒 Privacy & Security Demo
      </h1>

      <div class="prose dark:prose-invert max-w-none mb-8 text-center">
        <p class="text-xl">
          Experience cutting-edge Fully Homomorphic Encryption (FHE) technology
          that enables computation on encrypted therapy data without ever
          exposing sensitive information.
        </p>
      </div>

      <!-- Security Hero Section -->
      <div class="bg-card text-foreground rounded-none p-8 mb-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div>
            <h2 class="text-2xl font-bold mb-4">
              Why Privacy Matters in Therapy
            </h2>
            <ul class="space-y-2">
              <li>
                ✓ <strong>Patient Trust:</strong> Complete confidentiality
                builds stronger therapeutic relationships
              </li>
              <li>
                ✓ <strong>Legal Compliance:</strong> HIPAA and GDPR compliant
                data processing
              </li>
              <li>
                ✓ <strong>Research Ethics:</strong> Enable studies while
                protecting individual privacy
              </li>
              <li>
                ✓ <strong>Data Security:</strong> Military-grade encryption for
                all sensitive information
              </li>
            </ul>
          </div>
          <div class="text-center">
            <div class="text-6xl mb-4">🛡️</div>
            <p class="text-lg font-semibold">Zero-Knowledge Processing</p>
            <p class="text-sm opacity-90">Analyze data without seeing it</p>
          </div>
        </div>
      </div>

      <!-- Interactive FHE Demo -->
      <div class="mb-8">
        <DynamicFHEDemo
          client:load
          className="w-full"
          showAdvanced={true}
          enableBenchmarks={true}
        />
      </div>

      <!-- How FHE Works -->
      <div class="bg-card border border-border rounded-none p-6 mb-8">
        <h2 class="text-2xl font-bold mb-6 text-center">
          How Fully Homomorphic Encryption Works
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="text-center">
            <div class="bg-secondary rounded-none w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl">🔐</span>
            </div>
            <h3 class="text-lg font-semibold mb-2">1. Encrypt Data</h3>
            <p class="text-sm text-muted-foreground">
              Patient therapy data is encrypted using advanced mathematical
              techniques, making it completely unreadable while preserving its
              computational structure.
            </p>
          </div>
          <div class="text-center">
            <div class="bg-secondary rounded-none w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl">⚙️</span>
            </div>
            <h3 class="text-lg font-semibold mb-2">2. Compute Encrypted</h3>
            <p class="text-sm text-muted-foreground">
              Perform complex analytics, machine learning, and statistical
              analysis directly on the encrypted data without ever decrypting
              it.
            </p>
          </div>
          <div class="text-center">
            <div class="bg-secondary rounded-none w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <ChartBar className="w-6 h-6" />
            </div>
            <h3 class="text-lg font-semibold mb-2">3. Decrypt Results</h3>
            <p class="text-sm text-muted-foreground">
              Only the final analysis results are decrypted, revealing insights
              while keeping all individual patient data completely private.
            </p>
          </div>
        </div>
      </div>

      <!-- Use Cases -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
        <div class="bg-card border border-border rounded-none p-6">
          <h3 class="text-xl font-semibold mb-4">🏥 Clinical Applications</h3>
          <div class="space-y-3">
            <div class="flex items-start space-x-3">
              <div class="text-foreground text-xl">•</div>
              <div>
                <strong>Multi-Site Research:</strong> Collaborate across
                institutions without sharing raw patient data
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div class="text-foreground text-xl">•</div>
              <div>
                <strong>Population Analytics:</strong> Analyze trends across
                patient populations while maintaining privacy
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div class="text-foreground text-xl">•</div>
              <div>
                <strong>Outcome Prediction:</strong> Build predictive models
                without exposing individual records
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div class="text-foreground text-xl">•</div>
              <div>
                <strong>Quality Assurance:</strong> Monitor treatment
                effectiveness while protecting patient identity
              </div>
            </div>
          </div>
        </div>

        <div class="bg-card border border-border rounded-none p-6">
          <h3 class="text-xl font-semibold mb-4">🔬 Research Benefits</h3>
          <div class="space-y-3">
            <div class="flex items-start space-x-3">
              <div class="text-foreground text-xl">•</div>
              <div>
                <strong>Larger Sample Sizes:</strong> Combine datasets from
                multiple sources securely
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div class="text-foreground text-xl">•</div>
              <div>
                <strong>Cross-Border Studies:</strong> International
                collaboration without data transfer restrictions
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div class="text-foreground text-xl">•</div>
              <div>
                <strong>Longitudinal Analysis:</strong> Track patient progress
                over time while maintaining anonymity
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div class="text-foreground text-xl">•</div>
              <div>
                <strong>Algorithm Development:</strong> Train AI models on
                sensitive data without privacy concerns
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Technical Specifications -->
      <div class="bg-secondary rounded-none p-6 mb-8">
        <h2 class="text-2xl font-bold mb-6 text-center">
          Technical Specifications
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="text-center">
            <div class="text-3xl mb-2">🔑</div>
            <h4 class="font-semibold">Encryption Scheme</h4>
            <p class="text-sm text-muted-foreground">
              Microsoft SEAL with BFV/CKKS schemes
            </p>
          </div>
          <div class="text-center">
            <div class="text-3xl mb-2">🛡️</div>
            <h4 class="font-semibold">Security Level</h4>
            <p class="text-sm text-muted-foreground">
              128-bit security with lattice-based cryptography
            </p>
          </div>
          <div class="text-center">
            <div class="text-3xl mb-2">⚡</div>
            <h4 class="font-semibold">Performance</h4>
            <p class="text-sm text-muted-foreground">
              Optimized for real-time therapy applications
            </p>
          </div>
          <div class="text-center">
            <div class="text-3xl mb-2">🌐</div>
            <h4 class="font-semibold">Compatibility</h4>
            <p class="text-sm text-muted-foreground">
              WebAssembly for cross-platform support
            </p>
          </div>
        </div>
      </div>

      <!-- Compliance & Standards -->
      <div class="bg-secondary rounded-none p-6 mb-8">
        <h2 class="text-2xl font-bold mb-4 text-center">
          Compliance & Standards
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
          <div>
            <div class="text-4xl mb-2">🏥</div>
            <h4 class="font-semibold text-foreground">HIPAA Compliant</h4>
            <p class="text-sm">
              Full compliance with healthcare privacy regulations
            </p>
          </div>
          <div>
            <div class="text-4xl mb-2">🌍</div>
            <h4 class="font-semibold text-foreground">GDPR Ready</h4>
            <p class="text-sm">
              European data protection regulation compliance
            </p>
          </div>
          <div>
            <div class="text-4xl mb-2">🔒</div>
            <h4 class="font-semibold text-foreground">SOC 2 Type II</h4>
            <p class="text-sm">
              Enterprise-grade security and availability controls
            </p>
          </div>
        </div>
      </div>

      <!-- Performance Comparison -->
      <div class="bg-secondary rounded-none p-6 mb-8">
        <h3 class="text-xl font-semibold mb-4">
          ⚡ Performance Considerations
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h4 class="font-semibold mb-2 text-foreground">Trade-offs</h4>
            <ul class="text-sm space-y-1">
              <li>
                • <strong>Computation Overhead:</strong> 100-1000x slower than
                plaintext operations
              </li>
              <li>
                • <strong>Memory Usage:</strong> Encrypted data requires more
                storage space
              </li>
              <li>
                • <strong>Network Bandwidth:</strong> Larger data packets for
                encrypted transmission
              </li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold mb-2 text-foreground">Optimizations</h4>
            <ul class="text-sm space-y-1">
              <li>
                • <strong>Batching:</strong> Process multiple values
                simultaneously
              </li>
              <li>
                • <strong>Caching:</strong> Reuse computed intermediate results
              </li>
              <li>
                • <strong>Parallel Processing:</strong> Distribute computations
                across cores
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Navigation Links -->
      <div class="text-center">
        <h2 class="text-2xl font-bold mb-4">
          Experience Privacy-First Therapy Technology
        </h2>
        <p class="text-muted-foreground mb-6 max-w-2xl mx-auto">
          Join the future of therapy where patient privacy and data utility
          coexist seamlessly through advanced cryptographic techniques.
        </p>
        <div class="flex justify-center space-x-4">
          <a
            href="/privacy"
            class="px-6 py-3 bg-primary text-primary-foreground rounded-none hover:bg-primary/90 transition-colors"
          >
            Privacy Policy
          </a>
          <a
            href="/admin/security"
            class="px-6 py-3 bg-primary text-primary-foreground rounded-none hover:bg-primary/90 transition-colors"
          >
            Security Details
          </a>
          <a
            href="/components"
            class="px-6 py-3 bg-secondary text-foreground rounded-none hover:bg-accent transition-colors"
          >
            All Components
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
