---
import { Target, TrendingUp } from 'lucide-react'

import BaseLayout from '@/layouts/BaseLayout.astro'
import { DynamicSwiperCarousel } from '@/lib/utils/dynamic-components'
---

<BaseLayout
  title="UI Component Showcase - Pixelated Empathy"
  description="Interactive UI components including advanced carousel systems and user interface elements"
>
  <section class="container mx-auto px-4 py-8">
    <div class="mx-auto max-w-6xl">
      <h1 class="np-text mb-6 text-center text-3xl font-bold md:text-4xl">
        UI Component Showcase
      </h1>

      <div class="prose dark:prose-invert mb-8 max-w-none text-center">
        <p class="np-text text-xl">
          Modern, accessible, and responsive UI components designed for optimal
          user experience in therapy and healthcare applications.
        </p>
      </div>

      <!-- Feature Carousel -->
      <div
        class="np-surface mb-8 p-6"
        style="border: 1px solid var(--np-line);"
      >
        <h2 class="np-text mb-4 text-2xl font-semibold">
          Feature Carousel - Slide Effect
        </h2>
        <p class="np-muted mb-6">
          Showcase platform features with smooth sliding transitions and
          responsive design.
        </p>
        <DynamicSwiperCarousel
          client:load
          effect="slide"
          autoplay={{ delay: 4000, disableOnInteraction: false }}
          navigation={true}
          pagination={{ clickable: true, dynamicBullets: true }}
          loop={true}
          slidesPerView={1}
          spaceBetween={30}
          height="400px"
          className="mb-4"
        />
      </div>

      <!-- Therapy Journey Carousel - Coverflow Effect -->
      <div
        class="np-surface mb-8 p-6"
        style="border: 1px solid var(--np-line);"
      >
        <h2 class="np-text mb-4 text-2xl font-semibold">
          Therapy Journey - Coverflow Effect
        </h2>
        <p class="np-muted mb-6">
          Interactive 3D coverflow effect for displaying therapy milestones and
          progress.
        </p>
        <DynamicSwiperCarousel
          client:load
          effect="coverflow"
          autoplay={false}
          navigation={true}
          pagination={{ clickable: true }}
          loop={true}
          slidesPerView={3}
          spaceBetween={20}
          centeredSlides={true}
          height="350px"
          className="mb-4"
          items={[
            {
              id: 'journey-1',
              title: 'Initial Assessment',
              description: 'Comprehensive evaluation and goal setting',
              content:
                '<div class="flex flex-col items-center justify-center h-full p-6" style="background:var(--np-elevated);color:var(--np-text)"><div class="text-5xl mb-4">📋</div><h3 class="text-xl font-bold mb-2">Assessment</h3><p class="text-center text-sm np-muted">Understanding your unique needs and challenges</p></div>',
            },
            {
              id: 'journey-2',
              title: 'Treatment Planning',
              description:
                'Collaborative goal setting and strategy development',
              content:
                '<div class="flex flex-col items-center justify-center h-full p-6" style="background:var(--np-elevated);color:var(--np-text)"><div class="text-5xl mb-4"><Target className="w-20 h-20" /></div><h3 class="text-xl font-bold mb-2">Planning</h3><p class="text-center text-sm np-muted">Creating personalized treatment strategies</p></div>',
            },
            {
              id: 'journey-3',
              title: 'Active Therapy',
              description: 'Regular sessions and skill building',
              content:
                '<div class="flex flex-col items-center justify-center h-full p-6" style="background:var(--np-elevated);color:var(--np-text)"><div class="text-5xl mb-4">💬</div><h3 class="text-xl font-bold mb-2">Therapy</h3><p class="text-center text-sm np-muted">Building skills and processing experiences</p></div>',
            },
            {
              id: 'journey-4',
              title: 'Progress Monitoring',
              description: 'Tracking improvements and adjusting approach',
              content:
                '<div class="flex flex-col items-center justify-center h-full p-6" style="background:var(--np-elevated);color:var(--np-text)"><div class="text-5xl mb-4"><TrendingUp className="w-20 h-20" /></div><h3 class="text-xl font-bold mb-2">Progress</h3><p class="text-center text-sm np-muted">Measuring growth and celebrating victories</p></div>',
            },
            {
              id: 'journey-5',
              title: 'Maintenance & Growth',
              description: 'Sustaining progress and continued development',
              content:
                '<div class="flex flex-col items-center justify-center h-full p-6" style="background:var(--np-elevated);color:var(--np-text)"><div class="text-5xl mb-4">🌱</div><h3 class="text-xl font-bold mb-2">Growth</h3><p class="text-center text-sm np-muted">Maintaining wellness and continued growth</p></div>',
            },
          ]}
        />
      </div>

      <!-- Testimonials - Fade Effect -->
      <div
        class="np-surface mb-8 p-6"
        style="border: 1px solid var(--np-line);"
      >
        <h2 class="np-text mb-4 text-2xl font-semibold">
          Patient Testimonials - Fade Effect
        </h2>
        <p class="np-muted mb-6">
          Smooth fade transitions for displaying patient success stories and
          testimonials.
        </p>
        <DynamicSwiperCarousel
          client:load
          effect="fade"
          autoplay={false}
          navigation={true}
          pagination={{ clickable: true }}
          loop={true}
          slidesPerView={3}
          spaceBetween={20}
          centeredSlides={true}
          height="350px"
          className="mb-4"
          items={[
            {
              id: 'testimonial-1',
              content:
                '<div class="flex flex-col items-center justify-center h-full p-8" style="background:var(--np-surface);color:var(--np-text)"><div class="text-4xl mb-4">💙</div><blockquote class="text-lg italic text-center mb-4">"The platform helped me understand my emotions better and gave me practical tools to manage anxiety."</blockquote><p class="font-semibold">- Sarah M.</p><p class="text-sm np-muted">Anxiety & Depression Recovery</p></div>',
            },
            {
              id: 'testimonial-2',
              content:
                '<div class="flex flex-col items-center justify-center h-full p-8" style="background:var(--np-surface);color:var(--np-text)"><div class="text-4xl mb-4">🌟</div><blockquote class="text-lg italic text-center mb-4">"The visualization tools made it easier to track my progress and stay motivated throughout treatment."</blockquote><p class="font-semibold">- Michael R.</p><p class="text-sm np-muted">PTSD Treatment</p></div>',
            },
            {
              id: 'testimonial-3',
              content:
                '<div class="flex flex-col items-center justify-center h-full p-8" style="background:var(--np-surface);color:var(--np-text)"><div class="text-4xl mb-4"><Target className="w-16 h-16" /></div><blockquote class="text-lg italic text-center mb-4">"Having clear treatment goals and being able to see my progress helped me stay engaged in therapy."</blockquote><p class="font-semibold">- Jessica L.</p><p class="text-sm np-muted">Behavioral Change Program</p></div>',
            },
          ]}
        />
      </div>

      <!-- Technical Features -->
      <div
        class="mb-8 p-6"
        style="background: var(--np-bg); border: 1px solid var(--np-line);"
      >
        <h2 class="np-text mb-6 text-center text-2xl font-bold">
          Carousel Features
        </h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
          <div class="text-center">
            <div class="mb-2 text-3xl">🎨</div>
            <h4 class="np-text font-semibold">Multiple Effects</h4>
            <p class="np-muted text-sm">
              Slide, fade, coverflow, and more transition effects
            </p>
          </div>
          <div class="text-center">
            <div class="mb-2 text-3xl">📱</div>
            <h4 class="np-text font-semibold">Touch Gestures</h4>
            <p class="np-muted text-sm">
              Native touch and swipe support for mobile devices
            </p>
          </div>
          <div class="text-center">
            <div class="mb-2 text-3xl">⚡</div>
            <h4 class="np-text font-semibold">Performance</h4>
            <p class="np-muted text-sm">
              Hardware accelerated and optimized for smooth performance
            </p>
          </div>
          <div class="text-center">
            <div class="mb-2 text-3xl">♿</div>
            <h4 class="np-text font-semibold">Accessibility</h4>
            <p class="np-muted text-sm">
              Full keyboard navigation and screen reader support
            </p>
          </div>
        </div>
      </div>

      <!-- Responsive Design Demo -->
      <div
        class="mb-8 p-6"
        style="background: var(--np-surface); border: 1px solid var(--np-line);"
      >
        <h2 class="np-text mb-4 text-2xl font-bold">Responsive Design</h2>
        <div class="grid grid-cols-1 gap-4 text-center md:grid-cols-3">
          <div class="p-4" style="background: var(--np-elevated);">
            <div class="mb-2 text-2xl">📱</div>
            <h4 class="np-text font-semibold">Mobile</h4>
            <p class="np-muted text-sm">
              1 slide per view, optimized touch controls
            </p>
          </div>
          <div class="p-4" style="background: var(--np-elevated);">
            <div class="mb-2 text-2xl">💻</div>
            <h4 class="np-text font-semibold">Tablet</h4>
            <p class="np-muted text-sm">2-3 slides per view, balanced layout</p>
          </div>
          <div class="p-4" style="background: var(--np-elevated);">
            <div class="mb-2 text-2xl">🖥️</div>
            <h4 class="np-text font-semibold">Desktop</h4>
            <p class="np-muted text-sm">Full feature set, multiple slides</p>
          </div>
        </div>
      </div>

      <!-- Use Cases -->
      <div
        class="np-surface mb-8 p-6"
        style="border: 1px solid var(--np-line);"
      >
        <h2 class="np-text mb-6 text-center text-2xl font-bold">
          Platform Integration Use Cases
        </h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div>
            <h3 class="np-text mb-3 text-lg font-semibold">
              Patient Onboarding
            </h3>
            <ul class="np-mid space-y-2 text-sm">
              <li>✓ Step-by-step platform introduction</li>
              <li>✓ Feature highlights and tutorials</li>
              <li>✓ Treatment process explanation</li>
              <li>✓ Goal setting walkthrough</li>
            </ul>
          </div>
          <div>
            <h3 class="np-text mb-3 text-lg font-semibold">
              Content Presentation
            </h3>
            <ul class="np-mid space-y-2 text-sm">
              <li>✓ Educational material delivery</li>
              <li>✓ Exercise and technique demonstrations</li>
              <li>✓ Progress celebration displays</li>
              <li>✓ Resource library navigation</li>
            </ul>
          </div>
          <div>
            <h3 class="np-text mb-3 text-lg font-semibold">
              Dashboard Features
            </h3>
            <ul class="np-mid space-y-2 text-sm">
              <li>✓ Quick access to recent activities</li>
              <li>✓ Upcoming appointments display</li>
              <li>✓ Treatment plan overview</li>
              <li>✓ Achievement showcases</li>
            </ul>
          </div>
          <div>
            <h3 class="np-text mb-3 text-lg font-semibold">
              Therapeutic Tools
            </h3>
            <ul class="np-mid space-y-2 text-sm">
              <li>✓ Guided meditation sessions</li>
              <li>✓ Coping strategy presentations</li>
              <li>✓ Interactive therapy exercises</li>
              <li>✓ Mood tracking interfaces</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Navigation Links -->
      <div class="text-center">
        <h2 class="np-text mb-4 text-2xl font-bold">
          Enhance Your User Experience
        </h2>
        <p class="np-muted mx-auto mb-6 max-w-2xl">
          Discover how these interactive UI components can improve engagement
          and accessibility in your therapy platform.
        </p>
        <div class="flex justify-center space-x-4">
          <a
            href="/demo-hub"
            class="np-cta px-6 py-3 font-semibold transition-colors"
            style="background: var(--np-elevated); color: var(--np-text); border: 1px solid var(--np-line);"
          >
            Try Interactive Demo
          </a>
          <a
            href="/docs/developer/code-examples"
            class="np-cta px-6 py-3 font-semibold transition-colors"
            style="background: var(--np-elevated); color: var(--np-text); border: 1px solid var(--np-line);"
          >
            Design System
          </a>
          <a
            href="/components"
            class="np-cta px-6 py-3 font-semibold transition-colors"
            style="background: var(--np-bg); color: var(--np-text); border: 1px solid var(--np-line);"
          >
            All Components
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
