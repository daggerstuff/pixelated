---
import BaseLayout from '@/layouts/BaseLayout.astro'
import {
  DynamicMultidimensionalEmotionChart,
  DynamicParticleVisualization,
} from '@/lib/utils/dynamic-components'
---

<BaseLayout
  title="3D Emotion Visualization - Pixelated Empathy"
  description="Advanced 3D emotion mapping and particle visualization for therapy sessions"
>
  <section class="container mx-auto px-4 py-8">
    <div class="mx-auto max-w-6xl">
      <h1 class="mb-6 text-center text-3xl font-bold md:text-4xl">
        3D Emotion Visualization
      </h1>

      <div class="prose dark:prose-invert mb-8 max-w-none text-center">
        <p class="text-xl">
          Immersive 3D visualization of emotional states using the
          Valence-Arousal-Dominance model and interactive particle systems for
          therapy sessions.
        </p>
      </div>

      <!-- Multidimensional Emotion Chart -->
      <div class="mb-8 rounded-none border border-border bg-card p-6">
        <h2 class="mb-4 text-2xl font-semibold">
          Multidimensional Emotion Mapping
        </h2>
        <p class="mb-6 text-muted-foreground">
          Interactive 3D visualization of emotions plotted in
          valence-arousal-dominance space. Hover over emotion points to see
          details and explore the emotional journey.
        </p>
        <DynamicMultidimensionalEmotionChart
          client:load
          showTrails={true}
          showAxes={true}
          className="mb-4"
        />
      </div>

      <!-- Particle Emotion System -->
      <div class="mb-8 rounded-none border border-border bg-card p-6">
        <h2 class="mb-4 text-2xl font-semibold">
          Interactive Particle Emotions
        </h2>
        <p class="mb-6 text-muted-foreground">
          Dynamic particle system that responds to different emotional states.
          Use the emotion controls to see how particles behave based on
          different feelings.
        </p>
        <DynamicParticleVisualization
          client:load
          particleCount={40}
          emotion="neutral"
          interactive={true}
          autoAnimate={true}
          enableMouse={true}
          showTrails={false}
          className="mb-4"
        />
      </div>

      <!-- Technical Details -->
      <div class="mb-8 grid grid-cols-1 gap-8 md:grid-cols-2">
        <div class="rounded-none border border-border bg-card p-6">
          <h3 class="mb-4 text-xl font-semibold">🧠 Emotion Model</h3>
          <div class="space-y-3">
            <div>
              <strong>Valence:</strong> Measures how positive or negative an
              emotion feels
            </div>
            <div>
              <strong>Arousal:</strong> Measures the intensity or energy level
              of the emotion
            </div>
            <div>
              <strong>Dominance:</strong> Measures the sense of control or power
              in the emotion
            </div>
          </div>
        </div>

        <div class="rounded-none border border-border bg-card p-6">
          <h3 class="mb-4 flex items-center gap-2 text-xl font-semibold">
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"></svg>{' '}
            Clinical Applications
          </h3>
          <div class="space-y-3">
            <div>
              <strong>Session Analysis:</strong> Visualize emotional patterns
              during therapy
            </div>
            <div>
              <strong>Progress Tracking:</strong> Monitor emotional stability
              over time
            </div>
            <div>
              <strong>Pattern Recognition:</strong> Identify emotional triggers
              and responses
            </div>
          </div>
        </div>
      </div>

      <!-- Features Grid -->
      <div class="mb-8 rounded-none bg-secondary p-6">
        <h2 class="mb-6 text-center text-2xl font-bold">
          Visualization Features
        </h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
          <div class="text-center">
            <div class="mb-2 text-3xl">🎨</div>
            <h4 class="mb-2 font-semibold">Color Coding</h4>
            <p class="text-sm text-muted-foreground">
              Emotion-based color mapping for instant recognition
            </p>
          </div>
          <div class="text-center">
            <div class="mb-2 text-3xl">🌟</div>
            <h4 class="mb-2 font-semibold">Interactive Controls</h4>
            <p class="text-sm text-muted-foreground">
              Mouse and touch controls for exploration
            </p>
          </div>
          <div class="text-center">
            <div class="mb-2 text-3xl">🔄</div>
            <h4 class="mb-2 font-semibold">Real-time Animation</h4>
            <p class="text-sm text-muted-foreground">
              Dynamic particle behaviors and transitions
            </p>
          </div>
          <div class="text-center">
            <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"></svg>
            <h4 class="mb-2 font-semibold">Data Visualization</h4>
            <p class="text-sm text-muted-foreground">
              Comprehensive emotion mapping and trails
            </p>
          </div>
        </div>
      </div>

      <!-- Integration Info -->
      <div class="mb-8 rounded-none bg-secondary p-6">
        <h3 class="mb-4 text-xl font-semibold">🔗 Platform Integration</h3>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          <div>
            <h4 class="font-semibold text-foreground">Therapy Sessions</h4>
            <p class="text-sm">
              Real-time emotion tracking during therapy sessions
            </p>
          </div>
          <div>
            <h4 class="font-semibold text-foreground">Progress Reports</h4>
            <p class="text-sm">
              Visual progress reporting for patients and therapists
            </p>
          </div>
          <div>
            <h4 class="font-semibold text-foreground">Research Tools</h4>
            <p class="text-sm">
              Data collection and analysis for research purposes
            </p>
          </div>
        </div>
      </div>

      <!-- Navigation Links -->
      <div class="flex justify-center space-x-4">
        <a
          href="/simulator"
          class="hover:bg-primary/90 rounded-none bg-primary px-6 py-3 text-primary-foreground transition-colors"
        >
          Try in Session
        </a>
        <a
          href="/components"
          class="rounded-none bg-secondary px-6 py-3 text-foreground transition-colors hover:bg-accent"
        >
          All Components
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
