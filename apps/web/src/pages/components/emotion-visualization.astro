---
import BaseLayout from '@/layouts/BaseLayout.astro'
import {
  DynamicMultidimensionalEmotionChart,
  DynamicParticleVisualization,
} from '@/lib/utils/dynamic-components'
---

<BaseLayout
  title="3D Emotion Visualization - Pixelated Empathy"
  description="Advanced 3D emotion mapping and particle visualization for therapy sessions"
>
  <section class="container mx-auto py-8 px-4">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold mb-6 text-center">
        3D Emotion Visualization
      </h1>

      <div class="prose dark:prose-invert max-w-none mb-8 text-center">
        <p class="text-xl">
          Immersive 3D visualization of emotional states using the
          Valence-Arousal-Dominance model and interactive particle systems for
          therapy sessions.
        </p>
      </div>

      <!-- Multidimensional Emotion Chart -->
      <div class="bg-card border border-border rounded-none p-6 mb-8">
        <h2 class="text-2xl font-semibold mb-4">
          Multidimensional Emotion Mapping
        </h2>
        <p class="text-muted-foreground mb-6">
          Interactive 3D visualization of emotions plotted in
          valence-arousal-dominance space. Hover over emotion points to see
          details and explore the emotional journey.
        </p>
        <DynamicMultidimensionalEmotionChart
          client:load
          showTrails={true}
          showAxes={true}
          className="mb-4"
        />
      </div>

      <!-- Particle Emotion System -->
      <div class="bg-card border border-border rounded-none p-6 mb-8">
        <h2 class="text-2xl font-semibold mb-4">
          Interactive Particle Emotions
        </h2>
        <p class="text-muted-foreground mb-6">
          Dynamic particle system that responds to different emotional states.
          Use the emotion controls to see how particles behave based on
          different feelings.
        </p>
        <DynamicParticleVisualization
          client:load
          particleCount={40}
          emotion="neutral"
          interactive={true}
          autoAnimate={true}
          enableMouse={true}
          showTrails={false}
          className="mb-4"
        />
      </div>

      <!-- Technical Details -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
        <div class="bg-card border border-border rounded-none p-6">
          <h3 class="text-xl font-semibold mb-4">🧠 Emotion Model</h3>
          <div class="space-y-3">
            <div>
              <strong>Valence:</strong> Measures how positive or negative an
              emotion feels
            </div>
            <div>
              <strong>Arousal:</strong> Measures the intensity or energy level
              of the emotion
            </div>
            <div>
              <strong>Dominance:</strong> Measures the sense of control or power
              in the emotion
            </div>
          </div>
        </div>

        <div class="bg-card border border-border rounded-none p-6">
          <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"></svg>{' '}
            Clinical Applications
          </h3>
          <div class="space-y-3">
            <div>
              <strong>Session Analysis:</strong> Visualize emotional patterns
              during therapy
            </div>
            <div>
              <strong>Progress Tracking:</strong> Monitor emotional stability
              over time
            </div>
            <div>
              <strong>Pattern Recognition:</strong> Identify emotional triggers
              and responses
            </div>
          </div>
        </div>
      </div>

      <!-- Features Grid -->
      <div class="bg-secondary rounded-none p-6 mb-8">
        <h2 class="text-2xl font-bold mb-6 text-center">
          Visualization Features
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="text-center">
            <div class="text-3xl mb-2">🎨</div>
            <h4 class="font-semibold mb-2">Color Coding</h4>
            <p class="text-sm text-muted-foreground">
              Emotion-based color mapping for instant recognition
            </p>
          </div>
          <div class="text-center">
            <div class="text-3xl mb-2">🌟</div>
            <h4 class="font-semibold mb-2">Interactive Controls</h4>
            <p class="text-sm text-muted-foreground">
              Mouse and touch controls for exploration
            </p>
          </div>
          <div class="text-center">
            <div class="text-3xl mb-2">🔄</div>
            <h4 class="font-semibold mb-2">Real-time Animation</h4>
            <p class="text-sm text-muted-foreground">
              Dynamic particle behaviors and transitions
            </p>
          </div>
          <div class="text-center">
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"></svg>
            <h4 class="font-semibold mb-2">Data Visualization</h4>
            <p class="text-sm text-muted-foreground">
              Comprehensive emotion mapping and trails
            </p>
          </div>
        </div>
      </div>

      <!-- Integration Info -->
      <div class="bg-secondary rounded-none p-6 mb-8">
        <h3 class="text-xl font-semibold mb-4">🔗 Platform Integration</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <h4 class="font-semibold text-foreground">Therapy Sessions</h4>
            <p class="text-sm">
              Real-time emotion tracking during therapy sessions
            </p>
          </div>
          <div>
            <h4 class="font-semibold text-foreground">Progress Reports</h4>
            <p class="text-sm">
              Visual progress reporting for patients and therapists
            </p>
          </div>
          <div>
            <h4 class="font-semibold text-foreground">Research Tools</h4>
            <p class="text-sm">
              Data collection and analysis for research purposes
            </p>
          </div>
        </div>
      </div>

      <!-- Navigation Links -->
      <div class="flex justify-center space-x-4">
        <a
          href="/simulator"
          class="px-6 py-3 bg-primary text-primary-foreground rounded-none hover:bg-primary/90 transition-colors"
        >
          Try in Session
        </a>
        <a
          href="/components"
          class="px-6 py-3 bg-secondary text-foreground rounded-none hover:bg-accent transition-colors"
        >
          All Components
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
