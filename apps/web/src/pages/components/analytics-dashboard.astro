---
import { ChartBar, Search, Target, TrendingUp } from 'lucide-react'

import BaseLayout from '@/layouts/BaseLayout.astro'
import { DynamicChartComponent } from '@/lib/utils/dynamic-components'
---

<BaseLayout
  title="Analytics Dashboard - Pixelated Empathy"
  description="Advanced analytics and visualization tools for therapy data analysis"
>
  <section class="container mx-auto px-4 py-8">
    <div class="mx-auto max-w-6xl">
      <h1 class="mb-6 text-center text-3xl font-bold md:text-4xl">
        Analytics Dashboard
      </h1>

      <div class="prose dark:prose-invert mb-8 max-w-none text-center">
        <p class="text-xl">
          Comprehensive analytics and visualization tools for therapy session
          data, patient progress tracking, and clinical insights.
        </p>
      </div>

      <!-- Chart Gallery -->
      <div class="mb-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
        <!-- Progress Tracking Chart -->
        <div class="rounded-none border border-border bg-card p-6">
          <h3 class="mb-4 text-xl font-semibold">Patient Progress Tracking</h3>
          <DynamicChartComponent
            client:load
            type="line"
            title="Therapy Progress Over Time"
            className="mb-4"
            data={{
              category: 'progress',
              timeRange: 30,
              dataPoints: 15,
              useBackendData: true,
              autoRefresh: true,
              refreshInterval: 30000,
            }}
          />
        </div>

        <!-- Session Metrics Chart -->
        <div class="rounded-none border border-border bg-card p-6">
          <h3 class="mb-4 text-xl font-semibold">Session Metrics</h3>
          <DynamicChartComponent
            client:load
            type="bar"
            title="Session Analysis"
            className="mb-4"
            data={{
              category: 'sessions',
              timeRange: 7,
              useBackendData: true,
            }}
          />
        </div>

        <!-- Emotion Distribution -->
        <div class="rounded-none border border-border bg-card p-6">
          <h3 class="mb-4 text-xl font-semibold">Emotion Distribution</h3>
          <DynamicChartComponent
            client:load
            type="pie"
            title="Emotional State Analysis"
            className="mb-4"
            data={{
              category: 'emotions',
              timeRange: 14,
              useBackendData: true,
            }}
          />
        </div>

        <!-- Correlation Analysis -->
        <div class="rounded-none border border-border bg-card p-6">
          <h3 class="mb-4 text-xl font-semibold">Correlation Analysis</h3>
          <DynamicChartComponent
            client:load
            type="scatter"
            title="Factor Correlation"
            className="mb-4"
            data={{
              category: 'emotions',
              timeRange: 30,
              dataPoints: 50,
              useBackendData: true,
            }}
          />
        </div>
      </div>

      <!-- Features Section -->
      <div class="mb-8 rounded-none bg-secondary p-6">
        <h2 class="mb-4 text-2xl font-bold">Key Features</h2>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
          <div class="flex items-start space-x-3">
            <div class="text-2xl">
              <ChartBar className="h-6 w-6" />
            </div>
            <div>
              <h4 class="font-semibold">Real-time Analytics</h4>
              <p class="text-sm text-muted-foreground">
                Live data visualization and updates
              </p>
            </div>
          </div>
          <div class="flex items-start space-x-3">
            <div class="text-2xl">
              <Target className="h-6 w-6" />
            </div>
            <div>
              <h4 class="font-semibold">Progress Tracking</h4>
              <p class="text-sm text-muted-foreground">
                Monitor patient progress over time
              </p>
            </div>
          </div>
          <div class="flex items-start space-x-3">
            <div class="text-2xl">
              <Search className="h-6 w-6" />
            </div>
            <div>
              <h4 class="font-semibold">Pattern Recognition</h4>
              <p class="text-sm text-muted-foreground">
                Identify trends and patterns in therapy data
              </p>
            </div>
          </div>
          <div class="flex items-start space-x-3">
            <div class="text-2xl">
              <TrendingUp className="h-6 w-6" />
            </div>
            <div>
              <h4 class="font-semibold">Performance Metrics</h4>
              <p class="text-sm text-muted-foreground">
                Comprehensive session and outcome metrics
              </p>
            </div>
          </div>
          <div class="flex items-start space-x-3">
            <div class="text-2xl">🎨</div>
            <div>
              <h4 class="font-semibold">Customizable Views</h4>
              <p class="text-sm text-muted-foreground">
                Flexible chart types and configurations
              </p>
            </div>
          </div>
          <div class="flex items-start space-x-3">
            <div class="text-2xl">📱</div>
            <div>
              <h4 class="font-semibold">Responsive Design</h4>
              <p class="text-sm text-muted-foreground">
                Works seamlessly on all devices
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Navigation Links -->
      <div class="flex justify-center space-x-4">
        <a
          href="/dashboard"
          class="hover:bg-primary/90 rounded-none bg-primary px-6 py-3 text-primary-foreground transition-colors"
        >
          View Full Dashboard
        </a>
        <a
          href="/components"
          class="rounded-none bg-secondary px-6 py-3 text-foreground transition-colors hover:bg-accent"
        >
          All Components
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
