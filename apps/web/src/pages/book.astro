---
import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = false
---

<BaseLayout
  title="Book Your Session - Pixelated Empathy"
  description="Schedule your therapy session with our licensed professionals"
  bgType={false}
>
  <div class="flex min-h-[80vh] items-center justify-center px-4">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="mb-6 text-4xl font-bold text-foreground lg:text-6xl">
        Book Your Session
      </h1>

      <p class="mb-8 text-xl text-muted-foreground">
        Connect with licensed therapists for professional mental health care.
      </p>

      <div class="rounded-none border border-border bg-card p-8">
        <h2 class="mb-4 text-2xl font-semibold text-foreground">Coming Soon</h2>
        <p class="mb-6 text-muted-foreground">
          Our booking system is currently under development. We'll be launching
          soon!
        </p>

        <div class="space-y-4">
          <a
            href="/contact"
            class="text-white from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 inline-flex transform items-center justify-center rounded-xl bg-gradient-to-r px-6 py-3 text-lg font-semibold shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
          >
            Contact Us for Scheduling
          </a>

          <div class="text-sm text-muted-foreground">
            Or email us at:{' '}
            <a
              href="mailto:booking@pixelatedempathy.com"
              class="text-foreground hover:underline"
            >
              booking@pixelatedempathy.com
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
