---
import DatasetSearch from '@/components/research/DatasetSearch'
import ResearchLayout from '@/layouts/ResearchLayout.astro'
---

<ResearchLayout title="Dataset Sourcing | Pixelated Empathy">
  <div class="mb-8 px-4 py-12">
    <div class="mx-auto mb-12 max-w-4xl text-center">
      <h1 class="text-white mb-6 text-4xl font-bold md:text-5xl">
        <span class="text-transparent from-emerald-400 to-cyan-500 bg-gradient-to-r bg-clip-text">
          Therapy Datasets
        </span>
      </h1>
      <p class="mx-auto max-w-2xl text-xl text-muted-foreground">
        Discover and analyze high-quality conversational datasets for training
        empathetic AI models.
      </p>
    </div>

    <div class="w-full">
      <DatasetSearch client:load />
    </div>
  </div>
</ResearchLayout>
