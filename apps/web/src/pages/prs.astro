---
export const prerender = false
import Link from '@/components/base/Link.astro'
import GithubView from '@/components/views/GithubView.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const frontmatter = {
  title: 'AstroEco is Contributing..',
  description:
    'Example: Displaying GitHub pull requests using astro-loader-github-prs',
  subtitle: '',
  bgType: 'plum',
  toc: false,
  ogImage: '/og-image.png',
}
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  bgType={frontmatter.bgType}
>
  <section class="py-12">
    <div class="mx-auto max-w-6xl px-4 text-center">
      <h1 class="text-white mb-4 text-4xl font-bold">
        AstroEco is <span class="animate-pulse">Contributing...</span>
      </h1>
      <p class="mb-12 italic text-muted-foreground">
        Example: Displaying GitHub pull requests using{' '}
        <Link
          href="https://github.com/lin-stephanie/astro-loaders/tree/main/packages/astro-loader-github-prs"
          external={true}
        >
          astro-loader-github-prs
        </Link>
      </p>
      <GithubView collectionType="prs" />
    </div>
  </section>
</BaseLayout>
