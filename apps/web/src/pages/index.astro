---
import BaseLayout from '@/layouts/BaseLayout.astro'
import '@/styles/np-landing.css'
import { withBasePath } from '@/utils/path'
import { heroContent } from '@/lib/content/hero'
import { workflowContent } from '@/lib/content/workflow'
import { ctaContent } from '@/lib/content/cta'

const hero = heroContent
const workflow = workflowContent
const cta = ctaContent

const evidence = [
  [
    'Scenario brief',
    'Faculty define the clinical pressure, skill target, and boundaries before a trainee enters the room.',
  ],
  [
    'Live attempt',
    'The trainee responds without a script while the simulated client adapts to timing, tone, and avoidance.',
  ],
  [
    'Supervisor read',
    'The complete exchange is reviewable turn by turn, with the exact decision point preserved.',
  ],
  [
    'Directed retry',
    'The trainee repeats the difficult moment with a specific coaching instruction instead of a vague note.',
  ],
]

const scenarioRows = [
  ['CR-17', 'Escalation', 'Suicidality screening and safety planning', 'High'],
  ['RP-08', 'Rupture', 'Withdrawal after a missed empathic cue', 'Moderate'],
  [
    'DS-12',
    'Disclosure',
    'High-stakes disclosure without flattening the room',
    'High',
  ],
]
---

<BaseLayout title="Pixelated Empathy" description={hero.metaDescription}>
  <main class="case-home">
    <section class="case-hero" aria-labelledby="case-title">
      <div class="case-shell">
        <div class="case-hero__copy">
          <h1 id="case-title">
            Practice the moment that usually gets discussed too late.
          </h1>
          <p class="case-hero__lede">
            Trainees work through difficult therapy conversations in real time.
            Supervisors review the exact exchange, mark the decision point, and
            send the trainee back in with a sharper instruction.
          </p>
          <div class="case-actions">
            <a
              class="case-action case-action--solid"
              href={withBasePath(hero.primaryCTA.href)}
            >
              {hero.primaryCTA.text}
            </a>
            <a class="case-action" href={withBasePath(hero.secondaryCTA.href)}>
              {hero.secondaryCTA.text}
            </a>
          </div>
        </div>

        <article
          class="case-console"
          aria-label="Supervised therapy practice example"
        >
          <header class="case-console__head">
            <div>
              <span class="case-console__id">CASE RP-08</span>
              <strong>Withdrawal after a missed cue</strong>
            </div>
            <span class="case-status">Review open</span>
          </header>

          <div class="case-console__body">
            <div class="case-turn case-turn--client">
              <span class="case-turn__who">Client · 18:42</span>
              <p>
                You keep asking me to explain it differently. I am starting to
                think you do not believe me.
              </p>
            </div>

            <div class="case-turn case-turn--trainee">
              <span class="case-turn__who">Trainee · 18:43</span>
              <p>
                I do believe you. I am asking because I want to make sure I
                understand everything that happened.
              </p>
            </div>

            <aside class="case-review" aria-label="Supervisor review">
              <div class="case-review__marker" aria-hidden="true">A</div>
              <div>
                <span class="case-review__who">Supervisor mark A</span>
                <strong>Defended intent before naming impact.</strong>
                <p>
                  The client has already told you how the questioning landed.
                  Stay with that injury before explaining why you asked.
                </p>
              </div>
            </aside>

            <div class="case-turn case-turn--retry">
              <span class="case-turn__who">
                Trainee · 18:46
                <span class="case-turn__tag">Directed retry</span>
              </span>
              <p>
                My questions left you feeling doubted. I can see why you would
                pull back. Can we stay with what happened between us just now?
              </p>
            </div>
          </div>

          <footer class="case-console__foot">
            <span>Supervisor mark A resolved</span>
            <span>Retry preserved in training record</span>
          </footer>
        </article>
      </div>
    </section>

    <section class="case-audience" aria-label="Audience overview">
      <div class="case-shell case-audience__grid">
        {
          hero.proofPoints.map((point) => (
            <article>
              <h2>{point.label}</h2>
              <p>{point.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="case-standards" aria-label="Platform standards">
      <div class="case-shell case-standards__inner">
        <span>HIPAA-ready</span>
        <span>FERPA-aligned</span>
        <span>Evidence-based scenarios</span>
        <span>Accreditation-ready records</span>
      </div>
    </section>

    <section class="case-process" aria-labelledby="process-title">
      <div class="case-shell">
        <div class="case-section-head">
          <h2 id="process-title">{workflow.title}</h2>
          <p>
            A repeatable teaching loop built around observable decisions, not
            recollection or role-play performance.
          </p>
        </div>
        <ol class="case-process__grid">
          {
            workflow.steps.map((step) => (
              <li>
                <span>{step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="case-evidence" aria-labelledby="evidence-title">
      <div class="case-shell case-evidence__layout">
        <div class="case-evidence__intro">
          <h2 id="evidence-title">
            One attempt becomes usable supervision evidence.
          </h2>
          <p>
            The scenario, transcript, supervisor mark, and retry stay attached
            to one record. Faculty can teach from what happened without
            reconstructing the room from memory.
          </p>
          <figure class="case-proof">
            <img
              src={withBasePath('/images/homepage/training-session-proof.png')}
              alt="Pixelated Empathy practice and supervisor review interface"
              loading="lazy"
              width="960"
              height="540"
            />
            <figcaption>
              Practice room / supervisor review / retained record
            </figcaption>
          </figure>
        </div>
        <ol class="case-evidence__list">
          {
            evidence.map(([title, body]) => (
              <li>
                <h3>{title}</h3>
                <p>{body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="case-scenarios" aria-labelledby="scenarios-title">
      <div class="case-shell">
        <div class="case-section-head case-section-head--wide">
          <h2 id="scenarios-title">
            Train where clinical judgment is easiest to lose.
          </h2>
          <p>
            Scenario families can match a course, practicum, or supervision
            team's actual curriculum.
          </p>
        </div>
        <div
          class="case-table"
          role="table"
          aria-label="Example scenario library"
        >
          <div class="case-table__row case-table__head" role="row">
            <span role="columnheader">Case</span><span role="columnheader"
              >Family</span
            ><span role="columnheader">Clinical pressure</span><span
              role="columnheader">Intensity</span
            >
          </div>
          {
            scenarioRows.map((row) => (
              <div class="case-table__row" role="row">
                {row.map((cell) => (
                  <span role="cell">{cell}</span>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="case-close" aria-labelledby="close-title">
      <div class="case-shell case-close__layout">
        <div>
          <h2 id="close-title">{cta.title}</h2>
          <p>{cta.intro}</p>
        </div>
        <div class="case-close__action">
          <p>
            Start with one cohort, one supervisor, and the conversations your
            trainees avoid rehearsing.
          </p>
          <div class="case-actions">
            <a
              class="case-action case-action--solid"
              href={withBasePath(cta.primaryCTA.href)}>{cta.primaryCTA.text}</a
            >
            <a class="case-action" href={withBasePath(cta.secondaryCTA.href)}
              >{cta.secondaryCTA.text}</a
            >
          </div>
          <small
            >HIPAA-ready · Security review available · No client data required</small
          >
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
