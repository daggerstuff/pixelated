---
import BaseLayout from '@/layouts/BaseLayout.astro'
import '@/styles/np-landing.css'
import { withBasePath } from '@/utils/path'

const metaTitle = 'Clinical AI Simulation & Supervised Practice'
const metaDescription =
  'Pixelated Empathy is an evidence-based clinical AI simulation platform for therapist training and supervision. Trainees practice high-stakes therapy conversations with adaptive AI clients while supervisors coach from point-in-time transcripts.'

const trainingLoop = [
  {
    num: '01',
    title: 'Standardized Simulation',
    description:
      'Trainees engage realistic AI clients designed with clinical psychopathology parameters—adapting to resistance, disclosure timing, and emotional shifts.',
  },
  {
    num: '02',
    title: 'In-Situ Transcript Review',
    description:
      'Supervisors annotate transcripts at the exact conversational turn that mattered, coaching specific micro-interventions rather than relying on recall.',
  },
  {
    num: '03',
    title: 'Deliberate Practice & Retries',
    description:
      'Trainees immediately re-enter the critical rupture point to test alternative repairs, developing clinical agility and neural resilience.',
  },
]

const clinicalScenarios = [
  {
    badge: 'Crisis Intervention',
    title: 'Suicidality Screening & Safety Planning',
    description:
      'Practice navigating explicit and implicit ideation, conducting C-SSRS assessments, and constructing collaborative safety plans under pressure.',
  },
  {
    badge: 'Alliance Dynamics',
    title: 'Therapeutic Rupture & Repair',
    description:
      'Identify subtle disengagement, address direct confrontation, and practice alliance-focused repair sequences without defensive countertransference.',
  },
  {
    badge: 'Trauma & Pacing',
    title: 'High-Stakes Disclosure Pacing',
    description:
      'Contain overwhelming affective floods, support grounding, and avoid premature problem-solving when clients disclose acute trauma.',
  },
  {
    badge: 'Cultural Humility',
    title: 'Intersectional Empathy & Micro-Ruptures',
    description:
      'Navigate cross-cultural misunderstandings, acknowledge systemic context, and practice humble inquiry when identity differences emerge.',
  },
]

const clinicalTriad = [
  {
    role: 'For Trainees',
    title: 'Safe Rehearsal for Low-Frequency, High-Acuity Cases',
    description:
      'Build confidence in difficult conversational turns before real client contact. Experiment with theoretical orientations in a zero-risk sandbox.',
  },
  {
    role: 'For Supervisors',
    title: 'Objective Evidence-Based Coaching',
    description:
      'Review complete transcripts with timestamped conversational metrics. Identify micro-skills, missed cues, and communication habits instantly.',
  },
  {
    role: 'For Program Directors',
    title: 'Standardized Cohort Competency Benchmarks',
    description:
      'Ensure every graduating clinician has demonstrated core competencies across identical, calibrated clinical situations ready for accreditation audits.',
  },
]
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <div class="np-page">
    <!-- Hero Section -->
    <section
      class="np-section np-hero-section"
      aria-label="Clinical AI Simulation Platform"
    >
      <div class="np-container">
        <div class="np-hero-grid">
          <!-- Main Hero Column -->
          <div class="np-hero-main">
            <span class="np-eyebrow">
              Clinical AI Training & Supervised Practice
            </span>
            <h1 class="np-display-hero">
              Rehearse high-stakes therapy conversations before real clients.
            </h1>
            <p class="np-lede">
              Pixelated Empathy provides standardized, adaptive AI client
              simulations for therapist training. Trainees practice rupture
              repairs, risk screenings, and complex disclosures—while
              supervisors review timestamped transcripts and coach from
              evidence.
            </p>
            <div class="np-actions-row">
              <a class="np-btn np-btn-primary" href={withBasePath('/contact')}>
                Request Institutional Pilot
              </a>
              <a class="np-btn np-btn-ghost" href={withBasePath('/features')}>
                Explore Clinical Scenarios
              </a>
            </div>
            <div class="np-trust-badges">
              <span class="np-trust-badge">HIPAA-Ready Architecture</span>
              <span class="np-trust-badge">Zero PHI Retention</span>
              <span class="np-trust-badge">Accreditation Aligned</span>
            </div>
          </div>

          <!-- Proof Console Column -->
          <div class="np-hero-proof">
            <aside
              class="np-console"
              aria-label="Supervised Simulation Transcript"
            >
              <div class="np-console-header">
                <div class="np-console-status">
                  <span class="np-status-dot" aria-hidden="true"></span>
                  <span>SIMULATION #0412</span>
                </div>
                <div class="np-console-scenario">CASE: ALLIANCE RUPTURE</div>
              </div>

              <div class="np-console-body">
                <!-- Turn 1: Client -->
                <div class="np-turn">
                  <div class="np-turn-meta np-turn-meta--client">
                    <span>AI Client · Sarah M. (Week 3)</span>
                    <span>14:08</span>
                  </div>
                  <div class="np-turn-content np-turn-content--client">
                    "I've been thinking about whether this is really working for
                    me. I just don't feel like I'm getting anywhere, and maybe I
                    shouldn't have started."
                  </div>
                </div>

                <!-- Turn 2: Trainee Attempt 1 -->
                <div class="np-turn">
                  <div class="np-turn-meta np-turn-meta--trainee">
                    <span>Trainee · Attempt 1</span>
                    <span>14:15</span>
                  </div>
                  <div class="np-turn-content np-turn-content--attempt-1">
                    "It sounds like you're not sure this is the right place.
                    What feels off to you?"
                  </div>
                </div>

                <!-- Supervisor Margin Note -->
                <div class="np-supervisor-note">
                  <div class="np-supervisor-meta">
                    <span>Supervisor Annotation · Dr. E. Vance</span>
                  </div>
                  <div class="np-supervisor-text">
                    "Named the hesitation, but redirected too fast. Slow
                    down—acknowledge the courage it takes to voice doubt, and
                    sit in the alliance rupture before asking for reasons."
                  </div>
                </div>

                <!-- Turn 3: Trainee Attempt 2 (Repaired) -->
                <div class="np-turn">
                  <div class="np-turn-meta np-turn-meta--trainee">
                    <span>Trainee · Attempt 2 (Repaired)</span>
                    <span>14:32</span>
                  </div>
                  <div class="np-turn-content np-turn-content--attempt-2">
                    "You've been showing up every week putting in real effort,
                    and not feeling any progress must feel deeply discouraging.
                    Let's stay right here—tell me more about what that weight
                    feels like today."
                  </div>
                </div>
              </div>

              <div class="np-console-footer">
                <div class="np-metric-item">
                  <span>✓</span>
                  <span>Alliance Attunement: 91% (+34%)</span>
                </div>
                <div>Transcript Saved to Practicum Record</div>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- Training Loop Section -->
    <section class="np-section np-section--surface" aria-label="How It Works">
      <div class="np-container">
        <span class="np-eyebrow">The Supervisory Loop</span>
        <h2 class="np-section-heading">
          A closed-loop system for clinical mastery.
        </h2>
        <p class="np-lede">
          Move beyond subjective trainee recall. Combine realistic patient
          simulation with point-in-time supervision to accelerate clinical
          development.
        </p>

        <div class="np-loop-grid">
          {trainingLoop.map((step) => (
            <div class="np-loop-card">
              <div class="np-loop-num">
                <span>{step.num}</span>
                <span aria-hidden="true">→</span>
              </div>
              <h3 class="np-card-title">{step.title}</h3>
              <p class="np-prose">{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Scenario Library Section -->
    <section class="np-section" aria-label="Clinical Scenario Curriculum">
      <div class="np-container">
        <span class="np-eyebrow">Standardized Scenarios</span>
        <h2 class="np-section-heading">
          High-stakes encounters, standardized for every trainee.
        </h2>
        <p class="np-lede">
          Our curriculum covers acute clinical scenarios rarely encountered
          during initial practicum hours, ensuring comprehensive preparedness.
        </p>

        <div class="np-scenario-grid">
          {clinicalScenarios.map((scenario) => (
            <div class="np-scenario-card">
              <div>
                <div class="np-scenario-badge">{scenario.badge}</div>
                <h3 class="np-card-title">{scenario.title}</h3>
              </div>
              <p class="np-prose" style="margin-top: 0.75rem;">
                {scenario.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Clinical Triad Section -->
    <section
      class="np-section np-section--surface"
      aria-label="Built for Clinical Teams"
    >
      <div class="np-container">
        <span class="np-eyebrow">The Training Triad</span>
        <h2 class="np-section-heading">
          Engineered for trainees, supervisors, and directors.
        </h2>
        <p class="np-lede">
          Every surface is tailored to the distinct workflows of counseling
          psychology programs and behavioral health residency teams.
        </p>

        <div class="np-triad-grid">
          {clinicalTriad.map((member) => (
            <div class="np-triad-card">
              <div class="np-triad-role">{member.role}</div>
              <h3 class="np-card-title">{member.title}</h3>
              <p class="np-prose">{member.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Security & Institutional Governance Section -->
    <section class="np-section" aria-label="Security and Privacy Posture">
      <div class="np-container">
        <span class="np-eyebrow">Institutional Trust & Compliance</span>
        <h2 class="np-section-heading">
          Built for HIPAA and clinical accreditation requirements.
        </h2>
        <p class="np-lede">
          Zero real-world patient data is required. All simulated conversations
          take place in isolated, private institutional enclaves.
        </p>

        <div class="np-security-grid">
          <div class="np-security-item">
            <h3 class="np-card-title">Zero PHI Exposure</h3>
            <p class="np-prose">
              Simulations use synthetic patient models. No actual client
              identifiers or medical records are ever introduced into the
              system.
            </p>
          </div>
          <div class="np-security-item">
            <h3 class="np-card-title">Encrypted & Auditable</h3>
            <p class="np-prose">
              End-to-end encryption at rest and in transit. Granular role-based
              access control separates trainee attempts, supervisor notes, and
              admin metrics.
            </p>
          </div>
          <div class="np-security-item">
            <h3 class="np-card-title">Curricular Alignment</h3>
            <p class="np-prose">
              Competencies mapped to CACREP, APA, and CSWE training guidelines
              for seamless integration into existing graduate coursework.
            </p>
          </div>
        </div>

        <!-- Institutional Pilot Banner -->
        <div class="np-pilot-banner">
          <div class="np-pilot-content">
            <h3
              class="np-card-title"
              style="font-size: 1.5rem; margin-bottom: 0.5rem;"
            >
              Deploy clinical AI simulation in your training program.
            </h3>
            <p class="np-prose" style="margin-bottom: 0;">
              Partner with Pixelated Empathy to pilot standardized simulation
              cohorts for your upcoming semester or practicum cycle.
            </p>
          </div>
          <div>
            <a class="np-btn np-btn-primary" href={withBasePath('/contact')}>
              Request Institutional Pilot
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
