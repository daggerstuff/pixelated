---
import BaseLayout from '@/layouts/BaseLayout.astro'
import '@/styles/np-landing.css'
import { withBasePath } from '@/utils/path'

const pageTitle = 'Pixelated Empathy'
const metaDescription =
  'A clinical simulation platform for therapist training. Trainees work a hard turn with an AI client. Supervisors mark the decision point and send the trainee back in with one sharper instruction.'

const audience = [
  {
    label: 'For programs',
    text: 'Assign the same AI client to every trainee. Scenarios cover intake, crisis, rupture repair, and disclosure — repeatable, standardized, and ready for accreditation review.',
  },
  {
    label: 'For supervisors',
    text: 'Open any attempt at the exact turn that mattered. Mark the decision point, leave a note, and assign a retry — the transcript is already there.',
  },
  {
    label: 'For trainees',
    text: 'Practice the moment without a script. See what changes when you return with a sharper instruction.',
  },
]

const loopSteps = [
  {
    number: '01',
    title: 'Pick the skill',
    body: 'Intake, empathy, rupture repair, crisis response — or any skill your curriculum defines.',
  },
  {
    number: '02',
    title: 'Run the session',
    body: 'The trainee responds in the moment. The transcript, context, and signals are preserved.',
  },
  {
    number: '03',
    title: 'Coach the retry',
    body: 'Supervisors annotate the record, then assign a retry or the next case.',
  },
]

const proofSteps = [
  {
    number: '01',
    title: 'Scenario brief',
    body: 'Faculty define the clinical pressure, skill target, and boundaries before a trainee enters the room.',
  },
  {
    number: '02',
    title: 'Live attempt',
    body: 'The trainee responds without a script while the simulated client adapts to timing, tone, and avoidance.',
  },
  {
    number: '03',
    title: 'Supervisor read',
    body: 'The complete exchange is reviewable turn by turn, with the exact decision point preserved.',
  },
  {
    number: '04',
    title: 'Directed retry',
    body: 'The trainee repeats the difficult moment with a specific coaching instruction instead of a vague note.',
  },
]

const scenarioRows = [
  ['CR-17', 'Escalation', 'Suicidality screening and safety planning', 'High'],
  ['RP-08', 'Rupture', 'Withdrawal after a missed empathic cue', 'Moderate'],
  [
    'DS-12',
    'Disclosure',
    'High-stakes disclosure without flattening the room',
    'High',
  ],
]
---

<BaseLayout title={pageTitle} description={metaDescription}>
  <main class="empathy-home">
    <section class="empathy-hero" aria-labelledby="empathy-title">
      <div class="empathy-shell empathy-hero__grid">
        <header class="empathy-hero__intro">
          <p class="empathy-kicker">
            Clinical simulation for therapist training
          </p>
          <h1 class="empathy-title" id="empathy-title">{pageTitle}</h1>
          <p class="empathy-lede">
            One AI client. One transcript. One sharper instruction.
          </p>
          <div class="empathy-actions">
            <a
              class="empathy-action empathy-action--solid"
              href={withBasePath('/contact')}
            >
              Request a demo
            </a>
            <a class="empathy-action" href={withBasePath('/demo-hub')}
              >See the demo</a
            >
          </div>
        </header>

        <article class="empathy-case" aria-labelledby="empathy-case-title">
          <header class="empathy-case__head">
            <div>
              <span class="empathy-case__id">RP-08</span>
              <h2 class="empathy-case__title" id="empathy-case-title">
                Withdrawal after a missed cue
              </h2>
            </div>
            <span class="empathy-case__status">Review open</span>
          </header>

          <div class="empathy-case__body">
            <ol class="empathy-transcript" aria-label="Practice transcript">
              <li class="empathy-turn empathy-turn--client">
                <span class="empathy-turn__marker" aria-hidden="true"></span>
                <div class="empathy-turn__body">
                  <span class="empathy-turn__who">Client · 18:42</span>
                  <p class="empathy-turn__message">
                    You keep asking me to explain it differently. I am starting
                    to think you do not believe me.
                  </p>
                </div>
              </li>

              <li class="empathy-turn empathy-turn--trainee">
                <span class="empathy-turn__marker" aria-hidden="true"></span>
                <div class="empathy-turn__body">
                  <span class="empathy-turn__who">Trainee · 18:43</span>
                  <p class="empathy-turn__message">
                    I do believe you. I am asking because I want to make sure I
                    understand everything that happened.
                  </p>
                </div>
              </li>

              <li class="empathy-review">
                <span class="empathy-review__marker" aria-hidden="true">A</span>
                <div class="empathy-review__body">
                  <span class="empathy-review__who">
                    Supervisor mark A · turn 18:43
                  </span>
                  <strong class="empathy-review__heading">
                    Defended intent before naming impact.
                  </strong>
                  <p class="empathy-review__note">
                    The client has already told you how the questioning landed.
                    Stay with that injury before explaining why you asked.
                  </p>
                  <span class="empathy-review__chip">Retry assigned</span>
                </div>
              </li>

              <li class="empathy-turn empathy-turn--trainee">
                <span class="empathy-turn__marker" aria-hidden="true"></span>
                <div class="empathy-turn__body">
                  <span class="empathy-turn__who">
                    Trainee · 18:46
                    <span class="empathy-turn__tag">Directed retry</span>
                  </span>
                  <p class="empathy-turn__message">
                    My questions left you feeling doubted. I can see why you
                    would pull back. Can we stay with what happened between us
                    just now?
                  </p>
                </div>
              </li>
            </ol>
          </div>

          <footer class="empathy-case__foot">
            <span>Supervisor mark A resolved</span>
            <span>Retry preserved in training record</span>
          </footer>
        </article>
      </div>
    </section>

    <section class="empathy-facts-section" aria-label="Audience overview">
      <div class="empathy-shell empathy-facts-section__grid">
        {
          audience.map((item) => (
            <article>
              <h3>{item.label}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="empathy-band" aria-label="Platform standards">
      <div class="empathy-shell empathy-band__grid">
        <span class="empathy-band__item">HIPAA-ready</span>
        <span class="empathy-band__item">FERPA-aligned</span>
        <span class="empathy-band__item">Evidence-based scenarios</span>
        <span class="empathy-band__item">Accreditation-ready records</span>
      </div>
    </section>

    <section class="empathy-loop" aria-labelledby="empathy-loop-title">
      <div class="empathy-shell">
        <div class="empathy-loop__head">
          <div>
            <h2 class="empathy-section-title" id="empathy-loop-title">
              Assign. Review. Coach. Repeat.
            </h2>
            <p class="empathy-body">
              A repeatable teaching loop built around observable decisions, not
              recollection or role-play performance.
            </p>
          </div>
        </div>

        <ol class="empathy-loop__grid">
          {
            loopSteps.map((step) => (
              <li class="empathy-loop__item">
                <span class="empathy-loop__number">{step.number}</span>
                <h3 class="empathy-loop__title">{step.title}</h3>
                <p class="empathy-loop__body">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="empathy-proof" aria-labelledby="empathy-proof-title">
      <div class="empathy-shell">
        <div class="empathy-proof__head">
          <div>
            <h2 class="empathy-section-title" id="empathy-proof-title">
              One attempt becomes usable supervision evidence.
            </h2>
          </div>
          <p class="empathy-body">
            The scenario, transcript, supervisor mark, and retry stay attached
            to one record. Faculty teach from what happened instead of
            reconstructing the room from memory.
          </p>
        </div>

        <div class="empathy-proof__grid">
          <p class="empathy-body empathy-proof__body">
            Nothing is reconstructed afterwards. The record shows what was
            said, when the supervisor stepped in, and what the trainee did
            with the instruction — so review sessions start from evidence
            instead of recall.
          </p>
          <ol class="empathy-proof__list">
            {
              proofSteps.map((step) => (
                <li class="empathy-proof__item">
                  <span class="empathy-proof__item-number">{step.number}</span>
                  <div>
                    <h3 class="empathy-proof__item-title">{step.title}</h3>
                    <p class="empathy-proof__item-body">{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <section class="empathy-library" aria-labelledby="empathy-library-title">
      <div class="empathy-shell">
        <div class="empathy-library__head">
          <div>
            <h2 class="empathy-section-title" id="empathy-library-title">
              A library of repeatable scenarios
            </h2>
            <p class="empathy-body">
              Standardized cases mean every trainee meets the same pressure.
              Cohorts can be compared on decisions, not luck.
            </p>
          </div>
        </div>

        <div class="empathy-library__table">
          <div class="empathy-library__row empathy-library__row--head">
            <span class="empathy-library__cell">Case</span>
            <span class="empathy-library__cell">Skill</span>
            <span class="empathy-library__cell">Focus</span>
            <span class="empathy-library__cell">Intensity</span>
          </div>
          {
            scenarioRows.map((row) => (
              <div class="empathy-library__row empathy-library__row--body">
                <span class="empathy-library__cell">{row[0]}</span>
                <span class="empathy-library__cell">{row[1]}</span>
                <span class="empathy-library__cell">{row[2]}</span>
                <span class="empathy-library__cell">{row[3]}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="empathy-close" aria-labelledby="empathy-close-title">
      <div class="empathy-shell empathy-close__grid">
        <div>
          <h2 class="empathy-section-title" id="empathy-close-title">
            Run one scenario with your cohort.
          </h2>
          <p class="empathy-close__lede">
            See the attempt, the mark, and the retry — end to end.
          </p>
          <small class="empathy-close__note">
            Demo sessions use synthetic clients. No student data required.
          </small>
        </div>
        <div class="empathy-actions">
          <a
            class="empathy-action empathy-action--solid"
            href={withBasePath('/contact')}
          >
            Request a demo
          </a>
          <a class="empathy-action" href={withBasePath('/demo-hub')}
            >See the demo</a
          >
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
