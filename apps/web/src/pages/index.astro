---
import BaseLayout from '@/layouts/BaseLayout.astro'
import '@/styles/np-landing.css'
import { withBasePath } from '@/utils/path'

const metaTitle = 'Clinical AI Simulation & Supervised Practice'
const metaDescription =
  'Pixelated Empathy gives therapy trainees a safe place to practice tough client conversations with adaptive AI clients, while supervisors coach directly from exact transcript moments.'

const trainingLoop = [
  {
    num: '01',
    title: 'Realistic AI Sessions',
    description:
      'Trainees talk with responsive AI clients that hesitate, push back, and test boundaries just like real people in session.',
  },
  {
    num: '02',
    title: 'Direct Supervisor Notes',
    description:
      'Supervisors highlight the exact turn where things stalled or clicked, leaving straightforward feedback instead of relying on memory.',
  },
  {
    num: '03',
    title: 'Instant Retries',
    description:
      'Trainees jump right back into the moment to try another approach and build real muscle memory before seeing real clients.',
  },
]

const clinicalScenarios = [
  {
    badge: 'Crisis & Safety',
    title: 'Suicide Screening & Safety Planning',
    description:
      'Catch subtle warning signs, ask direct questions without freezing up, and build realistic safety plans together.',
  },
  {
    badge: 'Tough Moments',
    title: 'Handling Pushback & Broken Trust',
    description:
      'Spot when a client checks out or gets frustrated, stay calm, and work through tension without getting defensive.',
  },
  {
    badge: 'Trauma & Pacing',
    title: 'Pacing Heavy Disclosures',
    description:
      'Help clients ground themselves during intense moments, pace painful memories, and avoid jumping into fix-it mode too soon.',
  },
  {
    badge: 'Cultural Humility',
    title: 'Working Through Identity Differences',
    description:
      'Address cultural misunderstandings openly, stay grounded, and talk through differences without making assumptions.',
  },
]

const clinicalTriad = [
  {
    role: 'For Trainees',
    title: 'Zero-Risk Practice for Tough Situations',
    description:
      'Get comfortable handling tense conversational turns before facing real clients. Try different approaches without worrying about making mistakes.',
  },
  {
    role: 'For Supervisors',
    title: 'Feedback Grounded in What Actually Happened',
    description:
      'Read the full transcript instead of guessing from trainee recall. Spot communication habits and teachable moments right away.',
  },
  {
    role: 'For Program Directors',
    title: 'Consistent Practice Across Every Cohort',
    description:
      'Make sure every student handles the same core clinical scenarios, with clean audit logs ready for accreditation reviews.',
  },
]
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <div class="np-page">
    <!-- Hero Section -->
    <section
      class="np-section np-hero-section"
      aria-label="Clinical AI Simulation Platform"
    >
      <div class="np-container">
        <div class="np-hero-grid">
          <!-- Main Hero Column -->
          <div class="np-hero-main">
            <span class="np-eyebrow">Clinical AI Simulation & Practice</span>
            <h1 class="np-display-hero">
              Rehearse high-stakes therapy conversations before real clients.
            </h1>
            <p class="np-lede">
              Pixelated Empathy gives trainees a realistic place to practice
              rupture repairs, crisis screenings, and heavy disclosures with
              responsive AI clients. Supervisors jump right into the transcript
              to coach exact moments that matter.
            </p>
            <div class="np-actions-row">
              <a class="np-btn np-btn-primary" href={withBasePath('/contact')}>
                Request a Program Pilot
              </a>
              <a class="np-btn np-btn-ghost" href={withBasePath('/features')}>
                Explore Practice Scenarios
              </a>
            </div>
            <div class="np-trust-badges">
              <span class="np-trust-badge">Zero Real Patient Data</span>
              <span class="np-trust-badge">Private & Encrypted</span>
              <span class="np-trust-badge">Accreditation Ready</span>
            </div>
          </div>

          <!-- Proof Console Column -->
          <div class="np-hero-proof">
            <aside
              class="np-console"
              aria-label="Supervised Simulation Transcript"
            >
              <div class="np-console-header">
                <div class="np-console-status">
                  <span class="np-status-dot" aria-hidden="true"></span>
                  <span>SIMULATION #0412</span>
                </div>
                <div class="np-console-scenario">CASE: ALLIANCE RUPTURE</div>
              </div>

              <div class="np-console-body">
                <!-- Turn 1: Client -->
                <div class="np-turn">
                  <div class="np-turn-meta np-turn-meta--client">
                    <span>AI Client · Sarah M. (Week 3)</span>
                    <span>14:08</span>
                  </div>
                  <div class="np-turn-content np-turn-content--client">
                    "I've been thinking about whether this is really working for
                    me. I just don't feel like I'm getting anywhere, and maybe I
                    shouldn't have started."
                  </div>
                </div>

                <!-- Turn 2: Trainee Attempt 1 -->
                <div class="np-turn">
                  <div class="np-turn-meta np-turn-meta--trainee">
                    <span>Trainee · Attempt 1</span>
                    <span>14:15</span>
                  </div>
                  <div class="np-turn-content np-turn-content--attempt-1">
                    "It sounds like you're not sure this is the right place.
                    What feels off to you?"
                  </div>
                </div>

                <!-- Supervisor Margin Note -->
                <div class="np-supervisor-note">
                  <div class="np-supervisor-meta">
                    <span>Supervisor Annotation · Dr. E. Vance</span>
                  </div>
                  <div class="np-supervisor-text">
                    "You dodged with a stock question. Don't get defensive or
                    overly clinical—just own that we're stuck and reset
                    together."
                  </div>
                </div>

                <!-- Turn 3: Trainee Attempt 2 (Repaired) -->
                <div class="np-turn">
                  <div class="np-turn-meta np-turn-meta--trainee">
                    <span>Trainee · Attempt 2 (Repaired)</span>
                    <span>14:32</span>
                  </div>
                  <div class="np-turn-content np-turn-content--attempt-2">
                    "Fair enough. If we're three weeks in and spinning our
                    wheels, doing more of the same won't help. What needs to
                    change?"
                  </div>
                </div>
              </div>

              <div class="np-console-footer">
                <div class="np-metric-item">
                  <span>✓</span>
                  <span>Alliance Attunement: 91% (+34%)</span>
                </div>
                <div>Transcript Saved to Practicum Record</div>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- Training Loop Section -->
    <section class="np-section np-section--surface" aria-label="How It Works">
      <div class="np-container">
        <span class="np-eyebrow">How It Works</span>
        <h2 class="np-section-heading">
          How trainees actually build real confidence.
        </h2>
        <p class="np-lede">
          Skip the vague post-session check-ins. Practice real conversations,
          see where things went off track, and try again on the spot.
        </p>

        <div class="np-loop-grid">
          {trainingLoop.map((step) => (
            <div class="np-loop-card">
              <div class="np-loop-num">
                <span>{step.num}</span>
                <span aria-hidden="true">→</span>
              </div>
              <h3 class="np-card-title">{step.title}</h3>
              <p class="np-prose">{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Scenario Library Section -->
    <section class="np-section" aria-label="Clinical Scenario Curriculum">
      <div class="np-container">
        <span class="np-eyebrow">Practice Scenarios</span>
        <h2 class="np-section-heading">
          The hardest moments in therapy, ready to practice.
        </h2>
        <p class="np-lede">
          Give every trainee hands-on practice with high-stress situations they
          might only see once or twice during practicum.
        </p>

        <div class="np-scenario-grid">
          {clinicalScenarios.map((scenario) => (
            <div class="np-scenario-card">
              <div>
                <div class="np-scenario-badge">{scenario.badge}</div>
                <h3 class="np-card-title">{scenario.title}</h3>
              </div>
              <p class="np-prose" style="margin-top: 0.75rem;">
                {scenario.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Clinical Triad Section -->
    <section
      class="np-section np-section--surface"
      aria-label="Built for Clinical Teams"
    >
      <div class="np-container">
        <span class="np-eyebrow">Built for the Whole Team</span>
        <h2 class="np-section-heading">
          Clear value for trainees, supervisors, and program leads.
        </h2>
        <p class="np-lede">
          Built to fit directly into counseling graduate programs, residency
          clinics, and weekly supervision.
        </p>

        <div class="np-triad-grid">
          {clinicalTriad.map((member) => (
            <div class="np-triad-card">
              <div class="np-triad-role">{member.role}</div>
              <h3 class="np-card-title">{member.title}</h3>
              <p class="np-prose">{member.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Security & Institutional Governance Section -->
    <section class="np-section" aria-label="Security and Privacy Posture">
      <div class="np-container">
        <span class="np-eyebrow">Privacy & Security</span>
        <h2 class="np-section-heading">Built for privacy from day one.</h2>
        <p class="np-lede">
          No real patient information is ever needed. All simulated sessions
          happen in private, isolated workspaces.
        </p>

        <div class="np-security-grid">
          <div class="np-security-item">
            <h3 class="np-card-title">Zero PHI Risk</h3>
            <p class="np-prose">
              All conversations run on synthetic AI clients. Real patient
              records or personal health details never touch our servers.
            </p>
          </div>
          <div class="np-security-item">
            <h3 class="np-card-title">Private & Encrypted</h3>
            <p class="np-prose">
              Transcripts and supervisor feedback stay strictly inside your
              program's workspace, encrypted at rest and in transit.
            </p>
          </div>
          <div class="np-security-item">
            <h3 class="np-card-title">Accreditation Ready</h3>
            <p class="np-prose">
              Easily track student competency milestones aligned with CACREP,
              APA, and CSWE training guidelines.
            </p>
          </div>
        </div>

        <!-- Institutional Pilot Banner -->
        <div class="np-pilot-banner">
          <div class="np-pilot-content">
            <h3
              class="np-card-title"
              style="font-size: 1.5rem; margin-bottom: 0.5rem;"
            >
              Bring realistic simulation to your training program.
            </h3>
            <p class="np-prose" style="margin-bottom: 0;">
              Partner with Pixelated Empathy to pilot standardized simulation
              cohorts for your upcoming semester.
            </p>
          </div>
          <div>
            <a class="np-btn np-btn-primary" href={withBasePath('/contact')}>
              Request a Program Pilot
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
