---
import '@/styles/np-tokens.css'
import '@/lib/fonts'
import BaseHead from '@/components/base/Head.astro'
import Navbar from '@/components/mizu/Navbar.astro'
import Footer from '@/components/mizu/Footer.astro'
import ToTopButton from '@/components/widgets/ToTopButton.astro'
import { BlogSearch } from '@/components/BlogSearch'
import SpeedInsights from '@vercel/speed-insights/astro'
import Analytics from '@vercel/analytics/astro'
import { FEATURES } from '@/config'

interface Props {
  title: string
  description?: string
  image?: string
  canonicalURL?: string
  pubDate?: Date
  author?: string
  tags?: string[]
}

const {
  title,
  description = 'A blog post',
  image = '/images/blog-default.jpg',
  pubDate,
  author,
  tags = [],
} = Astro.props

// Format date if provided
const formattedDate = pubDate?.toLocaleDateString('en-us', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})

const { cspNonce } = Astro.locals
const { nprogress, mediumZoom } = FEATURES

// Build JSON-LD in frontmatter to avoid angle brackets in template expressions
const jsonLdHtml =
  pubDate && author
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        'headline': title,
        'image': [image],
        'datePublished': pubDate.toISOString(),
        'author': [{ '@type': 'Person', 'name': author }],
      })
        .replace(/</g, '\\u003c')
        .replace(/>/g, '\\u003e')
    : null
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <BaseHead {title} {description} ogImage={image} {cspNonce} />

    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1a1a1a" />

    <script src="/js/polyfill-detector.js" is:inline></script>
    <script src="/js/module-loader.js" defer is:inline></script>
    <script src="/js/background-loader.js" defer is:inline></script>
    {
      (nprogress || mediumZoom) && (
        <script src="/js/nprogress-and-zoom.js" type="module" />
      )
    }

    {/* Structured data for blog post */}
    {
      jsonLdHtml && (
        <script is:inline type="application/ld+json" set:html={jsonLdHtml} />
      )
    }
  </head>

  <body
    class="bg-slate-950 text-slate-50 font-sans min-h-screen flex flex-col overflow-x-hidden selection:bg-indigo-500/30"
  >
    <Navbar />

    <main class="container-refined py-12">
      <article class="prose prose-lg dark:prose-invert mx-auto max-w-4xl">
        <!-- Blog post header -->
        <header class="mb-8">
          <h1 class="text-4xl font-bold mb-4">{title}</h1>
          {
            formattedDate && (
              <time
                datetime={pubDate?.toISOString()}
                class="text-muted-foreground"
              >
                {formattedDate}
              </time>
            )
          }
          {author && <p class="text-muted-foreground mt-2">By {author}</p>}
          {
            tags.length > 0 && (
              <div class="flex gap-2 mt-4">
                {tags.map((tag: unknown) => (
                  <a
                    href={`/blog/tags/${tag}`}
                    class="text-sm px-3 py-1 bg-muted rounded-full hover:bg-muted/80 transition-colors"
                    transition:animate="slide"
                    data-astro-prefetch
                  >
                    {tag}
                  </a>
                ))}
              </div>
            )
          }
        </header>

        <!-- Blog post content -->
        <div class="blog-content">
          <BlogSearch client:load />
          <slot />
        </div>
      </article>
    </main>

    <Footer />
    <ToTopButton />
    <SpeedInsights />
    <Analytics />
    <script is:inline nonce={cspNonce}>
      function speedInsightsBeforeSend(data) {
        return data
      }
    </script>
  </body>
</html>
