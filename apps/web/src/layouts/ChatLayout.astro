---
import '@/styles/np-tokens.css'
import '@/lib/fonts'
import UmamiAnalytics from '@/components/analytics/UmamiAnalytics.astro'
import SpeedInsights from '@vercel/speed-insights/astro'
import Analytics from '@vercel/analytics/astro'
import { FEATURES } from '@/config'

export interface Props {
  title?: string
}
const { title = 'Chat' } = Astro.props
const { cspNonce } = Astro.locals
const { nprogress, mediumZoom } = FEATURES
const shouldRenderAnalytics = process.env['NODE_ENV'] !== 'test'
---

<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1a1a1a" />
    <title>{title} | Pixelated Empathy</title>

    <script src="/js/polyfill-detector.js" is:inline></script>
    <script src="/js/module-loader.js" defer is:inline></script>
    <script src="/js/background-loader.js" defer is:inline></script>
    {
      (nprogress || mediumZoom) && (
        <script src="/js/nprogress-and-zoom.js" type="module" />
      )
    }

    <UmamiAnalytics nonce={cspNonce} />
  </head>
  <body
    class="bg-slate-950 text-slate-50 font-sans min-h-screen flex flex-col overflow-x-hidden selection:bg-indigo-500/30"
  >
    <!-- Skip to content link for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 rounded-md focus:shadow-lg transition-transform"
      style="background: var(--accent-primary); color: var(--bg-primary);"
    >
      Skip to content
    </a>
    <main id="main-content" class="min-h-screen">
      <slot />
    </main>

    <!-- Vercel Speed Insights and Analytics -->
    {
      shouldRenderAnalytics && (
        <>
          <SpeedInsights />
          <Analytics />
        </>
      )
    }
  </body>
</html>
