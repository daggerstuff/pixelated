---
// Type system: Pure Monospace Technical Instrument — JetBrains Mono
// Variable carries display, body, and mono roles. Weight, size, and
// tracking carry all hierarchy. No serif display, no soft sans.
import '@/lib/fonts'
/* Astro-palette base tokens (AGPL import-only CSS, no .astro source copied) */
/* style.css is loaded via <link> in <head> — public assets must not be
   imported through Astro frontmatter (Vite build resolution failure). */
import '@/styles/np-tokens.css'
import '@/styles/marketing.css'
import ThemeSwitcher from '@/components/ThemeSwitcher.astro'
import { withBasePath } from '@/utils/path'
import {
  getServiceWorkerScope,
  getServiceWorkerScriptUrl,
} from '@/utils/serviceWorkerPath'
import { SITE } from '@/config'
import SpeedInsights from '@vercel/speed-insights/astro'

interface Props {
  title?: string
  description?: string
  keywords?: string
  themeMode?: 'light' | 'dark' | 'system'
  ogType?: 'website' | 'article'
  image?: string
  bgType?: string | boolean
  pubDate?: string
  lastModDate?: string
  pathname?: string
  showNavBar?: boolean
  showFooter?: boolean
  showBackLink?: boolean
  fullWidthMain?: boolean
  centered?: boolean
  contentClass?: string
  transitionMode?: string
  isLoginPage?: boolean
  showSettingsPanel?: boolean
  showAnalysisPanel?: boolean
  initialTab?: string
  [key: string]: any
}

const siteName = SITE.title || 'Pixelated Empathy'
const defaultDescription =
  SITE.description ||
  'Clinical simulation for therapist training and supervision'

const {
  title = siteName,
  description = defaultDescription,
  ogType = 'website',
  image,
} = Astro.props

const siteBase = Astro.site ?? new URL(Astro.url.origin)
const canonicalURL = new URL(Astro.url.pathname, siteBase)
const imageURL = image
  ? new URL(image, siteBase)
  : new URL(withBasePath('/og.jpg'), siteBase)
const fullTitle = title === siteName ? title : `${title} — ${siteName}`

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/features', label: 'Features' },
  { href: '/trust', label: 'Trust' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
]

const currentPath = Astro.url.pathname
const isActive = (href: string) => {
  const full = withBasePath(href)
  return href === '/'
    ? currentPath === full
    : currentPath === full || currentPath.startsWith(`${full}/`)
}

const cspNonce = Astro.locals.cspNonce ?? ''
const serviceWorkerUrl = getServiceWorkerScriptUrl()
const serviceWorkerScope = getServiceWorkerScope()

// Speed Insights routes (/_vercel/speed-insights/*) only exist on Vercel.
// Skip on primary self-hosted builds to avoid dead script fetches.
const isVercelDeploy = !!process.env['VERCEL']

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'Pixelated Empathy',
  'url': 'https://pixelatedempathy.com',
  'logo': 'https://pixelatedempathy.com/favicon.svg',
  'description':
    'Clinical simulation and transcript-based review for therapist training and supervision teams.',
  'foundingDate': '2025',
  'address': { '@type': 'PostalAddress', 'addressCountry': 'US' },
  'contactPoint': {
    '@type': 'ContactPoint',
    'email': 'info@pixelatedempathy.com',
    'contactType': 'Customer Service',
  },
  'sameAs': [
    'https://x.com/juggledaggers',
    'https://github.com/daggerstuff/pixelated',
  ],
}

const mixpanelToken = import.meta.env['PUBLIC_MIXPANEL_TOKEN']

// Analytics never loads on privacy-sensitive surfaces (auth, chat, therapy,
// dashboards) — typed content there can contain PHI.
const analyticsExcludedPrefixes = [
  '/login',
  '/register',
  '/signin',
  '/signup',
  '/reset-password',
  '/auth',
  '/chat',
  '/therapy',
  '/mental-health',
  '/dashboard',
  '/admin',
  '/simulator',
]
const isAnalyticsAllowedRoute = !analyticsExcludedPrefixes.some((prefix) =>
  currentPath.startsWith(withBasePath(prefix)),
)

// Opt-in only: Mixpanel initializes solely after explicit consent
// (localStorage 'px-analytics-consent' === 'granted'). Session recording is
// disabled entirely for this mental-health product.
const mixpanelScript = mixpanelToken
  ? `
if (localStorage.getItem('px-analytics-consent') === 'granted') {
(function(e,c){if(!c.__SV){var l,h;window.mixpanel=c;c._i=[];c.init=function(q,r,f){function t(d,a){var g=a.split(".");2==g.length&&(d=d[g[0]],a=g[1]);d[a]=function(){d.push([a].concat(Array.prototype.slice.call(arguments,0)))}}var b=c;"undefined"!==typeof f?b=c[f]=[]:f="mixpanel";b.people=b.people||[];b.toString=function(d){var a="mixpanel";"mixpanel"!==f&&(a+="."+f);d||(a+=" (stub)");return a};b.people.toString=function(){return b.toString(1)+".people (stub)"};l="disable time_event track track_pageview track_links track_forms track_with_groups add_group set_group remove_group register register_once alias unregister identify name_tag set_config reset opt_in_tracking opt_out_tracking has_opted_in_tracking has_opted_out_tracking clear_opt_in_out_tracking start_batch_senders start_session_recording stop_session_recording people.set people.set_once people.unset people.increment people.append people.union people.track_charge people.clear_charges people.delete_user people.remove".split(" ");for(h=0;h<l.length;h++)t(b,l[h]);var n="set set_once union unset remove delete".split(" ");b.get_group=function(){function d(p){a[p]=function(){b.push([g,[p].concat(Array.prototype.slice.call(arguments,0)))}}for(var a={},g=["get_group"].concat(Array.prototype.slice.call(arguments,0)),m=0;m<n.length;m++)d(n[m]);return a};c._i.push([q,r,f])};c.__SV=1.2;var k=e.createElement("script");k.type="text/javascript";k.async=!0;k.src="undefined"!==typeof MIXPANEL_CUSTOM_LIB_URL?MIXPANEL_CUSTOM_LIB_URL:"file:"===e.location.protocol&&"//cdn.mxpnl.com/libs/mixpanel-2-latest.min.js".match(/^\\//)?"https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js":"//cdn.mxpnl.com/libs/mixpanel-2-latest.min.js";e=e.getElementsByTagName("script")[0];e.parentNode.insertBefore(k,e)}})(document,window.mixpanel||[]);
mixpanel.init('${mixpanelToken}', { autocapture: true });
}
`
  : ''
---

<!doctype html>
<html lang={SITE.lang || 'en'} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBasePath('/favicon.svg')} />
    <link rel="icon" href={withBasePath('/favicon.ico')} />
    <link rel="manifest" href={withBasePath('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={withBasePath('/favicon.svg')} />
    <meta name="theme-color" content="#131313" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={withBasePath('/sitemap-index.xml')} />
    <link rel="stylesheet" href={withBasePath('/css/style.css')} />
    <title>{fullTitle}</title>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {imageURL && <meta property="og:image" content={imageURL} />}

    <meta
      name="twitter:card"
      content={imageURL ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}

    <script is:inline nonce={cspNonce}>
      const storedTheme = localStorage.getItem('theme')
      document.documentElement.dataset['theme'] = storedTheme || 'dark'
      const storedPalette = localStorage.getItem('site-palette')
      const systemPalette = window.matchMedia('(prefers-color-scheme: dark)')
        .matches
        ? 'vesper'
        : 'rose-pine-dawn'
      document.documentElement.setAttribute(
        'data-palette',
        storedPalette || systemPalette,
      )
    </script>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)
        .replaceAll(String.fromCharCode(60), '\\u003c')
        .replaceAll(String.fromCharCode(62), '\\u003e')}
    />
    {
      mixpanelToken && isAnalyticsAllowedRoute && (
        <script type="text/javascript" set:html={mixpanelScript} />
      )
    }
    <script
      is:inline
      nonce={cspNonce}
      define:vars={{ serviceWorkerUrl, serviceWorkerScope }}
    >
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register(serviceWorkerUrl, { scope: serviceWorkerScope })
            .catch(() => {})
        })
      }
    </script>
  </head>
  <body>
    <a class="np-skip-link" href="#main-content">Skip to main content</a>

    <ThemeSwitcher showHint={true} />

    <header class="site-header">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href={withBasePath('/')} aria-label={siteName}>
          <span>{siteName}</span>
        </a>

        <details class="nav-menu">
          <summary class="nav-menu-button" aria-label="Open navigation">
            <span></span>
            <span></span>
            <span></span>
          </summary>
          <div class="nav-menu-panel">
            {
              navItems.map((item) => (
                <a
                  href={withBasePath(item.href)}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </div>
        </details>

        <div class="nav-links">
          {
            navItems.map((item) => (
              <a
                href={withBasePath(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>

        <div class="nav-tools">
          <button
            class="nav-icon-link"
            type="button"
            id="search-open"
            aria-label="Search (Ctrl/K)"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
          </button>
          <button
            class="nav-icon-link"
            type="button"
            aria-label="Toggle color theme"
            data-theme-toggle
          >
            <svg
              class="nav-toggle-sun"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              aria-hidden="true"
            >
              <circle cx="8" cy="8" r="3.25"></circle>
              <path
                d="M8 0.75v2M8 13.25v2M15.25 8h-2M2.75 8h-2M13.13 2.87l-1.42 1.42M4.29 11.71l-1.42 1.42M13.13 13.13l-1.42-1.42M4.29 4.29L2.87 2.87"
              ></path>
            </svg>
            <svg
              class="nav-toggle-moon"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              aria-hidden="true"
            >
              <path
                d="M13.25 9.6A5.75 5.75 0 0 1 6.4 2.75a5.75 5.75 0 1 0 6.85 6.85Z"
              ></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <!-- astro-palette footer -->
    <footer class="footer">
      <span>&copy; {new Date().getFullYear()} {siteName}</span>
    </footer>

    <!-- Search overlay (astro-palette style, Cmd/Ctrl K) -->
    <div class="theme-overlay" id="search-overlay" hidden>
      <div
        class="theme-overlay-panel"
        role="dialog"
        aria-label="Search"
        aria-modal="true"
      >
        <div class="search-input-row">
          <span class="search-prompt" aria-hidden="true">$</span>
          <input
            id="search-input"
            type="search"
            autocomplete="off"
            spellcheck="false"
            aria-label="Search query"
          />
          <span class="search-caret" aria-hidden="true"></span>
        </div>
        <div
          class="search-results"
          id="search-results"
          role="listbox"
          aria-label="Search results"
        >
          <p class="search-empty">Type to search</p>
        </div>
        <div class="theme-overlay-footer">
          <span class="theme-overlay-actions">
            <button class="theme-close-btn" type="button" id="search-close-btn"
              >esc</button
            >
          </span>
        </div>
      </div>
    </div>

    <script>
      // Theme toggle (light/dark) — retained for components that depend on data-theme
      const toggle = document.querySelector('[data-theme-toggle]')
      toggle?.addEventListener('click', () => {
        const current = document.documentElement.dataset['theme']
        const next = current === 'dark' ? 'light' : 'dark'
        document.documentElement.dataset['theme'] = next
        localStorage.setItem('theme', next)
        window.dispatchEvent(
          new CustomEvent('theme-changed', { detail: { theme: next } }),
        )
      })
    </script>

    <script>
      // Search overlay — astro-palette style, with Pagefind when available
      let searchController: AbortController | undefined

      function initSearch() {
        searchController?.abort()
        searchController = new AbortController()
        const { signal } = searchController

        const overlay = document.getElementById('search-overlay')
        const input = document.getElementById(
          'search-input',
        ) as HTMLInputElement | null
        const resultsEl = document.getElementById('search-results')
        const openBtn = document.getElementById('search-open')
        const closeBtn = document.getElementById('search-close-btn')
        if (!overlay || !input || !resultsEl || !openBtn || !closeBtn) return

        let pagefind: {
          search: (q: string) => Promise<any>
          init: () => void
        } | null = null
        let pagefindFailed = false

        async function loadPagefind() {
          if (pagefind || pagefindFailed) return pagefind
          try {
            pagefind = await new Function(
              "return import('/pagefind/pagefind.js')",
            )()
            pagefind?.init()
          } catch {
            pagefindFailed = true
          }
          return pagefind
        }

        let items: HTMLElement[] = []
        let activeIndex = -1
        let debounceTimer: ReturnType<typeof setTimeout> | undefined
        let queryId = 0

        function setEmpty(message: string) {
          if (!resultsEl) return
          resultsEl.innerHTML = ''
          const p = document.createElement('p')
          p.className = 'search-empty'
          p.textContent = message
          resultsEl.append(p)
          items = []
          activeIndex = -1
        }

        function setActive(index: number) {
          activeIndex = index
          items.forEach((item, i) => {
            item.setAttribute('aria-selected', String(i === index))
          })
          items[index]?.scrollIntoView({ block: 'nearest' })
        }

        async function runSearch(query: string) {
          const id = ++queryId
          if (!query.trim()) {
            setEmpty('Type to search')
            return
          }
          const pf = await loadPagefind()
          if (!pf) {
            setEmpty(
              'Search index not found: run npm run build to generate it.',
            )
            return
          }
          const res = await pf.search(query)
          if (id !== queryId || !resultsEl) return
          const top = await Promise.all(
            res.results.slice(0, 8).map((r: any) => r.data()),
          )
          if (id !== queryId) return
          if (top.length === 0) {
            setEmpty(`No matches for "${query}"`)
            return
          }
          resultsEl.innerHTML = ''
          items = top.map((data: any) => {
            const link = document.createElement('a')
            link.className = 'search-result'
            link.href = data.url
            link.setAttribute('role', 'option')
            const title = document.createElement('span')
            title.className = 'search-result-title'
            title.textContent = data.meta?.title ?? data.url
            const excerpt = document.createElement('span')
            excerpt.className = 'search-result-excerpt'
            excerpt.innerHTML = data.excerpt ?? ''
            link.append(title, excerpt)
            link.addEventListener(
              'click',
              () => {
                if (input) input.value = ''
              },
              { signal },
            )
            resultsEl.append(link)
            return link as HTMLElement
          })
          setActive(0)
        }

        function openOverlay() {
          if (!overlay || !input) return
          overlay.hidden = false
          document.body.style.overflow = 'hidden'
          input.value = ''
          activeIndex = -1
          setEmpty('Type to search')
          input.focus()
          void loadPagefind()
        }

        function closeOverlay() {
          if (!overlay) return
          overlay.hidden = true
          document.body.style.overflow = ''
        }

        if (input) {
          input.addEventListener(
            'input',
            () => {
              clearTimeout(debounceTimer)
              debounceTimer = setTimeout(() => runSearch(input.value), 150)
            },
            { signal },
          )
        }

        openBtn.addEventListener('click', openOverlay, { signal })
        closeBtn.addEventListener('click', closeOverlay, { signal })
        overlay.addEventListener(
          'click',
          (e) => {
            if (e.target === overlay) closeOverlay()
          },
          { signal },
        )

        document.addEventListener(
          'keydown',
          (e) => {
            if (e.key === 'k' && (e.ctrlKey || e.metaKey)) {
              if (document.getElementById('theme-overlay')?.hidden === false)
                return
              e.preventDefault()
              if (overlay.hidden) openOverlay()
              else closeOverlay()
              return
            }
            if (overlay.hidden) return
            if (e.key === 'Escape') {
              e.preventDefault()
              closeOverlay()
            } else if (e.key === 'ArrowDown') {
              e.preventDefault()
              setActive(Math.min(items.length - 1, activeIndex + 1))
            } else if (e.key === 'ArrowUp') {
              e.preventDefault()
              setActive(Math.max(0, activeIndex - 1))
            } else if (e.key === 'Enter') {
              const active = items[activeIndex]
              if (active) {
                e.preventDefault()
                active.click()
              }
            } else if (e.key === 'Tab') {
              const focusables = [input, ...items, closeBtn].filter(
                Boolean,
              ) as HTMLElement[]
              const first = focusables[0]
              const last = focusables[focusables.length - 1]
              if (!first || !last) return
              if (e.shiftKey && document.activeElement === first) {
                e.preventDefault()
                last.focus()
              } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault()
                first.focus()
              }
            }
          },
          { signal },
        )
      }

      document.addEventListener('astro:page-load', initSearch)
    </script>
    {isVercelDeploy && <SpeedInsights />}
  </body>
</html>

<style is:global>
  /* astro-palette nav header — overrides the .nav/.site-header defaults
     from style.css with pixelated's brand identity. */

  .nav-tools {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  /* Theme toggle: sun shows when dark, moon shows when light */
  .nav-toggle-moon {
    display: none;
  }
  html[data-theme='light'] .nav-toggle-sun {
    display: none;
  }
  html[data-theme='light'] .nav-toggle-moon {
    display: block;
  }

  /* Brand uses pixelated's identity alongside site name */
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .brand span {
    font-family: var(--np-font-display);
    font-size: 1rem;
    font-weight: 350;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--np-text);
    white-space: nowrap;
  }

  /* NP Skip link */
  .np-skip-link {
    position: absolute;
    top: -100%;
    left: 16px;
    z-index: 100;
    padding: 8px 16px;
    background: var(--np-elevated);
    color: var(--np-text);
    border: 1px solid var(--np-line-strong);
    font-family: var(--np-font-mono);
    font-size: 0.75rem;
    text-decoration: none;
  }
  .np-skip-link:focus-visible {
    top: 8px;
    outline: 1px solid var(--np-mid);
    outline-offset: 2px;
  }
</style>
