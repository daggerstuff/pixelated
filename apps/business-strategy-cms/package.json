{
  "name": "business-strategy-cms",
  "version": "1.0.0",
  "description": "Business Strategy Expansion & CMS System",
  "keywords": [
    "business-strategy",
    "cms",
    "collaboration",
    "workflow"
  ],
  "license": "MIT",
  "author": "Pixelated Team",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
