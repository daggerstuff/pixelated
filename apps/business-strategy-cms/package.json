    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.9.1",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.1",
    "typescript": "~5.7.3"
