"""Minimal pytest surface for the isolated ratchet analysis.

The ratchet runs mypy with --no-site-packages so that dev machines and CI
agree on the error set. The cost is that pytest is invisible, which makes
`pytest.mark.parametrize` and friends Any, and every decorated test
"untyped". That is an artefact of the isolation, not a defect in the test:
the decorator is not what the gate is meant to measure.

Declaring the decorator forms here removes the artefact while keeping the
analysis strict about the functions themselves — a decorated test is now
type-checked as a test, rather than degraded to Any. Everything not named
below falls through to the module __getattr__, so the stub cannot turn an
unknown pytest API into a false error.
"""

from typing import Any, Callable, TypeVar, overload

_F = TypeVar("_F", bound=Callable[..., Any])

class _MarkDecorator:
    """`pytest.mark.<name>`, usable bare or called."""

    @overload
    def __call__(self, __func: _F) -> _F: ...
    @overload
    def __call__(self, *args: Any, **kwargs: Any) -> Callable[[_F], _F]: ...

class _Mark:
    def __getattr__(self, name: str) -> _MarkDecorator: ...

mark: _Mark

class _RaisesContext:
    value: Any
    def __enter__(self) -> _RaisesContext: ...
    def __exit__(self, *args: Any) -> None: ...

def raises(*args: Any, **kwargs: Any) -> _RaisesContext: ...

class MonkeyPatch:
    def setattr(self, target: Any, name: Any, value: Any = ..., raising: bool = True) -> None: ...
    def delattr(self, target: Any, name: Any = ..., raising: bool = True) -> None: ...
    def setenv(self, name: str, value: str, prepend: str | None = None) -> None: ...
    def delenv(self, name: str, raising: bool = True) -> None: ...
    def setitem(self, dic: Any, name: Any, value: Any) -> None: ...
    def delitem(self, dic: Any, name: Any, raising: bool = True) -> None: ...
    def syspath_prepend(self, path: Any) -> None: ...
    def chdir(self, path: Any) -> None: ...
    def __getattr__(self, name: str) -> Any: ...

@overload
def fixture(__func: _F) -> _F: ...
@overload
def fixture(*args: Any, **kwargs: Any) -> Callable[[_F], _F]: ...

def __getattr__(name: str) -> Any: ...
