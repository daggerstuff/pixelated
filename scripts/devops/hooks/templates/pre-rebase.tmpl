#!/usr/bin/env bash
set -euo pipefail

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\u001b[0m'

# Hook arguments:
# $1: The upstream branch we are rebasing ONTO. Empty for `git rebase --root`.
# $2: The branch being rebased (optional; if omitted, current HEAD is rebased).

# UPSTREAM is the target branch ($1), and TARGET_BRANCH is the branch being rewritten ($2 or HEAD)
UPSTREAM="${1:-}"
TARGET_BRANCH="${2:-$(git symbolic-ref -q --short HEAD || echo "detached")}"

# Normalize branch names to avoid path issues
TARGET_BRANCH=$(git rev-parse --abbrev-ref "$TARGET_BRANCH" 2>/dev/null || echo "$TARGET_BRANCH")

# Fetch protected branches from git config, falling back to defaults if not set.
# This prevents the hook from being 'frozen' at installation time.
PROTECTED_BRANCHES=$(git config --get pixelated.protectedBranches || echo "main master production staging")

# Guard only applies to protected branches.
IS_PROTECTED=0
for BRANCH in $PROTECTED_BRANCHES; do
  if [ "$TARGET_BRANCH" = "$BRANCH" ]; then
    IS_PROTECTED=1
    break
  fi
done
if [ "$IS_PROTECTED" -ne 1 ]; then
  exit 0
fi

# A rebase rewrites exactly the commits it replays: UPSTREAM..TARGET_BRANCH
# (the whole branch for `--root`). Rewriting them is only dangerous if any of
# them already exists on a remote — that would require a force-push and break
# other checkouts. Local-only commits are safe to rebase and push normally.
if [ -n "$UPSTREAM" ]; then
  RANGE="$UPSTREAM..$TARGET_BRANCH"
else
  RANGE="$TARGET_BRANCH"
fi

TOTAL=$(git rev-list --count "$RANGE" 2>/dev/null || echo "?")
if [ "$TOTAL" = "?" ]; then
  # Unresolvable range — let git itself report the error.
  exit 0
fi

# Commits in the replay set that no remote ref can reach = local-only.
LOCAL_ONLY=$(git rev-list --count "$RANGE" --not --remotes 2>/dev/null || echo 0)

if [ "$LOCAL_ONLY" -eq "$TOTAL" ]; then
  # Fast-forward (nothing replayed) or replaying local-only commits only —
  # no published history changes. Proceed.
  exit 0
fi

PUBLISHED=$((TOTAL - LOCAL_ONLY))
echo -e "${RED}❌ ERROR: rebase would rewrite $PUBLISHED published commit(s) on protected branch '$TARGET_BRANCH'.${NC}"
echo -e "${YELLOW}Those commits already exist on a remote; rebasing them would require a force-push${NC}"
echo -e "${YELLOW}and break other checkouts. Rebasing local-only commits on '$TARGET_BRANCH' remains allowed.${NC}"
exit 1
