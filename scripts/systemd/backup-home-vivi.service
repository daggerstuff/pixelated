[Unit]
Description=Backup /home/vivi and upload to Google Drive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
NoNewPrivileges=yes
PrivateTmp=yes
Environment="BACKUP_MODE=sectioned"
User=vivi
Group=vivi
Environment=HOME=/home/vivi
Environment=RCLONE_CONFIG=/home/vivi/.config/rclone/rclone.conf
Environment=SOURCE_DIR=/home/vivi
Environment=BACKUP_DIR=/home/vivi/.local/share/home_backups
Environment=RCLONE_TARGET=gdrive:vivi-home-backups
# Optional: upload directly into a specific subfolder within RCLONE_TARGET.
# Leave empty to sync directly into RCLONE_TARGET.
Environment=RCLONE_SYNC_PATH=
Environment=BACKUP_KEEP_RUNS=6
Environment=BACKUP_RUN_PREFIX=home-vivi-run
Environment=BACKUP_SECTION_STRICT_ERRORS=false
# Optional: comma/newline-separated list of sections; defaults to all top-level home folders.
Environment=BACKUP_SECTIONS=
ExecStart=/usr/bin/env bash /home/vivi/pixelated/scripts/backup/backup-home-vivi.sh
Restart=no
RestartSec=30s
StandardOutput=journal
StandardError=journal
TimeoutStartSec=3h
TimeoutStopSec=10m
KillMode=control-group
KillSignal=SIGINT
SendSIGKILL=no
OOMPolicy=kill
WorkingDirectory=/home/vivi
