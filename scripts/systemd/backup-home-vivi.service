[Unit]
Description=Backup /home/vivi and upload to S3
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
NoNewPrivileges=yes
PrivateTmp=yes
Environment="BACKUP_MODE=sectioned"
User=vivi
Group=vivi
Environment=HOME=/home/vivi
Environment=RCLONE_CONFIG=/home/vivi/.config/rclone/rclone.conf
Environment=SOURCE_DIR=/home/vivi
Environment=BACKUP_DIR=/home/vivi/.local/share/home_backups
Environment=RCLONE_TARGET=azureblob:vivi-home-backups
# Optional: upload directly into a specific subfolder within RCLONE_TARGET.
# Leave empty to sync directly into RCLONE_TARGET.
Environment=RCLONE_SYNC_PATH=
Environment=BACKUP_KEEP_RUNS=6
Environment=BACKUP_RUN_PREFIX=home-vivi-run
Environment=BACKUP_SECTION_STRICT_ERRORS=false
Environment="BACKUP_SKIP_SECTIONS=.cache .cargo .claude .claude-mem .codeql .cursor .cursor-server .codex .gemini .gemini-* .kube .antigravity-server .aitk .hermes .local .npm .pnpm-store .yarn .gradle .rustup .android .tmp .Trash .cache .cache-browser .venvs .virtualenvs"
Environment=BACKUP_RCLONE_TRANSFERS=24
Environment=BACKUP_RCLONE_CHECKERS=16
Environment=BACKUP_RCLONE_FAST_LIST=true
Environment=BACKUP_RCLONE_STATS=8s
Environment="BACKUP_RCLONE_EXCLUDE_EXTRA=.codeql/** .git/** .local/share/Trash/** .cache/** .npm/** .cargo/** .pnpm-store/** .yarn/** .node-gyp/** .gradle/** .rustup/** .android/** .ssh/** .cache/pip/** .cache/ms-playwright/** .cache/Code/** .cache/google-chrome/** .cache/gh/** .cache/huggingface/* pixelated/apps/web/src/lib/deployment/multi-region/ServiceDiscoveryManager.ts"
Environment="BACKUP_RCLONE_EXTRA_ARGS="
Environment=BACKUP_HEARTBEAT_INTERVAL=30
Environment=BACKUP_RUN_STATE_MAX_AGE_SECONDS=0
# Optional: comma/newline-separated list of sections; defaults to all top-level home folders.
Environment=BACKUP_SECTIONS=
ExecStart=/usr/bin/env bash /home/vivi/pixelated/scripts/backup/backup-home-vivi.sh
Restart=on-failure
RestartSec=3m
StandardOutput=journal
StandardError=journal
TimeoutStartSec=8h
TimeoutStopSec=10m
KillMode=control-group
KillSignal=SIGINT
SendSIGKILL=no
OOMPolicy=kill
WorkingDirectory=/home/vivi
