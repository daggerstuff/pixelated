        "names the wrong emotion"
      ]
    },
    {
      "move_id": "move_exploratory_specificity",
      "label": "Exploratory Specificity",
      "intent": "Move from vague suffering to concrete trigger, meaning, and pattern.",
      "when_to_use": [
        "confused narratives",
        "repeating cycles"
      ],
      "micro_skills": [
