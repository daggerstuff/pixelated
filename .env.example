# CMS Business Strategy API Environment Configuration

# ============================================================================
# DATABASE CONNECTIONS
# ============================================================================

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/<DATABASE>

# PostgreSQL / Supabase
DATABASE_URL=postgresql://user:password@localhost:5432/pixelated_cms

# Redis
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# API CONFIGURATION
# ============================================================================

# Server
PORT=5000
NODE_ENV=development
HOST=localhost

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ============================================================================
# AUTHENTICATION
# ============================================================================

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRY=24h # Per original PR requirements

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# Optional: Cloud Storage
AWS_REGION=hel1
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_BUCKET=pixel-data

# Production deployment (deploy/production/deploy-therapeutic-ai.sh)
THERAPEUTIC_DATABASE_URL=postgresql://user:password@postgres:5432/therapeutic_ai
THERAPEUTIC_REDIS_URL=redis://redis:6379/0

# Sentry (required for production sourcemap upload + error monitoring)
# SENTRY_AUTH_TOKEN is also read automatically from .env.sentry-build-plugin
# during builds by @sentry/vite-plugin. For CI/CD, set it as a secret:
#   GitHub Actions: repo Settings > Secrets > SENTRY_AUTH_TOKEN
#   Vercel:        Project Settings > Environment Variables
SENTRY_DSN=
# Client-facing DSN (Astro PUBLIC_ prefix — available in browser code)
PUBLIC_SENTRY_DSN=
# Mixpanel analytics token (available in browser code)
PUBLIC_MIXPANEL_TOKEN=
# Legacy aliases (resolved in fallback order by configs):
#   SENTRY_PUBLIC_DSN, VITE_SENTRY_DSN
SENTRY_AUTH_TOKEN=
SENTRY_ORG=pixelated-empathy-dq
SENTRY_PROJECT=pixel-astro

# Cloudflare Workers deployment
# Set to "cloudflare" to use env-based Sentry DSN lookup (sentry.server.cloudflare.ts)
# via wrangler secret / binding instead of process.env.
DEPLOY_TARGET=node

# Hermes RL (Tinker-Atropos)
TINKER_API_KEY=your-tinker-api-key
WANDB_API_KEY=your-wandb-key
NIM_API_KEY=your-nim-key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
RL_INFERENCE_TEST_MODELS=meta/llama-3.1-8b-instruct,meta/llama-3.1-70b-instruct,abacusai/dracarys-llama-3.1-70b-instruct

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=info
LOG_FORMAT=json

# ============================================================================
# RATE LIMITING
# ============================================================================

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# SECURITY
# ============================================================================

# HIPAA Compliance
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_RETENTION_DAYS=2555

# Encryption
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# ============================================================================
# FEATURE FLAGS
# ============================================================================

FEATURE_COLLABORATION=true
FEATURE_VERSIONING=true
FEATURE_APPROVAL_WORKFLOWS=true
FEATURE_AI_INSIGHTS=false

# ============================================================================
# AUTH0 CONFIGURATION
# ============================================================================

# Auth0 Domain (without https://)
AUTH0_DOMAIN=dev-f3vkhvb6n52y7fre.us.auth0.com

# Auth0 Application Credentials (from Applications > Your App > Settings)
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Auth0 API Audience (from APIs > Your API > Settings > Identifier)
AUTH0_AUDIENCE=https://your-api-identifier

# Auth0 Machine-to-Machine Application (for Management API)
# Create in Applications > Create Application > Machine to Machine
# Grant it permissions: read:users, update:users, create:users, delete:users
AUTH0_MANAGEMENT_CLIENT_ID=your-management-client-id
AUTH0_MANAGEMENT_CLIENT_SECRET=your-management-client-secret

# Auth0 Callback URL
AUTH0_CALLBACK_URL=http://localhost:4321/api/auth/auth0-callback

# Public Auth0 Config (browser @auth0/auth0-react — use SPA app, not regular_web)
PUBLIC_AUTH0_DOMAIN=dev-f3vkhvb6n52y7fre.us.auth0.com
PUBLIC_AUTH0_CLIENT_ID=your-spa-client-id
# Optional: custom API identifier (leave unset if using Management API audience only on server)
# PUBLIC_AUTH0_AUDIENCE=https://your-api-identifier
# Vite-style aliases (same SPA client as PUBLIC_*)
VITE_AUTH0_DOMAIN=dev-f3vkhvb6n52y7fre.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id

# ============================================================================
# LLM / AI PROVIDER (Pixelated Empathy backend — apps/web/src/pe)
# ============================================================================

# Provider type: mock | openai | openai-compatible
# Default is "mock" — no API key required for local development.
LLM_PROVIDER=mock

# API key for the LLM provider.
# Optional when LLM_PROVIDER=mock, REQUIRED otherwise.
# LLM_API_KEY=sk-your-key-here

# Base URL for the LLM API.
# Optional for openai, REQUIRED for openai-compatible (e.g. local LLM servers).
# LLM_BASE_URL=https://api.openai.com/v1

# Model identifier (e.g. gpt-4, claude-3-opus, local-model-name).
# LLM_MODEL_ID=gpt-4

# ============================================================================
# NEON AI GATEWAY (free during beta — https://neon.com/docs/ai-gateway/overview)
# ============================================================================
# Neon AI Gateway provides OpenAI-compatible access to open-weight models.
# Free during beta. Requires a paid Neon plan + aws-us-east-2 region.
#
# When these are set, the TS backend (completion.ts, response.ts, etc.) and
# Python backend (llm_client.py, llm_quality_judge.py, nvidia_llm_callback.py)
# will use Neon as the LLM provider instead of NVIDIA NIM or OpenAI.
#
# Token: Create in Neon Console → Branch → Credentials (scope: ai_gateway:invoke)
# Base URL: Found in Neon Console or via `neon api /projects/{id}/branches/{id}/ai_gateway`
#
# NEON_AI_GATEWAY_TOKEN=nt_live_your_token_here
# NEON_AI_GATEWAY_BASE_URL=https://your-branch-api.ai.c-5.us-east-2.aws.neon.tech
#
# OpenAI SDK compat — same values as above, with /v1 appended:
# OPENAI_API_KEY=nt_live_your_token_here
# OPENAI_BASE_URL=https://your-branch-api.ai.c-5.us-east-2.aws.neon.tech/v1
#
# Python backend uses these (same values):
# LLM_API_KEY=nt_live_your_token_here
# LLM_BASE_URL=https://your-branch-api.ai.c-5.us-east-2.aws.neon.tech/v1
#
# Default model (TS backend). Falls back to gpt-oss-120b if unset.
# LLM_DEFAULT_MODEL=gpt-oss-120b
#
# Judge models (Python llm_quality_judge.py). Falls back to Qwen/Llama if unset.
# LLM_PRIMARY_MODEL=gpt-oss-120b
# LLM_SECONDARY_MODEL=llama-4-maverick
#
# Available open-weight models (free):
#   gpt-oss-120b, gpt-oss-20b, llama-4-maverick, meta-llama-3-3-70b-instruct,
#   meta-llama-3-1-8b-instruct, qwen3-next-80b-a3b-instruct,
#   qwen35-122b-a10b, gemma-3-12b
# Frontier models (gpt-5*, claude-*, gemini-*) require a verified account.
