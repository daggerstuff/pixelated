{
  "permissions": {
    "allow": [
      "Bash(curl -s \"http://127.0.0.1:4323/login\" -w \"\\\\nHTTP Status: %{http_code}\\\\n\")",
      "Bash(pnpm list *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "notionApi",
    "linear",
    "foresight",
    "context7",
    "asana",
    "colab-mcp"
  ],
  "disabledMcpjsonServers": ["colab-mcp"],
  "skillOverrides": {
    "distill": "off",
    "executing-plans": "off",
    "ai-engineer": "on",
    "autofix": "on",
    "taste-skill": "on",
    "dotagents": "on",
    "find-skills": "on",
    "git-lint": "on",
    "git-push": "on"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/vivi/.github/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/home/vivi/.local/bin/headroom wrap selfheal --marker headroom-wrap-selfheal",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: runs after Edit/Write/MultiEdit on UI files and surfaces findings as system reminders."
}
