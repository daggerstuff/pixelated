{
  "version": "1.2.0",
  "baseline": {
    "security_policies": {
      "enforce_mfa": true,
      "audit_logging": true,
      "data_encryption": true,
      "authentication": {
        "session_timeout_seconds": 900,
        "max_login_attempts": 5,
        "account_lockout_minutes": 30,
        "password_min_length": 12,
        "password_require_special": true,
        "password_require_numbers": true,
        "password_require_uppercase": true
      },
      "rate_limiting": {
        "enabled": true,
        "max_requests_per_minute": 100,
        "burst_size": 20
      },
      "session_management": {
        "rotate_on_login": true,
        "invalidate_on_logout": true,
        "prevent_concurrent_sessions": true
      },
      "csp_policy": {
        "default_src": "'self'",
        "script_src": "'self' 'nonce-<generated>' https://cdn.pixelatedempathy.com https://www.googletagmanager.com https://js.sentry-cdn.com https://analytics.pixelatedempathy.com",
        "style_src": "'self' 'unsafe-inline' 'nonce-<generated>' https://cdn.pixelatedempathy.com https://fonts.googleapis.com https://cdn.jsdelivr.net",
        "img_src": "'self' data: blob: https://cdn.pixelatedempathy.com https://images.unsplash.com https://upload.wikimedia.org https://avatars.githubusercontent.com https://www.gravatar.com",
        "connect_src": "'self' https://api.nebius.ai https://api.openai.com https://api.replicate.com https://api.resend.com https://www.googletagmanager.com https://js.sentry-cdn.com https://analytics.pixelatedempathy.com https://accounts.google.com https://api.github.com https://*.sentry.io https://pixelatedempathy.com wss://*.sentry.io https://cdn.jsdelivr.net",
        "font_src": "'self' https://cdn.pixelatedempathy.com https://fonts.gstatic.com https://fonts.bunny.net https://cdn.jsdelivr.net",
        "object_src": "'none'",
        "frame_ancestors": "'none'",
        "base_uri": "'self'",
        "form_action": "'self'",
        "frame_src": "'self' https://giscus.app",
        "worker_src": "'self' blob:",
        "manifest_src": "'self'",
        "media_src": "'self' https://cdn.pixelatedempathy.com",
        "upgrade_insecure_requests": true,
        "report_uri": "/api/v1/csp-violation"
      },
      "security_headers": {
        "x_content_type_options": "nosniff",
        "x_frame_options": "DENY",
        "referrer_policy": "strict-origin-when-cross-origin",
        "permissions_policy": "camera=(), microphone=(), geolocation=(), payment=()",
        "hsts": "max-age=31536000; includeSubDomains; preload"
      }
    },
    "compliance_standards": ["HIPAA", "GDPR", "SOC2", "ISO-27001"],
    "encryption": {
      "data_at_rest": {
        "algorithm": "AES-256-GCM",
        "key_rotation_days": 90
      },
      "data_in_transit": {
        "protocol": "TLS 1.3",
        "certificate_path": "/etc/ssl/certs/pixelated.crt"
      },
      "fhe_enabled": true,
      "key_management": {
        "provider": "AWS KMS",
        "key_rotation_interval_days": 90
      }
    },
    "audit": {
      "log_level": "warn",
      "log_retention_days": 365,
      "include_events": [
        "authentication",
        "authorization_failures",
        "data_access",
        "admin_actions",
        "encryption_key_operations",
        "phi_access"
      ],
      "audit_log_format": "structured_json"
    },
    "vulnerability_scanning": {
      "dependency_audit_enabled": true,
      "docker_image_scan_enabled": true,
      "sast_tools": ["trivy", "semgrep", "oxlint"],
      "schedule": {
        "dependencies": "weekly",
        "docker_images": "on_build",
        "static_analysis": "per_commit"
      },
      "severity_threshold": "high",
      "fail_pipeline_on": "critical"
    },
    "testing": {
      "unit_test_coverage_target": 70,
      "security_unit_tests_required": true,
      "hipaa_compliance_tests_required": true,
      "penetration_test_schedule": "quarterly",
      "dependency_vulnerability_check_cmd": "pnpm audit --audit-level moderate"
    },
    "incident_response": {
      "contact_email": "security@pixelatedempathy.com",
      "response_time_target_minutes": 15,
      "resolution_time_target_hours": 4,
      "post_mortem_required_for": ["phi_breach", "data_loss", "service_outage"],
      "notification_authorities_within_hours": 72
    }
  }
}
