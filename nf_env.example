# Colab Nightmare-Fuel run env — copy to /content/nf_env and fill in real values.
# Loaded by scripts/colab_nf_bootstrap.py (load_env reads KEY=VALUE lines).
# Fill secrets from the repo-root .env (gitignored); NEVER commit real values here.

# --- Generation target ---
# Total edge-case records. Variations per combo = ceil(TARGET/120); the 120-combo
# matrix (10 families x 3 difficulty x 4 ambiguity) then yields >= TARGET records.
TARGET=50000
# Optional hard cap on TOTAL output records (smoke/dry runs only).
# Unset for the real +50k run.
#NF_LIMIT=5

# --- ModerateGuard credit-burn limits (defaults: 10000/hour, 50000 hard) ---
# The guard auto-kills once total records > NF_HARD_CEILING. A +50k run produces
# 50040 edge + 92 nightmare = 50132 records, so the DEFAULT 50000 ceiling would
# stop it ~132 records short. Raise NF_HARD_CEILING for the real run.
NF_HOURLY_LIMIT=10000
NF_HARD_CEILING=55000
# Gate-rejected generations are retried up to this many times with the offending
# phrase explicitly forbidden (cuts the ~25% cliché rejection rate to a few %).
NF_REJECT_RETRIES=2

# --- Ollama / local model (the ONLY backend — never switch off Ollama) ---
LOCAL_MODEL=gurubot/wayfarer-2-12B
# Ollama OpenAI-compatible endpoint.
VLLM_URL=http://localhost:11434
# Parallel request serving (default 1 = serial). Match the generator's concurrency
# (3) so an A100/40GB runs ~3x faster; raise/lower with VRAM headroom.
OLLAMA_NUM_PARALLEL=3
# Where generated JSONL lands on the Colab VM.
NF_OUTPUT_DIR=/content/output

# --- Crash-persistence upload to Cloudflare R2 (S3-compatible, via rclone) ---
R2_BUCKET=training
R2_ENDPOINT=https://6c9200f8f880a7f846e70cda63baa1be.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<from-.env>
R2_SECRET_ACCESS_KEY=<from-.env>
R2_PREFIX=colab_nf_output
# Seconds between durable R2 mirror uploads (default 300); a final flush always runs.
NF_UPLOAD_INTERVAL=300

# --- Observability ---
# LangSmith v2: LANGSMITH_WORKSPACE_ID is REQUIRED — without it ingest 403s.
LANGSMITH_API_KEY=<from-.env>
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=clinical-nf-generation
LANGSMITH_WORKSPACE_ID=<from-.env>
# Weave (W&B tracing).
WANDB_API_KEY=<from-.env>
WANDB_PROJECT=pixelated-empathy-kan28