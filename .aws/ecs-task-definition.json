{
  "family": "pixelated-empathy-api",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "ARM64"
  },
  "executionRoleArn": "arn:aws:iam::638175140335:role/pixelated-empathy-staging-ecs-exec",
  "taskRoleArn": "arn:aws:iam::638175140335:role/pixelated-empathy-staging-ecs-task",
  "containerDefinitions": [
    {
      "name": "pixelated-empathy-api",
      "image": "${IMAGE_URI}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4321,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "APP_NAME",
          "value": "pixelated-empathy"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "4321"
        },
        {
          "name": "HOST",
          "value": "0.0.0.0"
        },
        {
          "name": "CORS_ORIGIN",
          "value": "https://pixelatedempathy.com,https://www.pixelatedempathy.com"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:638175140335:secret:pixelated/DATABASE_URL-qeked8"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:ssm:us-east-1:638175140335:parameter/pixelated/REDIS_URL"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:ssm:us-east-1:638175140335:parameter/pixelated/JWT_SECRET"
        },
        {
          "name": "API_KEY",
          "valueFrom": "arn:aws:ssm:us-east-1:638175140335:parameter/pixelated/API_KEY"
        },
        {
          "name": "SENTRY_DSN",
          "valueFrom": "arn:aws:ssm:us-east-1:638175140335:parameter/pixelated/SENTRY_DSN"
        },
        {
          "name": "AUTH0_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:638175140335:secret:pixelated/AUTH0_CLIENT_SECRET-Cqa4K3"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:4321/api/health/ || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/pixelated-empathy-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "ulimits": [
        {
          "name": "nofile",
          "softLimit": 65536,
          "hardLimit": 65536
        }
      ]
    }
  ]
}
