      "AuditItemIn": {
        "description": "One piece of content submitted for auditing.",
        "properties": {
          "author_role": {
            "default": "",
            "description": "Who produced the item.",
            "title": "Author Role",
            "type": "string"
          },
          "content": {
            "description": "The content text to audit.",
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "context": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Adapter metadata.",
            "title": "Context",
            "type": "object"
          },
          "id": {
            "description": "Stable identifier for this item.",
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "default": "ai_response",
            "description": "Content kind, e.g. 'ai_response'.",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": ["id", "content"],
        "title": "AuditItemIn",
        "type": "object"
      },
      "AuditRequest": {
        "description": "Request body for POST /api/v1/audits.",
        "properties": {
          "auditors": {
            "default": ["brene_brown"],
            "description": "Adversarial auditor persona names (TOML descriptors shipped with quadit).",
            "items": {
              "type": "string"
            },
            "minItems": 0,
            "title": "Auditors",
            "type": "array"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/AuditItemIn"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          },
          "mode": {
            "default": "deterministic",
            "description": "'deterministic' for pattern scans, 'llm' for full judge prompts.",
            "pattern": "^(deterministic|llm)$",
            "title": "Mode",
            "type": "string"
          }
        },
        "required": ["items"],
        "title": "AuditRequest",
        "type": "object"
      },
      "CreateSimulationRequest": {
        "properties": {
          "learner_id": {
            "anyOf": [
