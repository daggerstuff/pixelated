    "agent:status": "uv run python -m tools.agent_runner status",
    "agent:dashboard": "uv run python -m tools.agent_runner dashboard",
    "agent:events": "uv run python -m tools.agent_runner events",
    "agent:plan": "uv run python -m tools.agent_runner plan",
    "agent:lineage": "uv run python -m tools.agent_runner lineage",
