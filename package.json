    "test:all": "node scripts/testing/local-test-runner.cjs",
    "test:blocking": "VITEST_SUITE=blocking node ./scripts/testing/blocking-test-runner.cjs",
    "test:advisory": "VITEST_SUITE=advisory node ./scripts/testing/local-test-runner.cjs",
