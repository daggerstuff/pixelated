{
  "name": "pixelated",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bias:py": "PORT=5000 ENV=development uv run --python 3.13 python src/lib/ai/bias-detection/python-service/bias_detection_service.py",
    "astro": "astro",
    "sync": "astro sync",
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' astro dev --host 0.0.0.0 --port 5173",
    "start": "node scripts/utils/start-server.mjs",
    "start:sentry": "node scripts/utils/start-server.mjs",
    "preview": "PIXELATED_PREVIEW=true node scripts/utils/start-server.mjs",
    "dev:bias-detection": "PORT=8001 tsx src/lib/ai/bias-detection/server.ts",
    "dev:ai-service": "PORT=8002 tsx src/lib/ai/services/server.ts",
    "dev:analytics": "tsx src/lib/analytics/server.ts",
    "dev:worker": "NODE_ENV=development tsx src/lib/jobs/worker.ts",
    "dev:training-server": "NODE_ENV=development tsx src/lib/services/training/server.ts",
    "dev:websocket": "NODE_ENV=development tsx src/server.ts",
    "dev:academic-sourcing": "ENV=development uv run uvicorn ai.sourcing.academic.api.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:all-services": "concurrently \"pnpm dev\" \"pnpm dev:bias-detection\" \"pnpm dev:ai-service\" \"pnpm dev:analytics\" \"pnpm dev:worker\" \"pnpm dev:training-server\" \"pnpm dev:websocket\" \"pnpm dev:academic-sourcing\" \"pnpm bias:py\"",
    "setup:dev": "./scripts/setup-dev.sh",
    "submodules:init": "git submodule init",
    "submodules:update": "git submodule update",
    "submodules:sync": "git submodule init && git submodule update",
    "jules:setup": "bash scripts/devops/jules-setup.sh",
    "jules:check": "git status | grep 'on branch staging' || (echo '❌ ERROR: Jules must work on staging branch' && exit 1) && pnpm check:all",
    "hooks:install": "[ -f scripts/devops/install-git-hooks.sh ] && bash scripts/devops/install-git-hooks.sh || echo \"Skipping git hooks install: scripts/devops/install-git-hooks.sh not found.\"",
    "prepare": "pnpm run -s hooks:install",
    "build": "CI=true node scripts/ci/build-with-pipe-handling.mjs",
    "build:vercel": "DEPLOY_TARGET=vercel astro build",
    "build:api-docs": "npx tsx scripts/generate-memory-openapi.ts",
    "build:analyze": "astro build && pnpm run analyze:bundle",
    "analyze:bundle": "npx astro-bundle-analyzer dist",
    "format": "oxfmt --write . && prettier --write \"**/*.astro\"",
    "format:check": "oxfmt --check . && prettier --check \"**/*.astro\"",
    "format:check:changed": "node scripts/ci/format-changed.mjs",
    "format:jules-markdown": "tsx scripts/ci/format-jules-markdown.ts",
    "prelint": "bash scripts/ci/prelint-node.sh",
    "prelint:fix": "bash scripts/ci/prelint-node.sh",
    "prelint:ci:all": "bash scripts/ci/prelint-node.sh",
    "prelint:ci:type-aware:all": "bash scripts/ci/prelint-node.sh",
    "lint": "oxlint -c .oxlintrc.json . && pnpm lint:no-suppressions",
    "lint:full": "oxlint --type-aware -c .oxlintrc.json .",
    "lint:markdown": "pnpm exec markdownlint --config .markdownlint.json --ignore node_modules --ignore '**/node_modules/**' \"**/*.md\" \"**/*.mdx\"",
    "lint:markdown:staged": "git diff --cached --name-only --diff-filter=ACM -- '*.md' '*.mdx' | xargs -r pnpm exec markdownlint --config .markdownlint.json",
    "lint:ci": "node scripts/ci/lint-changed.mjs",
    "lint:ci:all": "oxlint -c .oxlintrc.json . && pnpm lint:no-suppressions",
    "lint:zod": "node scripts/ci/check-zod-deprecations.mjs",
    "lint:no-suppressions": "bash scripts/ci/check-no-suppressions.sh",
    "lint:ci:with-markdown": "pnpm lint:ci && pnpm lint:markdown:ci && pnpm lint:no-suppressions",
    "lint:ci:type-aware": "node scripts/ci/lint-changed.mjs --type-aware",
    "lint:ci:type-aware:all": "pnpm exec oxlint --type-aware -c .oxlintrc.json . && pnpm lint:no-suppressions",
    "lint:markdown:ci": "node scripts/ci/lint-changed.mjs --markdown",
    "lint:markdown:ci:all": "pnpm exec markdownlint --config .markdownlint.json --ignore node_modules --ignore '**/node_modules/**' \"**/*.md\" \"**/*.mdx\"",
    "lint:fix": "oxlint -c .oxlintrc.json --fix-dangerously . && pnpm lint:no-suppressions",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' astro check && NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit",
    "typecheck:strict": "NODE_OPTIONS='--max-old-space-size=8192' tsx scripts/validate-typescript.ts",
    "type-check": "pnpm run typecheck",
    "check": "NODE_OPTIONS='--max-old-space-size=8192' astro check",
    "check:all": "pnpm run check && pnpm run typecheck",
    "test": "node ./scripts/testing/local-test-runner.cjs",
    "test:blocking": "VITEST_SUITE=blocking node ./scripts/testing/blocking-test-runner.cjs",
    "test:advisory": "VITEST_SUITE=advisory node ./scripts/testing/local-test-runner.cjs",
    "test:unit": "NODE_ENV=test NODE_OPTIONS='--max-old-space-size=8192' vitest run -c config/vitest.config.ts --coverage",
    "test:integration": "vitest run tests/integration/",
    "test:coverage": "NODE_ENV=test vitest run -c config/vitest.config.ts --coverage",
    "test:watch": "vitest watch",
    "test:all": "node scripts/testing/local-test-runner.cjs",
    "test:evals": "uv run pytest -q tests/test_therapy_bench_persistence.py tests/test_faiss_standalone.py tests/test_relevance_scorer_standalone.py",
    "test:hipaa": "node scripts/consolidated-test.js hipaa",
    "test:crypto": "node scripts/consolidated-test.js crypto",
    "test:backup": "node scripts/consolidated-test.js backup",
    "test:security": "node scripts/consolidated-test.js security",
    "test:bias-detection": "vitest run src/lib/ai/bias-detection/ src/components/admin/bias-detection/",
    "e2e": "playwright test --config=config/playwright.config.ts",
    "e2e:smoke": "playwright test tests/e2e/smoke/ --config=config/playwright.config.ts",
    "e2e:browser": "playwright test tests/browser/ --config=config/playwright.config.ts",
    "e2e:browser-compat": "playwright test tests/browser-compatibility.spec.ts --config=config/playwright-browser-compat.config.ts",
    "e2e:browser-compat-timeout": "bash scripts/browser-compatibility-test.sh",
    "e2e:ui": "playwright test --ui --config=config/playwright.config.ts",
    "e2e:headed": "playwright test --headed --config=config/playwright.config.ts",
    "e2e:debug": "playwright test --debug --config=config/playwright.config.ts",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install",
    "e2e:codegen": "playwright codegen localhost:3000",
    "e2e:docker": "docker-compose -f docker/docker-compose.playwright.yml run --rm playwright",
    "e2e:docker:ui": "docker-compose -f docker/docker-compose.playwright.yml run --rm -e PLAYWRIGHT_UI=true playwright pnpm e2e:ui",
    "e2e:docker:setup": "bash scripts/testing/test-playwright-docker.sh",
    "mongodb:init": "node scripts/mongodb-init.js",
    "mongodb:seed": "node scripts/mongodb-seed.js",
    "mongodb:migrate": "node scripts/mongodb-migrate.js",
    "db:migrate": "tsx scripts/db-migrate.ts migrate",
    "db:rollback": "tsx scripts/db-migrate.ts rollback",
    "db:status": "tsx scripts/db-migrate.ts status",
    "redis:check": "node src/lib/services/redis/health-check.js",
