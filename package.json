    "e2e:debug": "playwright test --debug --config=config/playwright.config.ts",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install",
    "codegen:graphql": "graphql-codegen --config codegen.ts && node -e \"const fs=require('fs');const f='apps/web/src/lib/graphql/generated/types.ts';let c=fs.readFileSync(f,'utf8');const s=new Set();c=c.replace(/^export type (\\w+) =\\n(?:  \\| '[^']+';?\\n)+/gm,(m,n)=>{if(s.has(n))return'';s.add(n);return m});fs.writeFileSync(f,c);\"",
    "e2e:codegen": "playwright codegen localhost:3000",
    "e2e:docker": "docker-compose -f infra/docker/docker-compose.playwright.yml run --rm playwright",
    "e2e:docker:ui": "docker-compose -f infra/docker/docker-compose.playwright.yml run --rm -e PLAYWRIGHT_UI=true playwright pnpm e2e:ui",
    "e2e:docker:setup": "bash scripts/testing/test-playwright-docker.sh",
