    "redis:ping": "./scripts/redis.sh ping",
    "redis:health": "./scripts/redis.sh health",
    "redis:use:local": "./scripts/redis.sh local",
    "redis:use:remote": "./scripts/redis.sh remote",
    "security:redis-check": "./scripts/check-redis-hardening.sh",
    "test:redis:local": "./scripts/redis.sh local",
    "test:redis:local:integration": "bash ./scripts/redis.sh local pnpm vitest -c config/vitest.config.ts src/lib/services/redis/__tests__/CacheInvalidation.integration.test.ts src/lib/services/redis/__tests__/RedisService.integration.test.ts src/lib/services/redis/__tests__/RedisService.perf.test.ts src/lib/services/redis/__tests__/Analytics.integration.test.ts --coverage.enabled=false",
    "test:redis:remote": "bash ./scripts/redis.sh remote pnpm vitest -c config/vitest.config.ts src/lib/services/redis/__tests__/RedisService.test.ts src/lib/services/redis/__tests__/CacheInvalidation.integration.test.ts src/lib/services/redis/__tests__/RedisService.integration.test.ts src/lib/services/redis/__tests__/RedisService.perf.test.ts src/lib/services/redis/__tests__/Analytics.integration.test.ts --coverage.enabled=false",
