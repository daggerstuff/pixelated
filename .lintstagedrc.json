{
  ".Jules/**/*.md": ["pnpm run format:jules-markdown"],
  ".Jules/**/*.mdx": ["pnpm run format:jules-markdown"],
  "*.{js,ts,jsx,tsx,astro}": ["bash scripts/ci/oxlint-staged.sh -c .oxlintrc.json --ignore-pattern 'src/scripts/**'"],
  "*.{ts,tsx}": ["node scripts/ci/check-zod-deprecations.mjs"],
  "*.{md,mdx}": [
    "markdownlint --config .markdownlint.json --ignore \".agents/**\" --ignore \".Jules/**\""
  ],
  "*.py": ["ruff check --fix --exit-zero", "ruff format"]
}
