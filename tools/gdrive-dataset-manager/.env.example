# Postgres (drive-index-postgres container, docker/docker-compose.drive-index.yml)
DRIVE_INDEX_DSN=postgresql://drive_index:CHANGEME@127.0.0.1:5433/drive_index
# Used by docker compose for the container itself
DRIVE_INDEX_DB=drive_index
DRIVE_INDEX_DB_USER=drive_index
DRIVE_INDEX_DB_PASSWORD=CHANGEME

# Google OAuth
# Directory containing client_secret_*.json candidates (matched by token client_id)
DRIVE_CLIENT_SECRETS_DIR=~
# Where the working drive.readonly token is stored (chmod 600)
DRIVE_STATE_DIR=~/.gdrive-index
# Optional: seed token to match client secrets against (read-only, never overwritten)
DRIVE_SEED_TOKEN_PATH=

# Pipeline tuning
DRIVE_INDEX_TMPDIR=/data/tmp/drive-index
DRIVE_INDEX_MAX_DOWNLOAD_BYTES=536870912
DRIVE_INDEX_SYNC_WORKERS=4
WHISPER_MODEL=small
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
